## The brand page: the logo, colours and app icons to download

# Browser tab title
brand-title = Brand · Luft
brand-description = The Luft logo, its colours and the icons of its apps, ready to download.
brand-heading = Brand
brand-lede = The Luft logo, its colours and the icons of the apps that come with it. Use them freely to write about Luft or to show that your work runs on it.

brand-logo-heading = Logo
# Names of the downloadable logos. "Light" is the version for dark backgrounds.
brand-logo-wordmark = Logo with name
brand-logo-wordmark-light = Logo with name, light
brand-logo-mark = Logo
brand-logo-mark-light = Logo, light
# { $name } is one of the logo or app names above; { $format } is SVG or PNG.
brand-download = Download { $name } as { $format }

brand-rule-space = Leave room around it, at least half its height on every side.
brand-rule-background = Use the dark logo on light backgrounds and the light one on dark backgrounds. Over photos, pick whichever reads better.
brand-rule-as-is = Keep it as it is: no other colours, outlines, shadows, stretching or turning.
brand-rule-name = The name is just Luft, with a capital L. When it needs more, add plain words after it, like “Luft for laptops”.

brand-colours-heading = Colours
brand-colours-text = Click a colour to copy it.
brand-colour-ink = Ink
brand-colour-paper = Paper
brand-colour-night = Night
brand-colour-mist = Mist
brand-colour-brass = Brass
brand-colour-sand = Sand
# Accessible name of a colour swatch. { $name } is the colour's name, { $hex } its code such as #1d1b17.
brand-colour-copy = Copy { $name }, { $hex }
# Shown in place of the colour's code for a moment after copying it
brand-colour-copied = Copied

brand-icons-heading = App icons
