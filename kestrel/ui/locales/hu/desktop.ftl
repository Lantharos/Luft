window-menu-unmaximize = Előző méret
window-menu-pin = Rögzítés a tálcán
window-menu-unpin = Rögzítés feloldása a tálcán
window-menu-close = { $count ->
    [one] Ablak bezárása
   *[other] Összes ablak bezárása
}

## Context menus

context-menu-back = Vissza

## Window previews (hovering a taskbar app)

previews-close-window = Bezárás: { $title }

## Tray

tray-apps = Rendszertálca
