+#pragma once
+
+#include "backends/meta-stage-private.h"
+#include "compositor/meta-background-effect.h"
+
+typedef struct _MetaBackgroundBlurView MetaBackgroundBlurView;
+
+typedef struct
+{
+  graphene_matrix_t actor_to_framebuffer;
+  graphene_matrix_t framebuffer_to_actor;
+  float scale;
+  gboolean flip_x;
+  gboolean flip_y;
+} MetaBackgroundTransform;
+
+typedef struct
+{
+  ClutterActor *actor;
+  ClutterActorBox box;
+  gboolean bounded;
+} MetaBackgroundPlacement;
+
+struct _MetaBackgroundBlurView
+{
+  MetaBackgroundBlur *blur;
+  ClutterStageView *view;
+  CoglFramebuffer *framebuffer;
+  CoglPipeline *pipeline;
+  int capacity_width;
+  int capacity_height;
+  MtkRectangle source_rect;
+  ClutterActorBox actor_box;
+  ClutterActorBox region_box;
+  gboolean flip_x;
+  gboolean flip_y;
+  gboolean valid;
+  gboolean seen;
+  gboolean dirty;
+  MtkRectangle stage_area;
+};
+
+struct _MetaBackgroundBlur
+{
+  MetaCompositor *compositor;
+  ClutterActor *actor;
+  MtkRegion *blur_region;
+  MetaStage *stage;
+  MetaStageRedrawClipFilter *redraw_clip_filter;
+  gulong before_paint_id;
+  GList *views;
+  GArray *placements;
+  GArray *previous_placements;
+  guint64 print;
+};
+
+MetaBackgroundBlurView * meta_background_blur_get_view (MetaBackgroundBlur *blur,
+                                                        ClutterStageView   *view);
+
+MetaBackgroundBlurView * meta_background_blur_find_result (MetaBackgroundBlur    *blur,
+                                                           const ClutterActorBox *region_box);
+
+void meta_background_blur_get_region_box (MetaBackgroundBlur    *blur,
+                                          const ClutterActorBox *content_box,
+                                          int                    content_width,
+                                          int                    content_height,
+                                          ClutterActorBox       *region_box);
+
+gboolean meta_background_blur_behind_changed (MetaBackgroundBlur *blur,
+                                              const MtkRegion    *blurred);
+
+gboolean meta_background_get_transform (ClutterActor            *actor,
+                                        ClutterPaintContext     *paint_context,
+                                        CoglFramebuffer         *framebuffer,
+                                        const ClutterActorBox   *actor_box,
+                                        MetaBackgroundTransform *transform);
+
+gboolean meta_background_actor_box_to_framebuffer (const ClutterActorBox         *actor_box,
+                                                   const MetaBackgroundTransform *transform,
+                                                   graphene_rect_t               *framebuffer_rect);
+
+gboolean meta_background_framebuffer_to_actor_box (const graphene_rect_t         *framebuffer_rect,
+                                                   const MetaBackgroundTransform *transform,
+                                                   ClutterActorBox               *actor_box);
+
+gboolean meta_background_region_rect_to_actor_box (const MtkRectangle    *region_rect,
+                                                   const ClutterActorBox *content_box,
+                                                   int                    content_width,
+                                                   int                    content_height,
+                                                   ClutterActorBox       *actor_box);
diff --git a/src/compositor/meta-background-blur.c b/src/compositor/meta-background-blur.c
new file mode 100644
index 0000000000000000000000000000000000000000..47c0c4929c59d6bccff38ded59c96e68b6e44d5e
--- /dev/null
+++ b/src/compositor/meta-background-blur.c
@@ -0,0 +1,344 @@
+/*
+ * Copyright (C) 2026 Kristof Imeri
+ *
+ * This program is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU General Public License as
+ * published by the Free Software Foundation; either version 2 of the
+ * License, or (at your option) any later version.
+ *
+ * This program is distributed in the hope that it will be useful, but
+ * WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program; if not, see <http://www.gnu.org/licenses/>.
+ */
+
+#include "config.h"
+
+#include <math.h>
+
+#include "compositor/meta-background-blur-private.h"
+
+#include "clutter/clutter-mutter.h"
+
+static void view_destroyed (gpointer  data,
+                            GObject  *view);
+
+static void
+free_view (MetaBackgroundBlurView *blur_view)
+{
+  g_object_weak_unref (G_OBJECT (blur_view->view), view_destroyed, blur_view);
+  g_clear_object (&blur_view->framebuffer);
+  g_clear_object (&blur_view->pipeline);
+  g_free (blur_view);
+}
+
+MetaBackgroundBlurView *
+meta_background_blur_get_view (MetaBackgroundBlur *blur,
+                               ClutterStageView   *view)
+{
+  MetaBackgroundBlurView *blur_view;
+  GList *l;
+
+  for (l = blur->views; l; l = l->next)
+    {
+      blur_view = l->data;
+      if (blur_view->view == view)
+        return blur_view;
+    }
+
+  blur_view = g_new0 (MetaBackgroundBlurView, 1);
+  blur_view->blur = blur;
+  blur_view->view = view;
+  g_object_weak_ref (G_OBJECT (view), view_destroyed, blur_view);
+  blur->views = g_list_prepend (blur->views, blur_view);
+  return blur_view;
+}
+
+MetaBackgroundBlurView *
+meta_background_blur_find_result (MetaBackgroundBlur    *blur,
+                                  const ClutterActorBox *region_box)
+{
+  GList *l;
+
+  for (l = blur->views; l; l = l->next)
+    {
+      MetaBackgroundBlurView *blur_view = l->data;
+
+      if (blur_view->valid &&
+          clutter_actor_box_equal (&blur_view->region_box, region_box))
+        return blur_view;
+    }
+
+  return NULL;
+}
+
+void
+meta_background_blur_get_region_box (MetaBackgroundBlur    *blur,
+                                     const ClutterActorBox *content_box,
+                                     int                    content_width,
+                                     int                    content_height,
+                                     ClutterActorBox       *region_box)
+{
+  MtkRectangle extents = mtk_region_get_extents (blur->blur_region);
+  float x_scale = (content_box->x2 - content_box->x1) / MAX (content_width, 1);
+  float y_scale = (content_box->y2 - content_box->y1) / MAX (content_height, 1);
+
+  *region_box = (ClutterActorBox) {
+    .x1 = content_box->x1 + extents.x * x_scale,
+    .y1 = content_box->y1 + extents.y * y_scale,
+    .x2 = content_box->x1 + (extents.x + extents.width) * x_scale,
+    .y2 = content_box->y1 + (extents.y + extents.height) * y_scale,
+  };
+}
+
+static MtkRegion *
+region_on_stage (const MtkRegion    *region,
+                 graphene_matrix_t  *actor_to_stage,
+                 const MtkRectangle *layout)
+{
+  MtkRegion *on_stage;
+
+  if (!graphene_matrix_is_2d (actor_to_stage))
+    return NULL;
+
+  on_stage = mtk_region_apply_matrix_transform_expand (region, actor_to_stage);
+  mtk_region_intersect_rectangle (on_stage, layout);
+  return on_stage;
+}
+
+static MtkRegion *
+original_on_stage (MetaBackgroundBlur *blur,
+                   const MtkRectangle *layout)
+{
+  graphene_matrix_t actor_to_stage;
+
+  clutter_actor_get_relative_transformation_matrix (blur->actor,
+                                                    CLUTTER_ACTOR (blur->stage),
+                                                    &actor_to_stage);
+  return region_on_stage (blur->blur_region, &actor_to_stage, layout);
+}
+
+static gboolean
+add_to_redraw_clip (MtkRegion       *redraw_clip,
+                    const MtkRegion *area)
+{
+  g_autoptr (MtkRegion) missing = mtk_region_copy (area);
+
+  mtk_region_subtract (missing, redraw_clip);
+  if (mtk_region_is_empty (missing))
+    return FALSE;
+
+  mtk_region_union (redraw_clip, missing);
+  return TRUE;
+}
+
+static gboolean
+touches (const MtkRegion *redraw_clip,
+         const MtkRegion *area)
+{
+  g_autoptr (MtkRegion) overlap = NULL;
+
+  if (!redraw_clip)
+    return TRUE;
+
+  overlap = mtk_region_copy (area);
+  mtk_region_intersect (overlap, redraw_clip);
+  return !mtk_region_is_empty (overlap);
+}
+
+static gboolean
+look_behind (MetaBackgroundBlur *blur,
+             ClutterStageView   *view,
+             MtkRegion          *redraw_clip,
+             const MtkRectangle *layout)
+{
+  MetaBackgroundBlurView *blur_view = meta_background_blur_get_view (blur, view);
+  g_autoptr (MtkRegion) area = NULL;
+  g_autoptr (MtkRegion) looked = NULL;
+  MtkRectangle extents;
+
+  if (!clutter_actor_is_mapped (blur->actor) ||
+      clutter_actor_get_paint_opacity (blur->actor) == 0 ||
+      !g_list_find (clutter_actor_peek_stage_views (blur->actor), view))
+    return FALSE;
+
+  area = original_on_stage (blur, layout);
+  if (!area || mtk_region_is_empty (area))
+    return FALSE;
+
+  if (!blur_view->seen)
+    {
+      blur_view->seen = TRUE;
+      extents = mtk_region_get_extents (area);
+      looked = mtk_region_copy (area);
+      if (redraw_clip)
+        mtk_region_intersect (looked, redraw_clip);
+      blur_view->dirty = !blur_view->valid ||
+        !mtk_rectangle_equal (&extents, &blur_view->stage_area) ||
+        (!mtk_region_is_empty (looked) &&
+         meta_background_blur_behind_changed (blur, looked));
+      blur_view->stage_area = extents;
+      if (blur_view->dirty)
+        clutter_actor_invalidate_paint_cache (blur->actor);
+    }
+
+  if (!blur_view->dirty || !redraw_clip || !touches (redraw_clip, area))
+    return FALSE;
+
+  return add_to_redraw_clip (redraw_clip, area);
+}
+
+typedef struct
+{
+  MetaBackgroundBlur *blur;
+  ClutterStageView *view;
+  MtkRegion *redraw_clip;
+  MtkRectangle layout;
+  gboolean grew;
+} CloneData;
+
+static void
+look_behind_clone (ClutterActor *source,
+                   ClutterActor *clone,
+                   gpointer      user_data)
+{
+  CloneData *data = user_data;
+  g_autoptr (MtkRegion) area = NULL;
+  graphene_matrix_t actor_to_source;
+  graphene_matrix_t source_to_clone;
+  graphene_matrix_t clone_to_stage;
+  graphene_matrix_t actor_to_stage;
+
+  if (!g_list_find (clutter_actor_peek_stage_views (clone), data->view))
+    return;
+
+  clutter_actor_get_relative_transformation_matrix (data->blur->actor, source,
+                                                    &actor_to_source);
+  clutter_clone_get_source_transform (CLUTTER_CLONE (clone), &source_to_clone);
+  clutter_actor_get_relative_transformation_matrix (clone,
+                                                    CLUTTER_ACTOR (data->blur->stage),
+                                                    &clone_to_stage);
+  graphene_matrix_multiply (&actor_to_source, &source_to_clone, &actor_to_stage);
+  graphene_matrix_multiply (&actor_to_stage, &clone_to_stage, &actor_to_stage);
+
+  area = region_on_stage (data->blur->blur_region, &actor_to_stage, &data->layout);
+  if (!area || !touches (data->redraw_clip, area))
+    return;
+
+  clutter_actor_invalidate_paint_cache (data->blur->actor);
+  if (data->redraw_clip)
+    data->grew |= add_to_redraw_clip (data->redraw_clip, area);
+}
+
+static gboolean
+clones_keep_a_result (MetaBackgroundBlur *blur)
+{
+  GList *l;
+
+  for (l = blur->views; l; l = l->next)
+    {
+      MetaBackgroundBlurView *blur_view = l->data;
+
+      if (blur_view->valid)
+        return TRUE;
+    }
+
+  return FALSE;
+}
+
+static gboolean
+expand_redraw_clip (MetaStage        *stage,
+                    ClutterStageView *view,
+                    MtkRegion        *redraw_clip,
+                    gpointer          user_data)
+{
+  MetaBackgroundBlur *blur = user_data;
+  CloneData data = {
+    .blur = blur,
+    .view = view,
+    .redraw_clip = redraw_clip,
+  };
+
+  if (clutter_actor_get_stage (blur->actor) != CLUTTER_ACTOR (stage))
+    return FALSE;
+
+  clutter_stage_view_get_layout (view, &data.layout);
+  data.grew = look_behind (blur, view, redraw_clip, &data.layout);
+
+  if (!clones_keep_a_result (blur))
+    clutter_actor_foreach_mapped_clone (blur->actor, look_behind_clone, &data);
+
+  return data.grew;
+}
+
+static void
+forget_frame (MetaBackgroundBlur *blur,
+              ClutterStageView   *view)
+{
+  GList *l;
+
+  for (l = blur->views; l; l = l->next)
+    {
+      MetaBackgroundBlurView *blur_view = l->data;
+
+      if (blur_view->view != view)
+        continue;
+
+      blur_view->seen = FALSE;
+      blur_view->dirty = FALSE;
+    }
+}
+
+static void
+view_destroyed (gpointer  data,
+                GObject  *view)
+{
+  MetaBackgroundBlurView *blur_view = data;
+  MetaBackgroundBlur *blur = blur_view->blur;
+
+  blur->views = g_list_remove (blur->views, blur_view);
+  g_clear_object (&blur_view->framebuffer);
+  g_clear_object (&blur_view->pipeline);
+  g_free (blur_view);
+}
+
+MetaBackgroundBlur *
+meta_background_blur_new (MetaCompositor  *compositor,
+                          ClutterActor    *actor,
+                          const MtkRegion *blur_region)
+{
+  MetaBackgroundBlur *blur;
+
+  g_return_val_if_fail (CLUTTER_IS_ACTOR (actor), NULL);
+  g_return_val_if_fail (blur_region != NULL, NULL);
+
+  blur = g_new0 (MetaBackgroundBlur, 1);
+  blur->compositor = compositor;
+  blur->actor = actor;
+  blur->blur_region = mtk_region_copy (blur_region);
+  blur->stage = META_STAGE (meta_compositor_get_stage (compositor));
+  blur->placements = g_array_new (FALSE, FALSE, sizeof (MetaBackgroundPlacement));
+  blur->previous_placements = g_array_new (FALSE, FALSE, sizeof (MetaBackgroundPlacement));
+  blur->redraw_clip_filter =
+    meta_stage_add_redraw_clip_filter (blur->stage, expand_redraw_clip, blur, NULL);
+  blur->before_paint_id =
+    g_signal_connect_swapped (blur->stage, "before-paint",
+                              G_CALLBACK (forget_frame), blur);
+  return blur;
+}
+
+void
+meta_background_blur_destroy (MetaBackgroundBlur *blur)
+{
+  g_clear_pointer (&blur->redraw_clip_filter,
+                   meta_stage_remove_redraw_clip_filter);
+  g_clear_signal_handler (&blur->before_paint_id, blur->stage);
+  g_list_free_full (blur->views, (GDestroyNotify) free_view);
+  g_clear_pointer (&blur->blur_region, mtk_region_unref);
+  g_array_unref (blur->placements);
+  g_array_unref (blur->previous_placements);
+  g_free (blur);
+}
