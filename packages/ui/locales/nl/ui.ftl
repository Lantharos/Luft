## Fingerprints
## Each finger has a name used as a title (the message value) and a form used inside
## a sentence (.inline), like "Place your … on the sensor." Adjust the case of .inline
## to fit those sentences.

ui-finger-right-index = Rechterwijsvinger
    .inline = rechterwijsvinger
ui-finger-left-index = Linkerwijsvinger
    .inline = linkerwijsvinger
ui-finger-right-thumb = Rechterduim
    .inline = rechterduim
ui-finger-left-thumb = Linkerduim
    .inline = linkerduim
ui-finger-right-middle = Rechtermiddelvinger
    .inline = rechtermiddelvinger
ui-finger-left-middle = Linkermiddelvinger
    .inline = linkermiddelvinger
ui-finger-right-ring = Rechterringvinger
    .inline = rechterringvinger
ui-finger-left-ring = Linkerringvinger
    .inline = linkerringvinger
ui-finger-right-little = Rechterpink
    .inline = rechterpink
ui-finger-left-little = Linkerpink
    .inline = linkerpink

ui-fingerprint-place = Leg je { $finger } op de sensor.
ui-fingerprint-swipe = Veeg met je { $finger } over de sensor.
ui-fingerprint-stage-passed = Goed. Til je vinger op en leg hem opnieuw neer.
ui-fingerprint-stage-passed-swipe = Goed. Veeg nog een keer.
ui-fingerprint-retry = Dat werd niet goed gelezen. Probeer het opnieuw.
ui-fingerprint-swipe-too-short = Veeg iets langzamer.
ui-fingerprint-not-centered = Leg je vinger midden op de sensor.
ui-fingerprint-remove-and-retry = Til je vinger op en probeer het opnieuw.
ui-fingerprint-added = Vingerafdruk toegevoegd.
ui-fingerprint-full = De lezer heeft geen ruimte meer voor nog een vingerafdruk.
ui-fingerprint-disconnected = De vingerafdruklezer reageert niet meer. Probeer het zo opnieuw.
ui-fingerprint-duplicate = Deze vinger is al opgeslagen op de lezer, waarschijnlijk door Windows of een ander account. Gebruik een andere vinger.
ui-fingerprint-failed = Kan deze vingerafdruk niet toevoegen. Probeer het opnieuw.

