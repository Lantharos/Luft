+static void
+set_device_tool (MetaSeatImpl           *seat_impl,
+                 ClutterInputDevice     *input_device,
+                 ClutterInputDeviceTool *tool)
+{
+  MetaInputDeviceNative *evdev_device = META_INPUT_DEVICE_NATIVE (input_device);
+
+  if (evdev_device->last_tool == tool)
+    return;
+
+  evdev_device->last_tool = tool;
+  meta_input_settings_notify_tool_change (seat_impl->input_settings,
+                                          input_device, tool);
+}
+
+void
+meta_seat_impl_notify_tablet_proximity_in_impl (MetaSeatImpl           *seat_impl,
+                                                ClutterInputDevice     *input_device,
+                                                ClutterInputDeviceTool *tool,
+                                                uint64_t                time_us,
+                                                gboolean                in)
+{
+  if (in)
+    set_device_tool (seat_impl, input_device, tool);
+  notify_proximity (input_device, time_us, in);
+  if (!in)
+    set_device_tool (seat_impl, input_device, NULL);
+}
