index 0000000000000000000000000000000000000000..240d4061ba6c864b6d4bd270ed017dcb39111650
--- /dev/null
+++ b/src/wayland/meta-wayland-image-copy-capture.c
@@ -0,0 +1,916 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "config.h"
+
+#include "wayland/meta-wayland-image-copy-capture.h"
+
+#include <drm_fourcc.h>
+#include <glib-unix.h>
+
+#include "backends/meta-backend-private.h"
+#include "backends/meta-cursor-tracker-private.h"
+#include "backends/meta-screen-cast-window.h"
+#include "compositor/meta-window-actor-private.h"
+#include "core/display-private.h"
+#include "core/window-private.h"
+#include "wayland/meta-wayland-buffer.h"
+#include "wayland/meta-wayland-dma-buf.h"
+#include "wayland/meta-wayland-foreign-toplevel-list.h"
+#include "wayland/meta-wayland-private.h"
+#include "wayland/meta-wayland-sandbox.h"
+#include "wayland/meta-wayland-versions.h"
+
+#include "ext-image-capture-source-v1-server-protocol.h"
+#include "ext-image-copy-capture-v1-server-protocol.h"
+
+typedef struct
+{
+  uint32_t shm_format;
+  uint32_t drm_format;
+  CoglPixelFormat cogl_format;
+} CaptureFormat;
+
+static const CaptureFormat formats[] = {
+  { WL_SHM_FORMAT_ARGB8888, DRM_FORMAT_ARGB8888, COGL_PIXEL_FORMAT_BGRA_8888_PRE },
+  { WL_SHM_FORMAT_XRGB8888, DRM_FORMAT_XRGB8888, COGL_PIXEL_FORMAT_BGRX_8888 },
+};
+
+static GQuark quark_framebuffer = 0;
+
+typedef struct _Session Session;
+
+typedef enum
+{
+  COPY_DONE,
+  COPY_UNFIT,
+  COPY_FAILED,
+} CopyResult;
+
+typedef struct
+{
+  struct wl_resource *resource;
+  MetaWindow *window;
+  gulong unmanaged_handler_id;
+} CaptureSource;
+
+typedef struct
+{
+  Session *session;
+  struct wl_resource *resource;
+  struct wl_resource *buffer;
+  gboolean captured;
+  int64_t copied_at;
+  int fence;
+  guint fence_source_id;
+} Frame;
+
+struct _Session
+{
+  MetaWaylandImageCopyCapture *manager;
+  struct wl_resource *resource;
+  unsigned int id;
+  MetaWindow *window;
+  MetaWindowActor *actor;
+  gboolean paint_cursors;
+  MtkRectangle area;
+  gboolean copied_once;
+  gboolean damaged;
+  Frame *frame;
+  guint copy_source_id;
+  CoglFramebuffer *readback;
+  gulong damaged_handler_id;
+  gulong size_handler_id;
+  gulong unmanaged_handler_id;
+  gulong cursor_handler_id;
+};
+
+struct _MetaWaylandImageCopyCapture
+{
+  MetaWaylandCompositor *compositor;
+  GHashTable *sessions;
+  unsigned int last_id;
+};
+
+static const struct ext_image_capture_source_v1_interface source_interface;
+static const struct ext_image_copy_capture_session_v1_interface session_interface;
+static const struct ext_image_copy_capture_frame_v1_interface frame_interface;
+
+static MetaBackend *
+backend_of (Session *session)
+{
+  return meta_context_get_backend (session->manager->compositor->context);
+}
+
+static CoglContext *
+cogl_context_of (Session *session)
+{
+  return clutter_backend_get_cogl_context (meta_backend_get_clutter_backend (backend_of (session)));
+}
+
+static MetaDisplay *
+display_of (Session *session)
+{
+  return meta_context_get_display (session->manager->compositor->context);
+}
+
+static const CaptureFormat *
+format_for_shm (uint32_t shm_format)
+{
+  for (size_t i = 0; i < G_N_ELEMENTS (formats); i++)
+    if (formats[i].shm_format == shm_format)
+      return &formats[i];
+  return NULL;
+}
+
+static const CaptureFormat *
+format_for_drm (uint32_t drm_format)
+{
+  for (size_t i = 0; i < G_N_ELEMENTS (formats); i++)
+    if (formats[i].drm_format == drm_format)
+      return &formats[i];
+  return NULL;
+}
+
+static void
+source_free (CaptureSource *source)
+{
+  if (source->window)
+    g_clear_signal_handler (&source->unmanaged_handler_id, source->window);
+  g_free (source);
+}
+
+static void
+on_source_window_unmanaged (MetaWindow    *window,
+                            CaptureSource *source)
+{
+  g_clear_signal_handler (&source->unmanaged_handler_id, window);
+  source->window = NULL;
+}
+
+static void
+source_destructor (struct wl_resource *resource)
+{
+  source_free (wl_resource_get_user_data (resource));
+}
+
+static void
+source_destroy (struct wl_client   *client,
+                struct wl_resource *resource)
+{
+  wl_resource_destroy (resource);
+}
+
+static const struct ext_image_capture_source_v1_interface source_interface = {
+  source_destroy,
+};
+
+static void
+toplevel_source_manager_create_source (struct wl_client   *client,
+                                       struct wl_resource *resource,
+                                       uint32_t            id,
+                                       struct wl_resource *toplevel_handle)
+{
+  CaptureSource *source = g_new0 (CaptureSource, 1);
+
+  source->window = meta_wayland_foreign_toplevel_handle_get_window (toplevel_handle);
+  if (source->window)
+    source->unmanaged_handler_id =
+      g_signal_connect (source->window, "unmanaged", G_CALLBACK (on_source_window_unmanaged), source);
+
+  source->resource = wl_resource_create (client, &ext_image_capture_source_v1_interface,
+                                         wl_resource_get_version (resource), id);
+  wl_resource_set_implementation (source->resource, &source_interface, source, source_destructor);
+}
+
+static void
+manager_destroy (struct wl_client   *client,
+                 struct wl_resource *resource)
+{
+  wl_resource_destroy (resource);
+}
+
+static const struct ext_foreign_toplevel_image_capture_source_manager_v1_interface toplevel_source_manager_interface = {
+  toplevel_source_manager_create_source,
+  manager_destroy,
+};
+
+static void
+blit_cursor (Session         *session,
+             CoglFramebuffer *framebuffer)
+{
+  MetaBackend *backend = backend_of (session);
+  MetaCursorRenderer *cursor_renderer = meta_backend_get_cursor_renderer (backend);
+  MetaCursorTracker *cursor_tracker = meta_backend_get_cursor_tracker (backend);
+  graphene_point_t relative_position;
+  graphene_point_t position;
+  graphene_matrix_t matrix;
+  g_autoptr (CoglPipeline) pipeline = NULL;
+  ClutterCursor *cursor;
+  CoglTexture *texture;
+  float view_scale, cursor_scale, scale, x, y;
+  int width, height, hotspot_x, hotspot_y;
+
+  cursor = cursor_renderer ? meta_cursor_renderer_get_cursor (cursor_renderer) : NULL;
+  texture = cursor ? clutter_cursor_get_texture (cursor) : NULL;
+  if (!texture)
+    return;
+
+  meta_cursor_tracker_get_pointer (cursor_tracker, &position, NULL);
+  if (!meta_screen_cast_window_transform_cursor_position (META_SCREEN_CAST_WINDOW (session->actor),
+                                                          cursor, &position,
+                                                          &relative_position, &view_scale))
+    return;
+
+  cursor_scale = clutter_cursor_get_scale (cursor);
+  scale = cursor_scale * view_scale;
+  clutter_cursor_get_geometry (cursor, &width, &height, &hotspot_x, &hotspot_y);
+  x = (relative_position.x - hotspot_x) * scale - session->area.x;
+  y = (relative_position.y - hotspot_y) * scale - session->area.y;
+
+  pipeline = cogl_pipeline_new (cogl_context_of (session));
+  cogl_pipeline_set_layer_texture (pipeline, 0, texture);
+  cogl_pipeline_set_layer_filters (pipeline, 0, COGL_PIPELINE_FILTER_LINEAR, COGL_PIPELINE_FILTER_LINEAR);
+  graphene_matrix_init_identity (&matrix);
+  mtk_compute_viewport_matrix (&matrix, width, height, cursor_scale,
+                               clutter_cursor_get_transform (cursor),
+                               clutter_cursor_get_viewport_src_rect (cursor));
+  cogl_pipeline_set_layer_matrix (pipeline, 0, &matrix);
+  cogl_framebuffer_draw_rectangle (framebuffer, pipeline, x, y, x + width, y + height);
+}
+
+static gboolean
+render (Session         *session,
+        CoglFramebuffer *framebuffer)
+{
+  cogl_framebuffer_clear4f (framebuffer, COGL_BUFFER_BIT_COLOR, 0, 0, 0, 0);
+  if (!meta_screen_cast_window_blit_to_framebuffer (META_SCREEN_CAST_WINDOW (session->actor),
+                                                    &session->area, framebuffer))
+    return FALSE;
+  if (session->paint_cursors)
+    blit_cursor (session, framebuffer);
+  return TRUE;
+}
+
+static CoglFramebuffer *
+readback_framebuffer (Session *session)
+{
+  g_autoptr (CoglTexture) texture = NULL;
+  CoglOffscreen *offscreen;
+
+  if (session->readback &&
+      cogl_framebuffer_get_width (session->readback) == session->area.width &&
+      cogl_framebuffer_get_height (session->readback) == session->area.height)
+    return session->readback;
+
+  g_clear_object (&session->readback);
+  texture = cogl_texture_2d_new_with_size (cogl_context_of (session), session->area.width, session->area.height);
+  offscreen = cogl_offscreen_new_with_texture (texture);
+  if (!cogl_framebuffer_allocate (COGL_FRAMEBUFFER (offscreen), NULL))
+    {
+      g_object_unref (offscreen);
+      return NULL;
+    }
+  session->readback = COGL_FRAMEBUFFER (offscreen);
+  return session->readback;
+}
+
+static CopyResult
+copy_to_shm (Session              *session,
+             struct wl_shm_buffer *shm_buffer)
+{
+  const CaptureFormat *format = format_for_shm (wl_shm_buffer_get_format (shm_buffer));
+  CoglFramebuffer *framebuffer;
+  gboolean copied;
+
+  if (!format ||
+      wl_shm_buffer_get_width (shm_buffer) != session->area.width ||
+      wl_shm_buffer_get_height (shm_buffer) != session->area.height ||
+      wl_shm_buffer_get_stride (shm_buffer) != session->area.width * 4)
+    return COPY_UNFIT;
+
+  framebuffer = readback_framebuffer (session);
+  if (!framebuffer || !render (session, framebuffer))
+    return COPY_FAILED;
+
+  wl_shm_buffer_begin_access (shm_buffer);
+  copied = cogl_framebuffer_read_pixels (framebuffer, 0, 0, session->area.width, session->area.height,
+                                         format->cogl_format, wl_shm_buffer_get_data (shm_buffer));
+  wl_shm_buffer_end_access (shm_buffer);
+  return copied ? COPY_DONE : COPY_FAILED;
+}
+
+static CoglFramebuffer *
+dma_buf_framebuffer (Session                 *session,
+                     MetaWaylandBuffer       *buffer,
+                     MetaWaylandDmaBufBuffer *dma_buf,
+                     const CaptureFormat     *format)
+{
+  CoglFramebuffer *framebuffer = g_object_get_qdata (G_OBJECT (buffer), quark_framebuffer);
+  g_autoptr (GError) error = NULL;
+
+  if (framebuffer)
+    return framebuffer;
+
+  framebuffer = meta_wayland_dma_buf_buffer_create_framebuffer (dma_buf, cogl_context_of (session),
+                                                                format->cogl_format, &error);
+  if (!framebuffer)
+    {
+      g_warning ("Couldn't record into a client's buffer: %s", error->message);
+      return NULL;
+    }
+
+  g_object_set_qdata_full (G_OBJECT (buffer), quark_framebuffer, framebuffer, g_object_unref);
+  return framebuffer;
+}
+
+static CopyResult
+copy_to_dma_buf (Session           *session,
+                 MetaWaylandBuffer *buffer,
+                 int               *fence)
+{
+  MetaWaylandDmaBufBuffer *dma_buf = meta_wayland_dma_buf_from_buffer (buffer);
+  const CaptureFormat *format =
+    format_for_drm (meta_wayland_dma_buf_buffer_get_drm_format (dma_buf));
+  CoglFramebuffer *framebuffer;
+
+  if (!format ||
+      meta_wayland_dma_buf_buffer_get_width (buffer) != session->area.width ||
+      meta_wayland_dma_buf_buffer_get_height (buffer) != session->area.height)
+    return COPY_UNFIT;
+
+  framebuffer = dma_buf_framebuffer (session, buffer, dma_buf, format);
+  if (!framebuffer || !render (session, framebuffer))
+    return COPY_FAILED;
+
+  cogl_framebuffer_flush (framebuffer);
+  *fence = cogl_renderer_get_latest_sync_fd (cogl_context_get_renderer (cogl_context_of (session)));
+  if (*fence < 0)
+    cogl_framebuffer_finish (framebuffer);
+  return COPY_DONE;
+}
+
+static void
+frame_free (Frame *frame)
+{
+  g_clear_handle_id (&frame->fence_source_id, g_source_remove);
+  g_clear_fd (&frame->fence, NULL);
+  g_free (frame);
+}
+
+static void
+frame_detach (Frame *frame)
+{
+  frame->session->frame = NULL;
+  wl_resource_set_user_data (frame->resource, NULL);
+}
+
+static void
+frame_fail (Frame                                              *frame,
+            enum ext_image_copy_capture_frame_v1_failure_reason reason)
+{
+  frame_detach (frame);
+  ext_image_copy_capture_frame_v1_send_failed (frame->resource, reason);
+  frame_free (frame);
+}
+
+static void
+frame_ready (Frame *frame)
+{
+  Session *session = frame->session;
+  uint64_t seconds = frame->copied_at / G_USEC_PER_SEC;
+
+  frame_detach (frame);
+  ext_image_copy_capture_frame_v1_send_transform (frame->resource, WL_OUTPUT_TRANSFORM_NORMAL);
+  ext_image_copy_capture_frame_v1_send_damage (frame->resource, 0, 0, session->area.width, session->area.height);
+  ext_image_copy_capture_frame_v1_send_presentation_time (frame->resource, seconds >> 32, seconds & 0xffffffff,
+                                                          (frame->copied_at % G_USEC_PER_SEC) * 1000);
+  ext_image_copy_capture_frame_v1_send_ready (frame->resource);
+  frame_free (frame);
+}
+
+static gboolean
+on_frame_rendered (int          fence,
+                   GIOCondition condition,
+                   gpointer     data)
+{
+  Frame *frame = data;
+
+  frame->fence_source_id = 0;
+  frame_ready (frame);
+  return G_SOURCE_REMOVE;
+}
+
+static void
+copy_frame (Session *session)
+{
+  Frame *frame = session->frame;
+  MetaWaylandBuffer *buffer;
+  struct wl_shm_buffer *shm_buffer;
+  CopyResult result = COPY_UNFIT;
+
+  frame->copied_at = g_get_monotonic_time ();
+  buffer = meta_wayland_buffer_from_resource (session->manager->compositor, frame->buffer);
+  shm_buffer = wl_shm_buffer_get (frame->buffer);
+  if (shm_buffer)
+    result = copy_to_shm (session, shm_buffer);
+  else if (meta_wayland_buffer_realize (buffer) && buffer->type == META_WAYLAND_BUFFER_TYPE_DMA_BUF)
+    result = copy_to_dma_buf (session, buffer, &frame->fence);
+
+  switch (result)
+    {
+    case COPY_UNFIT:
+      frame_fail (frame, EXT_IMAGE_COPY_CAPTURE_FRAME_V1_FAILURE_REASON_BUFFER_CONSTRAINTS);
+      return;
+    case COPY_FAILED:
+      frame_fail (frame, EXT_IMAGE_COPY_CAPTURE_FRAME_V1_FAILURE_REASON_UNKNOWN);
+      return;
+    case COPY_DONE:
+      break;
+    }
+
+  session->copied_once = TRUE;
+  session->damaged = FALSE;
+  if (frame->fence < 0)
+    frame_ready (frame);
+  else
+    frame->fence_source_id = g_unix_fd_add (frame->fence, G_IO_IN, on_frame_rendered, frame);
+}
+
+static gboolean
+copy_when_idle (gpointer data)
+{
+  Session *session = data;
+
+  session->copy_source_id = 0;
+  if (session->frame && session->frame->captured && !session->frame->fence_source_id &&
+      session->actor)
+    copy_frame (session);
+  return G_SOURCE_REMOVE;
+}
+
+static void
+maybe_copy (Session *session)
+{
+  if (!session->frame || !session->frame->captured || session->frame->fence_source_id ||
+      session->copy_source_id)
+    return;
+  if (session->copied_once && !session->damaged)
+    return;
+
+  session->copy_source_id = g_idle_add_full (G_PRIORITY_HIGH, copy_when_idle, session, NULL);
+}
+
+static void
+send_constraints (Session *session)
+{
+  CoglContext *cogl_context = cogl_context_of (session);
+  CoglRenderer *renderer = cogl_context_get_renderer (cogl_context);
+  MetaWaylandDmaBufManager *dma_buf_manager = session->manager->compositor->dma_buf_manager;
+  struct wl_resource *resource = session->resource;
+
+  ext_image_copy_capture_session_v1_send_buffer_size (resource, session->area.width, session->area.height);
+  for (size_t i = 0; i < G_N_ELEMENTS (formats); i++)
+    ext_image_copy_capture_session_v1_send_shm_format (resource, formats[i].shm_format);
+
+  if (dma_buf_manager && cogl_renderer_is_dma_buf_supported (renderer))
+    {
+      dev_t device = meta_wayland_dma_buf_manager_get_main_device (dma_buf_manager);
+      struct wl_array device_array;
+
+      wl_array_init (&device_array);
+      *(dev_t *) wl_array_add (&device_array, sizeof (dev_t)) = device;
+      ext_image_copy_capture_session_v1_send_dmabuf_device (resource, &device_array);
+      wl_array_release (&device_array);
+
+      for (size_t i = 0; i < G_N_ELEMENTS (formats); i++)
+        {
+          g_autoptr (GArray) modifiers = NULL;
+          uint64_t implicit = cogl_renderer_get_implicit_drm_modifier (renderer);
+          struct wl_array modifier_array;
+
+          modifiers = cogl_renderer_query_drm_modifiers (renderer, formats[i].cogl_format,
+                                                         COGL_DRM_MODIFIER_FILTER_SINGLE_PLANE |
+                                                         COGL_DRM_MODIFIER_FILTER_NOT_EXTERNAL_ONLY,
+                                                         NULL);
+          wl_array_init (&modifier_array);
+          for (guint m = 0; modifiers && m < modifiers->len; m++)
+            *(uint64_t *) wl_array_add (&modifier_array, sizeof (uint64_t)) = g_array_index (modifiers, uint64_t, m);
+          *(uint64_t *) wl_array_add (&modifier_array, sizeof (uint64_t)) = implicit;
+          ext_image_copy_capture_session_v1_send_dmabuf_format (resource, formats[i].drm_format, &modifier_array);
+          wl_array_release (&modifier_array);
+        }
+    }
+
+  ext_image_copy_capture_session_v1_send_done (resource);
+}
+
+static MtkRectangle
+client_area (Session *session)
+{
+  MtkRectangle bounds, buffer, client;
+  float scale_x, scale_y;
+
+  meta_screen_cast_window_get_buffer_bounds (META_SCREEN_CAST_WINDOW (session->actor), &bounds);
+  if (meta_window_get_client_type (session->window) != META_WINDOW_CLIENT_TYPE_X11)
+    return bounds;
+
+  meta_window_get_buffer_rect (session->window, &buffer);
+  meta_window_get_client_area_rect (session->window, &client);
+  scale_x = (float) bounds.width / buffer.width;
+  scale_y = (float) bounds.height / buffer.height;
+  return (MtkRectangle) {
+    .x = (int) roundf (client.x * scale_x),
+    .y = (int) roundf (client.y * scale_y),
+    .width = (int) roundf (client.width * scale_x),
+    .height = (int) roundf (client.height * scale_y),
+  };
+}
+
+static gboolean
+update_size (Session *session)
+{
+  MtkRectangle area = client_area (session);
+  gboolean resized = area.width != session->area.width || area.height != session->area.height;
+
+  session->area = area;
+  return resized;
+}
+
+static void
+on_damaged (MetaWindowActor *actor,
+            Session         *session)
+{
+  session->damaged = TRUE;
+  maybe_copy (session);
+}
+
+static void
+on_size_changed (MetaWindow *window,
+                 Session    *session)
+{
+  if (!update_size (session))
+    return;
+
+  send_constraints (session);
+  session->damaged = TRUE;
+}
+
+static void
+on_cursor_moved (MetaCursorTracker *cursor_tracker,
+                 Session           *session)
+{
+  session->damaged = TRUE;
+  maybe_copy (session);
+}
+
+static void
+session_stop (Session *session)
+{
+  MetaCursorTracker *cursor_tracker = meta_backend_get_cursor_tracker (backend_of (session));
+
+  if (!session->window)
+    return;
+
+  g_clear_handle_id (&session->copy_source_id, g_source_remove);
+  g_clear_signal_handler (&session->cursor_handler_id, cursor_tracker);
+  if (session->actor)
+    {
+      g_clear_signal_handler (&session->damaged_handler_id, session->actor);
+      meta_screen_cast_window_dec_usage (META_SCREEN_CAST_WINDOW (session->actor));
+      g_clear_object (&session->actor);
+    }
+  g_clear_signal_handler (&session->size_handler_id, session->window);
+  g_clear_signal_handler (&session->unmanaged_handler_id, session->window);
+  session->window = NULL;
+
+  if (session->frame && session->frame->captured)
+    frame_fail (session->frame, EXT_IMAGE_COPY_CAPTURE_FRAME_V1_FAILURE_REASON_STOPPED);
+
+  g_hash_table_remove (session->manager->sessions, GUINT_TO_POINTER (session->id));
+  meta_display_window_capture_ended (display_of (session), session->id);
+}
+
+static void
+on_unmanaged (MetaWindow *window,
+              Session    *session)
+{
+  session_stop (session);
+  ext_image_copy_capture_session_v1_send_stopped (session->resource);
+}
+
+static void
+frame_destructor (struct wl_resource *resource)
+{
+  Frame *frame = wl_resource_get_user_data (resource);
+
+  if (!frame)
+    return;
+
+  frame->session->frame = NULL;
+  frame_free (frame);
+}
+
+static void
+frame_destroy (struct wl_client   *client,
+               struct wl_resource *resource)
+{
+  wl_resource_destroy (resource);
+}
+
+static void
+frame_attach_buffer (struct wl_client   *client,
+                     struct wl_resource *resource,
+                     struct wl_resource *buffer)
+{
+  Frame *frame = wl_resource_get_user_data (resource);
+
+  if (!frame)
+    return;
+  if (frame->captured)
+    {
+      wl_resource_post_error (resource, EXT_IMAGE_COPY_CAPTURE_FRAME_V1_ERROR_ALREADY_CAPTURED,
+                              "attach_buffer sent after capture");
+      return;
+    }
+  frame->buffer = buffer;
+}
+
+static void
+frame_damage_buffer (struct wl_client   *client,
+                     struct wl_resource *resource,
+                     int32_t             x,
+                     int32_t             y,
+                     int32_t             width,
+                     int32_t             height)
+{
+  Frame *frame = wl_resource_get_user_data (resource);
+
+  if (x < 0 || y < 0 || width <= 0 || height <= 0)
+    {
+      wl_resource_post_error (resource, EXT_IMAGE_COPY_CAPTURE_FRAME_V1_ERROR_INVALID_BUFFER_DAMAGE,
+                              "damage_buffer with an invalid region");
+      return;
+    }
+  if (frame && frame->captured)
+    wl_resource_post_error (resource, EXT_IMAGE_COPY_CAPTURE_FRAME_V1_ERROR_ALREADY_CAPTURED,
+                            "damage_buffer sent after capture");
+}
+
+static void
+frame_capture (struct wl_client   *client,
+               struct wl_resource *resource)
+{
+  Frame *frame = wl_resource_get_user_data (resource);
+
+  if (!frame)
+    {
+      ext_image_copy_capture_frame_v1_send_failed (resource, EXT_IMAGE_COPY_CAPTURE_FRAME_V1_FAILURE_REASON_STOPPED);
+      return;
+    }
+  if (frame->captured)
+    {
+      wl_resource_post_error (resource, EXT_IMAGE_COPY_CAPTURE_FRAME_V1_ERROR_ALREADY_CAPTURED,
+                              "capture sent twice");
+      return;
+    }
+  if (!frame->buffer)
+    {
+      wl_resource_post_error (resource, EXT_IMAGE_COPY_CAPTURE_FRAME_V1_ERROR_NO_BUFFER,
+                              "capture sent without a buffer");
+      return;
+    }
+
+  frame->captured = TRUE;
+  maybe_copy (frame->session);
+}
+
+static const struct ext_image_copy_capture_frame_v1_interface frame_interface = {
+  frame_destroy,
+  frame_attach_buffer,
+  frame_damage_buffer,
+  frame_capture,
+};
+
+static void
+session_create_frame (struct wl_client   *client,
+                      struct wl_resource *resource,
+                      uint32_t            id)
+{
+  Session *session = wl_resource_get_user_data (resource);
+  struct wl_resource *frame_resource;
+  Frame *frame = NULL;
+
+  if (session->frame)
+    {
+      wl_resource_post_error (resource, EXT_IMAGE_COPY_CAPTURE_SESSION_V1_ERROR_DUPLICATE_FRAME,
+                              "create_frame sent before the previous frame was destroyed");
+      return;
+    }
+
+  frame_resource = wl_resource_create (client, &ext_image_copy_capture_frame_v1_interface,
+                                       wl_resource_get_version (resource), id);
+  if (session->window)
+    {
+      frame = g_new0 (Frame, 1);
+      frame->session = session;
+      frame->resource = frame_resource;
+      frame->fence = -1;
+      session->frame = frame;
+    }
+  wl_resource_set_implementation (frame_resource, &frame_interface, frame, frame_destructor);
+}
+
+static void
+session_destructor (struct wl_resource *resource)
+{
+  Session *session = wl_resource_get_user_data (resource);
+
+  session_stop (session);
+  if (session->frame)
+    {
+      wl_resource_set_user_data (session->frame->resource, NULL);
+      frame_free (session->frame);
+    }
+  g_clear_object (&session->readback);
+  g_free (session);
+}
+
+static void
+session_destroy (struct wl_client   *client,
+                 struct wl_resource *resource)
+{
+  wl_resource_destroy (resource);
+}
+
+static const struct ext_image_copy_capture_session_v1_interface session_interface = {
+  session_create_frame,
+  session_destroy,
+};
+
+static gboolean
+session_start (Session    *session,
+               MetaWindow *window)
+{
+  MetaCursorTracker *cursor_tracker = meta_backend_get_cursor_tracker (backend_of (session));
+  MetaWindowActor *actor = window ? meta_window_actor_from_window (window) : NULL;
+  struct wl_client *client = wl_resource_get_client (session->resource);
+
+  if (!actor)
+    return FALSE;
+
+  session->window = window;
+  session->actor = g_object_ref (actor);
+  session->id = ++session->manager->last_id;
+  meta_screen_cast_window_inc_usage (META_SCREEN_CAST_WINDOW (actor));
+  session->damaged_handler_id = g_signal_connect (actor, "damaged", G_CALLBACK (on_damaged), session);
+  session->size_handler_id = g_signal_connect (window, "size-changed", G_CALLBACK (on_size_changed), session);
+  session->unmanaged_handler_id = g_signal_connect (window, "unmanaged", G_CALLBACK (on_unmanaged), session);
+  if (session->paint_cursors)
+    session->cursor_handler_id =
+      g_signal_connect (cursor_tracker, "position-invalidated", G_CALLBACK (on_cursor_moved), session);
+  g_hash_table_insert (session->manager->sessions, GUINT_TO_POINTER (session->id), session);
+
+  update_size (session);
+  send_constraints (session);
+  meta_display_window_capture_started (display_of (session), session->id, window,
+                                       meta_wayland_client_get_sandboxed_app_id (client));
+  return TRUE;
+}
+
+static void
+copy_capture_manager_create_session (struct wl_client   *client,
+                                     struct wl_resource *resource,
+                                     uint32_t            id,
+                                     struct wl_resource *source_resource,
+                                     uint32_t            options)
+{
+  MetaWaylandImageCopyCapture *manager = wl_resource_get_user_data (resource);
+  CaptureSource *source = wl_resource_get_user_data (source_resource);
+  Session *session;
+
+  if (options & ~EXT_IMAGE_COPY_CAPTURE_MANAGER_V1_OPTIONS_PAINT_CURSORS)
+    {
+      wl_resource_post_error (resource, EXT_IMAGE_COPY_CAPTURE_MANAGER_V1_ERROR_INVALID_OPTION,
+                              "unknown capture options");
+      return;
+    }
+
+  session = g_new0 (Session, 1);
+  session->manager = manager;
+  session->paint_cursors = !!(options & EXT_IMAGE_COPY_CAPTURE_MANAGER_V1_OPTIONS_PAINT_CURSORS);
+  session->resource = wl_resource_create (client, &ext_image_copy_capture_session_v1_interface,
+                                          wl_resource_get_version (resource), id);
+  wl_resource_set_implementation (session->resource, &session_interface, session, session_destructor);
+
+  if (!meta_wayland_client_may_capture_windows (manager->compositor->context, client) ||
+      !session_start (session, source->window))
+    ext_image_copy_capture_session_v1_send_stopped (session->resource);
+}
+
+static void
+copy_capture_manager_create_pointer_cursor_session (struct wl_client   *client,
+                                                    struct wl_resource *resource,
+                                                    uint32_t            id,
+                                                    struct wl_resource *source,
+                                                    struct wl_resource *pointer)
+{
+  wl_resource_post_error (resource, WL_DISPLAY_ERROR_IMPLEMENTATION,
+                          "cursor sessions are not supported; ask for paint_cursors instead");
+}
+
+static const struct ext_image_copy_capture_manager_v1_interface copy_capture_manager_interface = {
+  copy_capture_manager_create_session,
+  copy_capture_manager_create_pointer_cursor_session,
+  manager_destroy,
+};
+
+static void
+bind_toplevel_source_manager (struct wl_client *client,
+                              void             *data,
+                              uint32_t          version,
+                              uint32_t          id)
+{
+  struct wl_resource *resource =
+    wl_resource_create (client, &ext_foreign_toplevel_image_capture_source_manager_v1_interface, version, id);
+
+  wl_resource_set_implementation (resource, &toplevel_source_manager_interface, data, NULL);
+}
+
+static void
+bind_copy_capture_manager (struct wl_client *client,
+                           void             *data,
+                           uint32_t          version,
+                           uint32_t          id)
+{
+  struct wl_resource *resource =
+    wl_resource_create (client, &ext_image_copy_capture_manager_v1_interface, version, id);
+
+  wl_resource_set_implementation (resource, &copy_capture_manager_interface, data, NULL);
+}
+
+/**
+ * meta_wayland_image_copy_capture_stop:
+ * @manager: the window capture of the compositor
+ * @id: a capture session, as meta_display's window-capture-started named it
+ *
+ * Ends the session; the client hears it stopped.
+ */
+void
+meta_wayland_image_copy_capture_stop (MetaWaylandImageCopyCapture *manager,
+                                      unsigned int                 id)
+{
+  Session *session = g_hash_table_lookup (manager->sessions, GUINT_TO_POINTER (id));
+
+  if (!session)
+    return;
+
+  session_stop (session);
+  ext_image_copy_capture_session_v1_send_stopped (session->resource);
+}
+
+static void
+add_global (MetaWaylandCompositor    *compositor,
+            const struct wl_interface *interface,
+            int                       version,
+            gpointer                  data,
+            wl_global_bind_func_t     bind)
+{
+  struct wl_global *global = wl_global_create (compositor->wayland_display, interface, version, data, bind);
+
+  if (!global)
+    g_error ("Failed to register a global %s object", interface->name);
+
+  meta_wayland_filter_manager_add_global (meta_wayland_compositor_get_filter_manager (compositor),
+                                          global, meta_wayland_filter_window_capture,
+                                          compositor->context);
+}
+
+static void
+image_copy_capture_free (MetaWaylandImageCopyCapture *manager)
+{
+  g_hash_table_destroy (manager->sessions);
+  g_free (manager);
+}
+
+MetaWaylandImageCopyCapture *
+meta_wayland_compositor_get_image_copy_capture (MetaWaylandCompositor *compositor)
+{
+  return g_object_get_data (G_OBJECT (compositor), "-meta-wayland-image-copy-capture");
+}
+
+void
+meta_wayland_init_image_copy_capture (MetaWaylandCompositor *compositor)
+{
+  MetaWaylandImageCopyCapture *manager = g_new0 (MetaWaylandImageCopyCapture, 1);
+
+  quark_framebuffer = g_quark_from_static_string ("-meta-wayland-image-copy-capture-framebuffer");
+  manager->compositor = compositor;
+  manager->sessions = g_hash_table_new (NULL, NULL);
+
+  add_global (compositor, &ext_foreign_toplevel_image_capture_source_manager_v1_interface,
+              META_EXT_IMAGE_CAPTURE_SOURCE_V1_VERSION, manager, bind_toplevel_source_manager);
+  add_global (compositor, &ext_image_copy_capture_manager_v1_interface,
+              META_EXT_IMAGE_COPY_CAPTURE_V1_VERSION, manager, bind_copy_capture_manager);
+
+  g_object_set_data_full (G_OBJECT (compositor), "-meta-wayland-image-copy-capture",
+                          manager, (GDestroyNotify) image_copy_capture_free);
+}
