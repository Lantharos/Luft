## Fingerprints
## Each finger has a name used as a title (the message value) and a form used inside
## a sentence (.inline), like "Place your … on the sensor." Adjust the case of .inline
## to fit those sentences.

ui-finger-right-index = Labais rādītājpirksts
    .inline = labo rādītājpirkstu
ui-finger-left-index = Kreisais rādītājpirksts
    .inline = kreiso rādītājpirkstu
ui-finger-right-thumb = Labais īkšķis
    .inline = labo īkšķi
ui-finger-left-thumb = Kreisais īkšķis
    .inline = kreiso īkšķi
ui-finger-right-middle = Labais vidējais pirksts
    .inline = labo vidējo pirkstu
ui-finger-left-middle = Kreisais vidējais pirksts
    .inline = kreiso vidējo pirkstu
ui-finger-right-ring = Labais zeltnesis
    .inline = labo zeltnesi
ui-finger-left-ring = Kreisais zeltnesis
    .inline = kreiso zeltnesi
ui-finger-right-little = Labais mazais pirkstiņš
    .inline = labo mazo pirkstiņu
ui-finger-left-little = Kreisais mazais pirkstiņš
    .inline = kreiso mazo pirkstiņu

ui-fingerprint-place = Novietojiet { $finger } uz sensora.
ui-fingerprint-swipe = Pārvelciet ar { $finger } pāri sensoram.
ui-fingerprint-stage-passed = Labi. Paceliet pirkstu un novietojiet to vēlreiz.
ui-fingerprint-stage-passed-swipe = Labi. Pārvelciet vēlreiz.
ui-fingerprint-retry = Neizdevās labi nolasīt. Mēģiniet vēlreiz.
ui-fingerprint-swipe-too-short = Pārvelciet nedaudz lēnāk.
ui-fingerprint-not-centered = Novietojiet pirkstu sensora vidū.
ui-fingerprint-remove-and-retry = Paceliet pirkstu un mēģiniet vēlreiz.
ui-fingerprint-added = Pirksta nospiedums pievienots.
ui-fingerprint-full = Lasītājā vairs nav vietas jaunam pirksta nospiedumam.
ui-fingerprint-disconnected = Pirkstu nospiedumu lasītājs vairs neatbild. Pēc brīža mēģiniet vēlreiz.
ui-fingerprint-duplicate = Šis pirksts lasītājā jau ir saglabāts, iespējams, no Windows vai cita konta. Izmantojiet citu pirkstu.
ui-fingerprint-failed = Šo pirksta nospiedumu neizdevās pievienot. Mēģiniet vēlreiz.

