+ * General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program; if not, see <http://www.gnu.org/licenses/>.
+ */
+
+#include "config.h"
+
+#include "backends/meta-backend-private.h"
+#include "compositor/meta-surface-actor.h"
+#include "compositor/meta-window-actor-private.h"
+#include "tests/meta-test-utils.h"
+#include "tests/meta-wayland-test-runner.h"
+#include "tests/meta-wayland-test-utils.h"
+
+static MetaWindow *
+wait_for_window (const char *title)
+{
+  MetaWindow *window;
+
+  window = meta_wait_for_client_window (test_context, title);
+  meta_wait_for_window_shown (window);
+  meta_wait_for_effects (window);
+  meta_window_move_frame (window, FALSE, 0, 0);
+
+  return window;
+}
+
+static void
+wait_for_paint (void)
+{
+  MetaBackend *backend = meta_context_get_backend (test_context);
+  ClutterActor *stage = meta_backend_get_stage (backend);
+
+  clutter_actor_queue_redraw (stage);
+  meta_wait_for_paint (CLUTTER_STAGE (stage));
+}
+
+static void
+window_culling_clipped_window (void)
+{
+  MetaBackend *backend = meta_context_get_backend (test_context);
+  MetaRenderer *renderer = meta_backend_get_renderer (backend);
+  ClutterStageView *view;
+  MetaWaylandTestClient *wayland_test_client;
+  MetaWindow *bottom_window;
+  MetaWindow *top_window;
+  MetaSurfaceActor *bottom_surface_actor;
+  float unobscured_fraction;
+
+  wayland_test_client =
+    meta_wayland_test_client_new (test_context, "window-culling");
+
+  bottom_window = wait_for_window ("window-culling-bottom");
+  top_window = wait_for_window ("window-culling-top");
+  meta_window_raise (top_window);
+
+  bottom_surface_actor =
+    meta_window_actor_get_surface (meta_window_actor_from_window (bottom_window));
+
+  view = meta_renderer_get_views (renderer)->data;
+
+  wait_for_paint ();
+  g_assert_true (meta_surface_actor_is_obscured_on_stage_view (bottom_surface_actor,
+                                                               view,
+                                                               &unobscured_fraction));
+
+  clutter_actor_set_clip (CLUTTER_ACTOR (meta_window_actor_from_window (top_window)),
+                          0, 0, 50, 100);
+
+  wait_for_paint ();
+  g_assert_false (meta_surface_actor_is_obscured_on_stage_view (bottom_surface_actor,
+                                                                view,
+                                                                &unobscured_fraction));
+  g_assert_cmpfloat (unobscured_fraction, ==, 0.5);
+
+  meta_wayland_test_driver_emit_sync_event (test_driver, 0);
+  meta_wayland_test_client_finish (wayland_test_client);
+}
+
+static void
+init_tests (void)
+{
+  g_test_add_func ("/compositor/window-culling/clipped-window",
+                   window_culling_clipped_window);
+}
+
+int
+main (int   argc,
+      char *argv[])
+{
+  return meta_run_wayland_tests (argc, argv, init_tests);
+}
