## App menu (right-click on a taskbar app)

window-menu-open = Άνοιγμα
window-menu-new-window = Νέο παράθυρο
window-menu-restore = Επαναφορά
window-menu-minimize = Ελαχιστοποίηση
window-menu-maximize = Μεγιστοποίηση
window-menu-unmaximize = Επαναφορά μεγέθους
window-menu-pin = Καρφίτσωμα στη γραμμή εργασιών
window-menu-unpin = Ξεκαρφίτσωμα από τη γραμμή εργασιών
window-menu-close = { $count ->
    [one] Κλείσιμο παραθύρου
   *[other] Κλείσιμο όλων των παραθύρων
}

## Context menus

context-menu-back = Πίσω

## Window previews (hovering a taskbar app)

previews-close-window = Κλείσιμο: { $title }

## Tray

tray-apps = Εφαρμογές πλαισίου συστήματος
tray-open-app = Άνοιγμα: { $appName }

## Board (tablet window layout)

board-open-start = Άνοιγμα του Start
board-show-all-windows = Εμφάνιση όλων των παραθύρων
board-quick-settings = Γρήγορες ρυθμίσεις

## Task view

task-view-close-window = Κλείσιμο παραθύρου
task-view-desktop = Χώρος εργασίας { $number }

## Snap layouts

snap-zone = Τακτοποίηση σε περιοχή { $width }% × { $height }%

## Window title bars

title-bar-minimize = Ελαχιστοποίηση
title-bar-maximize = Μεγιστοποίηση
title-bar-close = Κλείσιμο

## Window resizing

window-resize-size = { $width } × { $height }

## App not responding

close-dialog-title = Η εφαρμογή «{ $appName }» δεν αποκρίνεται
