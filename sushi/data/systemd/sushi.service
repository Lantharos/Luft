[Unit]
Description=Boot splash
Documentation=https://github.com/Lantharos/Luft/tree/main/sushi
DefaultDependencies=no
Wants=systemd-vconsole-setup.service
After=systemd-vconsole-setup.service
Before=systemd-ask-password-console.path cryptsetup-pre.target
Conflicts=plymouth-start.service
ConditionKernelCommandLine=sushi
ConditionVirtualization=!container
IgnoreOnIsolate=true

[Service]
Type=notify
ExecStart=@/usr/bin/sushid @sushid
KillMode=mixed
SendSIGKILL=no
RestrictAddressFamilies=AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=~@clock @cpu-emulation @debug @obsolete @raw-io @reboot @swap @mount
SystemCallFilter=chroot
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_SYS_CHROOT CAP_SYS_MODULE CAP_SYS_TTY_CONFIG CAP_DAC_OVERRIDE CAP_NET_ADMIN

[Install]
WantedBy=sysinit.target
