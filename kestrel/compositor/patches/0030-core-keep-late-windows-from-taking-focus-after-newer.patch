--- a/src/wayland/meta-wayland-client-private.h
+++ b/src/wayland/meta-wayland-client-private.h
@@ -54,6 +54,11 @@ MetaContext * meta_wayland_client_get_context (MetaWaylandClient *wayland_client
 META_EXPORT_TEST
 struct wl_client * meta_wayland_client_get_wl_client (MetaWaylandClient *wayland_client);
 
+gboolean meta_wayland_client_get_launch_time (MetaWaylandClient *wayland_client,
+                                              uint32_t          *launch_time);
+
+void meta_wayland_client_note_window_shown (MetaWaylandClient *wayland_client);
+
 META_EXPORT_TEST
 gboolean meta_wayland_client_matches (MetaWaylandClient      *wayland_client,
                                       const struct wl_client *wl_client);
diff --git a/src/wayland/meta-wayland-client.c b/src/wayland/meta-wayland-client.c
index 3c36928cb998db7a4559b0115e661eb9290df28f..853bb34b08ebb4bf2d330d697bde87e74fb60cf7 100644
--- a/src/wayland/meta-wayland-client.c
+++ b/src/wayland/meta-wayland-client.c
@@ -75,6 +75,9 @@ struct _MetaWaylandClient
   char *window_tag;
 
   pid_t pid;
+
+  uint32_t connection_time;
+  gboolean shown_window;
 };
 
 G_DEFINE_TYPE (MetaWaylandClient, meta_wayland_client, G_TYPE_OBJECT)
@@ -132,6 +135,7 @@ set_wayland_client (MetaWaylandClient *client,
   g_autoptr (MetaWaylandClient) old_client = NULL;
 
   client->wayland_client = wayland_client;
+  client->connection_time = (uint32_t) (g_get_monotonic_time () / 1000);
 
   old_client = wl_client_get_user_data (wayland_client);
   if (old_client)
@@ -285,6 +289,26 @@ meta_wayland_client_get_wl_client (MetaWaylandClient *client)
   return client->wayland_client;
 }
 
+/* Until a client shows its first window, that window was asked for when
+ * the client started.
+ */
+gboolean
+meta_wayland_client_get_launch_time (MetaWaylandClient *client,
+                                     uint32_t          *launch_time)
+{
+  if (client->shown_window)
+    return FALSE;
+
+  *launch_time = client->connection_time;
+  return TRUE;
+}
+
+void
+meta_wayland_client_note_window_shown (MetaWaylandClient *client)
+{
+  client->shown_window = TRUE;
+}
+
 gboolean
 meta_wayland_client_matches (MetaWaylandClient      *client,
                              const struct wl_client *wl_client)
diff --git a/src/x11/window-props.c b/src/x11/window-props.c
index f399bea45311911eca7be88640be717f8e71397a..97c600dc01db7cc0f5927d790ba2cd757d52be7e 100644
--- a/src/x11/window-props.c
+++ b/src/x11/window-props.c
@@ -447,6 +447,18 @@ reload_net_wm_user_time (MetaWindow    *window,
   if (value->type != META_PROP_VALUE_INVALID)
     {
       uint32_t cardinal = value->v.cardinal;
+
+      /* Toolkits stamp windows they present without an event with the X
+       * server's current time, which no user input stands behind.
+       */
+      if (XSERVER_TIME_IS_BEFORE (window->display->last_input_time, cardinal))
+        {
+          meta_topic (META_DEBUG_STARTUP,
+                      "Ignoring _NET_WM_USER_TIME %u of %s, newer than any input",
+                      cardinal, window->desc);
+          return;
+        }
+
       meta_window_set_user_time (window, cardinal);
     }
 }
diff --git a/src/x11/window-x11.c b/src/x11/window-x11.c
index 8d7210355fdbf80a07ac82cf03ae594a7461f3ea..fd9d43399447ab05352fc63761872fdad785870a 100644
--- a/src/x11/window-x11.c
+++ b/src/x11/window-x11.c
@@ -3657,6 +3657,21 @@ meta_window_x11_client_message (MetaWindow *window,
           timestamp = meta_display_get_current_time (display);
         }
 
+      /* A new window asking without a time, or with one newer than any
+       * input, has no input behind the request, so it counts from when it
+       * was launched.
+       */
+      if (window->showing_for_first_time &&
+          source_indication != META_CLIENT_TYPE_PAGER &&
+          (timestamp == 0 ||
+           XSERVER_TIME_IS_BEFORE (window->display->last_input_time, timestamp)))
+        {
+          meta_topic (META_DEBUG_FOCUS,
+                      "_NET_ACTIVE_WINDOW time %u of %s has no input behind it",
+                      timestamp, window->desc);
+          timestamp = window->net_wm_user_time;
+        }
+
       meta_window_activate_full (window, timestamp, source_indication, NULL);
       return TRUE;
     }
