## File dialogs

easel-dialog-open = Open
easel-dialog-save = Save
# The kinds of files offered in the Open dialog
easel-dialog-filter = Pictures, PDFs and Easel documents

## Problems

easel-error-no-name = This file has no name
easel-error-job-gone = This save was already finished
easel-error-job-busy = This save is still being written
easel-error-no-bytes = The command needs the picture's data
easel-error-tiles-short = The picture's data ends early
easel-error-not-tiles = This isn't picture data Easel can read
easel-error-not-document = This isn't an Easel document
easel-error-empty-board = The board is empty
# $name is the file name inside the document
easel-error-bad-name = Easel can't keep { $name } in a document
easel-error-no-model = Easel has no model for this
easel-error-model-missing = The model hasn't been downloaded yet
easel-error-pdf-locked = This PDF is locked with a password
easel-error-pdf-no-page = This PDF has no such page
