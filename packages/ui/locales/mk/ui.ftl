## Fingerprints
## Each finger has a name used as a title (the message value) and a form used inside
## a sentence (.inline), like "Place your … on the sensor." Adjust the case of .inline
## to fit those sentences.

ui-finger-right-index = Десен показалец
    .inline = десниот показалец
ui-finger-left-index = Лев показалец
    .inline = левиот показалец
ui-finger-right-thumb = Десен палец
    .inline = десниот палец
ui-finger-left-thumb = Лев палец
    .inline = левиот палец
ui-finger-right-middle = Десен среден прст
    .inline = десниот среден прст
ui-finger-left-middle = Лев среден прст
    .inline = левиот среден прст
ui-finger-right-ring = Десен прстенест прст
    .inline = десниот прстенест прст
ui-finger-left-ring = Лев прстенест прст
    .inline = левиот прстенест прст
ui-finger-right-little = Десен мал прст
    .inline = десниот мал прст
ui-finger-left-little = Лев мал прст
    .inline = левиот мал прст

ui-fingerprint-place = Ставете го { $finger } на сензорот.
ui-fingerprint-swipe = Повлечете го { $finger } преку сензорот.
ui-fingerprint-stage-passed = Добро. Подигнете го прстот, па ставете го повторно.
ui-fingerprint-stage-passed-swipe = Добро. Повлечете повторно.
ui-fingerprint-retry = Прстот не беше добро прочитан. Обидете се повторно.
ui-fingerprint-swipe-too-short = Повлечете малку побавно.
ui-fingerprint-not-centered = Ставете го прстот на средината на сензорот.
ui-fingerprint-remove-and-retry = Подигнете го прстот и обидете се повторно.
ui-fingerprint-added = Отпечатокот од прст е додаден.
ui-fingerprint-full = Читачот нема место за уште еден отпечаток од прст.
ui-fingerprint-disconnected = Читачот на отпечатоци од прсти престана да одговара. Обидете се повторно за момент.
ui-fingerprint-duplicate = Овој прст е веќе зачуван во читачот, веројатно од Windows или од друга сметка. Користете друг прст.
ui-fingerprint-failed = Отпечатокот од прст не можеше да се додаде. Обидете се повторно.

