## App menu (right-click on a taskbar app)

window-menu-open = Abrir
window-menu-new-window = Nueva ventana
window-menu-restore = Restaurar
window-menu-minimize = Minimizar
window-menu-maximize = Maximizar
window-menu-unmaximize = Restaurar tamaño
window-menu-pin = Anclar a la barra de tareas
window-menu-unpin = Desanclar de la barra de tareas
window-menu-close = { $count ->
    [one] Cerrar ventana
   *[other] Cerrar todas las ventanas
}

## Context menus

context-menu-back = Atrás

## Window previews (hovering a taskbar app)

previews-close-window = Cerrar { $title }

## Tray

tray-apps = Aplicaciones de la bandeja
