diff --git a/src/compositor/meta-background-wallpaper.c b/src/compositor/meta-background-wallpaper.c
index f5de599f915959a28bffa23193e4f0f6f81b8bda..a52ea2c4cdf396236d50da014ffc510880c50e42 100644
--- a/src/compositor/meta-background-wallpaper.c
+++ b/src/compositor/meta-background-wallpaper.c
@@ -59,6 +59,13 @@ meta_background_is_niko (MetaGlassMaterial material)
     material == META_GLASS_MATERIAL_NIKO_WALLPAPER;
