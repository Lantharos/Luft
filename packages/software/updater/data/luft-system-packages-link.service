[Unit]
Description=Offer the system packages built for this version of Luft
DefaultDependencies=no
After=local-fs.target
Before=systemd-sysext.service
Wants=systemd-sysext.service
ConditionPathExists=/var/lib/luft/system-packages/packages

[Service]
Type=oneshot
ExecStart=/usr/libexec/luft-updater link-system-packages

[Install]
WantedBy=sysinit.target
