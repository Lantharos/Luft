 };
 
@@ -310,6 +315,19 @@ meta_cursor_tracker_class_init (MetaCursorTrackerClass *klass)
                                                 G_SIGNAL_RUN_LAST,
                                                 0, NULL, NULL, NULL,
                                                 G_TYPE_NONE, 0);
+
+  /**
+   * MetaCursorTracker::pointer-shaken:
+   *
+   * Emitted at each turn while the pointer is shaken back and forth, so
+   * listeners can make the pointer easier to find for as long as it lasts.
+   * Motion is only watched while something is connected.
+   */
+  signals[POINTER_SHAKEN] = g_signal_new ("pointer-shaken",
+                                          G_TYPE_FROM_CLASS (klass),
+                                          G_SIGNAL_RUN_LAST,
+                                          0, NULL, NULL, NULL,
+                                          G_TYPE_NONE, 0);
 }
 
 /**
@@ -457,6 +475,75 @@ meta_cursor_tracker_uninhibit_cursor_visibility (MetaCursorTracker *tracker)
     set_pointer_visible (tracker, TRUE);
 }
 
+#define BUTTONS_MASK (CLUTTER_BUTTON1_MASK | CLUTTER_BUTTON2_MASK | CLUTTER_BUTTON3_MASK | \
+                      CLUTTER_BUTTON4_MASK | CLUTTER_BUTTON5_MASK)
+
+static gboolean
+is_cursor_shown (MetaCursorTracker *tracker)
+{
+  MetaCursorTrackerPrivate *priv =
+    meta_cursor_tracker_get_instance_private (tracker);
+
+  return priv->cursor_visibility_inhibitors <= 0 &&
+         priv->current_cursor &&
+         clutter_cursor_get_cursor_type (priv->current_cursor) != CLUTTER_CURSOR_NONE;
+}
+
+void
+meta_cursor_tracker_track_motion (MetaCursorTracker  *tracker,
+                                  const ClutterEvent *event,
+                                  gboolean            pointer_busy)
+{
+  MetaCursorTrackerPrivate *priv =
+    meta_cursor_tracker_get_instance_private (tracker);
+  graphene_point_t position;
+  double dx, dy;
+
+  if (!g_signal_has_handler_pending (tracker, signals[POINTER_SHAKEN], 0, TRUE))
+    return;
+
+  clutter_event_get_position (event, &position);
+  if (!clutter_event_get_relative_motion (event, &dx, &dy, NULL, NULL, NULL, NULL))
+    {
+      dx = position.x - priv->shake_position.x;
+      dy = position.y - priv->shake_position.y;
+    }
+  priv->shake_position = position;
+
+  if (pointer_busy ||
+      clutter_event_get_state (event) & BUTTONS_MASK ||
+      meta_backend_is_pointer_constrained (priv->backend) ||
+      !is_cursor_shown (tracker))
+    {
+      meta_pointer_shake_reset (&priv->shake);
+      return;
+    }
+
+  if (meta_pointer_shake_feed (&priv->shake, clutter_event_get_time_us (event), dx, dy))
+    g_signal_emit (tracker, signals[POINTER_SHAKEN], 0);
+}
+
+/**
+ * meta_cursor_tracker_set_magnification:
+ * @tracker: a #MetaCursorTracker
+ * @magnification: how many times larger to draw the pointer, at least 1
+ *
+ * Draws the pointer larger, loading cursor themes at the larger size so
+ * they stay sharp.
+ */
+void
+meta_cursor_tracker_set_magnification (MetaCursorTracker *tracker,
+                                       float              magnification)
+{
+  MetaCursorTrackerPrivate *priv =
+    meta_cursor_tracker_get_instance_private (tracker);
+
+  g_return_if_fail (magnification >= 1.0f);
+
+  meta_cursor_renderer_set_magnification (meta_backend_get_cursor_renderer (priv->backend),
+                                          magnification);
+}
+
 MetaBackend *
 meta_cursor_tracker_get_backend (MetaCursorTracker *tracker)
 {
diff --git a/src/backends/meta-pointer-shake.c b/src/backends/meta-pointer-shake.c
new file mode 100644
index 0000000000000000000000000000000000000000..f3388c98bfa3de550fac765729c1d1a8a179de21
--- /dev/null
+++ b/src/backends/meta-pointer-shake.c
@@ -0,0 +1,140 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "config.h"
+
+#include "backends/meta-pointer-shake.h"
+
+#include <math.h>
+#include <string.h>
+
+#define WINDOW_US (600 * G_TIME_SPAN_MILLISECOND)
+#define MAX_GAP_US (100 * G_TIME_SPAN_MILLISECOND)
+#define TURN_TRAVEL 6.0
+#define STROKE_TRAVEL 40.0
+#define STROKE_SPEED 500.0
+#define STROKE_STRAIGHTNESS 0.8
+#define REVERSAL_COSINE -0.5
+
+static void
+begin_stroke (MetaPointerShakeStroke *stroke,
+              int64_t                 start_us)
+{
+  *stroke = (MetaPointerShakeStroke) { .start_us = start_us };
+}
+
+static void
+extend_stroke (MetaPointerShakeStroke *stroke,
+               double                  dx,
+               double                  dy,
+               double                  length)
+{
+  stroke->x += dx;
+  stroke->y += dy;
+  stroke->path += length;
+}
+
+static gboolean
+is_shake_stroke (const MetaPointerShakeStroke *stroke,
+                 int64_t                       end_us)
+{
+  double travel = hypot (stroke->x, stroke->y);
+  double seconds = (double) (end_us - stroke->start_us) / G_USEC_PER_SEC;
+
+  return travel >= STROKE_TRAVEL &&
+         travel >= STROKE_STRAIGHTNESS * stroke->path &&
+         stroke->path >= STROKE_SPEED * seconds;
+}
+
+static gboolean
+reverse (MetaPointerShake *shake)
+{
+  int64_t reversal_us = shake->turn.start_us;
+  gboolean counts = is_shake_stroke (&shake->stroke, reversal_us);
+
+  shake->stroke = shake->turn;
+  shake->turn.path = 0.0;
+
+  if (!counts)
+    {
+      shake->n_reversals = 0;
+      return FALSE;
+    }
+
+  if (shake->n_reversals == META_POINTER_SHAKE_REVERSALS)
+    {
+      memmove (shake->reversals_us, shake->reversals_us + 1,
+               (META_POINTER_SHAKE_REVERSALS - 1) * sizeof (int64_t));
+      shake->n_reversals--;
+    }
+  shake->reversals_us[shake->n_reversals++] = reversal_us;
+
+  return shake->n_reversals == META_POINTER_SHAKE_REVERSALS &&
+         reversal_us - shake->reversals_us[0] <= WINDOW_US;
+}
+
+void
+meta_pointer_shake_reset (MetaPointerShake *shake)
+{
+  *shake = (MetaPointerShake) { 0 };
+}
+
+gboolean
+meta_pointer_shake_feed (MetaPointerShake *shake,
+                         int64_t           time_us,
+                         double            dx,
+                         double            dy)
+{
+  double length = hypot (dx, dy);
+  int64_t previous_us = shake->last_us;
+  double stroke_travel;
+  double turn_travel;
+  double cosine;
+
+  if (length == 0.0)
+    return FALSE;
+
+  shake->last_us = time_us;
+
+  if (time_us - previous_us > MAX_GAP_US)
+    {
+      begin_stroke (&shake->stroke, time_us);
+      shake->turn.path = 0.0;
+      shake->n_reversals = 0;
+      previous_us = time_us;
+    }
+
+  if (shake->turn.path == 0.0)
+    {
+      if (dx * shake->stroke.x + dy * shake->stroke.y >= 0.0)
+        {
+          extend_stroke (&shake->stroke, dx, dy, length);
+          return FALSE;
+        }
+      begin_stroke (&shake->turn, previous_us);
+    }
+
+  extend_stroke (&shake->turn, dx, dy, length);
+
+  stroke_travel = hypot (shake->stroke.x, shake->stroke.y);
+  turn_travel = hypot (shake->turn.x, shake->turn.y);
+  cosine = (shake->turn.x * shake->stroke.x + shake->turn.y * shake->stroke.y) /
+           (turn_travel * stroke_travel);
+
+  if (cosine >= 0.0)
+    {
+      extend_stroke (&shake->stroke, shake->turn.x, shake->turn.y, shake->turn.path);
+      shake->turn.path = 0.0;
+      return FALSE;
+    }
+
+  if (cosine <= REVERSAL_COSINE && turn_travel >= TURN_TRAVEL)
+    return reverse (shake);
+
+  if (turn_travel >= MAX (STROKE_TRAVEL, stroke_travel))
+    {
+      shake->stroke = shake->turn;
+      shake->turn.path = 0.0;
+      shake->n_reversals = 0;
+    }
+
+  return FALSE;
+}
