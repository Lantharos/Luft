## Fingerprints
## Each finger has a name used as a title (the message value) and a form used inside
## a sentence (.inline), like "Place your … on the sensor." Adjust the case of .inline
## to fit those sentences.

ui-finger-right-index = Pravý ukazováček
    .inline = pravým ukazováčkem
ui-finger-left-index = Levý ukazováček
    .inline = levým ukazováčkem
ui-finger-right-thumb = Pravý palec
    .inline = pravým palcem
ui-finger-left-thumb = Levý palec
    .inline = levým palcem
ui-finger-right-middle = Pravý prostředníček
    .inline = pravým prostředníčkem
ui-finger-left-middle = Levý prostředníček
    .inline = levým prostředníčkem
ui-finger-right-ring = Pravý prsteníček
    .inline = pravým prsteníčkem
ui-finger-left-ring = Levý prsteníček
    .inline = levým prsteníčkem
ui-finger-right-little = Pravý malíček
    .inline = pravým malíčkem
ui-finger-left-little = Levý malíček
    .inline = levým malíčkem

ui-fingerprint-place = Dotkněte se snímače { $finger }.
ui-fingerprint-swipe = Přejeďte { $finger } po snímači.
ui-fingerprint-stage-passed = Dobře. Zvedněte prst a přiložte ho znovu.
ui-fingerprint-stage-passed-swipe = Dobře. Přejeďte znovu.
ui-fingerprint-retry = Otisk se nepodařilo přečíst. Zkuste to znovu.
ui-fingerprint-swipe-too-short = Přejeďte trochu pomaleji.
ui-fingerprint-not-centered = Přiložte prst doprostřed snímače.
ui-fingerprint-remove-and-retry = Zvedněte prst a zkuste to znovu.
ui-fingerprint-added = Otisk prstu byl přidán.
ui-fingerprint-full = Ve čtečce už není místo pro další otisk prstu.
ui-fingerprint-disconnected = Čtečka otisků prstů přestala odpovídat. Zkuste to za chvíli znovu.
ui-fingerprint-duplicate = Čtečka už má tento prst uložený, nejspíš ze systému Windows nebo z jiného účtu. Použijte jiný prst.
ui-fingerprint-failed = Tento otisk prstu se nepodařilo přidat. Zkuste to znovu.

