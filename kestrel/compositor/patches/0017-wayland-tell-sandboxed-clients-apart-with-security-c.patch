diff --git a/src/wayland/meta-wayland-sandbox.c b/src/wayland/meta-wayland-sandbox.c
new file mode 100644
index 0000000000000000000000000000000000000000..0557ef9414317625c84c69f4d0fc2bce2fdc29cf
--- /dev/null
+++ b/src/wayland/meta-wayland-sandbox.c
@@ -0,0 +1,427 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "config.h"
+
+#include "wayland/meta-wayland-sandbox.h"
+
+#include <fcntl.h>
+#include <glib/gstdio.h>
+#include <sys/socket.h>
+#include <unistd.h>
+
+#include "core/meta-sandbox.h"
+#include "meta/meta-context.h"
+#include "wayland/meta-wayland-private.h"
+#include "wayland/meta-wayland-versions.h"
+
+#include "security-context-v1-server-protocol.h"
+
+#define FLATPAK_ENGINE "org.flatpak"
+
+typedef struct _MetaWaylandSandboxManager MetaWaylandSandboxManager;
+
+typedef struct _SecurityContext
+{
+  MetaWaylandSandboxManager *manager;
+  struct wl_list link;
+  int listen_fd;
+  int close_fd;
+  struct wl_event_source *listen_source;
+  struct wl_event_source *close_source;
+  char *engine;
+  char *app_id;
+  char *instance_id;
+} SecurityContext;
+
+struct _MetaWaylandSandboxManager
+{
+  MetaContext *context;
+  struct wl_display *display;
+  struct wl_listener client_created_listener;
+  struct wl_listener display_destroy_listener;
+  struct wl_list contexts;
+  SecurityContext *accepting;
+};
+
+typedef struct _ClientSandbox
+{
+  struct wl_listener destroy_listener;
+  gboolean sandboxed;
+  char *engine;
+  char *app_id;
+} ClientSandbox;
+
+static void
+on_client_destroyed (struct wl_listener *listener,
+                     void               *data)
+{
+  ClientSandbox *sandbox = wl_container_of (listener, sandbox, destroy_listener);
+
+  g_free (sandbox->engine);
+  g_free (sandbox->app_id);
+  g_free (sandbox);
+}
+
+static ClientSandbox *
+sandbox_of (const struct wl_client *client)
+{
+  struct wl_listener *listener =
+    wl_client_get_destroy_listener ((struct wl_client *) client,
+                                    on_client_destroyed);
+  ClientSandbox *sandbox;
+
+  return wl_container_of (listener, sandbox, destroy_listener);
+}
+
+gboolean
+meta_wayland_client_is_sandboxed (const struct wl_client *client)
+{
+  return sandbox_of (client)->sandboxed;
+}
+
+const char *
+meta_wayland_client_get_flatpak_app_id (const struct wl_client *client)
+{
+  ClientSandbox *sandbox = sandbox_of (client);
+
+  if (g_strcmp0 (sandbox->engine, FLATPAK_ENGINE) != 0)
+    return NULL;
+
+  return sandbox->app_id;
+}
+
+MetaWaylandAccess
+meta_wayland_filter_unsandboxed (const struct wl_client *client,
+                                 const struct wl_global *global,
+                                 gpointer                user_data)
+{
+  if (meta_wayland_client_is_sandboxed (client))
+    return META_WAYLAND_ACCESS_DENIED;
+
+  return META_WAYLAND_ACCESS_ALLOWED;
+}
+
+static gboolean
+connected_from_outside_sandbox (MetaWaylandSandboxManager *manager,
+                                struct wl_client          *client)
+{
+  g_autofd int pidfd = -1;
+  socklen_t length = sizeof (pidfd);
+  pid_t pid;
+
+  if (getsockopt (wl_client_get_fd (client), SOL_SOCKET, SO_PEERPIDFD,
+                  &pidfd, &length) < 0)
+    return FALSE;
+
+  wl_client_get_credentials (client, &pid, NULL, NULL);
+  return meta_process_is_unsandboxed (manager->context, pidfd, pid);
+}
+
+static gboolean
+is_trusted_flatpak (MetaWaylandSandboxManager *manager,
+                    ClientSandbox             *sandbox)
+{
+  return g_strcmp0 (sandbox->engine, FLATPAK_ENGINE) == 0 &&
+         sandbox->app_id &&
+         meta_context_is_app_trusted (manager->context, sandbox->app_id);
+}
+
+static void
+on_client_created (struct wl_listener *listener,
+                   void               *data)
+{
+  MetaWaylandSandboxManager *manager =
+    wl_container_of (listener, manager, client_created_listener);
+  struct wl_client *client = data;
+  ClientSandbox *sandbox = g_new0 (ClientSandbox, 1);
+
+  if (manager->accepting)
+    {
+      sandbox->engine = g_strdup (manager->accepting->engine);
+      sandbox->app_id = g_strdup (manager->accepting->app_id);
+      sandbox->sandboxed = !is_trusted_flatpak (manager, sandbox);
+    }
+  else
+    {
+      sandbox->sandboxed = !connected_from_outside_sandbox (manager, client);
+    }
+
+  sandbox->destroy_listener.notify = on_client_destroyed;
+  wl_client_add_destroy_listener (client, &sandbox->destroy_listener);
+}
+
+static void
+security_context_free (SecurityContext *context)
+{
+  if (context->listen_source)
+    wl_event_source_remove (context->listen_source);
+  if (context->close_source)
+    wl_event_source_remove (context->close_source);
+  wl_list_remove (&context->link);
+  close (context->listen_fd);
+  close (context->close_fd);
+  g_free (context->engine);
+  g_free (context->app_id);
+  g_free (context->instance_id);
+  g_free (context);
+}
+
+static int
+on_listen_fd (int       fd,
+              uint32_t  mask,
+              void     *data)
+{
+  SecurityContext *context = data;
+  MetaWaylandSandboxManager *manager = context->manager;
+  int client_fd;
+
+  if (mask & (WL_EVENT_HANGUP | WL_EVENT_ERROR))
+    {
+      security_context_free (context);
+      return 0;
+    }
+
+  client_fd = accept4 (fd, NULL, NULL, SOCK_CLOEXEC);
+  if (client_fd < 0)
+    return 0;
+
+  manager->accepting = context;
+  if (!wl_client_create (manager->display, client_fd))
+    close (client_fd);
+  manager->accepting = NULL;
+
+  return 0;
+}
+
+static int
+on_close_fd (int       fd,
+             uint32_t  mask,
+             void     *data)
+{
+  security_context_free (data);
+  return 0;
+}
+
+static SecurityContext *
+uncommitted_context (struct wl_resource *resource)
+{
+  SecurityContext *context = wl_resource_get_user_data (resource);
+
+  if (!context)
+    {
+      wl_resource_post_error (resource,
+                              WP_SECURITY_CONTEXT_V1_ERROR_ALREADY_USED,
+                              "the security context was already committed");
+    }
+
+  return context;
+}
+
+static void
+set_once (struct wl_resource  *resource,
+          char               **field,
+          const char          *value)
+{
+  if (*field)
+    {
+      wl_resource_post_error (resource,
+                              WP_SECURITY_CONTEXT_V1_ERROR_ALREADY_SET,
+                              "the security context metadata was already set");
+      return;
+    }
+
+  *field = g_strdup (value);
+}
+
+static void
+context_destroy (struct wl_client   *client,
+                 struct wl_resource *resource)
+{
+  wl_resource_destroy (resource);
+}
+
+static void
+context_set_sandbox_engine (struct wl_client   *client,
+                            struct wl_resource *resource,
+                            const char         *name)
+{
+  SecurityContext *context = uncommitted_context (resource);
+
+  if (context)
+    set_once (resource, &context->engine, name);
+}
+
+static void
+context_set_app_id (struct wl_client   *client,
+                    struct wl_resource *resource,
+                    const char         *app_id)
+{
+  SecurityContext *context = uncommitted_context (resource);
+
+  if (context)
+    set_once (resource, &context->app_id, app_id);
+}
+
+static void
+context_set_instance_id (struct wl_client   *client,
+                         struct wl_resource *resource,
+                         const char         *instance_id)
+{
+  SecurityContext *context = uncommitted_context (resource);
+
+  if (context)
+    set_once (resource, &context->instance_id, instance_id);
+}
+
+static void
+context_commit (struct wl_client   *client,
+                struct wl_resource *resource)
+{
+  SecurityContext *context = uncommitted_context (resource);
+  struct wl_event_loop *loop;
+
+  if (!context)
+    return;
+
+  wl_resource_set_user_data (resource, NULL);
+
+  fcntl (context->listen_fd, F_SETFL,
+         fcntl (context->listen_fd, F_GETFL) | O_NONBLOCK);
+  loop = wl_display_get_event_loop (context->manager->display);
+  context->listen_source = wl_event_loop_add_fd (loop, context->listen_fd,
+                                                 WL_EVENT_READABLE,
+                                                 on_listen_fd, context);
+  context->close_source = wl_event_loop_add_fd (loop, context->close_fd, 0,
+                                                on_close_fd, context);
+  wl_list_insert (&context->manager->contexts, &context->link);
+}
+
+static const struct wp_security_context_v1_interface context_interface =
+{
+  context_destroy,
+  context_set_sandbox_engine,
+  context_set_app_id,
+  context_set_instance_id,
+  context_commit,
+};
+
+static void
+context_destructor (struct wl_resource *resource)
+{
+  SecurityContext *context = wl_resource_get_user_data (resource);
+
+  if (context)
+    security_context_free (context);
+}
+
+static gboolean
+is_listening_socket (int fd)
+{
+  int listening = 0;
+  socklen_t length = sizeof (listening);
+
+  return getsockopt (fd, SOL_SOCKET, SO_ACCEPTCONN, &listening, &length) == 0 &&
+         listening;
+}
+
+static void
+manager_destroy (struct wl_client   *client,
+                 struct wl_resource *resource)
+{
+  wl_resource_destroy (resource);
+}
+
+static void
+manager_create_listener (struct wl_client   *client,
+                         struct wl_resource *resource,
+                         uint32_t            id,
+                         int32_t             listen_fd,
+                         int32_t             close_fd)
+{
+  SecurityContext *context;
+  struct wl_resource *context_resource;
+
+  if (!is_listening_socket (listen_fd))
+    {
+      close (listen_fd);
+      close (close_fd);
+      wl_resource_post_error (resource,
+                              WP_SECURITY_CONTEXT_MANAGER_V1_ERROR_INVALID_LISTEN_FD,
+                              "listen_fd is not a listening socket");
+      return;
+    }
+
+  context = g_new0 (SecurityContext, 1);
+  context->manager = wl_resource_get_user_data (resource);
+  context->listen_fd = listen_fd;
+  context->close_fd = close_fd;
+  wl_list_init (&context->link);
+
+  context_resource = wl_resource_create (client, &wp_security_context_v1_interface,
+                                         wl_resource_get_version (resource), id);
+  wl_resource_set_implementation (context_resource, &context_interface,
+                                  context, context_destructor);
+}
+
+static const struct wp_security_context_manager_v1_interface manager_interface =
+{
+  manager_destroy,
+  manager_create_listener,
+};
+
+static void
+bind_manager (struct wl_client *client,
+              void             *data,
+              uint32_t          version,
+              uint32_t          id)
+{
+  struct wl_resource *resource;
+
+  resource = wl_resource_create (client, &wp_security_context_manager_v1_interface,
+                                 version, id);
+  wl_resource_set_implementation (resource, &manager_interface, data, NULL);
+}
+
+static void
+on_display_destroyed (struct wl_listener *listener,
+                      void               *data)
+{
+  MetaWaylandSandboxManager *manager =
+    wl_container_of (listener, manager, display_destroy_listener);
+  SecurityContext *context, *next;
+
+  wl_list_for_each_safe (context, next, &manager->contexts, link)
+    security_context_free (context);
+
+  wl_list_remove (&manager->client_created_listener.link);
+  g_free (manager);
+}
+
+void
+meta_wayland_init_sandbox (MetaWaylandCompositor *compositor)
+{
+  MetaWaylandSandboxManager *manager;
+  struct wl_global *global;
+
+  manager = g_new0 (MetaWaylandSandboxManager, 1);
+  manager->context = meta_wayland_compositor_get_context (compositor);
+  manager->display = compositor->wayland_display;
+  wl_list_init (&manager->contexts);
+
+  manager->client_created_listener.notify = on_client_created;
+  wl_display_add_client_created_listener (manager->display,
+                                          &manager->client_created_listener);
+  manager->display_destroy_listener.notify = on_display_destroyed;
+  wl_display_add_destroy_listener (manager->display,
+                                   &manager->display_destroy_listener);
+
+  global = wl_global_create (manager->display,
+                             &wp_security_context_manager_v1_interface,
+                             META_WP_SECURITY_CONTEXT_V1_VERSION,
+                             manager, bind_manager);
+  if (!global)
+    g_error ("Failed to register a global wp_security_context_manager_v1 object");
+
+  meta_wayland_filter_manager_add_global (meta_wayland_compositor_get_filter_manager (compositor),
+                                          global, meta_wayland_filter_unsandboxed,
+                                          NULL);
+}
