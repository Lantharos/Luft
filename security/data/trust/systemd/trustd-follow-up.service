[Unit]
Description=Bring Luft's key, startup files and TPM disk key in line with how this computer started
Documentation=https://github.com/Lantharos/Luft/blob/main/docs/boot.md
ConditionKernelCommandLine=!rd.live.image
After=local-fs.target tpm2.target
Before=trustd.service

[Service]
Type=oneshot
ExecStart=/usr/bin/trustctl follow-up
KeyringMode=shared
ProtectHome=read-only
PrivateTmp=yes
NoNewPrivileges=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_ALG
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
