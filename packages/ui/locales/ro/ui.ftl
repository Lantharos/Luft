## Fingerprints
## Each finger has a name used as a title (the message value) and a form used inside
## a sentence (.inline), like "Place your … on the sensor." Adjust the case of .inline
## to fit those sentences.

ui-finger-right-index = Arătătorul drept
    .inline = arătătorul drept
ui-finger-left-index = Arătătorul stâng
    .inline = arătătorul stâng
ui-finger-right-thumb = Degetul mare drept
    .inline = degetul mare drept
ui-finger-left-thumb = Degetul mare stâng
    .inline = degetul mare stâng
ui-finger-right-middle = Degetul mijlociu drept
    .inline = degetul mijlociu drept
ui-finger-left-middle = Degetul mijlociu stâng
    .inline = degetul mijlociu stâng
ui-finger-right-ring = Inelarul drept
    .inline = inelarul drept
ui-finger-left-ring = Inelarul stâng
    .inline = inelarul stâng
ui-finger-right-little = Degetul mic drept
    .inline = degetul mic drept
ui-finger-left-little = Degetul mic stâng
    .inline = degetul mic stâng

ui-fingerprint-place = Puneți { $finger } pe senzor.
ui-fingerprint-swipe = Glisați { $finger } peste senzor.
ui-fingerprint-stage-passed = Bine. Ridicați degetul, apoi puneți-l din nou.
ui-fingerprint-stage-passed-swipe = Bine. Glisați din nou.
ui-fingerprint-retry = Amprenta nu s-a citit bine. Încercați din nou.
ui-fingerprint-swipe-too-short = Glisați puțin mai încet.
ui-fingerprint-not-centered = Centrați degetul pe senzor.
ui-fingerprint-remove-and-retry = Ridicați degetul și încercați din nou.
ui-fingerprint-added = Amprenta a fost adăugată.
ui-fingerprint-full = Cititorul nu mai are loc pentru altă amprentă.
ui-fingerprint-disconnected = Cititorul de amprente nu mai răspunde. Încercați din nou peste câteva momente.
ui-fingerprint-duplicate = Acest deget este deja salvat în cititor, probabil de Windows sau de alt cont. Folosiți alt deget.
ui-fingerprint-failed = Amprenta nu a putut fi adăugată. Încercați din nou.

