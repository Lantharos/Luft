#!/usr/bin/bash
set -uo pipefail

manager=${0##*/}
if [[ $manager == luft-package-manager ]]; then
	manager=$1
	shift
fi
given=("$@")
action=
words=()
yes=0
downloads=

fedora() {
	[[ $manager == dnf* || $manager == yum ]]
}

real_dnf() {
	exec /usr/bin/dnf5 "${given[@]}"
}

bold() {
	if [[ -t 2 ]]; then
		printf '\e[1m%s\e[0m' "$1"
	else
		printf '%s' "$1"
	fi
}

package_hint() {
	fedora || printf 'Luft is based on Fedora, so it uses dnf instead of %s.\n' "$manager" >&2
	printf 'The system is read-only, so software comes from Schelf instead:\n' >&2
	printf '  %s installs apps from Flathub and tools from Fedora,\n' "$(bold 'schelf install …')" >&2
	printf '  %s adds any package from Fedora to the system, such as Tailscale.\n' "$(bold 'schelf install --system …')" >&2
	exit 1
}

update_hint() {
	printf 'Luft updates itself. Updates are in Settings, under Updates.\n' >&2
	printf 'Apps, AppImages and system packages update with %s.\n' "$(bold 'schelf update')" >&2
	exit 0
}

takes_value() {
	case $1 in
	--setopt | --setvar | --repo | --repoid | --enablerepo | --disablerepo | --enable-repo | --disable-repo | \
		--from-repo | -x | --exclude | --releasever | -c | --config | --forcearch | --destdir | --comment | -o | -t)
		return 0
		;;
	esac
	return 1
}

read_arguments() {
	local word skip=0
	for word in "$@"; do
		if ((skip)); then
			skip=0
		elif [[ $word == --installroot* ]] && fedora; then
			real_dnf
		elif [[ $word == -* ]]; then
			case $word in
			-y | --assumeyes | --yes | --assume-yes | --noconfirm | -n | --non-interactive | --no-confirm) yes=1 ;;
			-[SR]*) [[ $manager == pacman && -z $action ]] && action=$word ;;
			esac
			takes_value "$word" && skip=1
		elif [[ -z $action ]]; then
			action=$word
		else
			words+=("$word")
		fi
	done
}

as_you() {
	((EUID == 0)) || return 0
	local uid=${SUDO_UID:-${PKEXEC_UID:-0}}
	((uid != 0)) || return 0
	exec runuser -u "$(id -un "$uid")" -- env XDG_RUNTIME_DIR="/run/user/$uid" \
		DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$uid/bus" \
		/usr/libexec/luft-package-manager "$manager" "${given[@]}"
}

as_system_packages() {
	fedora && { ((yes)) || [[ ! -t 0 ]]; }
}

listed() {
	local names=$1
	shift
	while (($# > 1)); do
		names+=", $1"
		shift
	done
	(($#)) && names+=" and $1"
	printf '%s' "$names"
}

confirm() {
	((yes)) && return 0
	local reply
	printf '%s [Y/n] ' "$1" >&2
	read -r reply || {
		printf '\n' >&2
		exit 1
	}
	case ${reply,,} in
	'' | y | yes) ;;
	*) exit 1 ;;
	esac
}

download() {
	local address=$1
	if [[ -z $downloads ]]; then
		downloads=$(mktemp -d -p "${XDG_CACHE_HOME:-$HOME/.cache}") || exit 1
		trap 'rm -rf "$downloads"' EXIT
	fi
	curl --fail --location --silent --show-error --output "$downloads/${address##*/}" "$address" || exit 1
}

install() {
	local word present=0 status=0
	local -a names=() files=() yes_flag=()
	for word in "${words[@]}"; do
		if rpm --query --quiet --whatprovides "$word" 2>/dev/null; then
			printf '%s is already installed.\n' "$word" >&2
			((++present))
		elif [[ $word == *.rpm || $word == */* ]]; then
			files+=("$word")
		else
			names+=("$word")
		fi
	done
	((present > 0 && ${#names[@]} + ${#files[@]} == 0)) && exit 0
	((${#names[@]} + ${#files[@]} > 0)) || package_hint
	confirm "Luft installs this with Schelf. Install $(listed "${names[@]}" "${files[@]##*/}")?"
	for word in "${!files[@]}"; do
		if [[ ${files[word]} == *://* ]]; then
			download "${files[word]}"
			files[word]=$downloads/${files[word]##*/}
		fi
	done
	((yes)) && yes_flag=(--yes)
	if ! as_system_packages; then
		schelf install "${yes_flag[@]}" "${names[@]}" "${files[@]}"
		exit
	fi
	if ((${#names[@]})); then
		schelf install --system --yes "${names[@]}" || status=$?
	fi
	if ((${#files[@]})); then
		schelf install --yes "${files[@]}" || status=$?
	fi
	exit "$status"
}

remove() {
	((${#words[@]})) || package_hint
	confirm "Luft removes this with Schelf. Remove $(listed "${words[@]}")?"
	if as_system_packages; then
		exec schelf remove --system --yes "${words[@]}"
	fi
	exec schelf remove --yes "${words[@]}"
}

search() {
	((${#words[@]})) || package_hint
	[[ -t 0 ]] && confirm "Luft finds software with Schelf. Search for $(listed "${words[@]}")?"
	exec schelf search "${words[@]}"
}

add_source() {
	[[ -n $1 ]] || package_hint
	printf 'Luft adds software sources for system packages with Schelf.\n' >&2
	if ((yes)); then
		exec schelf repo add --yes "$1"
	fi
	exec schelf repo add "$1"
}

repo_file() {
	local word
	while (($#)); do
		word=$1
		shift
		case $word in
		--from-repofile=*) printf '%s' "${word#--from-repofile=}" && return ;;
		--from-repofile) printf '%s' "${1:-}" && return ;;
		esac
	done
}

handle_dnf() {
	case $action in
	info | list | provides | whatprovides | repoquery | rq | repolist | repoinfo | history | check-update | \
		check-upgrade | download | makecache | advisory | updateinfo | leaves | help | '')
		real_dnf
		;;
	upgrade | update | up | distro-sync | dsync | upgrade-minimal) update_hint ;;
	esac
	as_you
	case $action in
	install | in) install ;;
	remove | erase | rm) remove ;;
	search | se) search ;;
	copr) [[ ${words[0]:-} == enable ]] && add_source "${words[1]:+copr:${words[1]}}" ;;
	config-manager) [[ ${words[0]:-} == addrepo ]] && add_source "$(repo_file "${given[@]}")" ;;
	esac
	package_hint
}

handle_other() {
	case $manager:$action in
	apt*:install | zypper:in | zypper:install) install ;;
	apt*:remove | apt*:purge | zypper:rm | zypper:remove) remove ;;
	apt*:search | zypper:se | zypper:search) search ;;
	apt*:update | apt*:upgrade | apt*:full-upgrade | apt*:dist-upgrade | zypper:up | zypper:update | \
		zypper:dup | zypper:dist-upgrade | zypper:patch)
		update_hint
		;;
	pacman:-S*u*) update_hint ;;
	pacman:-S*s*) search ;;
	pacman:-S | pacman:-Sy)
		if ((${#words[@]})); then
			install
		fi
		update_hint
		;;
	pacman:-R*) remove ;;
	esac
	package_hint
}

if fedora && [[ ! -d /run/systemd/system ]]; then
	real_dnf
fi
read_arguments "$@"
if fedora; then
	handle_dnf
else
	handle_other
fi
