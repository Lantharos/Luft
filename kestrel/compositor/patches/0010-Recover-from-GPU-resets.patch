+static ClutterActorTraverseVisitFlags
+realize_mapped_actor_cb (ClutterActor *self,
+                         int           depth,
+                         void         *user_data)
+{
+  ClutterActorPrivate *priv = self->priv;
+
+  /* An actor may be unmapped, yet realized. Such would've also been unrealized
+   * by `clutter_actor_unrealize_mapped()`, so we re-realize.
+   * But if the actor was not unrealized by `clutter_actor_unrealize_mapped()`,
+   * then we skip it and its children. */
+  if (!clutter_actor_is_mapped (self) &&
+      !clutter_actor_is_unrealized_mapped (self))
+    return CLUTTER_ACTOR_TRAVERSE_VISIT_SKIP_CHILDREN;
+
+  if (clutter_actor_is_realized (self))
+    {
+      if (clutter_actor_is_unrealized_mapped (self))
+        {
+          /* It is not safe if the actor has been re-realized earlier because
+           * it could've been realized with resources from a defunct context. */
+          g_warning ("Actor '%s' was realized earlier than expected",
+                     _clutter_actor_get_debug_name (self));
+          priv->is_unrealized_mapped = FALSE;
+        }
+
+      /* That an actor is realized doesn't mean its children are,
+       * so we check its children. */
+      return CLUTTER_ACTOR_TRAVERSE_VISIT_CONTINUE;
+    }
+
+  /* If the actor is mapped and unrealized, it must've been unrealized
+   * by `clutter_actor_unrealize_mapped()`. */
+  g_assert (clutter_actor_is_unrealized_mapped (self));
+
+  g_signal_emit (self, actor_signals[REALIZE], 0);
+
+  self->flags |= CLUTTER_ACTOR_REALIZED;
+  g_object_notify_by_pspec (G_OBJECT (self), obj_props[PROP_REALIZED]);
+
+  priv->is_unrealized_mapped = FALSE;
+
+#ifdef CLUTTER_ENABLE_DEBUG
+  clutter_actor_verify_map_state (self);
+#endif
+
+  return CLUTTER_ACTOR_TRAVERSE_VISIT_CONTINUE;
+}
+
+/* 
+ * clutter_actor_realize_mapped:
+ * @self: A #ClutterActor
+ *
+ * Realizes a mapped actor and its mapped children that were previously
+ * unrealized by `clutter_actor_unrealize_mapped()`.
+ *
+ * Used to restore actors during graphics recovery. */
+void
+clutter_actor_realize_mapped (ClutterActor *self)
+{
+  g_return_if_fail (CLUTTER_IS_ACTOR (self));
+
+  _clutter_actor_traverse (self,
+                           CLUTTER_ACTOR_TRAVERSE_DEPTH_FIRST,
+                           realize_mapped_actor_cb,
+                           NULL,
+                           NULL);
+}
+
 static void
 clutter_actor_real_unrealize (ClutterActor *self)
 {
-  /* we must be unmapped (implying our children are also unmapped) */
-  g_assert (!clutter_actor_is_mapped (self));
+  ClutterActorPrivate *priv = self->priv;
+  ClutterContext *context = clutter_actor_get_context (self);
+  ClutterBackend *backend = clutter_context_get_backend (context);
+  ClutterGraphicsRecoveryContext *recovery_context =
+    clutter_backend_get_graphics_recovery_context (backend);
+
+  /* we must be unmapped (implying our children are also unmapped),
+   * except we're being unrealized by `clutter_actor_unrealize_mapped()` */
+  g_assert (!clutter_actor_is_mapped (self) ||
+            clutter_actor_is_unrealized_mapped (self));
+
+  if (priv->effects != NULL &&
+      (clutter_graphics_recovery_context_get_state (recovery_context) ==
+       CLUTTER_GRAPHICS_RECOVERY_STATE_RESTORING))
+    {
+      g_list_foreach ((GList *)_clutter_meta_group_peek_metas (priv->effects),
+                      (GFunc)clutter_effect_unrealize, NULL);
+    }
 }
 
