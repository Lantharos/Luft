+static MetaGlassMaterial
+luca_material (MetaCompositor *compositor)
+{
+  MetaCompositorPrivate *priv =
+    meta_compositor_get_instance_private (compositor);
+
+  return priv->luca_from_wallpaper ? META_GLASS_MATERIAL_WALLPAPER : META_GLASS_MATERIAL_LIVE;
+}
+
 MetaGlassMaterial
-meta_compositor_get_glass_material (MetaCompositor *compositor)
+meta_compositor_get_glass_material (MetaCompositor       *compositor,
+                                    MetaGlassRole         role,
+                                    MetaGlassPreference   preference)
+{
+  MetaCompositorPrivate *priv =
+    meta_compositor_get_instance_private (compositor);
+  MetaGlassStyle style;
+
+  switch (preference)
+    {
+    case META_GLASS_PREFERENCE_MARIS:
+      return META_GLASS_MATERIAL_SURFACE;
+    case META_GLASS_PREFERENCE_LUCA:
+      return luca_material (compositor);
+    case META_GLASS_PREFERENCE_USER:
+      break;
+    }
+
+  style = role == META_GLASS_ROLE_TRANSIENT ? priv->glass_transients : priv->glass_windows;
+  return style == META_GLASS_STYLE_MARIS ? META_GLASS_MATERIAL_SURFACE : luca_material (compositor);
+}
+
+void
+meta_compositor_count_maris_request (MetaCompositor *compositor,
+                                     int             change)
 {
   MetaCompositorPrivate *priv =
     meta_compositor_get_instance_private (compositor);
+  gboolean requested = priv->maris_requests > 0;
 
-  if (priv->glass_windows == META_GLASS_STYLE_MARIS)
-    return META_GLASS_MATERIAL_SURFACE;
+  priv->maris_requests += change;
+  if (requested != (priv->maris_requests > 0))
+    g_signal_emit (compositor, compositor_signals[GLASS_CHANGED], 0);
+}
 
-  return priv->luca_from_wallpaper ? META_GLASS_MATERIAL_WALLPAPER : META_GLASS_MATERIAL_LIVE;
+/**
+ * meta_compositor_get_maris_requested:
+ * @compositor: a #MetaCompositor
+ *
+ * Returns: whether an app asks for Maris glass, whatever the person chose
+ */
+gboolean
+meta_compositor_get_maris_requested (MetaCompositor *compositor)
+{
+  MetaCompositorPrivate *priv =
+    meta_compositor_get_instance_private (compositor);
+
+  return priv->maris_requests > 0;
 }
 
