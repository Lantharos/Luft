[Unit]
Description=USB protection while locked
Before=display-manager.service systemd-user-sessions.service

[Service]
Type=dbus
BusName=com.lantharos.UsbProtection1
ExecStart=@libexecdir@/luft-usb-protection
Restart=on-failure
UMask=0077
StateDirectory=luft-usb-protection
StateDirectoryMode=0700
ReadWritePaths=/sys/devices /sys/bus/usb
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
