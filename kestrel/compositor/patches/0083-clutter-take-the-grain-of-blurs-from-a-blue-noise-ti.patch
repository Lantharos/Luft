+/**
+ * clutter_blur_node_get_grain: (skip)
+ * @context: a #CoglContext
+ *
+ * The tile of blue noise that blurs add their grain from, for effects
+ * that draw blurs with a shader of their own. Each texel is a uniform
+ * value in its red channel; the tile repeats every
+ * %CLUTTER_GRAIN_SIZE pixels.
+ *
+ * Returns: (transfer none): the grain tile
+ */
+CoglTexture *
+clutter_blur_node_get_grain (CoglContext *context)
+{
+  static CoglTexture *grain;
+  uint8_t pixels[CLUTTER_GRAIN_SIZE * CLUTTER_GRAIN_SIZE * 4];
+  int i;
+
+  if (grain)
+    return grain;
+
+  for (i = 0; i < CLUTTER_GRAIN_SIZE * CLUTTER_GRAIN_SIZE; i++)
+    {
+      pixels[i * 4] = pixels[i * 4 + 1] = pixels[i * 4 + 2] = clutter_grain[i];
+      pixels[i * 4 + 3] = 255;
+    }
+  grain = cogl_texture_2d_new_from_data (context, CLUTTER_GRAIN_SIZE, CLUTTER_GRAIN_SIZE,
+                                         COGL_PIXEL_FORMAT_RGBA_8888,
+                                         CLUTTER_GRAIN_SIZE * 4, pixels, NULL);
+  return grain;
+}
