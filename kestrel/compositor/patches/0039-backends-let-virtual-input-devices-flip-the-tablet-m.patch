From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Kristof Imeri <kristof@lanth.me>
Date: Sun, 18 Oct 2026 14:32:06 +0200
Subject: [PATCH 39/40] backends: let virtual input devices flip the tablet
 mode switch

Add clutter_virtual_input_device_notify_tablet_mode(), implemented by
the native backend. The device then counts as the seat's tablet mode
switch, so touch mode follows it exactly as it follows a convertible's
hinge, and programs that drive the desktop, such as Kestrel's checks,
can fold a computer into a tablet and back.
---
 .../clutter/clutter-virtual-input-device.c    | 22 +++++++++++
 .../clutter/clutter-virtual-input-device.h    |  7 ++++
 .../native/meta-input-device-native.h         |  2 +
 src/backends/native/meta-seat-impl.c          | 14 +++++++
 src/backends/native/meta-seat-impl.h          |  4 ++
 .../native/meta-virtual-input-device-native.c | 37 +++++++++++++++++++
 6 files changed, 86 insertions(+)

diff --git a/clutter/clutter/clutter-virtual-input-device.c b/clutter/clutter/clutter-virtual-input-device.c
index a6f9e2d6892eb97a10413a637245eb716cb5cab9..2d8ec8fd37becf8de171a0fefafa2aaa0893b15e 100644
--- a/clutter/clutter/clutter-virtual-input-device.c
+++ b/clutter/clutter/clutter-virtual-input-device.c
@@ -255,6 +255,28 @@ clutter_virtual_input_device_notify_touchpad_swipe (ClutterVirtualInputDevice
                                 dx, dy);
 }
 
+/**
+ * clutter_virtual_input_device_notify_tablet_mode:
+ * @virtual_device: a virtual input device
+ * @tablet_mode: whether the device is folded or detached into a tablet
+ *
+ * Flips a tablet mode switch on the device, as a convertible's hinge or
+ * keyboard dock would. The device counts as the seat's tablet mode switch
+ * from then on.
+ */
+void
+clutter_virtual_input_device_notify_tablet_mode (ClutterVirtualInputDevice *virtual_device,
+                                                 gboolean                   tablet_mode)
+{
+  ClutterVirtualInputDeviceClass *klass =
+    CLUTTER_VIRTUAL_INPUT_DEVICE_GET_CLASS (virtual_device);
+
+  g_return_if_fail (CLUTTER_IS_VIRTUAL_INPUT_DEVICE (virtual_device));
+  g_return_if_fail (klass->notify_tablet_mode != NULL);
+
+  klass->notify_tablet_mode (virtual_device, tablet_mode);
+}
+
 int
 clutter_virtual_input_device_get_device_type (ClutterVirtualInputDevice *virtual_device)
 {
diff --git a/clutter/clutter/clutter-virtual-input-device.h b/clutter/clutter/clutter-virtual-input-device.h
index 7d2bceb35daca63ec3c1d93e56122fe934b9f49d..1c1a8fa1ac24fe9aa2961c30a70a3bbcf13473c7 100644
--- a/clutter/clutter/clutter-virtual-input-device.h
+++ b/clutter/clutter/clutter-virtual-input-device.h
@@ -121,6 +121,9 @@ struct _ClutterVirtualInputDeviceClass
                                  uint32_t                     fingers,
                                  double                       dx,
                                  double                       dy);
+
+  void (*notify_tablet_mode) (ClutterVirtualInputDevice *virtual_device,
+                              gboolean                   tablet_mode);
 };
 
 CLUTTER_EXPORT
@@ -204,6 +207,10 @@ void clutter_virtual_input_device_notify_touchpad_swipe (ClutterVirtualInputDevi
                                                          double                       dx,
                                                          double                       dy);
 
+CLUTTER_EXPORT
+void clutter_virtual_input_device_notify_tablet_mode (ClutterVirtualInputDevice *virtual_device,
+                                                      gboolean                   tablet_mode);
+
 CLUTTER_EXPORT
 int clutter_virtual_input_device_get_device_type (ClutterVirtualInputDevice *virtual_device);
 
