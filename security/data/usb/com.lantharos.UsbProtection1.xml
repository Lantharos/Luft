<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
 "https://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<node name="/com/lantharos/UsbProtection1">
  <!--
    USB protection while the screen is locked and at the login screen.

    Enabled: whether new USB devices wait while nobody is signed in and unlocked at the computer.
    Guarding: whether new devices are being held back right now.
    Held: devices held back so far, as (id, name), id being the sysfs device name such as "3-2".

    Released is emitted after unlocking, with the devices that were held back and are now available.
  -->
  <interface name="com.lantharos.UsbProtection1">
    <property name="Enabled" type="b" access="read"/>
    <property name="Guarding" type="b" access="read"/>
    <property name="Held" type="a(ss)" access="read"/>
    <method name="SetEnabled">
      <arg name="enabled" type="b" direction="in"/>
    </method>
    <signal name="Released">
      <arg name="devices" type="a(ss)"/>
    </signal>
  </interface>
</node>
