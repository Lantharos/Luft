---
import { alternates, localize } from '../../i18n/pages';

interface Props {
	page: string;
}

const { locale, t } = localize(Astro);
const languages = alternates(Astro.props.page);
const current = languages.find(({ tag }) => tag === locale)!;
---

<button
	type="button"
	popovertarget="languages"
	class="language-button inline-flex items-center gap-1.5 transition-colors duration-(--motion-tap) hover:text-ink"
	aria-label={t('site-language-button', { language: current.name })}
>
	<svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true">
		<circle cx="12" cy="12" r="9" />
		<path d="M3 12h18M12 3c2.5 2.7 3.8 5.7 3.8 9s-1.3 6.3-3.8 9c-2.5-2.7-3.8-5.7-3.8-9S9.5 5.7 12 3Z" />
	</svg>
	{current.name}
</button>

<nav id="languages" popover aria-label={t('site-languages')} class="languages rounded-2xl bg-raised p-2 text-sm shadow-[0_24px_60px_-20px_rgb(0_0_0/0.4)] ring-1 ring-hairline">
	<ul class="grid grid-cols-2 sm:grid-cols-3">
		{
			languages.map(({ tag, name, href }) => (
				<li>
					<a
						href={href}
						hreflang={tag}
						lang={tag}
						aria-current={tag === locale ? 'true' : undefined}
						class="block truncate rounded-lg px-3 py-1.5 text-ink-soft transition-colors duration-(--motion-tap) hover:bg-ink/6 hover:text-ink aria-[current=true]:font-semibold aria-[current=true]:text-ink"
					>
						{name}
					</a>
				</li>
			))
		}
	</ul>
</nav>

<script is:inline>
	document.getElementById('languages').addEventListener('click', (event) => {
		const choice = event.target.closest('a[hreflang]');
		if (choice) document.cookie = `lang=${choice.hreflang}; path=/; max-age=31536000; samesite=lax; secure`;
	});
</script>

<style>
	.languages {
		width: min(34rem, calc(100vw - 2.5rem));
		opacity: 0;
		translate: 0 0.375rem;
		transition:
			opacity var(--motion-tap) linear,
			translate var(--spring-snappy-duration) var(--spring-snappy),
			display var(--motion-tap) allow-discrete,
			overlay var(--motion-tap) allow-discrete;
	}

	.languages:popover-open {
		opacity: 1;
		translate: none;

		@starting-style {
			opacity: 0;
			translate: 0 0.375rem;
		}
	}

	@supports (anchor-name: --languages) {
		.language-button {
			anchor-name: --languages;
		}

		.languages {
			position-anchor: --languages;
			position-area: block-start span-inline-start;
			position-try-fallbacks: flip-inline, flip-block;
			inset: auto;
			margin: 0 0 0.75rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.languages,
		.languages:popover-open {
			translate: none;
		}
	}
</style>
