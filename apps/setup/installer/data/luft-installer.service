[Unit]
Description=Luft installer and first-run setup

[Service]
Type=dbus
BusName=com.lantharos.Installer1
ExecStart=/usr/libexec/luft-installer
SELinuxContext=system_u:system_r:install_t:s0
SyslogIdentifier=luft-installer
RuntimeDirectory=luft-installer
RuntimeDirectoryPreserve=yes
StateDirectory=luft-installer
KillMode=mixed
TimeoutStopSec=5min
