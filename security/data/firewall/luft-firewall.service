[Unit]
Description=Firewall
Wants=luft-firewall-base.service
After=luft-firewall-base.service
PartOf=luft-firewall-base.service

[Service]
Type=dbus
BusName=com.lantharos.Firewall1
ExecStart=@libexecdir@/luft-firewall
Restart=on-failure
UMask=0077
StateDirectory=luft-firewall
StateDirectoryMode=0700
RuntimeDirectory=luft-firewall
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallFilter=bpf
CapabilityBoundingSet=CAP_NET_ADMIN CAP_BPF CAP_SYS_PTRACE
IPAddressDeny=any

[Install]
WantedBy=multi-user.target
