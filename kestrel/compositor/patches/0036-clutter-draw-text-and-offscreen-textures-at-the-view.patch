diff --git a/clutter/clutter/clutter-util.c b/clutter/clutter/clutter-util.c
index d017006f20aa7a631214d4313ef450ae4191ead3..bfa6284fbd03323188af9868116467fc7eb0bb58 100644
--- a/clutter/clutter/clutter-util.c
+++ b/clutter/clutter/clutter-util.c
@@ -108,6 +108,45 @@ _clutter_util_fully_transform_vertices (const graphene_matrix_t  *modelview,
     }
 }
 
+#define PIXEL_EPSILON (1.f / 128.f)
+
+gboolean
+_clutter_util_offset_to_whole_pixel (CoglFramebuffer *framebuffer,
+                                     float            x,
+                                     float            y,
+                                     float            pixels_per_unit,
+                                     float           *offset_x,
+                                     float           *offset_y)
+{
+  graphene_matrix_t modelview, projection;
+  float viewport[4];
+  graphene_point3d_t in[3] = {
+    GRAPHENE_POINT3D_INIT (x, y, 0.f),
+    GRAPHENE_POINT3D_INIT (x + 1.f, y, 0.f),
+    GRAPHENE_POINT3D_INIT (x, y + 1.f, 0.f),
+  };
+  graphene_point3d_t out[3];
+  float step_x, step_y;
+
+  cogl_framebuffer_get_modelview_matrix (framebuffer, &modelview);
+  cogl_framebuffer_get_projection_matrix (framebuffer, &projection);
+  cogl_framebuffer_get_viewport4fv (framebuffer, viewport);
+  _clutter_util_fully_transform_vertices (&modelview, &projection, viewport,
+                                          in, out, G_N_ELEMENTS (in));
+
+  step_x = out[1].x - out[0].x;
+  step_y = out[2].y - out[0].y;
+  if (fabsf (fabsf (step_x) - pixels_per_unit) > PIXEL_EPSILON ||
+      fabsf (fabsf (step_y) - pixels_per_unit) > PIXEL_EPSILON ||
+      fabsf (out[1].y - out[0].y) > PIXEL_EPSILON ||
+      fabsf (out[2].x - out[0].x) > PIXEL_EPSILON)
+    return FALSE;
+
+  *offset_x = (roundf (out[0].x) - out[0].x) / step_x;
+  *offset_y = (roundf (out[0].y) - out[0].y) / step_y;
+  return TRUE;
+}
