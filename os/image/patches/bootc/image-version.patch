From 609df458711ae0585a40a3d30f3145dc89835241 Mon Sep 17 00:00:00 2001
From: Kristof Imeri <imeri@lanth.me>
Date: Tue, 27 Oct 2026 19:35:46 +0100
Subject: [PATCH] composefs: Give a UKI's boot entry the image's version

The Type #1 entry written for a UKI took its version from the UKI's
os-release, so an image could only show its version in the boot menu
by carrying it inside the image. Renaming an image, as promoting a
tested build to a release does by changing only its version
annotation, then can't change what the boot menu shows without
building new layers.

Use the image's org.opencontainers.image.version annotation, the
version bootc status shows, when the image has one, and the UKI's
os-release otherwise.
---
 crates/lib/src/bootc_composefs/boot.rs   | 22 +++++++++++++++++++++-
 crates/lib/src/bootc_composefs/update.rs |  4 +++-
 2 files changed, 24 insertions(+), 2 deletions(-)

diff --git a/crates/lib/src/bootc_composefs/boot.rs b/crates/lib/src/bootc_composefs/boot.rs
index 202e311..ec6a74e 100644
--- a/crates/lib/src/bootc_composefs/boot.rs
+++ b/crates/lib/src/bootc_composefs/boot.rs
@@ -1272,12 +1272,29 @@ fn write_systemd_uki_config(
     Ok(())
 }
 
+/// The version `bootc status` shows for an image: its manifest's
+/// `org.opencontainers.image.version` annotation.
+pub(crate) fn image_version(
+    repo: &crate::store::ComposefsRepository,
+    manifest_digest: &str,
+) -> Option<String> {
+    let digest: composefs_oci::OciDigest = manifest_digest.parse().ok()?;
+    composefs_oci::OciImage::<Sha512HashValue>::open(repo, &digest, None)
+        .ok()?
+        .manifest()
+        .annotations()
+        .as_ref()?
+        .get(ostree_ext::oci_spec::image::ANNOTATION_VERSION)
+        .cloned()
+}
+
 #[context("Setting up UKI boot")]
 pub(crate) fn setup_composefs_uki_boot(
     setup_type: BootSetupType,
     repo: &crate::store::ComposefsRepository,
     id: &Sha512HashValue,
     entries: Vec<ComposefsBootEntry<Sha512HashValue>>,
+    version: Option<String>,
 ) -> Result<String> {
     let (root_path, boot_partition, bootloader, missing_fsverity_allowed, uki_addons) =
         match setup_type {
@@ -1372,8 +1389,9 @@ pub(crate) fn setup_composefs_uki_boot(
         };
     }
 
-    let uki_info =
+    let mut uki_info =
         uki_info.ok_or_else(|| anyhow::anyhow!("Failed to get version and boot label from UKI"))?;
+    uki_info.version = version.or(uki_info.version);
 
     let boot_digest = uki_info.boot_digest.clone();
 
@@ -1746,11 +1764,13 @@ pub(crate) async fn setup_composefs_boot(
             mounted_root.dir(),
         )?,
         BootType::Uki => {
+            let version = image_version(&repo, &pull_result.manifest_digest.to_string());
             let uki_setup_result = setup_composefs_uki_boot(
                 BootSetupType::Setup((&root_setup, &state, &postfetch)),
                 &repo,
                 &id,
                 entries,
+                version,
             );
 
             match uki_setup_result {
diff --git a/crates/lib/src/bootc_composefs/update.rs b/crates/lib/src/bootc_composefs/update.rs
index c2b43c8..33bf549 100644
--- a/crates/lib/src/bootc_composefs/update.rs
+++ b/crates/lib/src/bootc_composefs/update.rs
@@ -18,7 +18,7 @@ use crate::spec::BootloaderKind;
 use crate::{
     bootc_composefs::{
         boot::{
-            BootSetupType, BootType, UKIDigestMismatch, print_uki_dumpfile_diff,
+            BootSetupType, BootType, UKIDigestMismatch, image_version, print_uki_dumpfile_diff,
             setup_composefs_bls_boot, setup_composefs_uki_boot,
         },
         gc::composefs_gc,
@@ -325,11 +325,13 @@ pub(crate) async fn do_upgrade(
         )?,
 
         BootType::Uki => {
+            let version = image_version(&repo, &manifest_digest);
             let uki_setup_result = setup_composefs_uki_boot(
                 BootSetupType::Upgrade((storage, booted_cfs, &host)),
                 &repo,
                 &id,
                 entries,
+                version,
             );
 
             match uki_setup_result {
