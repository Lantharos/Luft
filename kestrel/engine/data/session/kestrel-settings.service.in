[Unit]
Description=Kestrel settings
CollectMode=inactive-or-failed
PartOf=kestrel-session.target
Before=kestrel.service

[Service]
Slice=session.slice
Type=dbus
BusName=com.lantharos.Settings
Environment=GIO_USE_VFS=local
ExecStart=@libexecdir@/luft-launch @libexecdir@/kestrel-settings
Restart=on-failure
TimeoutStopSec=5
OOMScoreAdjust=-800
MemoryMin=32M
NoNewPrivileges=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
UMask=0077
