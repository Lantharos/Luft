diff --git a/src/backends/native/meta-seat-impl.c b/src/backends/native/meta-seat-impl.c
index 0526a26d9157de30ee7c9d0e6e2d21e8e5b08c3b..dfc60e1934091b2e029874d083f8bb39e7aa0762 100644
--- a/src/backends/native/meta-seat-impl.c
+++ b/src/backends/native/meta-seat-impl.c
@@ -1954,6 +1954,9 @@ has_pointer (MetaSeatImpl *seat_impl)
 static gboolean
 device_is_tablet_switch (MetaInputDeviceNative *device_native)
 {
+  if (device_native->virtual_tablet_switch)
+    return TRUE;
+
   if (!device_native->libinput_device)
     return FALSE;
 
@@ -2014,6 +2017,17 @@ update_touch_mode (MetaSeatImpl *seat_impl)
     }
 }
 
+void
+meta_seat_impl_notify_tablet_mode_in_impl (MetaSeatImpl       *seat_impl,
+                                           ClutterInputDevice *input_device,
+                                           gboolean            tablet_mode)
+{
+  META_INPUT_DEVICE_NATIVE (input_device)->virtual_tablet_switch = TRUE;
+  seat_impl->has_tablet_switch = TRUE;
+  seat_impl->tablet_mode_switch_state = tablet_mode;
+  update_touch_mode (seat_impl);
+}
+
 static void
 meta_seat_impl_take_device (MetaSeatImpl       *seat_impl,
                             ClutterInputDevice *device)
diff --git a/src/backends/native/meta-seat-impl.h b/src/backends/native/meta-seat-impl.h
index 638c68f3229749ec4836796763db8960a320fac2..5e5d6ad6ab7df231987624235eb8303fc71f50d4 100644
--- a/src/backends/native/meta-seat-impl.h
+++ b/src/backends/native/meta-seat-impl.h
@@ -190,6 +190,10 @@ void meta_seat_impl_notify_touchpad_swipe_in_impl (ClutterInputDevice          *
                                                    double                       dx,
                                                    double                       dy);
 
+void meta_seat_impl_notify_tablet_mode_in_impl (MetaSeatImpl       *seat_impl,
