<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Luft</vendor>
  <vendor_url>https://github.com/Lantharos</vendor_url>

  <action id="com.lantharos.windows.status">
    <description>See Windows on this computer</description>
    <message>Authentication is required to look at Windows on this computer</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>

  <action id="com.lantharos.windows.change">
    <description>Change Windows' settings</description>
    <message>Authentication is required to change Windows' settings</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>

  <action id="com.lantharos.windows.bluetooth">
    <description>Bring Bluetooth devices from Windows</description>
    <message>Authentication is required to use the Bluetooth devices paired in Windows</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>
</policyconfig>
