   cogl_pipeline_set_layer_wrap_mode (pipeline, 0,
                                      COGL_PIPELINE_WRAP_MODE_CLAMP_TO_EDGE);
-  add_glass_effect (paint, pipeline);
+  meta_background_add_glass_effect (paint, pipeline);
   meta_background_apply_corners (paint, pipeline, piece);
   cogl_color_init_from_4f (&color, alpha, alpha, alpha, alpha);
   cogl_pipeline_set_color (pipeline, &color);
@@ -133,6 +146,7 @@ meta_background_shows_wallpaper (MetaCompositor    *compositor,
   MtkRectangle area;
 
   return material != META_GLASS_MATERIAL_LIVE &&
+    material != META_GLASS_MATERIAL_NIKO &&
     meta_compositor_get_frosted_wallpaper (compositor, frost_of (material), 0, &area);
 }
 
