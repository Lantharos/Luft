+void
+meta_window_actor_window_to_stage_space (MetaWindowActor *window_actor,
+                                         float           *x,
+                                         float           *y)
+{
+  ClutterActor *window_group =
+    clutter_actor_get_parent (CLUTTER_ACTOR (window_actor));
+  ClutterActor *stage = clutter_actor_get_stage (CLUTTER_ACTOR (window_actor));
+  graphene_matrix_t group_to_stage;
+  graphene_point3d_t point = GRAPHENE_POINT3D_INIT (*x, *y, 0.f);
+
+  if (!window_group || !stage)
+    return;
+
+  clutter_actor_get_relative_transformation_matrix (window_group, stage,
+                                                    &group_to_stage);
+  if (graphene_matrix_is_identity (&group_to_stage))
+    return;
+
+  graphene_matrix_transform_point3d (&group_to_stage, &point, &point);
+  *x = point.x;
+  *y = point.y;
+}
