       break;
+    case PROP_MAGNIFICATION:
+      meta_window_set_magnification (window, g_value_get_double (value));
+      break;
     default:
       G_OBJECT_WARN_INVALID_PROPERTY_ID (object, prop_id, pspec);
       break;
@@ -606,6 +613,26 @@ meta_window_set_unconstrained (MetaWindow *window,
   g_object_notify_by_pspec (G_OBJECT (window), obj_props[PROP_UNCONSTRAINED]);
 }
 
+double
+meta_window_get_magnification (MetaWindow *window)
+{
+  while (window->transient_for)
+    window = window->transient_for;
+
+  return window->magnification;
+}
+
+void
+meta_window_set_magnification (MetaWindow *window,
+                               double      magnification)
+{
+  if (G_APPROX_VALUE (window->magnification, magnification, FLT_EPSILON))
+    return;
+
+  window->magnification = magnification;
+  g_object_notify_by_pspec (G_OBJECT (window), obj_props[PROP_MAGNIFICATION]);
+}
+
 static void
 meta_window_class_init (MetaWindowClass *klass)
 {
@@ -651,6 +678,18 @@ meta_window_class_init (MetaWindowClass *klass)
                           FALSE,
                           G_PARAM_READWRITE | G_PARAM_EXPLICIT_NOTIFY |
                           G_PARAM_STATIC_STRINGS);
+  /**
+   * MetaWindow:magnification:
+   *
+   * How much larger than its size the window is shown. Clients are asked
+   * to draw it with that much more detail, so it stays sharp when magnified.
+   * Popups and dialogs follow their parent window.
+   */
+  obj_props[PROP_MAGNIFICATION] =
+    g_param_spec_double ("magnification", NULL, NULL,
+                         0.1, 16.0, 1.0,
+                         G_PARAM_READWRITE | G_PARAM_EXPLICIT_NOTIFY |
+                         G_PARAM_STATIC_STRINGS);
