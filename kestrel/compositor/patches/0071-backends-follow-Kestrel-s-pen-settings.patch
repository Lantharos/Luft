+static void
+notify_pen_action (MetaToolActionMapper *mapper,
+                   ClutterInputDevice   *device,
+                   MetaPenButtonAction   action)
+{
+  MetaContext *context = meta_backend_get_context (mapper->backend);
+  MetaDisplay *display = meta_context_get_display (context);
+
+  switch (action)
+    {
+    case META_PEN_BUTTON_ACTION_SCREENSHOT:
+      meta_display_notify_pen_action (display, device, "screenshot");
+      break;
+    case META_PEN_BUTTON_ACTION_NOTES:
+      meta_display_notify_pen_action (display, device, "notes");
+      break;
+    case META_PEN_BUTTON_ACTION_START:
+      meta_display_notify_pen_action (display, device, "start");
+      break;
+    default:
+      g_assert_not_reached ();
+    }
+}
