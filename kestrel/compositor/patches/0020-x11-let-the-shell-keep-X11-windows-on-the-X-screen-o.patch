+/**
+ * meta_display_set_x11_origin:
+ * @display: a #MetaDisplay
+ * @x: horizontal position of the X screen's origin
+ * @y: vertical position of the X screen's origin
+ *
+ * Sets where the X screen's origin lies among the windows. X11 windows get
+ * their X server positions relative to it, so a shell that lays windows out
+ * on a canvas larger than the monitors can keep the X11 windows it shows on
+ * the X screen, where the X server can reach them with the pointer.
+ */
+void
+meta_display_set_x11_origin (MetaDisplay *display,
+                             int          x,
+                             int          y)
+{
+  if (display->x11_origin_x == x && display->x11_origin_y == y)
+    return;
+
+  display->x11_origin_x = x;
+  display->x11_origin_y = y;
+
+#ifdef HAVE_XWAYLAND
+  g_autoptr (GSList) windows = meta_display_list_windows (display,
+                                                          META_LIST_DEFAULT);
+
+  for (GSList *l = windows; l; l = l->next)
+    {
+      MetaWindow *window = l->data;
+
+      if (window->client_type == META_WINDOW_CLIENT_TYPE_X11)
+        meta_window_x11_sync_origin (window);
+    }
+
+  if (display->x11_display)
+    XFlush (display->x11_display->xdisplay);
+#endif
+}
