 src/wayland/meta-wayland-idle-notify.c | 180 +++++++++++++++++++++++++
 src/wayland/meta-wayland-idle-notify.h |  22 +++
 src/wayland/meta-wayland-versions.h    |   1 +
 src/wayland/meta-wayland.c             |   2 +
 5 files changed, 208 insertions(+)
 create mode 100644 src/wayland/meta-wayland-idle-notify.c
 create mode 100644 src/wayland/meta-wayland-idle-notify.h

