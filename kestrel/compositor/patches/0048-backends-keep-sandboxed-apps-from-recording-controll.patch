 src/backends/meta-dbus-access-checker.h     |   4 +
 src/backends/meta-dbus-session-manager.c    |  45 ++++++++
 src/backends/meta-display-config-skeleton.c | 113 ++++++++++++++++++++
 src/backends/meta-display-config-skeleton.h |  13 +++
 src/backends/meta-monitor-manager.c         |   4 +-
