[Unit]
Description=Swap that grows and shrinks with demand
DefaultDependencies=no
RequiresMountsFor=/var
After=local-fs.target
Before=shutdown.target
Conflicts=shutdown.target

[Service]
Type=exec
ExecStartPre=+@libexecdir@/luft-swap prepare
ExecStart=@libexecdir@/luft-swap
Restart=on-failure
RestartSec=5
OOMScoreAdjust=-900
MemoryMin=16M
UMask=0077
ProtectSystem=strict
ReadWritePaths=-/var/swap /sys/module/zswap/parameters
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service @swap
CapabilityBoundingSet=CAP_SYS_ADMIN
IPAddressDeny=any

[Install]
WantedBy=multi-user.target
