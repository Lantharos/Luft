diff --git a/src/compositor/meta-scanout-log.c b/src/compositor/meta-scanout-log.c
new file mode 100644
index 0000000000000000000000000000000000000000..a2de1fc784199bfe25b8ce5ed069fcd1bd7f9c7d
--- /dev/null
+++ b/src/compositor/meta-scanout-log.c
@@ -0,0 +1,285 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "config.h"
+
+#include "compositor/meta-scanout-log.h"
+
+#include <gio/gio.h>
+
+#include "compositor/compositor-private.h"
+#include "compositor/meta-window-actor-private.h"
+
+#define SETTINGS_SCHEMA "com.lantharos.kestrel.diagnostics"
+#define SETTINGS_KEY "log-direct-scanout"
+#define DESKTOP_DELAY_MS 1000
+#define LINES_PER_MINUTE 30
+
+typedef struct
+{
+  MetaScanoutLog *log;
+  ClutterStageView *view;
+  int64_t started_us;
+  int64_t stopped_us;
+  int64_t first_composited_frame;
+  guint delay_timeout_id;
+} ViewState;
+
+struct _MetaScanoutLog
+{
+  MetaCompositor *compositor;
+  ClutterStage *stage;
+  GSettings *settings;
+  gboolean enabled;
+  GHashTable *views;
+  gulong presented_handler_id;
+  int64_t minute_start_us;
+  int lines;
+  int suppressed;
+};
+
+G_GNUC_PRINTF (2, 3)
+static void
+log_line (MetaScanoutLog *log,
+          const char     *format,
+          ...)
+{
+  int64_t now_us = g_get_monotonic_time ();
+  g_autofree char *message = NULL;
+  va_list args;
+
+  if (now_us - log->minute_start_us >= G_USEC_PER_SEC * 60)
+    {
+      if (log->suppressed > 0)
+        g_message ("Direct scanout: %d lines left out in the last minute",
+                   log->suppressed);
+      log->minute_start_us = now_us;
+      log->lines = 0;
+      log->suppressed = 0;
+    }
+
+  if (log->lines >= LINES_PER_MINUTE)
+    {
+      log->suppressed++;
+      return;
+    }
+
+  log->lines++;
+  va_start (args, format);
+  message = g_strdup_vprintf (format, args);
+  va_end (args);
+  g_message ("Direct scanout: %s", message);
+}
+
+static const char *
+describe_window (MetaWindow *window)
+{
+  const char *id;
+
+  if (!window)
+    return "a closed window";
+
+  id = meta_window_get_sandboxed_app_id (window);
+  if (!id)
+    id = meta_window_get_gtk_application_id (window);
+  if (!id)
+    id = meta_window_get_wm_class (window);
+  return id ? id : "an unnamed window";
+}
+
+static char *
+describe_stop (MetaScanoutLog *log,
+               MetaWindow     *window)
+{
+  MetaWindowActor *window_actor;
+  GString *reasons;
+
+  if (!window)
+    return g_strdup ("the window closed");
+
+  window_actor = meta_window_actor_from_window (window);
+  reasons = g_string_new (NULL);
+  if (!meta_window_is_fullscreen (window))
+    g_string_append (reasons, "left fullscreen, ");
+  if (window_actor && meta_window_actor_is_frozen (window_actor))
+    g_string_append (reasons, "waiting for the client to resize, ");
+  if (window_actor && meta_window_actor_effect_in_progress (window_actor))
+    g_string_append (reasons, "animating, ");
+  if (meta_compositor_is_unredirect_inhibited (log->compositor))
+    g_string_append (reasons, "shell surface on top, ");
+
+  if (reasons->len == 0)
+    return g_string_free_and_steal (g_string_append (reasons,
+                                                     "the window was covered or changed shape"));
+
+  g_string_truncate (reasons, reasons->len - 2);
+  return g_string_free_and_steal (reasons);
+}
+
+static void
+stop_waiting (ViewState *state)
+{
+  state->first_composited_frame = 0;
+  g_clear_handle_id (&state->delay_timeout_id, g_source_remove);
+}
+
+static void
+view_destroyed (gpointer  data,
+                GObject  *view)
+{
+  ViewState *state = data;
+
+  state->view = NULL;
+  g_hash_table_remove (state->log->views, view);
+}
+
+static void
+view_state_free (ViewState *state)
+{
+  stop_waiting (state);
+  if (state->view)
+    g_object_weak_unref (G_OBJECT (state->view), view_destroyed, state);
+  g_free (state);
+}
+
+static ViewState *
+ensure_view_state (MetaScanoutLog   *log,
+                   ClutterStageView *view)
+{
+  ViewState *state = g_hash_table_lookup (log->views, view);
+
+  if (state)
+    return state;
+
+  state = g_new0 (ViewState, 1);
+  state->log = log;
+  state->view = view;
+  g_object_weak_ref (G_OBJECT (view), view_destroyed, state);
+  g_hash_table_insert (log->views, view, state);
+  return state;
+}
+
+static gboolean
+on_desktop_delayed (gpointer user_data)
+{
+  ViewState *state = user_data;
+  ClutterFrameClock *frame_clock =
+    clutter_stage_view_get_frame_clock (state->view);
+
+  state->delay_timeout_id = 0;
+  log_line (state->log,
+            "%s: the desktop is not back on screen %d ms after direct scanout "
+            "ended (redraw queued: %s, oldest frame waiting for %.1f ms)",
+            clutter_stage_view_get_name (state->view),
+            DESKTOP_DELAY_MS,
+            clutter_stage_view_has_redraw_clip (state->view) ? "yes" : "no",
+            frame_clock ?
+            clutter_frame_clock_get_presentation_wait_us (frame_clock) / 1000.0 :
+            0.0);
+  return G_SOURCE_REMOVE;
+}
+
+static void
+on_presented (ClutterStage     *stage,
+              ClutterStageView *view,
+              ClutterFrameInfo *frame_info,
+              MetaScanoutLog   *log)
+{
+  ViewState *state = g_hash_table_lookup (log->views, view);
+
+  if (!state || state->first_composited_frame == 0 ||
+      frame_info->view_frame_counter < state->first_composited_frame)
+    return;
+
+  log_line (log, "%s: the desktop was back on screen %.1f ms after direct scanout ended",
+            clutter_stage_view_get_name (view),
+            (g_get_monotonic_time () - state->stopped_us) / 1000.0);
+  stop_waiting (state);
+}
+
+static void
+sync_enabled (MetaScanoutLog *log)
+{
+  log->enabled = g_settings_get_boolean (log->settings, SETTINGS_KEY);
+
+  if (log->enabled && !log->presented_handler_id)
+    {
+      log->presented_handler_id =
+        g_signal_connect (log->stage, "presented",
+                          G_CALLBACK (on_presented), log);
+    }
+  else if (!log->enabled)
+    {
+      g_clear_signal_handler (&log->presented_handler_id, log->stage);
+      g_hash_table_remove_all (log->views);
+    }
+}
+
+MetaScanoutLog *
+meta_scanout_log_new (MetaCompositor *compositor,
+                      ClutterStage   *stage)
+{
+  MetaScanoutLog *log = g_new0 (MetaScanoutLog, 1);
+
+  log->compositor = compositor;
+  log->stage = stage;
+  log->views = g_hash_table_new_full (NULL, NULL, NULL,
+                                      (GDestroyNotify) view_state_free);
+  log->settings = g_settings_new (SETTINGS_SCHEMA);
+  g_signal_connect_swapped (log->settings, "changed::" SETTINGS_KEY,
+                            G_CALLBACK (sync_enabled), log);
+  sync_enabled (log);
+  return log;
+}
+
+void
+meta_scanout_log_free (MetaScanoutLog *log)
+{
+  g_clear_signal_handler (&log->presented_handler_id, log->stage);
+  g_clear_object (&log->settings);
+  g_clear_pointer (&log->views, g_hash_table_destroy);
+  g_free (log);
+}
+
+void
+meta_scanout_log_started (MetaScanoutLog   *log,
+                          ClutterStageView *view,
+                          MetaWindow       *window)
+{
+  ViewState *state;
+
+  if (!log->enabled)
+    return;
+
+  state = ensure_view_state (log, view);
+  stop_waiting (state);
+  state->started_us = g_get_monotonic_time ();
+  log_line (log, "%s: showing %s directly",
+            clutter_stage_view_get_name (view), describe_window (window));
+}
+
+void
+meta_scanout_log_stopped (MetaScanoutLog   *log,
+                          ClutterStageView *view,
+                          MetaWindow       *window,
+                          ClutterFrame     *frame)
+{
+  g_autofree char *reason = NULL;
+  ViewState *state;
+
+  if (!log->enabled)
+    return;
+
+  state = ensure_view_state (log, view);
+  reason = describe_stop (log, window);
+  state->stopped_us = g_get_monotonic_time ();
+  log_line (log, "%s: stopped showing %s directly after %.1f s: %s",
+            clutter_stage_view_get_name (view), describe_window (window),
+            state->started_us ?
+            (state->stopped_us - state->started_us) / (double) G_USEC_PER_SEC :
+            0.0,
+            reason);
+
+  stop_waiting (state);
+  state->first_composited_frame = clutter_frame_get_count (frame);
+  state->delay_timeout_id = g_timeout_add (DESKTOP_DELAY_MS,
+                                           on_desktop_delayed, state);
+}
