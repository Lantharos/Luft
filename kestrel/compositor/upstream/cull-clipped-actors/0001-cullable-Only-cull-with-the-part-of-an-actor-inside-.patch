From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Kristof Imeri <kristof@lanth.me>
Date: Wed, 21 Oct 2026 06:11:56 +0200
Subject: [PATCH 1/2] cullable: Only cull with the part of an actor inside its
 clip

A shell can clip a window actor, for example to keep a window that
reaches past a monitor on that monitor. The actor then only paints the
part inside its clip, but culling still took its whole opaque region as
covering what is below it. Windows and the background below the part
the clip hides weren't painted, and that area showed stale content.

Put back what an actor culled outside of its clip, so that it only
obscures what it paints, while actors below it are still culled within
the clip.
---
 src/compositor/meta-cullable.c | 40 ++++++++++++++++++++++++++++++++--
 1 file changed, 38 insertions(+), 2 deletions(-)

diff --git a/src/compositor/meta-cullable.c b/src/compositor/meta-cullable.c
index 6e55809ec6..c77387a743 100644
--- a/src/compositor/meta-cullable.c
+++ b/src/compositor/meta-cullable.c
@@ -77,6 +77,42 @@ region_apply_transform_expand_maybe_ref (MtkRegion         *region,
 typedef void (* ChildCullMethod) (MetaCullable *cullable,
                                   MtkRegion    *region);
 
+static MtkRegion *
+copy_region_outside_clip (ClutterActor *actor,
+                          MtkRegion    *region)
+{
+  graphene_rect_t clip;
+  MtkRectangle clip_rect;
+  MtkRegion *outside_clip;
+
+  clutter_actor_get_clip (actor,
+                          &clip.origin.x, &clip.origin.y,
+                          &clip.size.width, &clip.size.height);
+  mtk_rectangle_from_graphene_rect (&clip, MTK_ROUNDING_STRATEGY_SHRINK,
+                                    &clip_rect);
+
+  outside_clip = mtk_region_copy (region);
+  mtk_region_subtract_rectangle (outside_clip, &clip_rect);
+
+  return outside_clip;
+}
+
+static void
+cull_child_within_clip (MetaCullable    *child,
+                        MtkRegion       *region,
+                        ChildCullMethod  method)
+{
+  g_autoptr (MtkRegion) outside_clip = NULL;
+
+  if (clutter_actor_has_clip (CLUTTER_ACTOR (child)))
+    outside_clip = copy_region_outside_clip (CLUTTER_ACTOR (child), region);
+
+  method (child, region);
+
+  if (outside_clip)
+    mtk_region_union (region, outside_clip);
+}
+
 static void
 cull_out_children_common (MetaCullable    *cullable,
                           MtkRegion       *region,
@@ -129,7 +165,7 @@ cull_out_children_common (MetaCullable    *cullable,
           if (graphene_matrix_is_identity (&actor_transform))
             {
               /* No transformation needed, simply pass through to child */
-              method (META_CULLABLE (child), region);
+              cull_child_within_clip (META_CULLABLE (child), region, method);
               continue;
             }
 
@@ -147,7 +183,7 @@ cull_out_children_common (MetaCullable    *cullable,
 
           g_assert (actor_region);
 
-          method (META_CULLABLE (child), actor_region);
+          cull_child_within_clip (META_CULLABLE (child), actor_region, method);
 
           reduced_region =
             region_apply_transform_expand_maybe_ref (actor_region,
