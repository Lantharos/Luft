--- a/clutter/clutter/clutter-seat.h
+++ b/clutter/clutter/clutter-seat.h
@@ -104,6 +104,8 @@ struct _ClutterSeatClass
   ClutterVirtualDeviceType (* get_supported_virtual_device_types) (ClutterSeat *seat);
 
   ClutterInputDevice * (* get_virtual_source_pointer) (ClutterSeat *seat);
+
+  void (* consume_held_modifiers) (ClutterSeat *seat);
 };
 
 CLUTTER_EXPORT
@@ -152,6 +154,10 @@ CLUTTER_EXPORT
 void clutter_seat_warp_pointer (ClutterSeat *seat,
                                 int          x,
                                 int          y);
