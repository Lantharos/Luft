## Fingerprints
## Each finger has a name used as a title (the message value) and a form used inside
## a sentence (.inline), like "Place your … on the sensor." Adjust the case of .inline
## to fit those sentences.

ui-finger-right-index = Højre pegefinger
    .inline = højre pegefinger
ui-finger-left-index = Venstre pegefinger
    .inline = venstre pegefinger
ui-finger-right-thumb = Højre tommelfinger
    .inline = højre tommelfinger
ui-finger-left-thumb = Venstre tommelfinger
    .inline = venstre tommelfinger
ui-finger-right-middle = Højre langfinger
    .inline = højre langfinger
ui-finger-left-middle = Venstre langfinger
    .inline = venstre langfinger
ui-finger-right-ring = Højre ringfinger
    .inline = højre ringfinger
ui-finger-left-ring = Venstre ringfinger
    .inline = venstre ringfinger
ui-finger-right-little = Højre lillefinger
    .inline = højre lillefinger
ui-finger-left-little = Venstre lillefinger
    .inline = venstre lillefinger

ui-fingerprint-place = Læg din { $finger } på sensoren.
ui-fingerprint-swipe = Stryg din { $finger } hen over sensoren.
ui-fingerprint-stage-passed = Godt. Løft fingeren, og læg den på igen.
ui-fingerprint-stage-passed-swipe = Godt. Stryg igen.
ui-fingerprint-retry = Det kunne ikke aflæses ordentligt. Prøv igen.
ui-fingerprint-swipe-too-short = Stryg lidt langsommere.
ui-fingerprint-not-centered = Placer fingeren midt på sensoren.
ui-fingerprint-remove-and-retry = Løft fingeren, og prøv igen.
ui-fingerprint-added = Fingeraftrykket er tilføjet.
ui-fingerprint-full = Læseren har ikke plads til flere fingeraftryk.
ui-fingerprint-disconnected = Fingeraftrykslæseren svarer ikke længere. Prøv igen om lidt.
ui-fingerprint-duplicate = Læseren har allerede gemt denne finger, sandsynligvis fra Windows eller en anden konto. Brug en anden finger.
ui-fingerprint-failed = Fingeraftrykket kunne ikke tilføjes. Prøv igen.

