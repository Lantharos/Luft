[Unit]
Description=Install the apps Luft comes with
After=kestrel-session.target graphical-session.target
PartOf=graphical-session.target
ConditionUser=!@system

[Service]
Type=oneshot
ExecStart=/usr/libexec/luft-launch /usr/bin/schelf --preinstall
Nice=10

[Install]
WantedBy=kestrel-session.target
