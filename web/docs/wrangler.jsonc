{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "luft-docs",
	"compatibility_date": "2026-10-17",
	"routes": [{ "pattern": "docs.luft.computer", "custom_domain": true }],
	"assets": {
		"directory": "./dist",
		"html_handling": "auto-trailing-slash",
		"not_found_handling": "404-page"
	}
}
