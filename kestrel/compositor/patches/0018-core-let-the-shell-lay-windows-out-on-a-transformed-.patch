+gboolean
+meta_window_is_unconstrained (MetaWindow *window)
+{
+  while (window->transient_for)
+    window = window->transient_for;
+
+  return window->unconstrained;
+}
+
+void
+meta_window_set_unconstrained (MetaWindow *window,
+                               gboolean    unconstrained)
+{
+  if (window->unconstrained == unconstrained)
+    return;
+
+  window->unconstrained = unconstrained;
+  g_object_notify_by_pspec (G_OBJECT (window), obj_props[PROP_UNCONSTRAINED]);
+}
