 src/frames/meson.build                        |  7 ++
 src/frames/meta-frame-header.c                | 55 +++++++++++--
 src/frames/meta-frame-style.c                 | 79 +++++++++++++++++++
 src/frames/meta-frame-style.h                 | 20 +++++
 src/frames/meta-window-tracker.c              | 20 +++--
