[Unit]
Description=Start encrypting the system disk
DefaultDependencies=no
ConditionPathExists=/etc/trustd/stage/plan.json
Wants=tpm2.target
After=systemd-udev-trigger.service tpm2.target sushi.service systemd-pcrphase-initrd.service
Before=cryptsetup.target initrd-root-device.target sysroot.mount

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/trustctl encryption initrd
SyslogIdentifier=trustd
TimeoutSec=infinity
