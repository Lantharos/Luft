From 9e8d86c34f12ede54e7bdf5653342b3da5880f86 Mon Sep 17 00:00:00 2001
From: Kristof Imeri <imeri@lanth.me>
Date: Sat, 17 Oct 2026 14:43:43 +0200
Subject: [PATCH] composefs: Read containers-storage images from their layers

Pulling a containers-storage: image through skopeo makes
containers/image copy each layer it serves to a temporary file in
/var/tmp before the first byte goes out, and composefs fetches as many
layers at once as there are CPUs. Installing from a live medium, whose
/var/tmp is in memory, needs room for the biggest few layers of the
image at once there: about 4 GB for an image with NVIDIA's driver, so
installs ran out of space on machines with 8 GB of RAM or less.

For containers-storage: sources, use composefs' own import from the
store's layers instead, which reads the files where they are and
reflinks, hardlinks or copies each into the repository.
---
 crates/lib/src/bootc_composefs/repo.rs | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/crates/lib/src/bootc_composefs/repo.rs b/crates/lib/src/bootc_composefs/repo.rs
index 9a12624..830abd7 100644
--- a/crates/lib/src/bootc_composefs/repo.rs
+++ b/crates/lib/src/bootc_composefs/repo.rs
@@ -198,6 +198,12 @@ pub(crate) struct PullRepoResult {
 /// This is the default path: the image is fetched directly from the source
 /// transport (registry, oci directory, etc.) into the composefs repo without
 /// going through containers-storage first.
+///
+/// An image that is already in containers-storage is read straight from its
+/// layers instead. Through skopeo, containers-storage first copies each layer
+/// it serves to a temporary file in /var/tmp, and several layers are fetched
+/// at once. On a live system /var/tmp is in memory, so installing from a live
+/// medium's image store ran out of space with a few GB of RAM.
 async fn pull_composefs_direct(
     repo: &Arc<crate::store::ComposefsRepository>,
     imgref: &containers_image_proxy::ImageReference,
@@ -218,6 +224,11 @@ async fn pull_composefs_direct(
         None,
         PullOptions {
             img_proxy_config: Some(config),
+            local_fetch: if imgref.transport == containers_image_proxy::Transport::ContainerStorage {
+                LocalFetchOpt::IfPossible
+            } else {
+                LocalFetchOpt::Disabled
+            },
             progress: Some(reporter),
             ..Default::default()
         },
