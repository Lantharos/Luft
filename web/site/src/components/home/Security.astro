---
import { localize } from '../../i18n/pages';
import Backdrop from './Backdrop.astro';

const { t } = localize(Astro);
const points = [
	[t('home-security-sealed'), t('home-security-sealed-text')],
	[t('home-security-updates'), t('home-security-updates-text')],
	[t('home-security-secure-boot'), t('home-security-secure-boot-text')],
	[t('home-security-encryption'), t('home-security-encryption-text')],
	[t('home-security-passkeys'), t('home-security-passkeys-text')],
	[t('home-security-keyring'), t('home-security-keyring-text')]
];
---

<section id="security" class="relative isolate overflow-hidden py-32 text-ink scheme-dark md:py-48">
	<Backdrop name="Nocturne" position="50% 40%" />
	<div class="absolute inset-0 -z-10 bg-[#0b0d14]/30" aria-hidden="true"></div>
	<div class="page">
		<div class="reveal max-w-2xl">
			<h2 class="text-headline font-semibold text-balance">{t('home-security-heading')}</h2>
			<p class="mt-6 text-lede text-ink-soft text-pretty">{t('home-security-text')}</p>
		</div>
		<dl class="mt-16 grid gap-x-12 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
			{
				points.map(([title, text]) => (
					<div class="reveal border-t border-hairline pt-6">
						<dt class="text-lg font-semibold">{title}</dt>
						<dd class="mt-2 text-ink-soft">{text}</dd>
					</div>
				))
			}
		</dl>
	</div>
</section>
