+static gboolean
+stage_to_framebuffer (MetaBackgroundPaint *paint,
+                      ClutterStageView    *view,
+                      graphene_matrix_t   *matrix)
+{
+  graphene_matrix_t actor_to_stage;
+  graphene_matrix_t stage_to_actor;
+  MtkRectangle layout;
+  float scale;
+
+  if (view && paint->framebuffer == clutter_stage_view_get_framebuffer (view))
+    {
+      clutter_stage_view_get_layout (view, &layout);
+      scale = clutter_stage_view_get_scale (view);
+      graphene_matrix_init_translate (matrix,
+                                      &GRAPHENE_POINT3D_INIT (-layout.x, -layout.y, 0.f));
+      graphene_matrix_scale (matrix, scale, scale, 1.f);
+      return TRUE;
+    }
+
+  clutter_actor_get_relative_transformation_matrix (paint->actor,
+                                                    clutter_actor_get_stage (paint->actor),
+                                                    &actor_to_stage);
+  if (!graphene_matrix_inverse (&actor_to_stage, &stage_to_actor))
+    return FALSE;
+
+  graphene_matrix_multiply (&stage_to_actor, &paint->transform.actor_to_framebuffer, matrix);
+  return TRUE;
+}
+
+static CoglPipeline *
+create_piece_pipeline (MetaBackgroundPaint   *paint,
+                       CoglTexture           *texture,
+                       const graphene_rect_t *piece)
+{
+  CoglPipeline *pipeline = cogl_pipeline_new (cogl_texture_get_context (texture));
+  float alpha = paint->opacity / 255.f;
+  CoglColor color;
+
+  cogl_pipeline_set_layer_texture (pipeline, 0, texture);
+  cogl_pipeline_set_layer_filters (pipeline, 0,
+                                   COGL_PIPELINE_FILTER_LINEAR,
+                                   COGL_PIPELINE_FILTER_LINEAR);
+  cogl_pipeline_set_layer_wrap_mode (pipeline, 0,
+                                     COGL_PIPELINE_WRAP_MODE_CLAMP_TO_EDGE);
+  clutter_blur_add_framebuffer_effect (pipeline, paint->saturation, paint->noise,
+                                       piece->size.width, piece->size.height);
+  meta_background_apply_corners (paint, pipeline, piece);
+  cogl_color_init_from_4f (&color, alpha, alpha, alpha, alpha);
+  cogl_pipeline_set_color (pipeline, &color);
+  return pipeline;
+}
+
+static void
+add_piece_rectangle (ClutterPaintNode        *node,
+                     MetaBackgroundPaint     *paint,
+                     const graphene_matrix_t *to_framebuffer,
+                     const graphene_rect_t   *piece,
+                     const graphene_rect_t   *framebuffer_rect)
+{
+  gboolean flip_x = graphene_matrix_get_value (to_framebuffer, 0, 0) < 0.f;
+  gboolean flip_y = graphene_matrix_get_value (to_framebuffer, 1, 1) < 0.f;
+  ClutterActorBox actor_box;
+  graphene_rect_t shown;
+  float x1, y1, x2, y2;
+
+  if (!graphene_rect_intersection (framebuffer_rect, piece, &shown) ||
+      !meta_background_framebuffer_to_actor_box (&shown, &paint->transform, &actor_box))
+    return;
+
+  x1 = (shown.origin.x - piece->origin.x) / piece->size.width;
+  y1 = (shown.origin.y - piece->origin.y) / piece->size.height;
+  x2 = (shown.origin.x + shown.size.width - piece->origin.x) / piece->size.width;
+  y2 = (shown.origin.y + shown.size.height - piece->origin.y) / piece->size.height;
+  clutter_paint_node_add_texture_rectangle (node, &actor_box,
+                                            flip_x ? 1.f - x1 : x1,
+                                            flip_y ? 1.f - y1 : y1,
+                                            flip_x ? 1.f - x2 : x2,
+                                            flip_y ? 1.f - y2 : y2);
+}
+
+void
+meta_background_paint_wallpaper (MetaBackgroundPaint *paint,
+                                 ClutterStageView    *view)
+{
+  graphene_matrix_t to_framebuffer;
+  MtkRectangle area;
+  CoglTexture *texture;
+  unsigned int i;
+
+  if (!stage_to_framebuffer (paint, view, &to_framebuffer))
+    return;
+
+  for (i = 0; (texture = meta_compositor_get_frosted_wallpaper (paint->compositor, i, &area)); i++)
+    {
+      g_autoptr (ClutterPaintNode) node = NULL;
+      g_autoptr (CoglPipeline) pipeline = NULL;
+      graphene_rect_t piece = mtk_rectangle_to_graphene_rect (&area);
+      int j;
+
+      graphene_matrix_transform_bounds (&to_framebuffer, &piece, &piece);
+      pipeline = create_piece_pipeline (paint, texture, &piece);
+      node = clutter_pipeline_node_new (pipeline);
+      clutter_paint_node_set_static_name (node, "MetaBackgroundBlur (wallpaper)");
+
+      for (j = 0; j < mtk_region_num_rectangles (paint->paint_region); j++)
+        {
+          graphene_rect_t framebuffer_rect;
+          ClutterActorBox actor_box;
+
+          if (meta_background_paint_box (paint, j, &actor_box, &framebuffer_rect))
+            add_piece_rectangle (node, paint, &to_framebuffer, &piece, &framebuffer_rect);
+        }
+
+      clutter_paint_node_add_child (paint->root_node, node);
+    }
+}
