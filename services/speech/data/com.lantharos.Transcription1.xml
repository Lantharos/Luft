<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
 "https://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<node name="/com/lantharos/Transcription1">
  <!--
    Transcribing recordings, run in the session and started on demand, at the lowest priority, so it
    only uses the computer when nothing else wants it. It exits after half a minute with nothing to
    do, and unloads Whisper three minutes after the last request. It only reads the recordings it's
    handed, and writes nothing anywhere.
  -->
  <interface name="com.lantharos.Transcription1">
    <!-- Transcribes about two minutes of an Ogg Opus recording, mono, from `from` milliseconds, cut
         where nobody speaks. `ended` says the recording won't grow any more; until it has, speech
         running into its end is left for later. `languages` are the ones to tell apart, such as
         "sr-Latn", "de", "en" and "sq"; none means every language Whisper knows. Answers with JSON,
         the Transcribed in packages/system/speech/src/types.rs: what was said, each piece with its
         start and end in milliseconds and its language, where the next request goes on from, and
         whether the whole recording is done. Fails with com.lantharos.Transcription1.Error.NotInstalled,
         naming the model, when Whisper isn't downloaded, with
         com.lantharos.Transcription1.Error.Unsupported when the processor can't run it, and with
         com.lantharos.Transcription1.Error.Paused while the computer runs on a battery below 30% that
         isn't charging. -->
    <method name="Transcribe">
      <arg name="audio" type="h" direction="in"/>
      <arg name="from" type="t" direction="in"/>
      <arg name="ended" type="b" direction="in"/>
      <arg name="languages" type="as" direction="in"/>
      <arg name="transcribed" type="s" direction="out"/>
    </method>
  </interface>
</node>
