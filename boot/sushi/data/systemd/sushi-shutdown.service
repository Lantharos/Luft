[Unit]
Description=Show the splash while the computer shuts down
DefaultDependencies=no
ConditionKernelCommandLine=sushi
ConditionVirtualization=!container
Wants=sushi.service
After=sushi.service
Before=systemd-reboot.service systemd-poweroff.service systemd-halt.service systemd-kexec.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=-/usr/bin/sushictl show shutdown
TimeoutStartSec=6min
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
CapabilityBoundingSet=

[Install]
WantedBy=reboot.target poweroff.target halt.target kexec.target
