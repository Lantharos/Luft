 }
 
+/**
+ * clutter_pipeline_node_set_whole_pixels:
+ * @node: a #ClutterPipelineNode
+ * @whole_pixels: whether to draw on whole pixels
+ *
+ * Moves textured rectangles that map one texel to one pixel of the
+ * framebuffer onto whole pixels, so they are drawn without resampling.
+ */
+void
+clutter_pipeline_node_set_whole_pixels (ClutterPipelineNode *node,
+                                        gboolean             whole_pixels)
+{
+  g_return_if_fail (CLUTTER_IS_PIPELINE_NODE (node));
+
+  node->whole_pixels = whole_pixels;
+}
