diff --git a/src/meta/compositor.h b/src/meta/compositor.h
index 1e29fb506a3153e0133e11da211818011bdbacca..88ed52b72b212ca899f0a8fdd7ef7398018fee81 100644
--- a/src/meta/compositor.h
+++ b/src/meta/compositor.h
@@ -126,12 +126,15 @@ void meta_compositor_get_background_blur_params (MetaCompositor *compositor,
  * @META_GLASS_STYLE_NIKO: glass blurs what is behind it, or only the
  *   wallpaper whenever Luca does, and takes the luminosity and some of the
  *   hue of the Niko tint, like Acrylic, see meta_compositor_set_niko_tint()
+ * @META_GLASS_STYLE_VESA: glass blurs like Luca and catches light along
+ *   the edges of its window, like liquid glass
  */
 typedef enum
 {
   META_GLASS_STYLE_LUCA,
   META_GLASS_STYLE_MARIS,
   META_GLASS_STYLE_NIKO,
+  META_GLASS_STYLE_VESA,
 } MetaGlassStyle;
 
 /**
@@ -139,11 +142,13 @@ typedef enum
  * @META_WALLPAPER_FROST_BLURRED: the wallpaper blurred like Luca glass
  * @META_WALLPAPER_FROST_WIDE: the wallpaper blurred so wide that only its
  *   colours are left, for Maris
+ * @META_WALLPAPER_FROST_CLEAR: the wallpaper barely softened, for Vesa
  */
 typedef enum
 {
   META_WALLPAPER_FROST_BLURRED,
   META_WALLPAPER_FROST_WIDE,
+  META_WALLPAPER_FROST_CLEAR,
 } MetaWallpaperFrost;
 
 META_EXPORT
diff --git a/src/wayland/meta-wayland-kestrel-glass.c b/src/wayland/meta-wayland-kestrel-glass.c
index 39bba81bc5e17df9082a16f97f616f30318784e2..f111b5b368fe0466a22c40b6c8a08527c4dc78f1 100644
--- a/src/wayland/meta-wayland-kestrel-glass.c
+++ b/src/wayland/meta-wayland-kestrel-glass.c
@@ -48,6 +48,9 @@ material_of (MetaGlassMaterial material)
     case META_GLASS_MATERIAL_NIKO:
     case META_GLASS_MATERIAL_NIKO_WALLPAPER:
       return KESTREL_GLASS_V1_MATERIAL_NIKO;
+    case META_GLASS_MATERIAL_VESA:
+    case META_GLASS_MATERIAL_VESA_WALLPAPER:
+      return KESTREL_GLASS_V1_MATERIAL_VESA;
     case META_GLASS_MATERIAL_LIVE:
     case META_GLASS_MATERIAL_WALLPAPER:
       break;
@@ -160,6 +163,9 @@ glass_set_preference (struct wl_client   *client,
     case KESTREL_GLASS_V1_PREFERENCE_NIKO:
       set_preference (glass, META_GLASS_PREFERENCE_NIKO);
       break;
+    case KESTREL_GLASS_V1_PREFERENCE_VESA:
+      set_preference (glass, META_GLASS_PREFERENCE_VESA);
+      break;
     default:
       set_preference (glass, META_GLASS_PREFERENCE_USER);
       break;
diff --git a/src/wayland/protocol/kestrel-glass-v1.xml b/src/wayland/protocol/kestrel-glass-v1.xml
index 8f51209a4be7bf4437890e493b680d9aa1e07c38..0fe97f444b85ab4264d870eb4c0ce705500db981 100644
--- a/src/wayland/protocol/kestrel-glass-v1.xml
+++ b/src/wayland/protocol/kestrel-glass-v1.xml
@@ -26,16 +26,18 @@
   <interface name="kestrel_glass_manager_v1" version="1">
     <description summary="the material of a surface's glass">
       Glass is the part of a surface a client asks to blur through
-      ext_background_effect_v1. Kestrel draws it as one of three materials:
+      ext_background_effect_v1. Kestrel draws it as one of four materials:
       Luca, a blur of what is behind the surface or only of the wallpaper;
       Maris, the desktop's surface colour over a wide blur of the wallpaper
-      that covers most of it; and Niko, a blur of what is behind the surface
-      that takes the lightness of the surface colour.
+      that covers most of it; Niko, a blur of what is behind the surface
+      that takes the lightness of the surface colour; and Vesa, Luca's blur
+      with light caught along the window's edges.
 
       Through a glass object, a client says what kind of surface the glass
       belongs to and which material it would like, and hears which material
-      the glass has. A client draws its own tint over Luca glass, and none
-      over Maris or Niko glass, which already are the whole surface.
+      the glass has. A client draws its own tint over Luca and Vesa glass,
+      and none over Maris or Niko glass, which already are the whole
+      surface.
     </description>
 
     <enum name="error">
@@ -80,6 +82,7 @@
       <entry name="luca" value="1" summary="Luca"/>
       <entry name="maris" value="2" summary="Maris"/>
       <entry name="niko" value="3" summary="Niko"/>
+      <entry name="vesa" value="4" summary="Vesa"/>
     </enum>
 
     <enum name="material">
@@ -89,6 +92,8 @@
              summary="the surface colour over a wide blur of the wallpaper"/>
       <entry name="niko" value="2"
              summary="a blur of what is behind, or of the wallpaper only, in the lightness of the surface colour"/>
+      <entry name="vesa" value="3"
+             summary="a blur of what is behind, or of the wallpaper only, that catches light along the window's edges"/>
     </enum>
 
     <request name="destroy" type="destructor">
@@ -105,8 +110,8 @@
 
     <request name="set_preference">
       <description summary="ask for a material">
-        Maris is always granted. Luca and Niko are granted too, and then blur
-        only the wallpaper whenever the person's Luca glass does, such as
+        Maris is always granted. Luca, Niko and Vesa are granted too, and then
+        blur only the wallpaper whenever the person's Luca glass does, such as
         while the power saver is on. The default is user.
       </description>
       <arg name="preference" type="uint" enum="preference"/>
