# The name of the extension in Settings and the store
extension-name = Phosphor
extension-description = Rice the whole desktop: borders, glow, CRT, colour fringes and open and close effects on windows, filters, bloom and chromatic aberration over the screen, and lines across the taskbar and Luft's apps
off = Off
normal = Normal
accent = Accent
phosphor-green = Phosphor green
amber = Amber
neon-pink = Neon pink
ice = Ice
strength = Strength
# Section of the page about the shortcut that turns everything off
safety = If the screen becomes hard to read
safety-detail = This shortcut works everywhere, even when nothing on the screen can be read. It turns off everything every extension draws, until you turn it back on. Phosphor draws over everything on your screen, on your computer only, and it turns off by itself if a shader fails or the desktop gets very slow.
safety-shortcut = Turn every effect off
safety-no-shortcut = Not set
safety-off = Effects are turned off
safety-turn-on = Turn back on
section-windows = Windows
border = Border
    .description = Drawn around each window, following its corners. It doesn't touch what's in the window.
# Border style: one colour
border-color-style = One colour
border-gradient = Gradient
border-glow = Glow
border-first-color = Colour
border-second-color = Second colour
border-width = Width
border-motion = Movement
still = Still
flow = Flowing
pulse = Pulsing
border-focused = Only on the focused window
overlay = Overlay
    .description = Drawn on top of each window. It doesn't read what's in the window.
scanlines = Scanlines
tint = Tint
grain = Film grain
vignette = Vignette
crt-border = CRT border
window-crt = CRT in windows
    .description = How strong it is. It runs inside the pixels of the apps you pick below, and costs some memory for each window.
window-aberration = Chromatic aberration in windows
    .description = How strong it is. Red and blue drift apart towards the edges of the window. It runs inside the pixels of the apps you pick below, and costs some memory for each window.
open-effect = When a window opens
close-effect = When a window closes
glitch = Glitch
fold = Fold
dissolve = Dissolve
burn = Burn
# A CRT screen powering on or off
crt-power = CRT power
windows-fullscreen = Keep on fullscreen windows
    .description = Off keeps games and videos going straight to the screen, as fast as they can. On, every frame goes through the desktop first, which costs games speed.
section-rules = Apps
section-rules-detail = Pick what goes on every app, then make exceptions.
everywhere-border = Border on every app
everywhere-overlay = Overlay on every app
everywhere-crt = CRT on every app
everywhere-aberration = Chromatic aberration on every app
everywhere-motion = Open and close effects on every app
rules-empty = No exceptions yet
# Buttons on an app's exception; $part is the name of an effect, such as Border
rule-on = { $part }: on
rule-off = { $part }: off
rule-motion = Open and close effects
rule-remove = Remove
rule-add = Add an exception
rule-add-pick = Choose an app
section-desktop = Whole screen
section-desktop-detail = Filters go over everything on a display, after the desktop is drawn. They stay off on the lock screen.
desktop-crt = CRT
crt-scanlines = Scanlines
crt-curvature = Curvature
    .description = Bends the picture like a tube. The pointer bends with it, so it's drawn by the desktop and moving it redraws the screen.
crt-mask = Phosphor mask
crt-flicker = Flicker
    .description = Moves all the time, so the screen redraws 30 times a second. It rests after 30 seconds without input.
invert = Invert
invert-colors = Colours
invert-lightness = Lightness, keeping hues
grade = Colour grade
grade-warm = Warm
grade-cold = Cold
grade-teal-orange = Teal and orange
grade-noir = Noir
grade-sepia = Sepia
grade-vivid = Vivid
shadow-boost = Shadow boost
    .description = Lifts dark areas so you can see into them.
bloom = Bloom
    .description = Bright parts of the screen glow into what's around them.
chromatic-aberration = Chromatic aberration
    .description = Red and blue drift apart towards the edges of the screen, like a cheap lens. It looks the same at every display scale.
filters-fullscreen = Keep on fullscreen windows
    .description = Off takes filters away while something runs fullscreen on that display, so games stay fast. On, every frame of a game goes through the filter, which costs speed.
filters-captured = Show in screenshots and recordings
    .description = Off keeps them out, like night light. Borders and other window effects always show.
desktop-filters = Screen filter
section-surfaces = Luft's own surfaces
section-surfaces-detail = Lines across the taskbar and panels, and in Luft's apps, which draw them with their own styles. Other apps aren't touched.
