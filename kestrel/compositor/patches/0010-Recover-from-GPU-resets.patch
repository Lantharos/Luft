+ * Authored By Toluwaleke Ogundipe <anonymoux47@gmail.com>
+ */
+
+/**
+ * ClutterGraphicsRecoveryContext:
+ *
+ * Graphics recovery context
+ *
+ * Graphics resets occur when the GPU hardware or driver encounters an
+ * unrecoverable hang or fault, forcing it to reset its state. During this
+ * event, existing GPU contexts and all allocated GPU memory are lost.
+ * To prevent a session-ending crash or freeze, the compositor must safely
+ * go through a recovery cycle to recreate the lost contexts and resources.
+ *
+ * #ClutterGraphicsRecoveryContext manages the internal state machine and
+ * asynchronous tracking necessary to execute this recovery cycle. It ensures
+ * the compositor gracefully survives these faults by driving the graphics
+ * pipeline back to a stable, rendering state. It provides a basic API to
+ * query the state of the cycle.
+ */
+
+#include "config.h"
+
+#include "clutter/clutter-graphics-recovery-context.h"
+
+#include "clutter/clutter-backend.h"
+#include "clutter/clutter-debug.h"
+#include "clutter/clutter-private.h"
+
+#define GRAPHICS_RESET_TIMEOUT_US (G_USEC_PER_SEC * 2)  /* 2 seconds */
+#define GRAPHICS_RESET_POLL_INTERVAL_MS 20  /* 0.02 seconds */
+#define GRAPHICS_RESTORE_TIMEOUT_US (G_USEC_PER_SEC * 2)  /* 2 seconds */
+#define GRAPHICS_RESTORE_RETRY_INTERVAL_MS 20  /* 0.02 seconds */
+#define GRAPHICS_RECOVERY_TIMEOUT_PRIORITY (G_PRIORITY_HIGH + 5)
+#define GRAPHICS_RECOVERY_IDLE_PRIORITY (G_PRIORITY_HIGH_IDLE + 5)
+
+enum
+{
+  PROP_0,
+  PROP_BACKEND,
+  N_PROPS
+};
+
+static GParamSpec *obj_props[N_PROPS];
+
+enum
+{
+  /* Reset */
+  RESET_DETECTED,
+  RESET_COMPLETED,
+
+  /* Restoration */
+  UNREALIZE_GRAPHICS,
+  RECREATE_CONTEXT,
+  REALIZE_GRAPHICS,
+
+  /* Outcome */
+  GRAPHICS_RESTORED,
+  RECOVERY_FAILED,
+
+  N_SIGNALS
+};
+
+static guint signals[N_SIGNALS] = { 0 };
+
+struct _ClutterGraphicsRecoveryContext
+{
+  GObject parent_instance;
+
+  ClutterBackend *backend;
+
+  ClutterGraphicsRecoveryState state;
+  unsigned int source_id;
+  int64_t phase_start_time_us;
+};
+
+G_DEFINE_TYPE (ClutterGraphicsRecoveryContext,
+               clutter_graphics_recovery_context,
+               G_TYPE_OBJECT)
+
+static gboolean
+signal_accumulator_fail_fast (GSignalInvocationHint *ihint,
+                              GValue                *return_accu,
+                              const GValue          *handler_return,
+                              gpointer               data)
+{
+  gboolean success;
+
+  success = g_value_get_boolean (handler_return);
+  g_value_set_boolean (return_accu, success);
+
+  return success;
+}
+
+static void
+clutter_graphics_recovery_context_finalize (GObject *object)
+{
+  ClutterGraphicsRecoveryContext *self =
+    CLUTTER_GRAPHICS_RECOVERY_CONTEXT (object);
+
+  g_clear_handle_id (&self->source_id, mtk_source_remove);
+
+  G_OBJECT_CLASS (clutter_graphics_recovery_context_parent_class)->
+    finalize (object);
+}
+
+static void
+clutter_graphics_recovery_context_set_property (GObject      *object,
+                                                guint         prop_id,
+                                                const GValue *value,
+                                                GParamSpec   *pspec)
+{
+  ClutterGraphicsRecoveryContext *self =
+    CLUTTER_GRAPHICS_RECOVERY_CONTEXT (object);
+
+  switch (prop_id)
+    {
+    case PROP_BACKEND:
+      self->backend = g_value_get_object (value);
+      break;
+    default:
+      G_OBJECT_WARN_INVALID_PROPERTY_ID (object, prop_id, pspec);
+      break;
+    }
+}
+
+static void
+clutter_graphics_recovery_context_class_init (ClutterGraphicsRecoveryContextClass *klass)
+{
+  GObjectClass *object_class = G_OBJECT_CLASS (klass);
+
+  object_class->finalize = clutter_graphics_recovery_context_finalize;
+  object_class->set_property = clutter_graphics_recovery_context_set_property;
+
+  /**
+   * ClutterGraphicsRecoveryContext:backend:
+   *
+   * The #ClutterBackend associated with the graphics recovery context.
+   */
+  obj_props[PROP_BACKEND] =
+    g_param_spec_object ("backend", NULL, NULL,
+                         CLUTTER_TYPE_BACKEND,
+                         G_PARAM_WRITABLE |
+                         G_PARAM_CONSTRUCT_ONLY |
+                         G_PARAM_STATIC_STRINGS);
+
+  g_object_class_install_properties (object_class, N_PROPS, obj_props);
+
+  /**
+   * ClutterGraphicsRecoveryContext::reset-detected:
+   * @context: the #ClutterGraphicsRecoveryContext that emitted the signal
+   *
+   * The signal is emitted when a graphics reset is first detected.
+   */
+  signals[RESET_DETECTED] =
+    g_signal_new (I_("reset-detected"),
+                  G_TYPE_FROM_CLASS (klass),
+                  G_SIGNAL_RUN_LAST,
+                  0,
+                  NULL, NULL, NULL,
+                  G_TYPE_NONE, 0);
+
+  /**
+   * ClutterGraphicsRecoveryContext::reset-completed:
+   * @context: the #ClutterGraphicsRecoveryContext that emitted the signal
+   *
+   * The signal is emitted when the GPU finishes resetting, before commencing
+   * restoration.
+   */
+  signals[RESET_COMPLETED] =
+    g_signal_new (I_("reset-completed"),
+                  G_TYPE_FROM_CLASS (klass),
+                  G_SIGNAL_RUN_LAST,
+                  0,
+                  NULL, NULL, NULL,
+                  G_TYPE_NONE, 0);
+
+  /**
+   * ClutterGraphicsRecoveryContext::unrealize-graphics:
+   * @context: the #ClutterGraphicsRecoveryContext that emitted the signal
+   *
+   * The signal is emitted to destroy GPU-associated objects/resources.
+   *
+   * ::: note
+   *     New graphics resources should be created via the `realize-graphics`
+   *     signal.
+   *
+   * ::: tip
+   *     For [class@Clutter.Actor]s, implement the `unrealize()` virtual method
+   *     instead of listening for this signal.
+   */
+  signals[UNREALIZE_GRAPHICS] =
+    g_signal_new (I_("unrealize-graphics"),
+                  G_TYPE_FROM_CLASS (klass),
+                  G_SIGNAL_RUN_LAST,
+                  0,
+                  NULL, NULL, NULL,
+                  G_TYPE_NONE, 0);
+
+  /**
+   * ClutterGraphicsRecoveryContext::recreate-context: (skip)
+   * @context: the #ClutterGraphicsRecoveryContext that emitted the signal
+   * @error: (nullable): return location for a #GError
+   *
+   * The signal is emitted to recreate the graphics context, e.g the
+   * `EGLContext` (for the EGL backend) and the `CoglContext`.
+   *
+   * Handlers must return %TRUE on success, otherwise %FALSE. If a handler
+   * returns %FALSE, the emission stops immediately.
+   *
+   * Returns: %TRUE if all handlers succeeded, otherwise %FALSE.
+   */
+  signals[RECREATE_CONTEXT] =
+    g_signal_new (I_("recreate-context"),
+                  G_TYPE_FROM_CLASS (klass),
+                  G_SIGNAL_RUN_LAST,
+                  0,
+                  signal_accumulator_fail_fast, NULL,
+                  NULL,
+                  G_TYPE_BOOLEAN,
+                  1,
+                  G_TYPE_POINTER);
+
+  /**
+   * ClutterGraphicsRecoveryContext::realize-graphics:
+   * @context: the #ClutterGraphicsRecoveryContext that emitted the signal
+   *
+   * The signal is emitted to recreate/reupload GPU-associated
+   * objects/resources.
+   *
+   * ::: note
+   *     Old (invalid) graphics resources should be destroyed via the
+   *     `unrealize-graphics` signal.
+   *
+   * ::: tip
+   *     For [class@Clutter.Actor]s, implement the `realize()` virtual method
+   *     instead of listening for this signal.
+   */
+  signals[REALIZE_GRAPHICS] =
+    g_signal_new (I_("realize-graphics"),
+                  G_TYPE_FROM_CLASS (klass),
+                  G_SIGNAL_RUN_LAST,
+                  0,
+                  NULL, NULL, NULL,
+                  G_TYPE_NONE, 0);
+
+  /**
+   * ClutterGraphicsRecoveryContext::graphics-restored:
+   * @context: the #ClutterGraphicsRecoveryContext that emitted the signal
+   *
+   * The signal is emitted when the graphics pipeline has been successfully
+   * restored.
+   */
+  signals[GRAPHICS_RESTORED] =
+    g_signal_new (I_("graphics-restored"),
+                  G_TYPE_FROM_CLASS (klass),
+                  G_SIGNAL_RUN_LAST,
+                  0,
+                  NULL, NULL, NULL,
+                  G_TYPE_NONE, 0);
+
+  /**
+   * ClutterGraphicsRecoveryContext::recovery-failed:
+   * @context: the #ClutterGraphicsRecoveryContext that emitted the signal
+   * @error: the #GError that resulted in recovery failure
+   *
+   * The signal is emitted when graphics recovery fails.
+   */
+  signals[RECOVERY_FAILED] =
+    g_signal_new (I_("recovery-failed"),
+                  G_TYPE_FROM_CLASS (klass),
+                  G_SIGNAL_RUN_LAST,
+                  0,
+                  NULL, NULL, NULL,
+                  G_TYPE_NONE,
+                  1,
+                  G_TYPE_ERROR);
+}
+
+static void
+clutter_graphics_recovery_context_init (ClutterGraphicsRecoveryContext *self)
+{
+}
+
+/**
+ * clutter_graphics_recovery_context_get_state:
+ * @context: a #ClutterGraphicsRecoveryContext
+ *
+ * Determines the current graphics recovery state.
+ *
+ * Returns: The current graphics recovery state.
+ */
+ClutterGraphicsRecoveryState
+clutter_graphics_recovery_context_get_state (ClutterGraphicsRecoveryContext *context)
+{
+  ClutterGraphicsRecoveryState current_state;
+  CoglContext *cogl_context;
+  CoglDriver *cogl_driver;
+  ClutterGraphicsRecoveryState new_state;
+  CoglGraphicsResetStatus status;
+
+  g_return_val_if_fail (CLUTTER_IS_GRAPHICS_RECOVERY_CONTEXT (context),
+                        CLUTTER_GRAPHICS_RECOVERY_STATE_NORMAL);
+
+  current_state = context->state;
+  switch (current_state)
+    {
+    case CLUTTER_GRAPHICS_RECOVERY_STATE_NORMAL:
+    case CLUTTER_GRAPHICS_RECOVERY_STATE_RESET_IN_PROGRESS:
+      break;
+
+    case CLUTTER_GRAPHICS_RECOVERY_STATE_RESET_COMPLETED:
+    case CLUTTER_GRAPHICS_RECOVERY_STATE_RESTORING:
+    case CLUTTER_GRAPHICS_RECOVERY_STATE_FAILED:
+      return current_state;
+    }
+
+  cogl_context = clutter_backend_get_cogl_context (context->backend);
+  cogl_driver = cogl_context_get_driver (cogl_context);
+  new_state = current_state;
+
+  status = cogl_driver_get_graphics_reset_status (cogl_driver);
+  switch (status)
+    {
+    case COGL_GRAPHICS_RESET_STATUS_PURGED_CONTEXT_RESET:
+    case COGL_GRAPHICS_RESET_STATUS_GUILTY_CONTEXT_RESET:
+    case COGL_GRAPHICS_RESET_STATUS_INNOCENT_CONTEXT_RESET:
+    case COGL_GRAPHICS_RESET_STATUS_UNKNOWN_CONTEXT_RESET:
+      new_state = CLUTTER_GRAPHICS_RECOVERY_STATE_RESET_IN_PROGRESS;
+      break;
+
+    case COGL_GRAPHICS_RESET_STATUS_NO_ERROR:
+      if (current_state == CLUTTER_GRAPHICS_RECOVERY_STATE_RESET_IN_PROGRESS)
+        new_state = CLUTTER_GRAPHICS_RECOVERY_STATE_RESET_COMPLETED;
+      else
+        new_state = CLUTTER_GRAPHICS_RECOVERY_STATE_NORMAL;
+      break;
+    }
+
+  if (new_state != current_state)
+    {
+      context->state = new_state;
+
+      if (new_state == CLUTTER_GRAPHICS_RECOVERY_STATE_RESET_IN_PROGRESS)
+        {
+          g_message ("Graphics reset detected");
+          g_signal_emit (context, signals[RESET_DETECTED], 0);
+        }
+      else if (new_state == CLUTTER_GRAPHICS_RECOVERY_STATE_RESET_COMPLETED)
+        {
+          CLUTTER_NOTE (RECOVERY, "Graphics reset completed");
+          g_signal_emit (context, signals[RESET_COMPLETED], 0);
+        }
+    }
+
+  return new_state;
+}
+
+/**
+ * restore_graphics:
+ * @context: a #ClutterGraphicsRecoveryContext
+ * @error: (nullable): return location for a #GError
+ *
+ * Completes the graphics pipeline restoration.
+ *
+ * Returns: %TRUE if restoration succeeds, otherwise %FALSE.
+ */
+static gboolean
+restore_graphics (ClutterGraphicsRecoveryContext  *context,
+                  GError                         **error)
+{
+  gboolean success = TRUE;
+
+  CLUTTER_NOTE (RECOVERY, "Recreating graphics context");
+  g_signal_emit (context, signals[RECREATE_CONTEXT], 0, error, &success);
+  if (!success)
+    return FALSE;
+
+  CLUTTER_NOTE (RECOVERY, "Realizing graphics resources");
+  g_signal_emit (context, signals[REALIZE_GRAPHICS], 0);
+
+  return TRUE;
+}
+
+/**
+ * do_recovery_failed:
+ * @context: a #ClutterGraphicsRecoveryContext
+ * @error: the #GError that resulted in recovery failure
+ *
+ * Performs necessary actions when graphics recovery fails.
+ */
+static void
+do_recovery_failed (ClutterGraphicsRecoveryContext *context,
+                    GError                         *error)
+{
+  CLUTTER_NOTE (RECOVERY, "Graphics recovery failed");
+  context->state = CLUTTER_GRAPHICS_RECOVERY_STATE_FAILED;
+  g_signal_emit (context, signals[RECOVERY_FAILED], 0, error);
+}
+
+static gboolean
+try_restore_graphics_cb (ClutterGraphicsRecoveryContext *context)
+{
+  g_autoptr (GError) error = NULL;
+
+  g_assert (context->state == CLUTTER_GRAPHICS_RECOVERY_STATE_RESTORING);
+
+  if ((g_get_monotonic_time () - context->phase_start_time_us) >=
+      GRAPHICS_RESTORE_TIMEOUT_US)
+    {
+      error = g_error_new (G_IO_ERROR,
+                           G_IO_ERROR_FAILED,
+                           "Graphics restoration timed out");
+      do_recovery_failed (context, error);
+
+      context->source_id = 0;
+      context->phase_start_time_us = 0;
+
+      return G_SOURCE_REMOVE;
+    }
+
+  if (restore_graphics (context, &error))
+    {
+      g_message ("Graphics recovery successful");
+      context->state = CLUTTER_GRAPHICS_RECOVERY_STATE_NORMAL;
+      g_signal_emit (context, signals[GRAPHICS_RESTORED], 0);
+
+      context->source_id = 0;
+      context->phase_start_time_us = 0;
+
+      return G_SOURCE_REMOVE;
+    }
+
+  CLUTTER_NOTE (RECOVERY,
+                "Graphics restoration attempt failed: %s",
+                (error != NULL ? error->message : "Cause unknown"));
+
+  return G_SOURCE_CONTINUE;
+}
+
+static gboolean
+start_restore_graphics_cb (ClutterGraphicsRecoveryContext *context)
+{
+  g_assert (context->state == CLUTTER_GRAPHICS_RECOVERY_STATE_RESET_COMPLETED);
+
+  context->state = CLUTTER_GRAPHICS_RECOVERY_STATE_RESTORING;
+  context->phase_start_time_us = g_get_monotonic_time ();
+
+  CLUTTER_NOTE (RECOVERY, "Unrealizing graphics resources");
+  g_signal_emit (context, signals[UNREALIZE_GRAPHICS], 0);
+
+  if (try_restore_graphics_cb (context) == G_SOURCE_CONTINUE)
+    {
+      context->source_id =
+        mtk_timeout_add_full (GRAPHICS_RECOVERY_TIMEOUT_PRIORITY,
+                              GRAPHICS_RESTORE_RETRY_INTERVAL_MS,
+                              (GSourceFunc)try_restore_graphics_cb,
+                              context,
+                              NULL);
+    }
+
+  return G_SOURCE_REMOVE;
+}
+
+static gboolean
+poll_graphics_reset_completed_cb (ClutterGraphicsRecoveryContext *context)
+{
+  ClutterGraphicsRecoveryState state;
+
+  g_assert (context->state == CLUTTER_GRAPHICS_RECOVERY_STATE_RESET_IN_PROGRESS ||
+            /* `clutter_graphics_recovery_context_get_state()` could've been
+             * called somewhere else since this callback's source was added,
+             * possibly advancing the state. */
+            context->state == CLUTTER_GRAPHICS_RECOVERY_STATE_RESET_COMPLETED);
+
+  if ((g_get_monotonic_time () - context->phase_start_time_us) >=
+      GRAPHICS_RESET_TIMEOUT_US)
+    {
+      CLUTTER_NOTE (RECOVERY,
+                    "Graphics reset timed out, but will try to restore anyway");
+      context->state = CLUTTER_GRAPHICS_RECOVERY_STATE_RESET_COMPLETED;
+      g_signal_emit (context, signals[RESET_COMPLETED], 0);
+    }
+
+  state = clutter_graphics_recovery_context_get_state (context);
+  switch (state)
+    {
+    case CLUTTER_GRAPHICS_RECOVERY_STATE_NORMAL:
+      g_assert_not_reached ();
+      break;
+
+    case CLUTTER_GRAPHICS_RECOVERY_STATE_RESET_IN_PROGRESS:
+      return G_SOURCE_CONTINUE;
+
+    case CLUTTER_GRAPHICS_RECOVERY_STATE_RESET_COMPLETED:
+      start_restore_graphics_cb (context);
+      break;
+
+    case CLUTTER_GRAPHICS_RECOVERY_STATE_RESTORING:
+    case CLUTTER_GRAPHICS_RECOVERY_STATE_FAILED:
+      g_assert_not_reached ();
+      break;
+    }
+
+  return G_SOURCE_REMOVE;
+}
+
+/**
+ * start_recovery:
+ * @context: a #ClutterGraphicsRecoveryContext
+ *
+ * Initiates graphics recovery.
+ */
+static void
+start_recovery (ClutterGraphicsRecoveryContext *context)
+{
+  ClutterGraphicsRecoveryState state;
+
+  g_assert (context->source_id == 0);
+  g_assert (context->phase_start_time_us == 0);
+
+  state = clutter_graphics_recovery_context_get_state (context);
+  switch (state)
+    {
+    case CLUTTER_GRAPHICS_RECOVERY_STATE_NORMAL:
+      g_assert_not_reached ();
+      break;
+
+    case CLUTTER_GRAPHICS_RECOVERY_STATE_RESET_IN_PROGRESS:
+      context->source_id =
+        mtk_timeout_add_full (GRAPHICS_RECOVERY_TIMEOUT_PRIORITY,
+                              GRAPHICS_RESET_POLL_INTERVAL_MS,
+                              (GSourceFunc)poll_graphics_reset_completed_cb,
+                              context,
+                              NULL);
+      break;
+
+    case CLUTTER_GRAPHICS_RECOVERY_STATE_RESET_COMPLETED:
+      context->source_id =
+        mtk_idle_add_full (GRAPHICS_RECOVERY_IDLE_PRIORITY,
+                           (GSourceFunc)start_restore_graphics_cb,
+                           context,
+                           NULL);
+      break;
+
+    case CLUTTER_GRAPHICS_RECOVERY_STATE_RESTORING:
+    case CLUTTER_GRAPHICS_RECOVERY_STATE_FAILED:
+      g_assert_not_reached ();
+      break;
+    }
+
+  context->phase_start_time_us = g_get_monotonic_time ();
+}
+
+/**
+ * clutter_graphics_recovery_context_is_in_progress:
+ * @context: a #ClutterGraphicsRecoveryContext
+ *
+ * Checks whether graphics recovery is in progress.
+ *
+ * ::: note
+ *     If recovery is not already in progress and a graphics reset is detected,
+ *     the recovery cycle is started.
+ *
+ * Returns: %TRUE if graphics recovery is in progress, otherwise %FALSE.
+ */
+gboolean
+clutter_graphics_recovery_context_is_in_progress (ClutterGraphicsRecoveryContext *context)
+{
+  ClutterGraphicsRecoveryState state;
+
+  g_return_val_if_fail (CLUTTER_IS_GRAPHICS_RECOVERY_CONTEXT (context), FALSE);
+
+  if (context->source_id)
+    return TRUE;
+
+  state = clutter_graphics_recovery_context_get_state (context);
+  switch (state)
+    {
+    case CLUTTER_GRAPHICS_RECOVERY_STATE_NORMAL:
+      return FALSE;
+
+    case CLUTTER_GRAPHICS_RECOVERY_STATE_RESET_IN_PROGRESS:
+    case CLUTTER_GRAPHICS_RECOVERY_STATE_RESET_COMPLETED:
+      start_recovery (context);
+      G_GNUC_FALLTHROUGH;
+
+    case CLUTTER_GRAPHICS_RECOVERY_STATE_RESTORING:
+    case CLUTTER_GRAPHICS_RECOVERY_STATE_FAILED:
+      return TRUE;
+    }
+
+  g_assert_not_reached ();
+}
