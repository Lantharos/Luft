[Unit]
Description=Offer NVIDIA's driver when an NVIDIA graphics card is new to this computer
After=kestrel-session.target graphical-session.target
PartOf=graphical-session.target
ConditionUser=!@system

[Service]
Type=exec
ExecStart=/usr/bin/settings --check-graphics
Nice=10

[Install]
WantedBy=kestrel-session.target
