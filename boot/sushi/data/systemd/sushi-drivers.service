[Unit]
Description=Load the graphics drivers the boot splash takes over
Documentation=https://github.com/Lantharos/Luft/tree/main/boot/sushi
DefaultDependencies=no
After=sushi.service akmods.service
Before=display-manager.service greetd.service
ConditionPathExists=!/etc/initrd-release

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/sushictl load-drivers
TimeoutStartSec=90
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service @module
CapabilityBoundingSet=CAP_SYS_MODULE

[Install]
WantedBy=sysinit.target
