 /**
  * meta_compositor_set_background_blur_params:
  * @compositor: a #MetaCompositor
@@ -1530,7 +1560,6 @@ meta_compositor_set_background_blur_params (MetaCompositor *compositor,
                                             float           noise)
 {
   MetaCompositorPrivate *priv;
-  GList *l;
 
   g_return_if_fail (META_IS_COMPOSITOR (compositor));
   g_return_if_fail (blur_radius >= 0.0f);
@@ -1548,8 +1577,115 @@ meta_compositor_set_background_blur_params (MetaCompositor *compositor,
   priv->background_saturation = saturation;
   priv->background_noise = noise;
 
-  for (l = priv->windows; l; l = l->next)
-    meta_window_actor_invalidate_background_blur (l->data);
+  invalidate_background_blurs (compositor);
+}
+
+/**
+ * meta_compositor_clear_frosted_wallpaper:
+ * @compositor: a #MetaCompositor
+ *
+ * Forgets every piece of frosted wallpaper.
+ */
+void
+meta_compositor_clear_frosted_wallpaper (MetaCompositor *compositor)
+{
+  MetaCompositorPrivate *priv =
+    meta_compositor_get_instance_private (compositor);
+
+  if (priv->frosted_wallpaper->len == 0)
+    return;
+
+  g_array_set_size (priv->frosted_wallpaper, 0);
+  if (priv->background_blur_from_wallpaper)
+    invalidate_background_blurs (compositor);
+}
+
+/**
+ * meta_compositor_add_frosted_wallpaper:
+ * @compositor: a #MetaCompositor
+ * @area: the part of the stage @texture covers, usually a monitor
+ * @texture: the blurred wallpaper of that area
+ *
+ * Adds a piece of blurred wallpaper that background effects show instead
+ * of blurring what is behind them, while
+ * meta_compositor_set_background_blur_from_wallpaper() says so.
+ */
+void
+meta_compositor_add_frosted_wallpaper (MetaCompositor     *compositor,
+                                       const MtkRectangle *area,
+                                       CoglTexture        *texture)
+{
+  MetaCompositorPrivate *priv =
+    meta_compositor_get_instance_private (compositor);
+  FrostedWallpaperPiece piece = { *area, g_object_ref (texture) };
+
+  g_array_append_val (priv->frosted_wallpaper, piece);
+  if (priv->background_blur_from_wallpaper)
+    invalidate_background_blurs (compositor);
+}
+
+/**
+ * meta_compositor_get_frosted_wallpaper: (skip)
+ * @compositor: a #MetaCompositor
+ * @index: which piece
+ * @area: (out): the part of the stage the piece covers
+ *
+ * Returns: (transfer none) (nullable): the piece's texture, or %NULL past
+ *   the last piece
+ */
+CoglTexture *
+meta_compositor_get_frosted_wallpaper (MetaCompositor *compositor,
+                                       unsigned int    index,
+                                       MtkRectangle   *area)
+{
+  MetaCompositorPrivate *priv =
+    meta_compositor_get_instance_private (compositor);
+  FrostedWallpaperPiece *piece;
+
+  if (index >= priv->frosted_wallpaper->len)
+    return NULL;
+
+  piece = &g_array_index (priv->frosted_wallpaper, FrostedWallpaperPiece, index);
+  *area = piece->area;
+  return piece->texture;
+}
+
+/**
+ * meta_compositor_set_background_blur_from_wallpaper:
+ * @compositor: a #MetaCompositor
+ * @from_wallpaper: whether background effects show the frosted wallpaper
+ *
+ * Lets background effects requested through ext-background-effect-v1 show
+ * the frosted wallpaper under the window instead of blurring what is
+ * behind it.
+ */
+void
+meta_compositor_set_background_blur_from_wallpaper (MetaCompositor *compositor,
+                                                    gboolean        from_wallpaper)
+{
+  MetaCompositorPrivate *priv =
+    meta_compositor_get_instance_private (compositor);
+
+  if (priv->background_blur_from_wallpaper == from_wallpaper)
+    return;
+
+  priv->background_blur_from_wallpaper = from_wallpaper;
+  invalidate_background_blurs (compositor);
+}
+
+/**
+ * meta_compositor_get_background_blur_from_wallpaper:
+ * @compositor: a #MetaCompositor
+ *
+ * Returns: whether background effects show the frosted wallpaper
+ */
+gboolean
+meta_compositor_get_background_blur_from_wallpaper (MetaCompositor *compositor)
+{
+  MetaCompositorPrivate *priv =
+    meta_compositor_get_instance_private (compositor);
+
+  return priv->background_blur_from_wallpaper && priv->frosted_wallpaper->len > 0;
 }
 
