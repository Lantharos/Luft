<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
 "https://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<node name="/com/lantharos/Installer1">
  <!--
    Installing Luft from the live system, and finishing first-run setup on the installed one.

    Phase: "live" (started from the USB stick), "handover" (installed for someone else, and whoever installed
      it is still finishing), "unclaimed" (waiting for its owner to set it up), "first-boot" (installed, the
      account's setup still pending) or "installed".
    Stage: "idle", "preparing" (making room and partitions), "copying", "waiting" (copied, waiting for the
      account and regional settings), "configuring", "finished" or "failed" (Error says why).
    Progress: 0 to 1 over the whole install.
    SecureBootCode: once finished, the code to type when the computer next starts so Secure Boot trusts Luft's
      signing key, or empty when it already does or Secure Boot is off.
    Version: the version of Luft the USB stick installs, such as "1.2-nightly.21", or empty when it doesn't say.
    Early: whether this image's build marked Luft as still early, which Install Luft says before anything is written.
    StableReleased: whether a stable version of Luft was out when this image was built.

    Survey, Install, OpenMovingBox, Configure and CreateAccount need com.lantharos.installer.install. The rest only answer the
    account setup is pending for: FinishFirstBoot, and, while setup is still open, the setup steps, which also
    need com.lantharos.installer.set-up and have to come from Install Luft's own program. UseLanguage is taken
    like Install on the live system and like a setup step after it. On a computer installed for someone
    else, the setup steps, LeaveToOwner and Claim answer the luft-setup account, which runs setup until
    the owner has an account. Erase needs com.lantharos.installer.erase.
  -->
  <interface name="com.lantharos.Installer1">
    <property name="Phase" type="s" access="read"/>
    <property name="Stage" type="s" access="read"/>
    <property name="Progress" type="d" access="read"/>
    <property name="Error" type="s" access="read"/>
    <property name="SecureBootCode" type="s" access="read"/>
    <property name="Version" type="s" access="read"/>
    <property name="Early" type="b" access="read"/>
    <property name="StableReleased" type="b" access="read"/>

    <!-- JSON: drives with their free spaces, EFI system partition and Windows (size, used, smallest it can
         shrink to, room for Luft, version, fast startup, whether its clock is in UTC, how many
         Bluetooth devices it has paired, and why it can't shrink: "bitlocker", "hibernated",
         "dirty" or "full"), drives Luft can't use ("running", "read-only", "too-small"), hints read from
         Windows (time zone, keyboard, locale) and the smallest size Luft needs. -->
    <method name="Survey">
      <arg name="survey" type="s" direction="out"/>
    </method>
    <!-- JSON: {"target": {"kind": "whole", "drive"} | {"kind": "alongside", "drive", "size"} |
         {"kind": "free", "drive", "offset"} | {"kind": "replace", "system"}, "variant": "default" | "nvidia",
         "windows": {"fastStartupOff", "universalClock", "bluetooth"}, "encryption": {"recoveryKey", "passphrase"} | null,
         "forSomeoneElse": true | false}.
         Starts right away; the Windows choices apply to the Windows on that drive. With encryption, Luft's partition
         is encrypted with the recovery key from trustd's GenerateRecoveryKey, and the passphrase too when the TPM
         can't unlock it; replacing a system while keeping its files can't be encrypted. For someone else,
         the install needs no account, Luft's partition is encrypted with a temporary key it carries
         itself, and the new system starts in the "handover" phase. -->
    <method name="Install">
      <arg name="request" type="s" direction="in"/>
    </method>
    <!-- Opens the sealed moving box Meet Luft packed, with the code it showed, and answers with JSON:
         {"bytes", "fullName", "userName"}. An install started afterwards unpacks the box into the new
         account; without this call the box stays closed. A wrong code fails. -->
    <method name="OpenMovingBox">
      <arg name="code" type="s" direction="in"/>
      <arg name="found" type="s" direction="out"/>
    </method>
    <!-- JSON: {"locale", "keyboard": {"layout", "variant"}, "timezone", "hostname"}. The last one given before
         copying ends is used. -->
    <method name="Configure">
      <arg name="regional" type="s" direction="in"/>
    </method>
    <!-- The account signs in automatically once, into first-run setup. -->
    <method name="CreateAccount">
      <arg name="name" type="s" direction="in"/>
      <arg name="full_name" type="s" direction="in"/>
      <arg name="password" type="s" direction="in"/>
    </method>
    <!-- The language errors are written in, as a BCP 47 tag like "de-AT". It's kept until the computer restarts. -->
    <method name="UseLanguage">
      <arg name="language" type="s" direction="in"/>
    </method>
    <!-- Only the account setup is pending for: stops signing in automatically. -->
    <method name="FinishFirstBoot"/>
    <!-- In the "handover" phase: makes the next start the owner's ("unclaimed"), and forgets the machine ID,
         SSH host keys and stored secrets this start made, so the owner's first start makes the computer's own. -->
    <method name="LeaveToOwner"/>
    <!-- In the "unclaimed" phase: writes the settings from Configure and creates the account from CreateAccount
         on this system, and has trustd's ClaimSystemDisk replace the disk's temporary key with the recovery key,
         and the passphrase when the TPM can't unlock it. The owner's session then starts in place of setup's,
         in the "first-boot" phase. -->
    <method name="Claim">
      <arg name="recovery_key" type="s" direction="in"/>
      <arg name="passphrase" type="s" direction="in"/>
    </method>
    <!-- Restarts to erase the computer: every account, file, app and setting goes, the disk gets a new
         temporary key in place of all its keys, and Luft starts in the "unclaimed" phase. -->
    <method name="Erase"/>
    <!-- Only for the account setup is pending for, while its setup window is open: makes one of the
         computer's Wi-Fi or wired networks "home" or "public" in the firewall, without the password
         the firewall asks everyone else for. -->
    <method name="SetNetworkType">
      <arg name="network" type="o" direction="in"/>
      <arg name="kind" type="s" direction="in"/>
    </method>
    <!-- Asks trustd to add Luft's key to shim, and gives the code to type when the computer restarts. -->
    <method name="EnrollSigningKey">
      <arg name="code" type="s" direction="out"/>
    </method>
    <!-- Starts adding a fingerprint for the account on the default reader; FingerprintStatus follows each
         touch until done, then the reader is let go. -->
    <method name="EnrollFingerprint">
      <arg name="finger" type="s" direction="in"/>
    </method>
    <method name="StopFingerprint"/>
    <!-- fprintd's EnrollStatus, for the fingerprint being added. -->
    <signal name="FingerprintStatus">
      <arg name="result" type="s"/>
      <arg name="done" type="b"/>
    </signal>
  </interface>
</node>
