[Unit]
Description=Kestrel session manager
CollectMode=inactive-or-failed
PartOf=kestrel-session.target
PartOf=kestrel-setup.target
Before=kestrel.service kestrel-setup.service

[Service]
Slice=session.slice
Type=dbus
BusName=org.gnome.SessionManager
ExecStart=@libexecdir@/kestrel-session-manager
Restart=on-failure
TimeoutStopSec=5
OOMScoreAdjust=-800
MemoryMin=32M
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0077
KeyringMode=private
