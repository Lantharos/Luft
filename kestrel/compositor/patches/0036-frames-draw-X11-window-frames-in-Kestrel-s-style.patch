diff --git a/src/frames/meta-window-tracker.c b/src/frames/meta-window-tracker.c
index 3f08388b5ea3c797e85797091919be26553bc8ed..04298748e4bac7642a5aa9f6d09cc58fa519b1fe 100644
--- a/src/frames/meta-window-tracker.c
+++ b/src/frames/meta-window-tracker.c
@@ -92,17 +92,25 @@ meta_window_tracker_get_property (GObject    *object,
 static void
 update_color_scheme (MetaWindowTracker *window_tracker)
 {
-  GDesktopColorScheme color_scheme;
-  gboolean is_dark;
+  GtkInterfaceColorScheme interface_color_scheme;
 
   g_assert (window_tracker->interface_settings != NULL);
 
-  color_scheme = g_settings_get_enum (window_tracker->interface_settings,
-                                      "color-scheme");
-  is_dark = color_scheme == G_DESKTOP_COLOR_SCHEME_PREFER_DARK;
+  switch (g_settings_get_enum (window_tracker->interface_settings, "color-scheme"))
+    {
+    case G_DESKTOP_COLOR_SCHEME_PREFER_DARK:
+      interface_color_scheme = GTK_INTERFACE_COLOR_SCHEME_DARK;
+      break;
+    case G_DESKTOP_COLOR_SCHEME_PREFER_LIGHT:
+      interface_color_scheme = GTK_INTERFACE_COLOR_SCHEME_LIGHT;
+      break;
+    default:
+      interface_color_scheme = GTK_INTERFACE_COLOR_SCHEME_DEFAULT;
+      break;
+    }
 
   g_object_set (gtk_settings_get_default (),
-                "gtk-application-prefer-dark-theme", is_dark,
+                "gtk-interface-color-scheme", interface_color_scheme,
                 NULL);
 }
 
diff --git a/src/frames/style/frames.css b/src/frames/style/frames.css
new file mode 100644
index 0000000000000000000000000000000000000000..2ad064593b1f6672ff1c7c3bbeb831ebe779babe
--- /dev/null
+++ b/src/frames/style/frames.css
@@ -0,0 +1,79 @@
+window.ssd-frame {
+  background: none;
+  font-family: "Open Runde", sans-serif;
+}
+
+window.ssd-frame .frame-titlebar {
+  min-height: 40px;
+  padding: 0 6px;
+  background-color: var(--kestrel-surface-container, #f3f3f0);
+  color: var(--kestrel-on-surface, #1b1b19);
+  transition: color 150ms ease-out;
+}
+
+@media (prefers-color-scheme: dark) {
+  window.ssd-frame .frame-titlebar {
+    background-color: var(--kestrel-surface-dim, #111110);
+    color: var(--kestrel-on-surface, #f3f3ef);
+  }
+}
+
+window.ssd-frame:backdrop .frame-titlebar {
+  color: var(--kestrel-outline, #75756e);
+}
+
+window.ssd-frame .frame-titlebar > .title {
+  margin: 0 10px;
+  font-size: 13px;
+  font-weight: 600;
+}
+
+window.ssd-frame windowcontrols {
+  border-spacing: 4px;
+}
+
+window.ssd-frame windowcontrols > button {
+  min-width: 28px;
+  min-height: 28px;
+  margin: 0;
+  padding: 0;
+  border: none;
+  border-radius: 999px;
+  box-shadow: none;
+  background-color: transparent;
+  background-image: none;
+  background-repeat: no-repeat;
+  background-position: center;
+  background-size: 16px;
+  color: var(--kestrel-outline, #75756e);
+  transition: background-color 150ms ease-out, color 150ms ease-out, transform 150ms ease-out;
+}
+
+window.ssd-frame windowcontrols > button > image {
+  opacity: 0;
+}
+
+window.ssd-frame windowcontrols > button.minimize {
+  background-image: -gtk-recolor(url("resource:///org/gnome/mutter/frames/icons/window-minimize-symbolic.svg"));
+}
+
+window.ssd-frame windowcontrols > button.maximize {
+  background-image: -gtk-recolor(url("resource:///org/gnome/mutter/frames/icons/window-maximize-symbolic.svg"));
+}
+
+window.ssd-frame windowcontrols > button.close {
+  background-image: -gtk-recolor(url("resource:///org/gnome/mutter/frames/icons/window-close-symbolic.svg"));
+}
+
+window.ssd-frame windowcontrols > button:hover {
+  background-color: color-mix(in oklab, currentColor 6.5%, transparent);
+  color: var(--kestrel-on-surface, #1b1b19);
+}
+
+window.ssd-frame windowcontrols > button:active {
+  transform: scale(0.96);
+}
+
+window.ssd-frame:backdrop windowcontrols > button:not(:hover) {
+  color: color-mix(in oklab, var(--kestrel-outline, #75756e) 70%, transparent);
+}
