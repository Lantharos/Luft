<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Luft</vendor>
  <vendor_url>https://github.com/Lantharos</vendor_url>

  <action id="com.lantharos.firewall.restrict">
    <description>Make a network public, or stop other devices from connecting to an app</description>
    <message>Authentication is required to change what other devices can connect to</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>

  <action id="com.lantharos.firewall.classify">
    <description>Make a network a home network</description>
    <message>Authentication is required to make this a home network</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_self</allow_active>
    </defaults>
  </action>

  <action id="com.lantharos.firewall.open-ports">
    <description>Open or close ports on home networks</description>
    <message>Authentication is required to change which ports are open on home networks</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>
  <action id="com.lantharos.firewall.open-ports-anywhere">
    <description>Open ports on every network, public ones too</description>
    <message>Authentication is required to let devices on public networks connect to this computer</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>

  <action id="com.lantharos.firewall.apps">
    <description>Let devices on home networks connect to an app</description>
    <message>Authentication is required to let devices on home networks connect to an app</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_self</allow_active>
    </defaults>
  </action>

  <action id="com.lantharos.firewall.apps-anywhere">
    <description>Let devices on public networks connect to an app</description>
    <message>Authentication is required to let devices on public networks connect to an app</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>
</policyconfig>
