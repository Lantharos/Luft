window-menu-new-window = Нов прозорец
window-menu-restore = Врати
window-menu-minimize = Минимизирај
window-menu-maximize = Максимизирај
window-menu-unmaximize = Врати во нормална големина
window-menu-pin = Закачи на лентата со задачи
window-menu-unpin = Откачи од лентата со задачи
window-menu-close = { $count ->
    [one] Затвори го прозорецот
   *[other] Затвори ги сите прозорци
}

## Context menus

context-menu-back = Назад

## Window previews (hovering a taskbar app)

