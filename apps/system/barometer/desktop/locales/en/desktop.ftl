## Devices

# Shown as the processor's name when the system doesn't report one.
barometer-cpu-unnamed = Processor
# A graphics card the system has no model name for; the variable is its maker, such as AMD, or empty.
barometer-gpu-unnamed = { $vendor } Graphics

## Processes

barometer-process-ended = This process has already ended
# What a process runs in, shown in its details next to Flatpak and Snap.
barometer-process-container = Container
barometer-app-not-installed = That app is no longer installed
