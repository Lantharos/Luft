diff --git a/src/wayland/meta-wayland-keyboard.c b/src/wayland/meta-wayland-keyboard.c
index 0b50eb6e301a2b8b5f84d27a7861372b4cc06f2f..bb81288f7c8f7a18d2982100533f91f477d0f14e 100644
--- a/src/wayland/meta-wayland-keyboard.c
+++ b/src/wayland/meta-wayland-keyboard.c
@@ -577,7 +577,9 @@ maybe_update_modifiers_from_event (MetaWaylandKeyboard *keyboard,
 
   event_type = clutter_event_type (event);
 
-  if (event_type != CLUTTER_KEY_PRESS && event_type != CLUTTER_KEY_RELEASE)
+  if (event_type != CLUTTER_KEY_PRESS &&
+      event_type != CLUTTER_KEY_RELEASE &&
+      event_type != CLUTTER_KEY_STATE)
     return FALSE;
 
   clutter_event_get_key_state (event,
@@ -606,6 +608,14 @@ meta_wayland_keyboard_update (MetaWaylandKeyboard   *keyboard,
                         is_press ? XKB_KEY_DOWN : XKB_KEY_UP);
 }
 
+void
+meta_wayland_keyboard_update_state (MetaWaylandKeyboard *keyboard,
+                                    const ClutterEvent  *event)
+{
+  if (maybe_update_modifiers_from_event (keyboard, event))
+    notify_modifiers (keyboard);
+}
+
