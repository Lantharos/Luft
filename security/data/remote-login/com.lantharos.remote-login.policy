<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Luft</vendor>
  <vendor_url>https://github.com/Lantharos</vendor_url>

  <action id="com.lantharos.remote-login.configure">
    <description>Turn on remote login and choose who can sign in over SSH</description>
    <message>Authentication is required to let people sign in to this computer from other devices</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>

  <action id="com.lantharos.remote-login.restrict">
    <description>Turn off remote login or let fewer people sign in over SSH</description>
    <message>Authentication is required to change who can sign in to this computer from other devices</message>
    <defaults>
      <allow_any>auth_admin_keep</allow_any>
      <allow_inactive>auth_admin_keep</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>

  <action id="com.lantharos.remote-login.password-login">
    <description>Let people sign in over SSH with a password</description>
    <message>Authentication is required to let people sign in to this computer from other devices with a password</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>

  <action id="com.lantharos.remote-login.public-networks">
    <description>Let devices on public networks sign in over SSH</description>
    <message>Authentication is required to let devices on public networks sign in to this computer</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>
</policyconfig>
