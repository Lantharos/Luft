From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Kristof Imeri <kristof@lanth.me>
Date: Wed, 14 Oct 2026 16:29:17 +0200
Subject: [PATCH 26/46] background: let the shell choose which part of a zoomed
 texture shows

The zoom style always crops a texture around its center. When a wallpaper
and a monitor have different shapes, the part worth keeping is often
elsewhere, such as the trees low in a landscape photo.

meta_background_set_focus() places the visible area at a fraction of the
cropped range on each axis. The default, 0.5, keeps today's centered crop.
---
 src/compositor/meta-background.c | 56 +++++++++++++++++++++++++++++---
 src/meta/meta-background.h       |  5 +++
 2 files changed, 57 insertions(+), 4 deletions(-)

diff --git a/src/compositor/meta-background.c b/src/compositor/meta-background.c
index 6d464d0083dd8d6bafc72e503a87eefeded80d4b..f5f7a07d777c797448e0ad049f51c6859d41f783 100644
--- a/src/compositor/meta-background.c
+++ b/src/compositor/meta-background.c
@@ -21,6 +21,7 @@
 
 #include "compositor/meta-background-private.h"
 
+#include <math.h>
 #include <string.h>
 
 #include "backends/meta-backend-private.h"
@@ -70,6 +71,8 @@ struct _MetaBackground
   CoglTexture *wallpaper_texture;
 
   float blend_factor;
+  float focus_x;
+  float focus_y;
 
   guint wallpaper_allocation_failed : 1;
 };
@@ -294,6 +297,8 @@ meta_background_class_init (MetaBackgroundClass *klass)
 static void
 meta_background_init (MetaBackground *self)
 {
+  self->focus_x = 0.5f;
+  self->focus_y = 0.5f;
 }
 
 static void
@@ -306,6 +311,21 @@ set_texture_area_from_monitor_area (MtkRectangle *monitor_area,
   texture_area->height = monitor_area->height;
 }
 
+static float
+zoom_focus (MetaBackground *self,
+            float           focus)
+{
+  return self->style == G_DESKTOP_BACKGROUND_STYLE_ZOOM ? focus : 0.5f;
+}
+
+static int
+place_along (int   monitor_length,
+             int   image_length,
+             float focus)
+{
+  return (int) roundf ((monitor_length - image_length) * focus);
+}
+
 static void
 get_texture_area (MetaBackground *self,
                   MtkRectangle   *monitor_rect,
@@ -377,9 +397,9 @@ get_texture_area (MetaBackground *self,
           image_area.width = monitor_rect->width;
           image_area.height = (int) (texture_height * monitor_x_scale);
 
-          /* Position image centered vertically in actor */
           image_area.x = 0;
-          image_area.y = monitor_rect->height / 2 - image_area.height / 2;
+          image_area.y = place_along (monitor_rect->height, image_area.height,
+                                      zoom_focus (self, self->focus_y));
         }
       else
         {
@@ -387,8 +407,8 @@ get_texture_area (MetaBackground *self,
           image_area.width = (int) (texture_width * monitor_y_scale);
           image_area.height = monitor_rect->height;
 
-          /* Position image centered horizontally in actor */
-          image_area.x = monitor_rect->width / 2 - image_area.width / 2;
+          image_area.x = place_along (monitor_rect->width, image_area.width,
+                                      zoom_focus (self, self->focus_x));
           image_area.y = 0;
         }
 
@@ -978,6 +998,34 @@ meta_background_set_blend_textures (MetaBackground          *self,
   mark_changed (self);
 }
 
+/**
+ * meta_background_set_focus:
+ * @self: a #MetaBackground
+ * @x: horizontal focus, from 0.0 (left edge) to 1.0 (right edge)
+ * @y: vertical focus, from 0.0 (top edge) to 1.0 (bottom edge)
+ *
+ * Choose which part of the texture stays visible when the zoom style crops
+ * it to a monitor of a different shape. The visible area sits at this
+ * fraction of the cropped range; 0.5 on both axes centers it.
+ */
+void
+meta_background_set_focus (MetaBackground *self,
+                           double          x,
+                           double          y)
+{
+  float focus_x = (float) CLAMP (x, 0.0, 1.0);
+  float focus_y = (float) CLAMP (y, 0.0, 1.0);
+
+  g_return_if_fail (META_IS_BACKGROUND (self));
+
+  if (self->focus_x == focus_x && self->focus_y == focus_y)
+    return;
+
+  self->focus_x = focus_x;
+  self->focus_y = focus_y;
+  mark_changed (self);
+}
+
 ClutterColorState *
 meta_background_get_color_state (MetaBackground *self)
 {
diff --git a/src/meta/meta-background.h b/src/meta/meta-background.h
index 05d6a494dab0c9727fcb3555fe47c71ec9ede638..599e7843788a3d7972eb87255dc978fd20b8bd5c 100644
--- a/src/meta/meta-background.h
+++ b/src/meta/meta-background.h
@@ -62,6 +62,11 @@ void meta_background_set_texture (MetaBackground          *self,
                                   GDesktopBackgroundStyle  style,
                                   ClutterColorState       *color_state);
 
+META_EXPORT
+void meta_background_set_focus (MetaBackground *self,
+                                double          x,
+                                double          y);
+
 META_EXPORT
 void meta_background_set_blend_textures (MetaBackground          *self,
                                          CoglTexture             *texture1,
