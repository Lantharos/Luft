---
import Base from '../layouts/Base.astro';
import Backdrop from '../components/home/Backdrop.astro';
import Choices from '../components/download/Choices.astro';
import Requirements from '../components/download/Requirements.astro';
import { urls } from '@luft/web';
import { localize } from '../i18n/pages';

const { t } = localize(Astro);
---

<Base title={t('download-title')} description={t('download-description')} page="download" credits={['Altitude']} overFog>
	<section class="relative isolate flex min-h-[70svh] items-center overflow-hidden pt-24 pb-24">
		<Backdrop name="Altitude" position="50% 70%" eager />
		<div class="absolute inset-x-0 bottom-0 -z-10 h-1/3 bg-linear-to-b from-transparent to-canvas" aria-hidden="true"></div>
		<div class="page text-ink scheme-light">
			<h1 class="enter text-[clamp(3rem,8vw,6.5rem)] leading-none font-semibold tracking-[-0.04em] text-balance">{t('download-heading')}</h1>
			<p class="enter mt-5 max-w-xl text-lede text-ink-soft" style="--order: 1">{t('download-lede')}</p>
		</div>
	</section>
	<Choices />
	<Requirements />
	<p class="page pb-24 text-ink-soft [&_a]:link [&_a]:text-ink" set:html={t('download-docs', { docs: urls.docs })} />
</Base>
