## Taskbar

taskbar-start = Başlat
taskbar-quick-settings = Hızlı ayarlar
taskbar-notifications-and-date = Bildirimler ve tarih
taskbar-show-desktop = Masaüstünü göster
taskbar-system-monitor = Sistem izleyici
taskbar-settings = Görev çubuğu ayarları
taskbar-show-keyboard-layout = Klavye düzenini göster
taskbar-keyboard-settings = Klavye ayarları
taskbar-network-settings = Ağ ayarları
taskbar-sound-settings = Ses ayarları
taskbar-date-time-settings = Tarih ve saat ayarları
taskbar-show-taskbar = Görev çubuğunu göster

## App menu (right-click on a taskbar app)

window-menu-open = Aç
window-menu-new-window = Yeni pencere
window-menu-restore = Geri yükle
window-menu-minimize = Simge durumuna küçült
window-menu-maximize = Ekranı kapla
window-menu-unmaximize = Önceki boyutuna getir
window-menu-pin = Görev çubuğuna sabitle
window-menu-unpin = Görev çubuğundan sabitlemeyi kaldır
window-menu-close = { $count ->
    [one] Pencereyi kapat
   *[other] Tüm pencereleri kapat
}

## Context menus

context-menu-back = Geri

## Window previews (hovering a taskbar app)

previews-close-window = Kapat: { $title }

## Tray

tray-apps = Sistem tepsisi uygulamaları
tray-open-app = { $appName } uygulamasını aç

## Board (tablet window layout)

board-open-start = Başlat menüsünü aç
board-show-all-windows = Tüm pencereleri göster
board-quick-settings = Hızlı ayarlar

## Task view

task-view-close-window = Pencereyi kapat
task-view-desktop = Çalışma alanı { $number }

## Snap layouts

snap-zone = Genişliği %{ $width }, yüksekliği %{ $height } olan alana yasla

## Window title bars

title-bar-minimize = Simge durumuna küçült
title-bar-maximize = Ekranı kapla
title-bar-close = Kapat

## Window resizing

window-resize-size = { $width } × { $height }

## App not responding

close-dialog-title = “{ $appName }” yanıt vermiyor
close-dialog-description = Uygulamanın devam etmesi için biraz bekleyebilir ya da uygulamayı tamamen kapanmaya zorlayabilirsiniz
close-dialog-force-quit = Kapanmaya zorla
close-dialog-wait = Bekle

