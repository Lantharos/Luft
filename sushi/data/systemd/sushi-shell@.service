[Unit]
Description=Shell asked for on the screen that says the computer couldn't start
Documentation=https://docs.luft.computer/developers/system/recovery/#opening-a-shell
DefaultDependencies=no
IgnoreOnIsolate=yes

[Service]
Type=oneshot
Environment=HOME=/root
WorkingDirectory=-/root
ExecStart=-/usr/bin/sulogin --force /dev/%I
StandardInput=tty-force
StandardOutput=inherit
StandardError=inherit
TTYPath=/dev/%I
TTYReset=yes
TimeoutStartSec=infinity
KillMode=process
SendSIGHUP=yes
