[Unit]
Description=Recover devices Windows left asleep
DefaultDependencies=no
After=local-fs.target systemd-udev-trigger.service
Before=greetd.service bluetooth.service alsa-state.service alsa-restore.service
ConditionKernelCommandLine=!rd.live.image

[Service]
Type=oneshot
ExecStart=/usr/libexec/luft-windows boot
SyslogIdentifier=luft-windows
RuntimeDirectory=luft-windows
RuntimeDirectoryPreserve=yes
ReadWritePaths=/sys/devices
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=disconnected
PrivateNetwork=yes
NoNewPrivileges=yes
DevicePolicy=closed
DeviceAllow=block-* r
DeviceAllow=char-alsa rw
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
CapabilityBoundingSet=CAP_SYS_RAWIO

[Install]
WantedBy=multi-user.target
