## Errors shown in Install Luft and first-run setup

installer-not-allowed = Nemate dozvolu za ovo.
installer-stopped = Instalacioni program se neočekivano zaustavio.
installer-request-invalid = Zahtjev nije ispravan: { $error }
installer-settings-invalid = Postavke nisu ispravne: { $error }
installer-busy = Luft se već instalira.
installer-account-exists = Račun je već napravljen.

## Choosing what to install

installer-no-image = Nema slike { $variant } za instaliranje.
installer-write-failed = Nije moguće zapisati { $path }

## Checking the destination

installer-drive-gone = Taj disk više nije priključen.
installer-drive-unusable = Luft se ne može instalirati na taj disk.
installer-system-gone = Taj sistem više ne postoji.
installer-system-unreplaceable = Luft još ne može zamijeniti { $system }.
installer-drive-running = Luft se upravo pokreće s tog diska, pa se on ne može izbrisati.
installer-windows-unshrinkable = Windows na tom disku se ne može smanjiti.
installer-size-wont-fit = Ta veličina ne staje pored Windowsa.
installer-space-gone = Taj slobodni prostor više ne postoji.
installer-space-too-small = Taj slobodni prostor je premalen za Luft.

## Account and regional settings

installer-user-name-invalid = To korisničko ime se ne može koristiti.
installer-full-name-invalid = Ime ne smije sadržavati dvotačke, zareze ni prijelome reda.
installer-password-missing = Odaberite lozinku.
installer-account-not-saved = Novi račun nije sačuvan
installer-account-missing = Novi račun nedostaje
installer-regional-invalid = Te regionalne postavke nisu ispravne.
installer-unknown-zone = Novi sistem ne poznaje vremensku zonu { $zone }.

## Installing

installer-esp-partition-failed = Nije moguće napraviti EFI sistemsku particiju
installer-startup-partition-failed = Nije moguće napraviti particiju za fajlove za pokretanje Lufta
installer-root-partition-failed = Nije moguće napraviti particiju za Luft
installer-encryption-failed = Nije moguće šifrirati particiju za Luft
installer-shrink-failed = Windows nije bilo moguće smanjiti
installer-no-esp = Disk nema EFI sistemsku particiju
installer-no-root = Particija za Luft nije napravljena
installer-copy-failed = Luft nije bilo moguće kopirati
installer-no-deployment = Novi sistem nema instancu
installer-deployment-unnamed = Instanca novog sistema nema naziv
installer-deployment-unopened = Novi sistem nije bilo moguće otvoriti
installer-boot-menu-failed = Meni za pokretanje Lufta nije bilo moguće postaviti na EFI sistemsku particiju
installer-key-queue-failed = Luftov Secure Boot ključ nije bilo moguće pripremiti za sljedeće pokretanje

## Replacing a Linux system

installer-encryption-keeps-old = Luft se ne može šifrirati kada pored sebe zadržava datoteke starog sistema.
installer-leftovers-failed = Ostatke ranijeg pokušaja nije bilo moguće ukloniti
installer-default-failed = Luft nije bilo moguće postaviti kao sistem koji se pokreće
installer-relabel-failed = Vaše fajlove nije bilo moguće označiti za Luft
installer-set-aside-failed = Stari sistem nije bilo moguće skloniti

## Things packed with Meet Luft

installer-box-unopened = Kutiju za selidbu nije bilo moguće otvoriti
installer-box-no-list = Kutija za selidbu nema popis sadržaja
installer-unpack-failed = Nije moguće raspakovati { $path }
installer-wallpaper-unnamed = Pozadina nema naziv
