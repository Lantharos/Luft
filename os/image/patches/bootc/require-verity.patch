From f4cff707607c73daae67199cd909c198d23b2358 Mon Sep 17 00:00:00 2001
From: Kristof Imeri <imeri@lanth.me>
Date: Thu, 22 Oct 2026 02:00:53 +0200
Subject: [PATCH] initramfs: Refuse a composefs image without fs-verity when
 the command line is strict

A repository created without fs-verity in meta.json, as bootc install
does through its pre-flight check, opens in insecure mode. Then an image
whose fs-verity is missing is mounted anyway, and without verity=require,
so neither the image nor the objects are checked against the digest the
signed command line names. Replacing the image file is enough to start
something else.

Unless the command line allows missing fs-verity, mount the image only
when its own fs-verity digest is the one named, and always with
verity=require, whatever meta.json says.
---
 crates/initramfs/src/lib.rs | 35 ++++++++++++++++++++++++++++++-----
 1 file changed, 30 insertions(+), 5 deletions(-)

diff --git a/crates/initramfs/src/lib.rs b/crates/initramfs/src/lib.rs
index ed989c57..6be4b8b4 100644
--- a/crates/initramfs/src/lib.rs
+++ b/crates/initramfs/src/lib.rs
@@ -24,7 +24,7 @@ use serde::Deserialize;
 
 use composefs::{
     fsverity::{FsVerityHashValue, Sha512HashValue},
-    mount::FsHandle,
+    mount::{FsHandle, MountOptions, VerityRequirement, composefs_fsmount},
     mountcompat::{overlayfs_set_fd, overlayfs_set_lower_and_data_fds, prepare_mount},
     repository::{ImageNotFound, Repository},
 };
@@ -365,18 +365,43 @@ pub fn mount_composefs_image(
     // that lack meta.json: it infers the algorithm and verity mode from
     // existing objects, writes meta.json, and opens normally.
     let (mut repo, _upgraded) = Repository::<Sha512HashValue>::open_upgrade(sysroot, "composefs")?;
-    if allow_missing_fsverity {
+    let rootfs = if allow_missing_fsverity {
         repo.set_insecure();
+        repo.mount(name)
+    } else {
+        mount_verified_image(&repo, name)
     }
-    let rootfs = repo
-        .mount(name)
-        .context("Failed to mount composefs image")?;
+    .context("Failed to mount composefs image")?;
 
     set_mount_readonly(&rootfs)?;
 
     Ok(rootfs)
 }
 
+/// Mounts the image only if its fs-verity digest is the one the kernel
+/// command line names, and makes overlayfs check every object against the
+/// digest the image records.  The repository's own metadata decides nothing
+/// here: an image without fs-verity is refused even in a repository that
+/// was created without it.
+fn mount_verified_image(repo: &Repository<Sha512HashValue>, name: &str) -> Result<OwnedFd> {
+    let (image, verified) = repo.open_image(name)?;
+    anyhow::ensure!(
+        verified,
+        "The composefs image {name} has no fs-verity digest, so it can't be checked"
+    );
+    let objects = repo
+        .objects_dir()
+        .context("Opening the composefs objects")?;
+    composefs_fsmount(
+        image,
+        name,
+        &[objects.as_fd()],
+        VerityRequirement::Required,
+        &MountOptions::default(),
+    )
+    .context("Mounting the composefs image with fs-verity required")
+}
+
 fn parse_composefs_candidates(cmdline: &str) -> Result<Vec<ComposefsCmdline<Sha512HashValue>>> {
     let mut candidates = Vec::new();
     let mut seen_legacy = false;
-- 
