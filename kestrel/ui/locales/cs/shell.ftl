## Battery

battery-level = { $status ->
    [charging] Baterie { $percentage } %, nabíjí se
    [full] Baterie { $percentage } %, plně nabitá
    [plugged] Baterie { $percentage } %, připojeno k napájení
   *[discharging] Baterie { $percentage } %
}

