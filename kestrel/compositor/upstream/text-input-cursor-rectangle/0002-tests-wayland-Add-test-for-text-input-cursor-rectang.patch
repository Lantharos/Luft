+#include "config.h"
+
+#include "backends/meta-backend-private.h"
+#include "tests/meta-wayland-test-runner.h"
+#include "tests/meta-wayland-test-utils.h"
+
+#define TEST_TYPE_INPUT_METHOD (test_input_method_get_type ())
+G_DECLARE_FINAL_TYPE (TestInputMethod, test_input_method,
+                      TEST, INPUT_METHOD, ClutterInputMethod)
+
+struct _TestInputMethod
+{
+  ClutterInputMethod parent;
+
+  graphene_rect_t cursor_location;
+};
+
+G_DEFINE_TYPE (TestInputMethod, test_input_method, CLUTTER_TYPE_INPUT_METHOD)
+
+static void
+test_input_method_focus_in (ClutterInputMethod *im,
+                            ClutterInputFocus  *focus)
+{
+}
+
+static void
+test_input_method_focus_out (ClutterInputMethod *im)
+{
+}
+
+static void
+test_input_method_reset (ClutterInputMethod *im)
+{
+}
+
+static void
+test_input_method_set_cursor_location (ClutterInputMethod    *im,
+                                       const graphene_rect_t *rect)
+{
+  TEST_INPUT_METHOD (im)->cursor_location = *rect;
+}
+
+static void
+test_input_method_class_init (TestInputMethodClass *klass)
+{
+  ClutterInputMethodClass *im_class = CLUTTER_INPUT_METHOD_CLASS (klass);
+
+  im_class->focus_in = test_input_method_focus_in;
+  im_class->focus_out = test_input_method_focus_out;
+  im_class->reset = test_input_method_reset;
+  im_class->set_cursor_location = test_input_method_set_cursor_location;
+}
+
+static void
+test_input_method_init (TestInputMethod *im)
+{
+}
+
+static void
+text_input_cursor_rectangle_after_focus_change (void)
+{
+  MetaBackend *backend = meta_context_get_backend (test_context);
+  ClutterBackend *clutter_backend = meta_backend_get_clutter_backend (backend);
+  g_autoptr (TestInputMethod) im = NULL;
+  MetaWaylandTestClient *wayland_test_client;
+
+  im = g_object_new (TEST_TYPE_INPUT_METHOD, NULL);
+  clutter_backend_set_input_method (clutter_backend, CLUTTER_INPUT_METHOD (im));
+
+  wayland_test_client =
+    meta_wayland_test_client_new_with_args (test_context,
+                                            "text-input",
+                                            "cursor-rectangle-after-focus-change",
+                                            NULL);
+  meta_wayland_test_driver_wait_for_sync_point (test_driver, 0);
+
+  g_assert_cmpfloat (im->cursor_location.size.width, ==, 30);
+  g_assert_cmpfloat (im->cursor_location.size.height, ==, 40);
+
+  meta_wayland_test_driver_emit_sync_event (test_driver, 0);
+  meta_wayland_test_client_finish (wayland_test_client);
+
+  clutter_backend_set_input_method (clutter_backend, NULL);
+}
+
+static void
+init_tests (void)
+{
+  g_test_add_func ("/wayland/text-input/cursor-rectangle-after-focus-change",
+                   text_input_cursor_rectangle_after_focus_change);
+}
+
+int
+main (int   argc,
+      char *argv[])
+{
+  return meta_run_wayland_tests (argc, argv, init_tests);
+}
