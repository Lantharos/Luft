diff --git a/src/compositor/meta-window-shadow.c b/src/compositor/meta-window-shadow.c
new file mode 100644
index 0000000000000000000000000000000000000000..6fc6fc17975c245cbfe5682b9162d22c8611161a
--- /dev/null
+++ b/src/compositor/meta-window-shadow.c
@@ -0,0 +1,119 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "config.h"
+
+#include "compositor/meta-window-corners.h"
+#include "compositor/meta-window-shadow.h"
+#include "meta/meta-window-actor.h"
+#include "x11/meta-window-shape.h"
+
+void
+meta_window_shadow_clear (MetaWindowShadow *shadow)
+{
+  g_clear_pointer (&shadow->shadow, meta_shadow_unref);
+  g_clear_pointer (&shadow->hole, mtk_region_unref);
+}
+
+static gboolean
+appears_focused (ClutterActor *actor)
+{
+  MetaWindow *window = meta_window_actor_get_meta_window (META_WINDOW_ACTOR (actor));
+
+  return meta_window_appears_focused (window);
+}
+
+static void
+ensure_shadow (MetaWindowShadow   *shadow,
+               ClutterActor       *actor,
+               const MtkRectangle *frame,
+               gboolean            focused)
+{
+  ClutterContext *clutter_context = clutter_actor_get_context (actor);
+  CoglContext *cogl_context =
+    clutter_backend_get_cogl_context (clutter_context_get_backend (clutter_context));
+  MtkRectangle rect = { 0, 0, frame->width, frame->height };
+  MetaWindowCorners corners = {
+    .bounds = GRAPHENE_RECT_INIT (0, 0, frame->width, frame->height),
+    .radius = MIN (META_WINDOW_CORNER_RADIUS,
+                   MIN (frame->width, frame->height) / 2.0f),
+  };
+  g_autoptr (MtkRegion) region = NULL;
+  MetaWindowShape *shape;
+
+  if (shadow->shadow &&
+      shadow->width == frame->width &&
+      shadow->height == frame->height &&
+      shadow->focused == focused)
+    return;
+
+  meta_window_shadow_clear (shadow);
+
+  region = mtk_region_create_rectangle (&rect);
+  meta_window_corners_clip_input (&corners, region);
+  shape = meta_window_shape_new (region);
+  shadow->hole = mtk_region_create_rectangle (&rect);
+  meta_window_corners_clip_inside (&corners, shadow->hole);
+  shadow->shadow = meta_shadow_factory_get_shadow (meta_shadow_factory_get_default (),
+                                                   shape, frame->width, frame->height,
+                                                   "normal", focused, cogl_context);
+  meta_window_shape_unref (shape);
+  shadow->width = frame->width;
+  shadow->height = frame->height;
+  shadow->focused = focused;
+}
+
+static void
+get_bounds (MetaWindowShadow   *shadow,
+            ClutterActor       *actor,
+            const MtkRectangle *frame,
+            MetaShadowParams   *params,
+            MtkRectangle       *bounds)
+{
+  gboolean focused = appears_focused (actor);
+
+  ensure_shadow (shadow, actor, frame, focused);
+  meta_shadow_factory_get_params (meta_shadow_factory_get_default (),
+                                  "normal", focused, params);
+  meta_shadow_get_bounds (shadow->shadow,
+                          frame->x + params->x_offset,
+                          frame->y + params->y_offset,
+                          frame->width, frame->height,
+                          bounds);
+}
+
+void
+meta_window_shadow_get_bounds (MetaWindowShadow   *shadow,
+                               ClutterActor       *actor,
+                               const MtkRectangle *frame,
+                               MtkRectangle       *bounds)
+{
+  MetaShadowParams params;
+
+  get_bounds (shadow, actor, frame, &params, bounds);
+}
+
+/* Like the shadows of X11 windows, but never under the window, where it
+ * would darken translucent and blurred parts of it */
+void
+meta_window_shadow_paint (MetaWindowShadow   *shadow,
+                          ClutterActor       *actor,
+                          CoglFramebuffer    *framebuffer,
+                          const MtkRectangle *frame,
+                          guint8              opacity)
+{
+  MetaShadowParams params;
+  MtkRectangle bounds;
+  g_autoptr (MtkRegion) clip = NULL;
+
+  get_bounds (shadow, actor, frame, &params, &bounds);
+  clip = mtk_region_create_rectangle (&bounds);
+  mtk_region_translate (shadow->hole, frame->x, frame->y);
+  mtk_region_subtract (clip, shadow->hole);
+  mtk_region_translate (shadow->hole, -frame->x, -frame->y);
+
+  meta_shadow_paint (shadow->shadow, framebuffer,
+                     frame->x + params.x_offset,
+                     frame->y + params.y_offset,
+                     frame->width, frame->height,
+                     opacity * params.opacity / 255,
+                     clip, TRUE);
+}
