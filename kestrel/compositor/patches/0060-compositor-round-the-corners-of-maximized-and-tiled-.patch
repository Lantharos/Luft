         CORNER_COVERAGE
         "  cogl_color_out *= coverage;\n"
         "}\n");
@@ -272,6 +383,7 @@ get_shadow_snippet (void)
     {
       snippet = cogl_snippet_new (COGL_SNIPPET_HOOK_FRAGMENT,
         CORNER_DECLARATIONS
+        "uniform vec4 kestrel_radii;\n"
         "varying vec2 kestrel_texture_origin;\n"
         "varying vec2 kestrel_texture_x;\n"
         "varying vec2 kestrel_texture_y;\n"
@@ -289,7 +401,7 @@ get_shadow_snippet (void)
         CORNER_COVERAGE
         "  vec2 side = sign(kestrel_position - center);\n"
         "  float outside = max(distance, 0.0) + 0.5;\n"
-        "  vec2 straight = half_size - kestrel_radius;\n"
+        "  vec2 straight = half_size - radius;\n"
         "  float edge_x = kestrel_shadow_alpha (center + side * vec2(half_size.x + outside, straight.y));\n"
         "  float edge_y = kestrel_shadow_alpha (center + side * vec2(straight.x, half_size.y + outside));\n"
         "  float around = mix(edge_x, edge_y, q.y * q.y / dot(q, q));\n"
@@ -334,8 +446,12 @@ meta_window_corners_apply (const MetaWindowCorners *corners,
   bounds[3] = corners->bounds.size.height;
   location = cogl_pipeline_get_uniform_location (pipeline, "kestrel_bounds");
   cogl_pipeline_set_uniform_float (pipeline, location, 4, 1, bounds);
-  location = cogl_pipeline_get_uniform_location (pipeline, "kestrel_radius");
-  cogl_pipeline_set_uniform_1f (pipeline, location, corners->radius);
+  bounds[0] = corners->rounded & META_WINDOW_CORNER_TOP_LEFT ? corners->radius : 0;
+  bounds[1] = corners->rounded & META_WINDOW_CORNER_TOP_RIGHT ? corners->radius : 0;
+  bounds[2] = corners->rounded & META_WINDOW_CORNER_BOTTOM_RIGHT ? corners->radius : 0;
+  bounds[3] = corners->rounded & META_WINDOW_CORNER_BOTTOM_LEFT ? corners->radius : 0;
+  location = cogl_pipeline_get_uniform_location (pipeline, "kestrel_radii");
+  cogl_pipeline_set_uniform_float (pipeline, location, 4, 1, bounds);
 }
 
 static void
@@ -355,9 +471,18 @@ subtract_corners (const MetaWindowCorners *corners,
     { x1, y2 - bottom, x1 + width, y2 - top },
     { x2 - width, y2 - bottom, x2, y2 - top },
   };
+  MetaWindowCornerMask masks[4] = {
+    META_WINDOW_CORNER_TOP_LEFT,
+    META_WINDOW_CORNER_TOP_RIGHT,
+    META_WINDOW_CORNER_BOTTOM_LEFT,
+    META_WINDOW_CORNER_BOTTOM_RIGHT,
+  };
 
   for (int i = 0; i < 4; i++)
     {
+      if (!(corners->rounded & masks[i]))
+        continue;
+
       MtkRectangle rect = {
         .x = (int) floorf (positions[i][0]),
         .y = (int) floorf (positions[i][1]),
@@ -433,7 +558,8 @@ get_outline_pipeline (CoglContext *context)
         "varying vec2 kestrel_position;\n",
         "kestrel_position = cogl_tex_coord0_in.xy;\n");
       fragment = cogl_snippet_new (COGL_SNIPPET_HOOK_FRAGMENT,
-        CORNER_DECLARATIONS,
+        CORNER_DECLARATIONS
+        "uniform float kestrel_radius;\n",
         "float pixel = kestrel_pixel_size ();\n"
         "vec2 half_size = kestrel_bounds.zw * 0.5;\n"
         "vec2 q = abs(kestrel_position - kestrel_bounds.xy - half_size) - half_size + kestrel_radius;\n"
