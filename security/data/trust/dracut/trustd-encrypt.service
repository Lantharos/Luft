[Unit]
Description=Start encrypting the system disk
DefaultDependencies=no
ConditionPathExists=/sys/firmware/efi/efivars/LuftDiskChange-b6a4c1e2-3f5d-4c8a-9e71-2d0f6a8b5c3e
Wants=tpm2.target
After=systemd-udev-trigger.service tpm2.target sushi.service systemd-pcrphase-initrd.service
Before=cryptsetup.target systemd-cryptsetup@root.service initrd-root-device.target sysroot.mount

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/trustctl encryption initrd
SyslogIdentifier=trustd
TimeoutSec=infinity
