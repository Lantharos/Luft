## The tray icon's menu and the name of the shortcut that stops every sound

app-name = Soundboard
open = Open Soundboard
stop-all = Stop all sounds
quit = Quit

## The board a new library starts with

first-board = Sounds

## Things that can go wrong, shown in a message at the bottom of the window

error-sound-gone = That sound is gone
error-board-gone = That board is gone
error-board-damaged = This board file is damaged
error-too-long = The sound is too long
error-unreadable = The sound can't be read
error-no-sound = The file has no sound in it
error-no-sound-server = The sound server isn't running
error-no-hotkeys = This desktop has no global hotkeys
