// Administrators at the computer can download and prepare system updates, and
// choose when that happens, without a password, so updates also arrive in the
// background. Going back to an earlier version still asks.
polkit.addRule(function (action, subject) {
    var background = ["com.lantharos.updater.download", "com.lantharos.updater.schedule"];
    if (background.indexOf(action.id) >= 0 && subject.local && subject.active && subject.isInGroup("wheel")) {
        return polkit.Result.YES;
    }
    return polkit.Result.NOT_HANDLED;
});
