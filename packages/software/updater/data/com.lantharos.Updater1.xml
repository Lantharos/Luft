<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
 "https://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<node name="/com/lantharos/Updater1">
  <!--
    Updates the system image with bootc. Started on demand and stops when idle.

    Downloading: whether an update is being downloaded right now, by anyone.
    Downloaded: bytes of image layers fetched so far by the current download.

    Download, SwitchVariant, Cancel and Apply need com.lantharos.updater.download; Rollback needs
    com.lantharos.updater.rollback. Status needs nothing.

    A finished download also builds the system packages for the version it staged, before
    Finished.
  -->
  <interface name="com.lantharos.Updater1">
    <property name="Downloading" type="b" access="read"/>
    <property name="Downloaded" type="t" access="read"/>

    <!-- JSON: {"host": `bootc status` as JSON, "configs": {manifest digest: OCI image config}} for the
         booted, staged and rollback images. -->
    <method name="Status">
      <arg name="status" type="s" direction="out"/>
    </method>
    <!-- Starts downloading the newest image and stages it, locked: it's only installed at a restart once
         Apply unlocks it. Finished says how it went. -->
    <method name="Download"/>
    <!-- Starts downloading the same channel and version of Luft's other image, "standard" or "nvidia",
         and stages it, unlocked, for the next restart, keeping this one to go back to. Downloading,
         Downloaded and Finished report it like an update. -->
    <method name="SwitchVariant">
      <arg name="variant" type="s" direction="in"/>
    </method>
    <method name="Cancel"/>
    <!-- Installs the downloaded update at the next restart or power off. -->
    <method name="Apply"/>
    <!-- Starts the previous version next time, or, when that's already queued, stays on this one. -->
    <method name="Rollback"/>
    <!-- Empty when the download succeeded. -->
    <signal name="Finished">
      <arg name="error" type="s"/>
    </signal>
  </interface>

  <!--
    Packages added to the system as a system extension, rebuilt for every version of Luft on the
    computer, from Fedora, the repositories that were added in /etc/yum.repos.d, and package files
    installed by themselves. Install, InstallFile and Remove need
    com.lantharos.updater.system-packages, AddRepository and RemoveRepository
    com.lantharos.updater.software-sources. Those that rebuild return once the running system
    uses the new set; Step tells how far they are. List and DescribeRepository need nothing.
  -->
  <interface name="com.lantharos.Updater1.SystemPackages">
    <property name="Busy" type="b" access="read"/>

    <!-- JSON: {"requested": [names], "packages": [{"name", "version", "arch", "summary",
         "requested", "units", "apps": [desktop entries], "origin": "fedora", "file" or
         {"repository": file}}] merged now,
         dependencies included, "services": [units turned on], "pending": true when the merged
         set isn't the requested one yet, "repositories": [{"file", "sources": [{"id", "name",
         "url"}]}]}. -->
    <method name="List">
      <arg name="packages" type="s" direction="out"/>
    </method>
    <method name="Install">
      <arg name="names" type="as" direction="in"/>
    </method>
    <!-- Installs a package file, kept so every version builds it again. Its digests are
         checked, not a signature. -->
    <method name="InstallFile">
      <arg name="package" type="h" direction="in"/>
    </method>
    <method name="Remove">
      <arg name="names" type="as" direction="in"/>
    </method>
    <!-- Checks a repository file to be kept as /etc/yum.repos.d/FILE.repo, and the keys it names,
         each given by the address its gpgkey has. Every source that's turned on must check
         signatures and be reached over HTTPS. JSON: {"file", "sources": [...], "keys":
         [{"fingerprint", "user"}]}. -->
    <method name="DescribeRepository">
      <arg name="file" type="s" direction="in"/>
      <arg name="text" type="s" direction="in"/>
      <arg name="keys" type="a{ss}" direction="in"/>
      <arg name="repository" type="s" direction="out"/>
    </method>
    <!-- Adds what DescribeRepository described, with its keys kept in /etc/pki/rpm-gpg. -->
    <method name="AddRepository">
      <arg name="file" type="s" direction="in"/>
      <arg name="text" type="s" direction="in"/>
      <arg name="keys" type="a{ss}" direction="in"/>
    </method>
    <!-- Removes a repository and the packages that came from it. -->
    <method name="RemoveRepository">
      <arg name="file" type="s" direction="in"/>
    </method>
    <!-- "downloading", "building" or "starting". -->
    <signal name="Step">
      <arg name="step" type="s"/>
    </signal>
  </interface>

  <!--
    Flatpak apps with full access, kept one app ID per line in /etc/kestrel/trusted-apps. Kestrel,
    Schelf and Luft's services treat them like apps installed on the system. Trust and Untrust need
    com.lantharos.updater.trust-app and refuse anything that isn't a Flatpak app ID. List needs
    nothing.
  -->
  <interface name="com.lantharos.Updater1.TrustedApps">
    <method name="List">
      <arg name="app_ids" type="as" direction="out"/>
    </method>
    <method name="Trust">
      <arg name="app_id" type="s" direction="in"/>
    </method>
    <method name="Untrust">
      <arg name="app_id" type="s" direction="in"/>
    </method>
  </interface>
</node>
