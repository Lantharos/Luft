<node>
  <interface name="com.lantharos.Firewall1">
    <method name="SetNetworkType">
      <arg name="network" type="o" direction="in"/>
      <arg name="kind" type="s" direction="in"/>
    </method>
    <method name="OpenPort">
      <arg name="port" type="q" direction="in"/>
      <arg name="protocol" type="s" direction="in"/>
      <arg name="networks" type="s" direction="in"/>
    </method>
    <method name="ClosePort">
      <arg name="port" type="q" direction="in"/>
      <arg name="protocol" type="s" direction="in"/>
    </method>
    <method name="SetAppAccess">
      <arg name="kind" type="s" direction="in"/>
      <arg name="id" type="s" direction="in"/>
      <arg name="access" type="s" direction="in"/>
    </method>
    <method name="ForgetApp">
      <arg name="kind" type="s" direction="in"/>
      <arg name="id" type="s" direction="in"/>
    </method>
    <method name="SetPostOpen">
      <arg name="open" type="b" direction="in"/>
    </method>
    <method name="SetExtensionPorts">
      <arg name="ports" type="a(qs)" direction="in"/>
    </method>
    <property name="Apps" type="a(sssu)" access="read"/>
    <property name="HomeInterfaces" type="as" access="read"/>
    <property name="OpenPorts" type="a(qss)" access="read"/>
    <property name="Unclassified" type="a(os)" access="read"/>
    <property name="Waiting" type="a(ssu)" access="read"/>
  </interface>
</node>
