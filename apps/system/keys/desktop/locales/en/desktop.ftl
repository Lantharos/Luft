## Layouts

# The variable is the layout's ID, such as us or de.
keys-layout-unreadable = The layout { $id } couldn't be read
keys-layout-invalid = This layout has a mistake the keyboard can't use
keys-keymap-unreadable = This keymap couldn't be read
keys-layout-gone = This layout no longer exists
keys-layout-unnamed = Give the layout a name
keys-dead-full = There's no room for more dead keys
keys-untypeable = The keyboard can't type that
keys-klc-invalid = This file doesn't describe a keyboard layout
keys-layout-import = Import a layout
# The kind of file the import window offers.
keys-layout-files = Keyboard layouts
keys-layout-export = Export layout

## Input methods

# The variable is what was wrong with the file, as the file reader reports it.
keys-method-unreadable = This input method couldn't be read: { $detail }
keys-method-unnamed = Give the input method a name
keys-method-nothing-to-try = Nothing to try yet
keys-method-unknown-file = Keys can open its own input methods, m17n .mim files and IBus table sources
keys-table-no-words = This file doesn't have a table of words
keys-mim-no-rules = This file doesn't have any rules Keys can use
keys-method-import = Import an input method
# The kind of file the import window offers.
keys-method-files = Input methods
keys-method-export = Export input method
# Describes the input methods in the system's list of input method engines.
keys-ibus-description = Input methods made with Keys

## Input sources

keys-sources-unavailable = Input sources aren't available here
