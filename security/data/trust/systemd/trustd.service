[Unit]
Description=Device trust: Secure Boot key, signed startup, TPM disk unlock and device encryption
After=local-fs.target

[Service]
Type=dbus
BusName=com.lantharos.Trust1
ExecStart=@libexecdir@/trustd
SyslogIdentifier=trustd
KeyringMode=shared
ProtectHome=read-only
PrivateTmp=yes
NoNewPrivileges=yes
UMask=0077
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectKernelModules=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_ALG
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
TimeoutStopSec=5min

[Install]
WantedBy=multi-user.target
