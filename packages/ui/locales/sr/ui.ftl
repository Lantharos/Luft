## Fingerprints
## Each finger has a name used as a title (the message value) and a form used inside
## a sentence (.inline), like "Place your … on the sensor." Adjust the case of .inline
## to fit those sentences.

ui-finger-right-index = Десни кажипрст
    .inline = десни кажипрст
ui-finger-left-index = Леви кажипрст
    .inline = леви кажипрст
ui-finger-right-thumb = Десни палац
    .inline = десни палац
ui-finger-left-thumb = Леви палац
    .inline = леви палац
ui-finger-right-middle = Десни средњи прст
    .inline = десни средњи прст
ui-finger-left-middle = Леви средњи прст
    .inline = леви средњи прст
ui-finger-right-ring = Десни домали прст
    .inline = десни домали прст
ui-finger-left-ring = Леви домали прст
    .inline = леви домали прст
ui-finger-right-little = Десни мали прст
    .inline = десни мали прст
ui-finger-left-little = Леви мали прст
    .inline = леви мали прст

ui-fingerprint-place = Ставите { $finger } на сензор.
ui-fingerprint-swipe = Превуците { $finger } преко сензора.
ui-fingerprint-stage-passed = Добро. Подигните прст, па га поново ставите.
ui-fingerprint-stage-passed-swipe = Добро. Превуците поново.
ui-fingerprint-retry = Очитавање није успело. Покушајте поново.
ui-fingerprint-swipe-too-short = Превуците мало спорије.
ui-fingerprint-not-centered = Поставите прст на средину сензора.
ui-fingerprint-remove-and-retry = Подигните прст и покушајте поново.
ui-fingerprint-added = Отисак прста је додат.
ui-fingerprint-full = Читач нема места за још један отисак прста.
ui-fingerprint-disconnected = Читач отиска прста је престао да одговара. Покушајте поново за тренутак.
ui-fingerprint-duplicate = Читач већ има сачуван овај прст, вероватно преко система Windows или другог налога. Користите други прст.
ui-fingerprint-failed = Додавање овог отиска прста није успело. Покушајте поново.

