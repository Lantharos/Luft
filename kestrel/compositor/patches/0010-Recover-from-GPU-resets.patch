+static void
+clutter_actor_real_realize (ClutterActor *self)
+{
+  ClutterActorPrivate *priv = self->priv;
+  ClutterContext *context = clutter_actor_get_context (self);
+  ClutterBackend *backend = clutter_context_get_backend (context);
+  ClutterGraphicsRecoveryContext *recovery_context =
+    clutter_backend_get_graphics_recovery_context (backend);
+
+  if (priv->effects != NULL &&
+      (clutter_graphics_recovery_context_get_state (recovery_context) ==
+       CLUTTER_GRAPHICS_RECOVERY_STATE_RESTORING))
+    {
+      g_list_foreach ((GList *)_clutter_meta_group_peek_metas (priv->effects),
+                      (GFunc)clutter_effect_realize, NULL);
+    }
+}
