[Unit]
Description=Passkeys
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=dbus
BusName=com.lantharos.Passkeys
ExecStart=@libexecdir@/luft-launch @libexecdir@/luft-passkeys
Restart=on-failure
Slice=session.slice
LimitCORE=0

[Install]
WantedBy=graphical-session.target
