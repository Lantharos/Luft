@@ -137,6 +137,11 @@ void clutter_blur_add_framebuffer_effect (CoglPipeline    *pipeline,
                                           const CoglColor *tint,
                                           float            luminosity);
 
+CLUTTER_EXPORT
+void clutter_blur_add_niko_effect (CoglPipeline    *pipeline,
