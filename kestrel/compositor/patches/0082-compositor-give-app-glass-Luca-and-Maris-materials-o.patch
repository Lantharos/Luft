-    meta_window_actor_invalidate_background_blur (l->data);
+  invalidate_background_blurs (compositor);
+}
+
+/**
+ * meta_compositor_set_glass:
+ * @compositor: a #MetaCompositor
+ * @windows: the style of app windows' glass
+ * @transients: the style of the glass of transient surfaces, such as
+ *   popovers and palettes
+ * @luca_from_wallpaper: whether Luca glass blurs only the wallpaper
+ *
+ * Sets how glass requested through ext-background-effect-v1 looks.
+ */
+void
+meta_compositor_set_glass (MetaCompositor *compositor,
+                           MetaGlassStyle  windows,
+                           MetaGlassStyle  transients,
+                           gboolean        luca_from_wallpaper)
+{
+  MetaCompositorPrivate *priv =
+    meta_compositor_get_instance_private (compositor);
+
+  if (priv->glass_windows == windows &&
+      priv->glass_transients == transients &&
+      priv->luca_from_wallpaper == luca_from_wallpaper)
+    return;
+
+  priv->glass_windows = windows;
+  priv->glass_transients = transients;
+  priv->luca_from_wallpaper = luca_from_wallpaper;
+  invalidate_background_blurs (compositor);
+}
+
+/**
+ * meta_compositor_set_glass_surface:
+ * @compositor: a #MetaCompositor
+ * @surface: the colour Maris glass is, its alpha how much of the wallpaper
+ *   it covers
+ */
+void
+meta_compositor_set_glass_surface (MetaCompositor  *compositor,
+                                   const CoglColor *surface)
+{
+  MetaCompositorPrivate *priv =
+    meta_compositor_get_instance_private (compositor);
+
+  if (cogl_color_equal (&priv->glass_surface, surface))
+    return;
+
+  priv->glass_surface = *surface;
+  invalidate_background_blurs (compositor);
+}
+
+/**
+ * meta_compositor_get_glass_surface:
+ * @compositor: a #MetaCompositor
+ *
+ * Returns: (transfer none): the colour of Maris glass
+ */
+const CoglColor *
+meta_compositor_get_glass_surface (MetaCompositor *compositor)
+{
+  MetaCompositorPrivate *priv =
+    meta_compositor_get_instance_private (compositor);
+
+  return &priv->glass_surface;
+}
+
+MetaGlassMaterial
+meta_compositor_get_glass_material (MetaCompositor *compositor)
+{
+  MetaCompositorPrivate *priv =
+    meta_compositor_get_instance_private (compositor);
+
+  if (priv->glass_windows == META_GLASS_STYLE_MARIS)
+    return META_GLASS_MATERIAL_SURFACE;
+
+  return priv->luca_from_wallpaper ? META_GLASS_MATERIAL_WALLPAPER : META_GLASS_MATERIAL_LIVE;
+}
+
+/**
+ * meta_compositor_clear_frosted_wallpaper:
+ * @compositor: a #MetaCompositor
+ * @frost: which frosted wallpaper
+ *
+ * Forgets every piece of that frosted wallpaper.
+ */
+void
+meta_compositor_clear_frosted_wallpaper (MetaCompositor     *compositor,
+                                         MetaWallpaperFrost  frost)
+{
+  MetaCompositorPrivate *priv =
+    meta_compositor_get_instance_private (compositor);
+
+  if (priv->frosted_wallpaper[frost]->len == 0)
+    return;
+
+  g_array_set_size (priv->frosted_wallpaper[frost], 0);
+  invalidate_background_blurs (compositor);
+}
+
+/**
+ * meta_compositor_add_frosted_wallpaper:
+ * @compositor: a #MetaCompositor
+ * @frost: which frosted wallpaper
+ * @area: the part of the stage @texture covers, usually a monitor
+ * @texture: the blurred wallpaper of that area
+ *
+ * Adds a piece of blurred wallpaper that glass shows instead of blurring
+ * what is behind it: the blurred one for Luca glass that blurs only the
+ * wallpaper, the wide one for Maris.
+ */
+void
+meta_compositor_add_frosted_wallpaper (MetaCompositor     *compositor,
+                                       MetaWallpaperFrost  frost,
+                                       const MtkRectangle *area,
+                                       CoglTexture        *texture)
+{
+  MetaCompositorPrivate *priv =
+    meta_compositor_get_instance_private (compositor);
+  FrostedWallpaperPiece piece = { *area, g_object_ref (texture) };
+
+  g_array_append_val (priv->frosted_wallpaper[frost], piece);
+  invalidate_background_blurs (compositor);
+}
+
+/**
+ * meta_compositor_get_frosted_wallpaper: (skip)
+ * @compositor: a #MetaCompositor
+ * @frost: which frosted wallpaper
+ * @index: which piece
+ * @area: (out): the part of the stage the piece covers
+ *
+ * Returns: (transfer none) (nullable): the piece's texture, or %NULL past
+ *   the last piece
+ */
+CoglTexture *
+meta_compositor_get_frosted_wallpaper (MetaCompositor     *compositor,
+                                       MetaWallpaperFrost  frost,
+                                       unsigned int        index,
+                                       MtkRectangle       *area)
+{
+  MetaCompositorPrivate *priv =
+    meta_compositor_get_instance_private (compositor);
+  FrostedWallpaperPiece *piece;
+
+  if (index >= priv->frosted_wallpaper[frost]->len)
+    return NULL;
+
+  piece = &g_array_index (priv->frosted_wallpaper[frost], FrostedWallpaperPiece, index);
+  *area = piece->area;
+  return piece->texture;
 }
 
