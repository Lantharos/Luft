## Fingerprints
## Each finger has a name used as a title (the message value) and a form used inside
## a sentence (.inline), like "Place your … on the sensor." Adjust the case of .inline
## to fit those sentences.

ui-finger-right-index = Desni kazalec
    .inline = desni kazalec
ui-finger-left-index = Levi kazalec
    .inline = levi kazalec
ui-finger-right-thumb = Desni palec
    .inline = desni palec
ui-finger-left-thumb = Levi palec
    .inline = levi palec
ui-finger-right-middle = Desni sredinec
    .inline = desni sredinec
ui-finger-left-middle = Levi sredinec
    .inline = levi sredinec
ui-finger-right-ring = Desni prstanec
    .inline = desni prstanec
ui-finger-left-ring = Levi prstanec
    .inline = levi prstanec
ui-finger-right-little = Desni mezinec
    .inline = desni mezinec
ui-finger-left-little = Levi mezinec
    .inline = levi mezinec

ui-fingerprint-place = Položite { $finger } na senzor.
ui-fingerprint-swipe = Povlecite { $finger } čez senzor.
ui-fingerprint-stage-passed = Dobro. Dvignite prst in ga znova položite.
ui-fingerprint-stage-passed-swipe = Dobro. Povlecite znova.
ui-fingerprint-retry = Branje ni uspelo. Poskusite znova.
ui-fingerprint-swipe-too-short = Povlecite malo počasneje.
ui-fingerprint-not-centered = Položite prst na sredino senzorja.
ui-fingerprint-remove-and-retry = Dvignite prst in poskusite znova.
ui-fingerprint-added = Prstni odtis je dodan.
ui-fingerprint-full = V bralniku ni več prostora za nov prstni odtis.
ui-fingerprint-disconnected = Bralnik prstnih odtisov se ne odziva več. Čez trenutek poskusite znova.
ui-fingerprint-duplicate = Ta prst je v bralniku že shranjen, verjetno iz sistema Windows ali drugega računa. Uporabite drug prst.
ui-fingerprint-failed = Prstnega odtisa ni bilo mogoče dodati. Poskusite znova.

