<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Luft</vendor>
  <vendor_url>https://github.com/Lantharos</vendor_url>

  <action id="com.lantharos.updater.download">
    <description>Download and install system updates</description>
    <message>Authentication is required to update this computer</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>

  <action id="com.lantharos.updater.rollback">
    <description>Go back to the previous version of the system</description>
    <message>Authentication is required to go back to the previous version</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>

  <action id="com.lantharos.updater.system-packages">
    <description>Add or remove system packages</description>
    <message>Authentication is required to change the system packages</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>

  <action id="com.lantharos.updater.trust-app">
    <description>Give an app full access or take it away</description>
    <message>Authentication is required to change which apps have full access</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>
</policyconfig>
