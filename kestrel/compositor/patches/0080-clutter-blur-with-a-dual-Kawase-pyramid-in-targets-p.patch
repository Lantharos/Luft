+"  sum += kawase_sample (cogl_sampler, uv + vec2 (0.0, 2.0 * o.y));        \n"
+"  sum += kawase_sample (cogl_sampler, uv + o) * 2.0;                      \n"
+"  sum += kawase_sample (cogl_sampler, uv + vec2 (2.0 * o.x, 0.0));        \n"
+"  sum += kawase_sample (cogl_sampler, uv + vec2 (o.x, -o.y)) * 2.0;       \n"
+"  sum += kawase_sample (cogl_sampler, uv + vec2 (0.0, -2.0 * o.y));       \n"
+"  sum += kawase_sample (cogl_sampler, uv - o) * 2.0;                      \n"
+"  cogl_texel = sum / 12.0;                                                \n";
