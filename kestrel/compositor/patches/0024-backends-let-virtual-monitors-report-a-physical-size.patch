From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Kristof Imeri <kristof@lanth.me>
Date: Wed, 14 Oct 2026 16:22:39 +0200
Subject: [PATCH 24/36] backends: let virtual monitors report a physical size

--virtual-monitor accepts an optional :WxHmm suffix, such as
1920x1080:344x194mm, so headless sessions can stand in for laptop
panels and HiDPI monitors when choosing a default scale.
---
 src/backends/meta-virtual-monitor.h       |  3 ++
 src/backends/native/meta-output-virtual.c |  2 +
 src/core/meta-context-main.c              | 63 ++++++++++++++---------
 3 files changed, 45 insertions(+), 23 deletions(-)

diff --git a/src/backends/meta-virtual-monitor.h b/src/backends/meta-virtual-monitor.h
index 512f8fc8ef8837c0a0f95b8a579b3e4d53236421..abeb74bb429693d34416a90878d65b0f648a2c26 100644
--- a/src/backends/meta-virtual-monitor.h
+++ b/src/backends/meta-virtual-monitor.h
@@ -39,6 +39,9 @@ struct _MetaVirtualMonitorInfo
   char *vendor;
   char *product;
   char *serial;
+
+  int width_mm;
+  int height_mm;
 };
 
 #define META_TYPE_VIRTUAL_MONITOR (meta_virtual_monitor_get_type ())
diff --git a/src/backends/native/meta-output-virtual.c b/src/backends/native/meta-output-virtual.c
index fb85db2f031dfe7883e62e9a5183d78abc529528..0090dc1e196b3de100b1c2ad428fc6382acc9247 100644
--- a/src/backends/native/meta-output-virtual.c
+++ b/src/backends/native/meta-output-virtual.c
@@ -58,6 +58,8 @@ meta_output_virtual_new (uint64_t                      id,
   output_info->vendor = g_strdup (info->vendor);
   output_info->product = g_strdup (info->product);
   output_info->serial = g_strdup (info->serial);
+  output_info->width_mm = info->width_mm;
+  output_info->height_mm = info->height_mm;
 
   if (modes)
     {
diff --git a/src/core/meta-context-main.c b/src/core/meta-context-main.c
index e40394b368fb31fb0c6b2be8e40384a27d752f0c..871d4c90250854bae4826a2e262f771f7938b669 100644
--- a/src/core/meta-context-main.c
+++ b/src/core/meta-context-main.c
@@ -294,6 +294,21 @@ meta_context_main_get_session_manager (MetaContext *context)
   return context_main->session_manager;
 }
 
+static gboolean
+parse_physical_size (const char *string,
+                     int        *width_mm,
+                     int        *height_mm)
+{
+  char *end;
+
+  *width_mm = (int) g_ascii_strtoll (string, &end, 10);
+  if (*width_mm <= 0 || *end != 'x')
+    return FALSE;
+
+  *height_mm = (int) g_ascii_strtoll (end + 1, &end, 10);
+  return *height_mm > 0 && g_str_equal (end, "mm");
+}
+
 static gboolean
 add_virtual_monitor_cb (const char  *option_name,
                         const char  *value,
@@ -301,36 +316,38 @@ add_virtual_monitor_cb (const char  *option_name,
                         GError     **error)
 {
   MetaContextMain *context_main = user_data;
+  g_auto (GStrv) parts = g_strsplit (value, ":", 2);
   int width, height;
+  int width_mm = 0, height_mm = 0;
   float refresh_rate;
+  g_autofree char *serial = NULL;
+  MetaVirtualMonitorInfo *virtual_monitor;
+  int n_existing_virtual_monitor_infos;
 
-  if (meta_parse_monitor_mode (value, &width, &height, &refresh_rate, 60.0))
-    {
-      g_autofree char *serial = NULL;
-      MetaVirtualMonitorInfo *virtual_monitor;
-      int n_existing_virtual_monitor_infos;
-
-      n_existing_virtual_monitor_infos =
-        g_list_length (context_main->options.virtual_monitor_infos);
-      serial = g_strdup_printf ("0x%.2x", n_existing_virtual_monitor_infos);
-      virtual_monitor =
-        meta_virtual_monitor_info_new_simple (width,
-                                              height,
-                                              refresh_rate,
-                                              "MetaVendor",
-                                              "MetaVirtualMonitor",
-                                              serial);
-      context_main->options.virtual_monitor_infos =
-        g_list_append (context_main->options.virtual_monitor_infos,
-                       virtual_monitor);
-      return TRUE;
-    }
-  else
+  if (!meta_parse_monitor_mode (parts[0], &width, &height, &refresh_rate, 60.0) ||
+      (parts[1] && !parse_physical_size (parts[1], &width_mm, &height_mm)))
     {
       g_set_error (error, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT,
                    "Unrecognizable virtual monitor spec '%s'", value);
       return FALSE;
     }
+
+  n_existing_virtual_monitor_infos =
+    g_list_length (context_main->options.virtual_monitor_infos);
+  serial = g_strdup_printf ("0x%.2x", n_existing_virtual_monitor_infos);
+  virtual_monitor =
+    meta_virtual_monitor_info_new_simple (width,
+                                          height,
+                                          refresh_rate,
+                                          "MetaVendor",
+                                          "MetaVirtualMonitor",
+                                          serial);
+  virtual_monitor->width_mm = width_mm;
+  virtual_monitor->height_mm = height_mm;
+  context_main->options.virtual_monitor_infos =
+    g_list_append (context_main->options.virtual_monitor_infos,
+                   virtual_monitor);
+  return TRUE;
 }
 
 static void
@@ -371,7 +388,7 @@ meta_context_main_add_option_entries (MetaContextMain *context_main)
     {
       "virtual-monitor", 0, 0, G_OPTION_ARG_CALLBACK,
       add_virtual_monitor_cb,
-      N_("Add persistent virtual monitor (WxH or WxH@R)")
+      N_("Add persistent virtual monitor (WxH or WxH@R, optionally followed by :WxHmm for its physical size)")
     },
 #ifdef HAVE_DEVKIT
     {
