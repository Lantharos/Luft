From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Kristof Imeri <kristof@lanth.me>
Date: Wed, 14 Oct 2026 16:22:39 +0200
Subject: [PATCH 25/38] backends: pick laptop-friendly default scales

Monitors without a saved configuration got 100% on 15.6" 1080p laptop
panels, 125% on 14" panels that other systems run at 150%, and thirds
such as 133% elsewhere. Aim for 110 DPI on every screen, which gives 150%
on 13" and 14" laptop panels, 125% on 15" to 17" ones and 100% on 24"
and 27" monitors, and prefer quarter steps unless a third fits clearly
better. Scales people chose are stored and never recalculated.
---
 src/backends/meta-monitor.c | 83 ++++++++++++++++++++++---------------
 1 file changed, 49 insertions(+), 34 deletions(-)

diff --git a/src/backends/meta-monitor.c b/src/backends/meta-monitor.c
index 04a91104bc2ddc8194f83708f154286e8bf9e4b4..113d3f1530433d35e1bf0e50b12a5bacb39e1b46 100644
--- a/src/backends/meta-monitor.c
+++ b/src/backends/meta-monitor.c
@@ -2423,25 +2423,52 @@ meta_monitor_calculate_crtc_pos (MetaMonitor         *monitor,
  * We choose a default scale factor such that the UI is as big
  * as it would be on a display with this DPI without scaling.
  *
- * Through experiementing, a value of 135 has been found to best
- * line up with the UI size chosen as default by other operating
- * systems (macOS, Android, iOS, Windows) and the community-decided
- * "known-good" scale factors for GNOME for various mobile devices
- * such as phones, tablets, and laptops
+ * A value of 110 lines up with the scale other operating systems
+ * pick for laptop panels and external monitors alike: 150% for 13" and
+ * 14" 1080p and 1920x1200 panels, 125% for 15" to 17" 1080p panels,
+ * 167% to 225% for HiDPI laptop panels and 100% for 24" to 27"
+ * 1080p and 1440p monitors.
  */
-#define UI_SCALE_MOBILE_TARGET_DPI 135
+#define UI_SCALE_TARGET_DPI 110
 
 /*
- * People tend to sit further away from larger stationary displays
- * than they do from mobile displays, so a UI of an identical size to
- * a mobile device has a smaller angular size and thus seems to be too
- * small.
- *
- * The largest mainstream laptops have screens ~17in, and HiDPI external
- * monitors start at ~23in, so 20in is a good boundary point
+ * Quarter steps (125%, 150%, 175%) are what people recognize and render
+ * most evenly, so they win over thirds unless a third fits much better.
  */
-#define UI_SCALE_LARGE_TARGET_DPI 110
-#define UI_SCALE_LARGE_MIN_SIZE_INCHES 20
+#define UI_SCALE_STEPS_PER_INTEGER 4
+#define UI_SCALE_STEP_TOLERANCE 0.1f
+
+static gboolean
+is_quarter_step (float scale)
+{
+  return fmodf (scale * UI_SCALE_STEPS_PER_INTEGER, 1.0f) == 0.0f;
+}
+
+static float
+find_closest_scale (const float *scales,
+                    int          n_scales,
+                    float        perfect_scale,
+                    gboolean     quarter_steps_only)
+{
+  float best_scale = 1.0f;
+  float best_scale_error = G_MAXFLOAT;
+
+  for (int i = 0; i < n_scales; i++)
+    {
+      float scale_error = fabsf (scales[i] - perfect_scale);
+
+      if (quarter_steps_only && !is_quarter_step (scales[i]))
+        continue;
+
+      if (scale_error < best_scale_error)
+        {
+          best_scale = scales[i];
+          best_scale_error = scale_error;
+        }
+    }
+
+  return best_scale;
+}
 
 static float
 calculate_scale (MetaMonitor                *monitor,
@@ -2452,8 +2479,7 @@ calculate_scale (MetaMonitor                *monitor,
   float diag_inches;
   g_autofree float *scales = NULL;
   int n_scales;
-  float best_scale, physical_dpi, perfect_scale, best_scale_error = 0.0f;
-  int target_dpi;
+  float best_scale, quarter_scale, physical_dpi, perfect_scale;
 
   /*
    * Somebody encoded the aspect ratio (16/9 or 16/10) instead of the physical
@@ -2468,17 +2494,11 @@ calculate_scale (MetaMonitor                *monitor,
     return 1.0;
   diag_inches = sqrtf (width_mm * width_mm + height_mm * height_mm) / 25.4f;
 
-  /* Pick the appropriate target DPI based on screen size */
-  if (diag_inches < UI_SCALE_LARGE_MIN_SIZE_INCHES)
-    target_dpi = UI_SCALE_MOBILE_TARGET_DPI;
-  else
-    target_dpi = UI_SCALE_LARGE_TARGET_DPI;
-
   meta_monitor_mode_get_resolution (monitor_mode, &width_px, &height_px);
 
   physical_dpi = sqrtf (width_px * width_px + height_px * height_px) /
                  diag_inches;
-  perfect_scale = physical_dpi / target_dpi;
+  perfect_scale = physical_dpi / UI_SCALE_TARGET_DPI;
 
   if (constraints & META_MONITOR_SCALES_CONSTRAINT_NO_FRAC)
     perfect_scale -= 0.125f;
@@ -2487,17 +2507,12 @@ calculate_scale (MetaMonitor                *monitor,
   scales = meta_monitor_calculate_supported_scales (monitor, monitor_mode,
                                                     constraints,
                                                     &n_scales);
-  best_scale = scales[0];
-  for (int i = 0; i < n_scales; i++)
-    {
-      float scale_error = fabsf (scales[i] - perfect_scale);
+  best_scale = find_closest_scale (scales, n_scales, perfect_scale, FALSE);
+  quarter_scale = find_closest_scale (scales, n_scales, perfect_scale, TRUE);
 
-      if (i == 0 || scale_error < best_scale_error)
-        {
-          best_scale = scales[i];
-          best_scale_error = scale_error;
-        }
-    }
+  if (fabsf (quarter_scale - perfect_scale) <=
+      fabsf (best_scale - perfect_scale) + UI_SCALE_STEP_TOLERANCE)
+    return quarter_scale;
 
   return best_scale;
 }
