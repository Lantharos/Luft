## Fingerprints
## Each finger has a name used as a title (the message value) and a form used inside
## a sentence (.inline), like "Place your … on the sensor." Adjust the case of .inline
## to fit those sentences.

ui-finger-right-index = Gishti tregues i djathtë
    .inline = gishtin tregues të djathtë
ui-finger-left-index = Gishti tregues i majtë
    .inline = gishtin tregues të majtë
ui-finger-right-thumb = Gishti i madh i djathtë
    .inline = gishtin e madh të djathtë
ui-finger-left-thumb = Gishti i madh i majtë
    .inline = gishtin e madh të majtë
ui-finger-right-middle = Gishti i mesëm i djathtë
    .inline = gishtin e mesëm të djathtë
ui-finger-left-middle = Gishti i mesëm i majtë
    .inline = gishtin e mesëm të majtë
ui-finger-right-ring = Gishti i unazës i djathtë
    .inline = gishtin e unazës të djathtë
ui-finger-left-ring = Gishti i unazës i majtë
    .inline = gishtin e unazës të majtë
ui-finger-right-little = Gishti i vogël i djathtë
    .inline = gishtin e vogël të djathtë
ui-finger-left-little = Gishti i vogël i majtë
    .inline = gishtin e vogël të majtë

ui-fingerprint-place = Vendose { $finger } mbi sensor.
ui-fingerprint-swipe = Rrëshqite { $finger } nëpër sensor.
ui-fingerprint-stage-passed = Mirë. Ngrije gishtin, pastaj vendose sërish.
ui-fingerprint-stage-passed-swipe = Mirë. Rrëshqite sërish.
ui-fingerprint-retry = Nuk u lexua mirë. Provo sërish.
ui-fingerprint-swipe-too-short = Rrëshqite pak më ngadalë.
ui-fingerprint-not-centered = Vendose gishtin në qendër të sensorit.
ui-fingerprint-remove-and-retry = Ngrije gishtin dhe provo sërish.
ui-fingerprint-added = Gjurma e gishtit u shtua.
ui-fingerprint-full = Lexuesi nuk ka më vend për një gjurmë tjetër gishti.
ui-fingerprint-disconnected = Lexuesi i gjurmëve të gishtave ndaloi së përgjigjuri. Provo sërish pas pak.
ui-fingerprint-duplicate = Lexuesi e ka të ruajtur tashmë këtë gisht, ndoshta nga Windows ose një llogari tjetër. Përdor një gisht tjetër.
ui-fingerprint-failed = Kjo gjurmë gishti nuk u shtua dot. Provo sërish.

