[Unit]
Description=Explain a restart after the graphics driver stopped responding
DefaultDependencies=no
After=local-fs.target sushi.service
Before=display-manager.service greetd.service sushi-quit.service
ConditionPathExistsGlob=|/var/lib/kestrel-watchdog/incidents/*.json
ConditionPathExistsGlob=|/sys/firmware/efi/efivars/KestrelIncident-*

[Service]
Type=oneshot
ExecStart=@libexecdir@/kestrel-watchdog boot
StateDirectory=kestrel-watchdog
RuntimeDirectory=kestrel-watchdog
Group=wheel
UMask=0027
StateDirectoryMode=0750
TimeoutStartSec=6min
ProtectSystem=full
ProtectHome=yes
PrivateTmp=disconnected
PrivateNetwork=yes
NoNewPrivileges=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_LINUX_IMMUTABLE CAP_DAC_OVERRIDE

[Install]
WantedBy=graphical.target
