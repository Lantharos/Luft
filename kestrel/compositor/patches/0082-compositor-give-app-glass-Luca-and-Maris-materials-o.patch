   priv->background_blur_radius = DEFAULT_BACKGROUND_BLUR_RADIUS;
   priv->background_saturation = DEFAULT_BACKGROUND_BLUR_SATURATION;
   priv->background_noise = DEFAULT_BACKGROUND_BLUR_NOISE;
