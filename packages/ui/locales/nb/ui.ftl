## Fingerprints
## Each finger has a name used as a title (the message value) and a form used inside
## a sentence (.inline), like "Place your … on the sensor." Adjust the case of .inline
## to fit those sentences.

ui-finger-right-index = Høyre pekefinger
    .inline = høyre pekefinger
ui-finger-left-index = Venstre pekefinger
    .inline = venstre pekefinger
ui-finger-right-thumb = Høyre tommel
    .inline = høyre tommel
ui-finger-left-thumb = Venstre tommel
    .inline = venstre tommel
ui-finger-right-middle = Høyre langfinger
    .inline = høyre langfinger
ui-finger-left-middle = Venstre langfinger
    .inline = venstre langfinger
ui-finger-right-ring = Høyre ringfinger
    .inline = høyre ringfinger
ui-finger-left-ring = Venstre ringfinger
    .inline = venstre ringfinger
ui-finger-right-little = Høyre lillefinger
    .inline = høyre lillefinger
ui-finger-left-little = Venstre lillefinger
    .inline = venstre lillefinger

ui-fingerprint-place = Legg { $finger } på sensoren.
ui-fingerprint-swipe = Dra { $finger } over sensoren.
ui-fingerprint-stage-passed = Bra. Løft fingeren, og legg den på igjen.
ui-fingerprint-stage-passed-swipe = Bra. Dra igjen.
ui-fingerprint-retry = Det ble ikke lest skikkelig. Prøv igjen.
ui-fingerprint-swipe-too-short = Dra litt saktere.
ui-fingerprint-not-centered = Legg fingeren midt på sensoren.
ui-fingerprint-remove-and-retry = Løft fingeren, og prøv igjen.
ui-fingerprint-added = Fingeravtrykket er lagt til.
ui-fingerprint-full = Leseren har ikke plass til flere fingeravtrykk.
ui-fingerprint-disconnected = Fingeravtrykkleseren sluttet å svare. Prøv igjen om litt.
ui-fingerprint-duplicate = Denne fingeren er allerede lagret på leseren, sannsynligvis av Windows eller en annen konto. Bruk en annen finger.
ui-fingerprint-failed = Kunne ikke legge til dette fingeravtrykket. Prøv igjen.

