## Taskbar

taskbar-start = Start
taskbar-quick-settings = Szybkie ustawienia
taskbar-notifications-and-date = Powiadomienia i data
taskbar-show-desktop = Pokaż pulpit
taskbar-system-monitor = Monitor systemu
taskbar-settings = Ustawienia paska zadań
taskbar-show-keyboard-layout = Pokaż układ klawiatury
taskbar-keyboard-settings = Ustawienia klawiatury
taskbar-network-settings = Ustawienia sieci
taskbar-sound-settings = Ustawienia dźwięku
taskbar-date-time-settings = Ustawienia daty i godziny
taskbar-show-taskbar = Pokaż pasek zadań

## App menu (right-click on a taskbar app)

window-menu-open = Otwórz
window-menu-new-window = Nowe okno
window-menu-restore = Przywróć
window-menu-minimize = Minimalizuj
window-menu-maximize = Maksymalizuj
window-menu-unmaximize = Przywróć rozmiar
window-menu-pin = Przypnij do paska zadań
window-menu-unpin = Odepnij od paska zadań
window-menu-close = { $count ->
    [one] Zamknij okno
    [few] Zamknij wszystkie okna
    [many] Zamknij wszystkie okna
   *[other] Zamknij wszystkie okna
}

## Context menus

context-menu-back = Wstecz

## Window previews (hovering a taskbar app)

previews-close-window = Zamknij okno { $title }

## Tray

tray-apps = Aplikacje w zasobniku systemowym
tray-open-app = Otwórz aplikację { $appName }

## Board (tablet window layout)

board-open-start = Otwórz menu Start
board-show-all-windows = Pokaż wszystkie okna
board-quick-settings = Szybkie ustawienia

## Task view

task-view-close-window = Zamknij okno
task-view-desktop = Obszar roboczy { $number }

## Snap layouts

snap-zone = Przyciągnij do obszaru { $width }% na { $height }%

## Window title bars

title-bar-minimize = Minimalizuj
title-bar-maximize = Maksymalizuj
title-bar-close = Zamknij

## Window resizing

window-resize-size = { $width } × { $height }

## App not responding

close-dialog-title = Aplikacja { $appName } nie odpowiada
close-dialog-description = Możesz chwilę poczekać, aż zacznie znowu działać, albo wymusić jej zamknięcie
close-dialog-force-quit = Wymuś zamknięcie
close-dialog-wait = Czekaj

