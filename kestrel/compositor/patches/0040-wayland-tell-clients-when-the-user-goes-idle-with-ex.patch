index 0000000000000000000000000000000000000000..5d216c4ea916bf13a41b81e1f913a415f3c8a8cd
--- /dev/null
+++ b/src/wayland/meta-wayland-idle-notify.c
@@ -0,0 +1,170 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "config.h"
+
+#include "wayland/meta-wayland-idle-notify.h"
+
+#include "backends/meta-backend-private.h"
+#include "meta/meta-idle-monitor.h"
+#include "wayland/meta-wayland-private.h"
+#include "wayland/meta-wayland-sandbox.h"
+#include "wayland/meta-wayland-versions.h"
+
+#include "ext-idle-notify-v1-server-protocol.h"
+
+#define MIN_TIMEOUT_MS 1000
+#define MIN_SANDBOXED_TIMEOUT_MS 10000
+
+typedef struct _MetaWaylandIdleNotification
+{
+  struct wl_resource *resource;
+  MetaIdleMonitor *monitor;
+  guint idle_watch_id;
+  guint active_watch_id;
+} MetaWaylandIdleNotification;
+
+static void
+on_user_active (MetaIdleMonitor *monitor,
+                guint            watch_id,
+                gpointer         user_data)
+{
+  MetaWaylandIdleNotification *notification = user_data;
+
+  notification->active_watch_id = 0;
+  ext_idle_notification_v1_send_resumed (notification->resource);
+}
+
+static void
+on_idle (MetaIdleMonitor *monitor,
+         guint            watch_id,
+         gpointer         user_data)
+{
+  MetaWaylandIdleNotification *notification = user_data;
+
+  if (notification->active_watch_id)
+    return;
+
+  ext_idle_notification_v1_send_idled (notification->resource);
+  notification->active_watch_id =
+    meta_idle_monitor_add_user_active_watch (monitor, on_user_active,
+                                             notification, NULL);
+}
+
+static void
+idle_notification_destructor (struct wl_resource *resource)
+{
+  MetaWaylandIdleNotification *notification = wl_resource_get_user_data (resource);
+
+  meta_idle_monitor_remove_watch (notification->monitor,
+                                  notification->idle_watch_id);
+  if (notification->active_watch_id)
+    meta_idle_monitor_remove_watch (notification->monitor,
+                                    notification->active_watch_id);
+  g_object_unref (notification->monitor);
+  g_free (notification);
+}
+
+static void
+idle_notification_destroy (struct wl_client   *client,
+                           struct wl_resource *resource)
+{
+  wl_resource_destroy (resource);
+}
+
+static const struct ext_idle_notification_v1_interface idle_notification_interface =
+{
+  idle_notification_destroy,
+};
+
+static void
+create_notification (struct wl_client          *client,
+                     struct wl_resource        *notifier_resource,
+                     uint32_t                   id,
+                     uint32_t                   timeout_msec,
+                     MetaIdleMonitorWatchFlags  flags)
+{
+  MetaWaylandCompositor *compositor = wl_resource_get_user_data (notifier_resource);
+  MetaBackend *backend =
+    meta_context_get_backend (meta_wayland_compositor_get_context (compositor));
+  uint32_t min_timeout_msec = meta_wayland_client_is_sandboxed (client)
+    ? MIN_SANDBOXED_TIMEOUT_MS
+    : MIN_TIMEOUT_MS;
+  MetaWaylandIdleNotification *notification;
+
+  notification = g_new0 (MetaWaylandIdleNotification, 1);
+  notification->monitor = g_object_ref (meta_backend_get_core_idle_monitor (backend));
+  notification->resource =
+    wl_resource_create (client, &ext_idle_notification_v1_interface,
+                        wl_resource_get_version (notifier_resource), id);
+  wl_resource_set_implementation (notification->resource,
+                                  &idle_notification_interface,
+                                  notification,
+                                  idle_notification_destructor);
+
+  notification->idle_watch_id =
+    meta_idle_monitor_add_idle_watch_full (notification->monitor,
+                                           MAX (timeout_msec, min_timeout_msec),
+                                           on_idle, notification, NULL,
+                                           flags |
+                                           META_IDLE_MONITOR_WATCH_FLAGS_START_NOW);
+}
+
+static void
+idle_notifier_destroy (struct wl_client   *client,
+                       struct wl_resource *resource)
+{
+  wl_resource_destroy (resource);
+}
+
+static void
+idle_notifier_get_idle_notification (struct wl_client   *client,
+                                     struct wl_resource *resource,
+                                     uint32_t            id,
+                                     uint32_t            timeout,
+                                     struct wl_resource *seat)
+{
+  create_notification (client, resource, id, timeout,
+                       META_IDLE_MONITOR_WATCH_FLAGS_NONE);
+}
+
+static void
+idle_notifier_get_input_idle_notification (struct wl_client   *client,
+                                           struct wl_resource *resource,
+                                           uint32_t            id,
+                                           uint32_t            timeout,
+                                           struct wl_resource *seat)
+{
+  create_notification (client, resource, id, timeout,
+                       META_IDLE_MONITOR_WATCH_FLAGS_UNINHIBITABLE);
+}
+
+static const struct ext_idle_notifier_v1_interface idle_notifier_interface =
+{
+  idle_notifier_destroy,
+  idle_notifier_get_idle_notification,
+  idle_notifier_get_input_idle_notification,
+};
+
+static void
+bind_idle_notifier (struct wl_client *client,
+                    void             *data,
+                    uint32_t          version,
+                    uint32_t          id)
+{
+  struct wl_resource *resource;
+
+  resource = wl_resource_create (client, &ext_idle_notifier_v1_interface,
+                                 version, id);
+  wl_resource_set_implementation (resource, &idle_notifier_interface,
+                                  data, NULL);
+}
+
+void
+meta_wayland_init_idle_notify (MetaWaylandCompositor *compositor)
+{
+  if (!wl_global_create (compositor->wayland_display,
+                         &ext_idle_notifier_v1_interface,
+                         META_EXT_IDLE_NOTIFIER_V1_VERSION,
+                         compositor,
+                         bind_idle_notifier))
+    g_error ("Failed to register a global ext_idle_notifier_v1 object");
+}
