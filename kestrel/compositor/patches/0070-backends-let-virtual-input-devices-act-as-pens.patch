+static gboolean
+notify_tablet_proximity_in_impl (GTask *task)
+{
+  MetaVirtualInputDeviceNative *virtual_native =
+    g_task_get_source_object (task);
+  ImplState *impl_state = virtual_native->impl_state;
+  MetaVirtualEventTablet *event = g_task_get_task_data (task);
+  ClutterInputDeviceTool **tool = &impl_state->tools[event->tool_type];
+
+  if (event->time_us == CLUTTER_CURRENT_TIME)
+    event->time_us = g_get_monotonic_time ();
+
+  if (!*tool)
+    *tool = meta_input_device_tool_native_new_virtual (event->tool_type);
+
+  meta_seat_impl_notify_tablet_proximity_in_impl (impl_state->seat_impl,
+                                                  impl_state->device,
+                                                  *tool,
+                                                  event->time_us,
+                                                  event->in_proximity);
+
+  g_task_return_boolean (task, TRUE);
+  return G_SOURCE_REMOVE;
+}
+
+static gboolean
+notify_tablet_motion_in_impl (GTask *task)
+{
+  MetaVirtualInputDeviceNative *virtual_native =
+    g_task_get_source_object (task);
+  ImplState *impl_state = virtual_native->impl_state;
+  MetaVirtualEventTablet *event = g_task_get_task_data (task);
+  ClutterInputDeviceTool *tool =
+    META_INPUT_DEVICE_NATIVE (impl_state->device)->last_tool;
+  double *axes;
+
+  if (!tool)
+    {
+      g_task_return_boolean (task, FALSE);
+      return G_SOURCE_REMOVE;
+    }
+
+  if (event->time_us == CLUTTER_CURRENT_TIME)
+    event->time_us = g_get_monotonic_time ();
+
+  axes = g_new0 (double, CLUTTER_INPUT_AXIS_LAST);
+  axes[CLUTTER_INPUT_AXIS_X] = event->x;
+  axes[CLUTTER_INPUT_AXIS_Y] = event->y;
+  axes[CLUTTER_INPUT_AXIS_PRESSURE] =
+    meta_input_device_tool_native_translate_pressure_in_impl (tool, event->pressure);
+
+  meta_seat_impl_notify_tablet_motion_in_impl (impl_state->seat_impl,
+                                               impl_state->device,
+                                               event->time_us,
+                                               (float) event->x,
+                                               (float) event->y,
+                                               axes);
+
+  g_task_return_boolean (task, TRUE);
+  return G_SOURCE_REMOVE;
+}
+
+static gboolean
+notify_tablet_button_in_impl (GTask *task)
+{
+  MetaVirtualInputDeviceNative *virtual_native =
+    g_task_get_source_object (task);
+  ImplState *impl_state = virtual_native->impl_state;
+  MetaVirtualEventTablet *event = g_task_get_task_data (task);
+
+  if (event->time_us == CLUTTER_CURRENT_TIME)
+    event->time_us = g_get_monotonic_time ();
+
+  meta_seat_impl_notify_button_in_impl (impl_state->seat_impl,
+                                        impl_state->device,
+                                        event->time_us,
+                                        event->button,
+                                        event->button_state);
+
+  g_task_return_boolean (task, TRUE);
+  return G_SOURCE_REMOVE;
+}
+
+static void
+run_tablet_task (ClutterVirtualInputDevice *virtual_device,
+                 MetaVirtualEventTablet    *event,
+                 GSourceFunc                func)
+{
+  MetaVirtualInputDeviceNative *virtual_native =
+    META_VIRTUAL_INPUT_DEVICE_NATIVE (virtual_device);
+  MetaSeatNative *seat_native =
+    meta_virtual_input_device_native_get_seat_native (virtual_native);
+  GTask *task;
+
+  task = g_task_new (virtual_native, NULL, NULL, NULL);
+  g_task_set_task_data (task, event, g_free);
+  meta_seat_impl_run_input_task (seat_native->impl, task, func);
+  g_object_unref (task);
+}
+
+static void
+meta_virtual_input_device_native_notify_tablet_proximity (ClutterVirtualInputDevice  *virtual_device,
+                                                          uint64_t                    time_us,
+                                                          gboolean                    in_proximity,
+                                                          ClutterInputDeviceToolType  tool_type)
+{
+  MetaVirtualEventTablet *event;
+
+  g_return_if_fail (META_VIRTUAL_INPUT_DEVICE_NATIVE (virtual_device)->impl_state != NULL);
+  g_return_if_fail (tool_type > CLUTTER_INPUT_DEVICE_TOOL_NONE &&
+                    tool_type <= CLUTTER_INPUT_DEVICE_TOOL_LENS);
+
+  event = g_new0 (MetaVirtualEventTablet, 1);
+  event->time_us = time_us;
+  event->in_proximity = in_proximity;
+  event->tool_type = tool_type;
+
+  run_tablet_task (virtual_device, event,
+                   (GSourceFunc) notify_tablet_proximity_in_impl);
+}
+
+static void
+meta_virtual_input_device_native_notify_tablet_motion (ClutterVirtualInputDevice *virtual_device,
+                                                       uint64_t                   time_us,
+                                                       double                     x,
+                                                       double                     y,
+                                                       double                     pressure)
+{
+  MetaVirtualEventTablet *event;
+
+  g_return_if_fail (META_VIRTUAL_INPUT_DEVICE_NATIVE (virtual_device)->impl_state != NULL);
+
+  event = g_new0 (MetaVirtualEventTablet, 1);
+  event->time_us = time_us;
+  event->x = x;
+  event->y = y;
+  event->pressure = pressure;
+
+  run_tablet_task (virtual_device, event,
+                   (GSourceFunc) notify_tablet_motion_in_impl);
+}
+
+static void
+meta_virtual_input_device_native_notify_tablet_button (ClutterVirtualInputDevice *virtual_device,
+                                                       uint64_t                   time_us,
+                                                       uint32_t                   button,
+                                                       ClutterButtonState         button_state)
+{
+  MetaVirtualEventTablet *event;
+
+  g_return_if_fail (META_VIRTUAL_INPUT_DEVICE_NATIVE (virtual_device)->impl_state != NULL);
+
+  event = g_new0 (MetaVirtualEventTablet, 1);
+  event->time_us = time_us;
+  event->button = button;
