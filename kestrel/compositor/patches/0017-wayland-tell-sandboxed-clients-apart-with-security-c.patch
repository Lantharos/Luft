diff --git a/src/core/meta-sandbox.c b/src/core/meta-sandbox.c
new file mode 100644
index 0000000000000000000000000000000000000000..b2883a224068ccb0daf4838fdad18199c1da05a0
--- /dev/null
+++ b/src/core/meta-sandbox.c
@@ -0,0 +1,175 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "config.h"
+
+#include "core/meta-sandbox.h"
+
+#include <fcntl.h>
+#include <gio/gio.h>
+#include <glib/gstdio.h>
+#include <stdlib.h>
+#include <sys/pidfd.h>
+#include <unistd.h>
+
+#include "meta/meta-backend.h"
+#include "meta/meta-context.h"
+
+#define TRUSTED_APPS_PATH "/etc/kestrel/trusted-apps"
+#define TRUSTED_APPS_CHECK_PATH_VARIABLE "KESTREL_TRUSTED_APPS"
+#define TRUSTED_APPS_KEY "-meta-trusted-apps"
+
+typedef struct _TrustedApps
+{
+  char *path;
+  GFileMonitor *monitor;
+  GHashTable *app_ids;
+} TrustedApps;
+
+static void
+load_trusted_apps (TrustedApps *trusted)
+{
+  g_autofree char *contents = NULL;
+  g_auto (GStrv) lines = NULL;
+  char **line;
+
+  g_hash_table_remove_all (trusted->app_ids);
+  if (!g_file_get_contents (trusted->path, &contents, NULL, NULL))
+    return;
+
+  lines = g_strsplit (contents, "\n", -1);
+  for (line = lines; *line; line++)
+    {
+      g_strstrip (*line);
+      if (**line)
+        g_hash_table_add (trusted->app_ids, g_strdup (*line));
+    }
+}
+
+static void
+on_trusted_apps_changed (GFileMonitor      *monitor,
+                         GFile             *file,
+                         GFile             *other_file,
+                         GFileMonitorEvent  event,
+                         TrustedApps       *trusted)
+{
+  if (event != G_FILE_MONITOR_EVENT_CHANGED &&
+      event != G_FILE_MONITOR_EVENT_ATTRIBUTE_CHANGED)
+    load_trusted_apps (trusted);
+}
+
+static void
+trusted_apps_free (TrustedApps *trusted)
+{
+  if (trusted->monitor)
+    g_signal_handlers_disconnect_by_data (trusted->monitor, trusted);
+  g_clear_object (&trusted->monitor);
+  g_hash_table_unref (trusted->app_ids);
+  g_free (trusted->path);
+  g_free (trusted);
+}
+
+static const char *
+trusted_apps_path (MetaContext *context)
+{
+  const char *check_path = g_getenv (TRUSTED_APPS_CHECK_PATH_VARIABLE);
+
+  if (check_path &&
+      meta_backend_is_headless (meta_context_get_backend (context)))
+    return check_path;
+
+  return TRUSTED_APPS_PATH;
+}
+
+static TrustedApps *
+trusted_apps_of (MetaContext *context)
+{
+  TrustedApps *trusted = g_object_get_data (G_OBJECT (context), TRUSTED_APPS_KEY);
+  g_autoptr (GFile) file = NULL;
+
+  if (trusted)
+    return trusted;
+
+  trusted = g_new0 (TrustedApps, 1);
+  trusted->path = g_strdup (trusted_apps_path (context));
+  trusted->app_ids = g_hash_table_new_full (g_str_hash, g_str_equal, g_free, NULL);
+
+  file = g_file_new_for_path (trusted->path);
+  trusted->monitor = g_file_monitor_file (file, G_FILE_MONITOR_NONE, NULL, NULL);
+  if (trusted->monitor)
+    {
+      g_signal_connect (trusted->monitor, "changed",
+                        G_CALLBACK (on_trusted_apps_changed), trusted);
+    }
+
+  load_trusted_apps (trusted);
+  g_object_set_data_full (G_OBJECT (context), TRUSTED_APPS_KEY, trusted,
+                          (GDestroyNotify) trusted_apps_free);
+  return trusted;
+}
+
+/**
+ * meta_context_is_app_trusted:
+ * @context: a #MetaContext
+ * @app_id: a Flatpak app ID
+ *
+ * Returns: whether the app was given full access, so it counts as unsandboxed
+ */
+gboolean
+meta_context_is_app_trusted (MetaContext *context,
+                             const char  *app_id)
+{
+  g_return_val_if_fail (META_IS_CONTEXT (context), FALSE);
+  g_return_val_if_fail (app_id, FALSE);
+
+  return g_hash_table_contains (trusted_apps_of (context)->app_ids, app_id);
+}
+
+static unsigned long
+read_root_mount_id (const char *mountinfo)
+{
+  char line[24] = { 0 };
+  g_autofd int fd = open (mountinfo, O_RDONLY | O_CLOEXEC);
+
+  if (fd < 0 || read (fd, line, sizeof (line) - 1) <= 0)
+    return 0;
+
+  return strtoul (line, NULL, 10);
+}
+
+static char *
+flatpak_app_id_of (pid_t pid)
+{
+  g_autofree char *path = g_strdup_printf ("/proc/%d/root/.flatpak-info", pid);
+  g_autoptr (GKeyFile) info = g_key_file_new ();
+
+  if (!g_key_file_load_from_file (info, path, G_KEY_FILE_NONE, NULL))
+    return NULL;
+
+  return g_key_file_get_string (info, "Application", "name", NULL);
+}
+
+static gboolean
+shares_root_mount (pid_t pid)
+{
+  g_autofree char *mountinfo = g_strdup_printf ("/proc/%d/mountinfo", pid);
+  unsigned long root_mount_id = read_root_mount_id ("/proc/self/mountinfo");
+
+  return root_mount_id != 0 && read_root_mount_id (mountinfo) == root_mount_id;
+}
+
+static gboolean
+runs_trusted_flatpak (MetaContext *context,
+                      pid_t        pid)
+{
+  g_autofree char *app_id = flatpak_app_id_of (pid);
+
+  return app_id && meta_context_is_app_trusted (context, app_id);
+}
+
+gboolean
+meta_process_is_unsandboxed (MetaContext *context,
+                             int          pidfd,
+                             pid_t        pid)
+{
+  return (shares_root_mount (pid) || runs_trusted_flatpak (context, pid)) &&
+         pidfd_send_signal (pidfd, 0, NULL, 0) == 0;
+}
