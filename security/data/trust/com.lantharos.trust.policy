<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Luft</vendor>
  <vendor_url>https://github.com/Lantharos</vendor_url>

  <action id="com.lantharos.trust.check">
    <description>Check whether the disk can be encrypted</description>
    <message>Authentication is required to check the disk</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>

  <action id="com.lantharos.trust.manage-encryption">
    <description>Change how the disk is encrypted and unlocked</description>
    <message>Authentication is required to change the disk's encryption</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>

  <action id="com.lantharos.trust.manage-drive-encryption">
    <description>Encrypt or decrypt a drive and change how it unlocks</description>
    <message>Authentication is required to change a drive's encryption</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>

  <action id="com.lantharos.trust.unlock-drive">
    <description>Unlock a drive with the key this computer keeps for it</description>
    <message>Authentication is required to unlock this drive</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>

  <action id="com.lantharos.trust.show-recovery-key">
    <description>Show the recovery key of the disk or a drive</description>
    <message>Authentication is required to show the recovery key</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>

  <action id="com.lantharos.trust.accept-secure-boot-change">
    <description>Let the TPM unlock the disk with this computer's new Secure Boot settings</description>
    <message>Authentication is required to trust how this computer starts now</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>

  <action id="com.lantharos.trust.manage-secure-boot">
    <description>Change Secure Boot keys and how the computer starts</description>
    <message>Authentication is required to change how the computer starts</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>

  <action id="com.lantharos.trust.remove-other-systems">
    <description>Remove another system from this computer and give Luft its space</description>
    <message>Authentication is required to remove another system from this computer</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>

  <action id="com.lantharos.trust.resize-system">
    <description>Change the size of Luft's partition</description>
    <message>Authentication is required to change the size of Luft's partition</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>

  <action id="com.lantharos.trust.confirm-startup">
    <description>Confirm that this version of Luft started</description>
    <message>Authentication is required to confirm that the computer started</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>
</policyconfig>
