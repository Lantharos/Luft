## File dialogs

draft-dialog-open = Open
draft-dialog-open-folder = Open Folder
draft-dialog-save-as = Save As

## Problems saving and starting

# $encoding is the name of a text encoding, such as utf-8
draft-error-unknown-encoding = Unknown encoding { $encoding }
draft-error-unmappable = Some characters can't be saved as { $encoding }. Save with UTF-8 instead.
draft-error-nothing-to-save = Nothing to save
draft-error-not-file-path = Not a file path
draft-error-no-home = Could not find the home folder
draft-error-no-state-folder = Could not find the state folder
# A file asked to be removed isn't one of Draft's backups of unsaved changes
draft-error-not-backup = Not a backup
