---
import { faq } from '../../data/faq';
import { localize } from '../../i18n/pages';

const { t } = localize(Astro);
---

<section id="questions" class="page py-24 md:py-44">
	<div class="grid gap-10 md:grid-cols-12">
		<h2 class="reveal text-headline font-semibold md:col-span-4">{t('home-questions-heading')}</h2>
		<div class="md:col-span-8">
			{
				faq(t).map(({ question, answer }, index) => (
					<div class="border-b border-hairline">
						<h3>
							<button
								type="button"
								class="group flex w-full cursor-pointer items-center justify-between gap-6 py-6 text-start text-lg font-semibold"
								aria-expanded="false"
								aria-controls={`answer-${index}`}
								data-question
							>
								{question}
								<svg
									class="size-5 shrink-0 text-ink-muted transition-transform duration-(--spring-snappy-duration) ease-(--spring-snappy) group-aria-expanded:rotate-45"
									viewBox="0 0 20 20"
									fill="none"
									stroke="currentColor"
									stroke-width="1.75"
									stroke-linecap="round"
									aria-hidden="true"
								>
									<path d="M10 4v12M4 10h12" />
								</svg>
							</button>
						</h3>
						<div id={`answer-${index}`} class="faq-answer" hidden="until-found">
							<p class="max-w-2xl pb-7 text-ink-soft text-pretty">{answer}</p>
						</div>
					</div>
				))
			}
		</div>
	</div>
</section>

<script>
	const questions = [...document.querySelectorAll<HTMLButtonElement>('[data-question]')];
	const answerTo = (question: HTMLButtonElement) => document.getElementById(question.getAttribute('aria-controls')!)!;

	function open(chosen: HTMLButtonElement | null) {
		for (const question of questions) {
			question.setAttribute('aria-expanded', String(question === chosen));
			if (question === chosen) answerTo(question).removeAttribute('hidden');
			else answerTo(question).setAttribute('hidden', 'until-found');
		}
	}

	for (const question of questions) {
		question.addEventListener('click', () => open(question.getAttribute('aria-expanded') === 'true' ? null : question));
		answerTo(question).addEventListener('beforematch', () => open(question));
	}
</script>

<style>
	@media (scripting: none) {
		.faq-answer[hidden] {
			display: block;
			content-visibility: visible;
		}
	}
</style>
