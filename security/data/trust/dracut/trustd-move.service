[Unit]
Description=Open both halves of the system disk while Luft moves it
DefaultDependencies=no
Wants=tpm2.target
After=tpm2.target systemd-pcrphase-initrd.service
Before=cryptsetup.target initrd-root-device.target sysroot.mount

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/trustctl system-disk open-halves
SyslogIdentifier=trustd
TimeoutSec=infinity
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_ALG
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
