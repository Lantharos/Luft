# The name of the extension in Settings and the store
extension-name = Spotify Style
extension-description = Spotify in Luft's look, following the desktop's colors, fonts and light and dark styles
state-starting = Getting Spotify ready
state-no-spicetify = Spicetify isn't installed. It's what lets Spotify change its look, so install it from spicetify.app first.
state-no-spotify = Spotify wasn't found. Install it and open it once, then try again.
state-failed = Spotify couldn't be styled. Check that Spotify and Spicetify are up to date, then try again.
state-restart = Restart Spotify to see its new look.
state-ready = Spotify follows the desktop whenever it's open.
state-connected = Spotify is following the desktop.
try-again = Try again
