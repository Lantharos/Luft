diff --git a/src/compositor/meta-background-effect.c b/src/compositor/meta-background-effect.c
index 0ab5f3ddb72bf977f5269b58d5ce5f8be09cc64e..d4a9d0217270d14424d2bc0d22fd9ff8c82c911d 100644
--- a/src/compositor/meta-background-effect.c
+++ b/src/compositor/meta-background-effect.c
@@ -112,7 +112,10 @@ meta_background_apply_corners (const MetaBackgroundPaint *paint,
   corners.bounds.origin.x -= space->origin.x;
   corners.bounds.origin.y -= space->origin.y;
   corners.radius *= paint->transform.scale;
