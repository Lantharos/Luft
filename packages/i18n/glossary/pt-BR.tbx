<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE martif PUBLIC "ISO 12200:1999A//DTD MARTIF core (DXFcdV04)//EN" "TBXcdv04.dtd">
<martif type="TBX" xml:lang="en">
  <martifHeader>
    <fileDesc>
      <sourceDesc>
        <p>Luft glossary for pt-BR</p>
      </sourceDesc>
    </fileDesc>
  </martifHeader>
  <text>
    <body>
      <termEntry id="1">
        <descrip type="Translation needed">No</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>Luft</term>
          </tig>
        </langSet>
        <langSet xml:lang="pt-BR">
          <tig>
            <term>Luft</term>
            <note from="translator">Not translated. Name of the operating system; masculine, takes the article: o Luft, do Luft</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="2">
        <descrip type="Translation needed">No</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>Kestrel</term>
          </tig>
        </langSet>
        <langSet xml:lang="pt-BR">
          <tig>
            <term>Kestrel</term>
            <note from="translator">Not translated. Name of Luft's desktop; masculine</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="3">
        <descrip type="Translation needed">No</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>Rover</term>
          </tig>
        </langSet>
        <langSet xml:lang="pt-BR">
          <tig>
            <term>Rover</term>
            <note from="translator">Not translated. App name, the file manager; masculine like every app name</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="4">
        <descrip type="Translation needed">No</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>Magpie</term>
          </tig>
        </langSet>
        <langSet xml:lang="pt-BR">
          <tig>
            <term>Magpie</term>
            <note from="translator">Not translated. App name, the viewer for photos, videos, music and PDFs</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="5">
        <descrip type="Translation needed">No</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>Mailman</term>
          </tig>
        </langSet>
        <langSet xml:lang="pt-BR">
          <tig>
            <term>Mailman</term>
            <note from="translator">Not translated. App name, the mail app</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="6">
        <descrip type="Translation needed">No</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>Draft</term>
          </tig>
        </langSet>
        <langSet xml:lang="pt-BR">
          <tig>
            <term>Draft</term>
            <note from="translator">Not translated. App name, the text and code editor</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="7">
        <descrip type="Translation needed">No</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>Tern</term>
          </tig>
        </langSet>
        <langSet xml:lang="pt-BR">
          <tig>
            <term>Tern</term>
            <note from="translator">Not translated. App name, the terminal</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="8">
        <descrip type="Translation needed">No</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>Schelf</term>
          </tig>
        </langSet>
        <langSet xml:lang="pt-BR">
          <tig>
            <term>Schelf</term>
            <note from="translator">Not translated. App name, the app store</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="9">
        <descrip type="Translation needed">No</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>Barometer</term>
          </tig>
        </langSet>
        <langSet xml:lang="pt-BR">
          <tig>
            <term>Barometer</term>
            <note from="translator">Not translated. App name, the system monitor</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="10">
        <descrip type="Translation needed">No</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>Keys</term>
          </tig>
        </langSet>
        <langSet xml:lang="pt-BR">
          <tig>
            <term>Keys</term>
            <note from="translator">Not translated. App name, makes keyboard layouts and input methods</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="11">
        <descrip type="Translation needed">No</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>Meet Luft</term>
          </tig>
        </langSet>
        <langSet xml:lang="pt-BR">
          <tig>
            <term>Meet Luft</term>
            <note from="translator">Not translated. Name of the Windows app that prepares a PC for Luft</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="12">
        <descrip type="Translation needed">No</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>Helium</term>
          </tig>
        </langSet>
        <langSet xml:lang="pt-BR">
          <tig>
            <term>Helium</term>
            <note from="translator">Not translated. Name of the default browser</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="13">
        <descrip type="Translation needed">No</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>Flatpak</term>
          </tig>
        </langSet>
        <langSet xml:lang="pt-BR">
          <tig>
            <term>Flatpak</term>
            <note from="translator">Not translated. App packaging format</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="14">
        <descrip type="Translation needed">No</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>Secure Boot</term>
          </tig>
        </langSet>
        <langSet xml:lang="pt-BR">
          <tig>
            <term>Secure Boot</term>
            <note from="translator">Not translated. UEFI feature, named this way in every PC's firmware setup</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="15">
        <descrip type="Translation needed">No</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>TPM</term>
          </tig>
        </langSet>
        <langSet xml:lang="pt-BR">
          <tig>
            <term>TPM</term>
            <note from="translator">Not translated. Trusted Platform Module; in the interface usually called the security chip</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="16">
        <descrip type="Translation needed">No</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>Bluetooth</term>
          </tig>
        </langSet>
        <langSet xml:lang="pt-BR">
          <tig>
            <term>Bluetooth</term>
            <note from="translator">Not translated. Trademark</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="17">
        <langSet xml:lang="en">
          <tig>
            <term>Wi-Fi</term>
          </tig>
        </langSet>
        <langSet xml:lang="pt-BR">
          <tig>
            <term>Wi-Fi</term>
            <note from="translator">Wireless network; o Wi-Fi</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="18">
        <langSet xml:lang="en">
          <tig>
            <term>Settings</term>
          </tig>
        </langSet>
        <langSet xml:lang="pt-BR">
          <tig>
            <term>Configurações</term>
            <note from="translator">App name and the general word for settings; feminine plural, as on Windows and GNOME</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="19">
        <langSet xml:lang="en">
          <tig>
            <term>Disks</term>
          </tig>
        </langSet>
        <langSet xml:lang="pt-BR">
          <tig>
            <term>Discos</term>
            <note from="translator">App name for the disk utility</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="20">
        <langSet xml:lang="en">
          <tig>
            <term>Install Luft</term>
          </tig>
        </langSet>
        <langSet xml:lang="pt-BR">
          <tig>
            <term>Instalar o Luft</term>
            <note from="translator">App name of the installer</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="21">
        <langSet xml:lang="en">
          <tig>
            <term>Network Sign-In</term>
          </tig>
        </langSet>
        <langSet xml:lang="pt-BR">
          <tig>
            <term>Login na rede</term>
            <note from="translator">App that opens the sign-in page of a public Wi-Fi</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="22">
        <langSet xml:lang="en">
          <tig>
            <term>File Manager</term>
          </tig>
        </langSet>
        <langSet xml:lang="pt-BR">
          <tig>
            <term>Gerenciador de arquivos</term>
            <note from="translator">Generic name of Rover</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="23">
        <langSet xml:lang="en">
          <tig>
            <term>Media Viewer</term>
          </tig>
        </langSet>
        <langSet xml:lang="pt-BR">
          <tig>
            <term>Visualizador de mídia</term>
            <note from="translator">Generic name of Magpie</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="24">
        <langSet xml:lang="en">
          <tig>
            <term>Mail</term>
          </tig>
        </langSet>
        <langSet xml:lang="pt-BR">
          <tig>
            <term>E-mail</term>
            <note from="translator">Generic name of Mailman</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="25">
        <langSet xml:lang="en">
          <tig>
            <term>Text Editor</term>
          </tig>
        </langSet>
        <langSet xml:lang="pt-BR">
          <tig>
            <term>Editor de texto</term>
            <note from="translator">Generic name of Draft</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="26">
        <langSet xml:lang="en">
          <tig>
            <term>App Store</term>
          </tig>
        </langSet>
        <langSet xml:lang="pt-BR">
          <tig>
            <term>Loja de apps</term>
            <note from="translator">Generic name of Schelf</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="27">
        <langSet xml:lang="en">
          <tig>
            <term>System Monitor</term>
          </tig>
        </langSet>
        <langSet xml:lang="pt-BR">
          <tig>
            <term>Monitor do sistema</term>
            <note from="translator">Generic name of Barometer</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="28">
        <langSet xml:lang="en">
          <tig>
            <term>Keyboard Layouts</term>
          </tig>
        </langSet>
        <langSet xml:lang="pt-BR">
          <tig>
            <term>Layouts de teclado</term>
            <note from="translator">Generic name of Keys</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="29">
        <langSet xml:lang="en">
          <tig>
            <term>Start</term>
          </tig>
        </langSet>
        <langSet xml:lang="pt-BR">
          <tig>
            <term>Start</term>
            <note from="translator">The menu opened with Super or the Luft mark; a name; masculine, in running text o menu Start</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="30">
        <langSet xml:lang="en">
          <tig>
            <term>board</term>
          </tig>
        </langSet>
        <langSet xml:lang="pt-BR">
          <tig>
            <term>quadro</term>
            <note from="translator">Mode that lays a workspace's windows side by side on an endless canvas; masculine</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="31">
        <langSet xml:lang="en">
          <tig>
            <term>Quick settings</term>
          </tig>
        </langSet>
        <langSet xml:lang="pt-BR">
          <tig>
            <term>Configurações rápidas</term>
            <note from="translator">Panel of switches and sliders opened from the status icons; feminine plural</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="32">
        <langSet xml:lang="en">
          <tig>
            <term>notification center</term>
          </tig>
        </langSet>
        <langSet xml:lang="pt-BR">
          <tig>
            <term>central de notificações</term>
            <note from="translator">Panel with notifications, media and the calendar, opened from the clock; feminine</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="33">
        <langSet xml:lang="en">
          <tig>
            <term>All windows</term>
          </tig>
        </langSet>
        <langSet xml:lang="pt-BR">
          <tig>
            <term>Todas as janelas</term>
            <note from="translator">The task view: every window of a workspace and the workspaces, Super+Tab</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="34">
        <langSet xml:lang="en">
          <tig>
            <term>snap</term>
          </tig>
        </langSet>
        <langSet xml:lang="pt-BR">
          <tig>
            <term>ajustar</term>
            <note from="translator">verb: put a window into a half, third or quarter of the screen</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="35">
        <langSet xml:lang="en">
          <tig>
            <term>snap layout</term>
          </tig>
        </langSet>
        <langSet xml:lang="pt-BR">
          <tig>
            <term>layout de ajuste</term>
            <note from="translator">One of the arrangements offered by Super+Z; masculine</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="36">
        <langSet xml:lang="en">
          <tig>
            <term>snap group</term>
          </tig>
        </langSet>
        <langSet xml:lang="pt-BR">
          <tig>
            <term>grupo de ajuste</term>
            <note from="translator">Windows snapped side by side that come back together; masculine</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="37">
        <langSet xml:lang="en">
          <tig>
            <term>taskbar</term>
          </tig>
        </langSet>
        <langSet xml:lang="pt-BR">
          <tig>
            <term>barra de tarefas</term>
            <note from="translator">The bar along the bottom of the screen; feminine</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="38">
        <langSet xml:lang="en">
          <tig>
            <term>tray</term>
          </tig>
        </langSet>
        <langSet xml:lang="pt-BR">
          <tig>
            <term>bandeja do sistema</term>
            <note from="translator">Taskbar button holding the icons of apps running in the background; feminine</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="39">
        <langSet xml:lang="en">
          <tig>
            <term>status icons</term>
          </tig>
        </langSet>
        <langSet xml:lang="pt-BR">
          <tig>
            <term>ícones de status</term>
            <note from="translator">Taskbar icons for network, sound and battery that open Quick settings</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="40">
        <langSet xml:lang="en">
          <tig>
            <term>lock screen</term>
          </tig>
        </langSet>
        <langSet xml:lang="pt-BR">
          <tig>
            <term>tela de bloqueio</term>
            <note from="translator">Screen shown while the session is locked; feminine</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="41">
        <langSet xml:lang="en">
          <tig>
            <term>login screen</term>
          </tig>
        </langSet>
        <langSet xml:lang="pt-BR">
          <tig>
            <term>tela de login</term>
            <note from="translator">Screen listing the people on the computer before anyone signs in; feminine</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="42">
        <langSet xml:lang="en">
          <tig>
            <term>workspace</term>
          </tig>
        </langSet>
        <langSet xml:lang="pt-BR">
          <tig>
            <term>espaço de trabalho</term>
            <note from="translator">One of up to ten separate desktops; masculine</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="43">
        <langSet xml:lang="en">
          <tig>
            <term>desktop</term>
          </tig>
        </langSet>
        <langSet xml:lang="pt-BR">
          <tig>
            <term>área de trabalho</term>
            <note from="translator">The background area behind the windows; also the whole desktop environment; feminine</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="44">
        <langSet xml:lang="en">
          <tig>
            <term>wallpaper</term>
          </tig>
        </langSet>
        <langSet xml:lang="pt-BR">
          <tig>
            <term>papel de parede</term>
            <note from="translator">Picture behind the desktop; masculine</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="45">
        <langSet xml:lang="en">
          <tig>
            <term>accent color</term>
          </tig>
        </langSet>
        <langSet xml:lang="pt-BR">
          <tig>
            <term>cor de destaque</term>
            <note from="translator">Color taken from the wallpaper and used for highlights; feminine</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="46">
        <langSet xml:lang="en">
          <tig>
            <term>dark style</term>
          </tig>
        </langSet>
        <langSet xml:lang="pt-BR">
          <tig>
            <term>Modo escuro</term>
            <note from="translator">Quick settings tile that switches between light and dark</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="47">
        <langSet xml:lang="en">
          <tig>
            <term>Night light</term>
          </tig>
        </langSet>
        <langSet xml:lang="pt-BR">
          <tig>
            <term>Luz noturna</term>
            <note from="translator">Warmer screen colors in the evening; feminine</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="48">
        <langSet xml:lang="en">
          <tig>
            <term>Do Not Disturb</term>
          </tig>
        </langSet>
        <langSet xml:lang="pt-BR">
          <tig>
            <term>Não perturbe</term>
            <note from="translator">Holds back notification banners and sounds; masculine (o Não perturbe)</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="49">
        <langSet xml:lang="en">
          <tig>
            <term>Airplane mode</term>
          </tig>
        </langSet>
        <langSet xml:lang="pt-BR">
          <tig>
            <term>Modo avião</term>
            <note from="translator">Turns off every radio</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="50">
        <langSet xml:lang="en">
          <tig>
            <term>Keep awake</term>
          </tig>
        </langSet>
        <langSet xml:lang="pt-BR">
          <tig>
            <term>Manter ativo</term>
            <note from="translator">Keeps the screen on for a while</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="51">
        <langSet xml:lang="en">
          <tig>
            <term>Power mode</term>
          </tig>
        </langSet>
        <langSet xml:lang="pt-BR">
          <tig>
            <term>Modo de energia</term>
            <note from="translator">Performance, Balanced or Power saver</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="52">
        <langSet xml:lang="en">
          <tig>
            <term>Power saver</term>
          </tig>
        </langSet>
        <langSet xml:lang="pt-BR">
          <tig>
            <term>Economia de energia</term>
            <note from="translator">Power mode</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="53">
        <langSet xml:lang="en">
          <tig>
            <term>Dictation</term>
          </tig>
        </langSet>
        <langSet xml:lang="pt-BR">
          <tig>
            <term>Ditado</term>
            <note from="translator">Typing by speaking; masculine</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="54">
        <langSet xml:lang="en">
          <tig>
            <term>clipboard</term>
          </tig>
        </langSet>
        <langSet xml:lang="pt-BR">
          <tig>
            <term>área de transferência</term>
            <note from="translator">Holds what was copied; feminine</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="55">
        <langSet xml:lang="en">
          <tig>
            <term>clipboard history</term>
          </tig>
        </langSet>
        <langSet xml:lang="pt-BR">
          <tig>
            <term>histórico da área de transferência</term>
            <note from="translator">List of recently copied items, Super+V</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="56">
        <langSet xml:lang="en">
          <tig>
            <term>emoji</term>
          </tig>
        </langSet>
        <langSet xml:lang="pt-BR">
          <tig>
            <term>emoji</term>
            <note from="translator">noun; masculine, plural emojis</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="57">
        <langSet xml:lang="en">
          <tig>
            <term>screenshot</term>
          </tig>
        </langSet>
        <langSet xml:lang="pt-BR">
          <tig>
            <term>captura de tela</term>
            <note from="translator">Picture of the screen; feminine, plural capturas de tela</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="58">
        <langSet xml:lang="en">
          <tig>
            <term>screen recording</term>
          </tig>
        </langSet>
        <langSet xml:lang="pt-BR">
          <tig>
            <term>gravação de tela</term>
            <note from="translator">Video of the screen; feminine</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="59">
        <langSet xml:lang="en">
          <tig>
            <term>privacy indicator</term>
          </tig>
        </langSet>
        <langSet xml:lang="pt-BR">
          <tig>
            <term>indicador de privacidade</term>
            <note from="translator">Taskbar icon shown while the camera, microphone, location or screen is in use</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="60">
        <langSet xml:lang="en">
          <tig>
            <term>Full access</term>
          </tig>
        </langSet>
        <langSet xml:lang="pt-BR">
          <tig>
            <term>Acesso total</term>
            <note from="translator">Schelf switch that lets a Flatpak app leave its sandbox: all files, clipboard in the background, other apps' windows; masculine</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="61">
