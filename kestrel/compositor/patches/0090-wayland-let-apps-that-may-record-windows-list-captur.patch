@@ -116,6 +116,39 @@ meta_wayland_filter_unsandboxed (const struct wl_client *client,
   return META_WAYLAND_ACCESS_ALLOWED;
 }
 
+/**
+ * meta_wayland_client_may_capture_windows:
+ * @context: the #MetaContext
+ * @client: a Wayland client
+ *
+ * Returns: whether @client may see and record windows and show overlays:
+ *   it runs outside a sandbox, or its app was given window-capture
+ */
+gboolean
+meta_wayland_client_may_capture_windows (MetaContext            *context,
+                                         const struct wl_client *client)
+{
+  const char *app_id;
+
+  if (!meta_wayland_client_is_sandboxed (client))
+    return TRUE;
+
+  app_id = meta_wayland_client_get_sandboxed_app_id (client);
+  return app_id &&
+         meta_context_is_app_permitted (context, META_PERMISSION_WINDOW_CAPTURE, app_id);
+}
+
+MetaWaylandAccess
+meta_wayland_filter_window_capture (const struct wl_client *client,
+                                    const struct wl_global *global,
+                                    gpointer                user_data)
+{
+  MetaContext *context = user_data;
+
+  return meta_wayland_client_may_capture_windows (context, client) ? META_WAYLAND_ACCESS_ALLOWED
+                                                                    : META_WAYLAND_ACCESS_DENIED;
+}
