+/**
+ * clutter_blur_node_set_area: (skip)
+ * @node: a #ClutterBlurNode
+ * @area: the parts of the blurred area that are wanted, from its top left
+ *
+ * Blurs only what @area needs, so only the pixels within
+ * clutter_blur_node_get_reach() of it are read.
+ */
+void
+clutter_blur_node_set_area (ClutterPaintNode *node,
+                            const MtkRegion  *area)
+{
+  ClutterBlurNode *blur_node = CLUTTER_BLUR_NODE (node);
+  MtkRectangle whole = { 0, 0, blur_node->width, blur_node->height };
+  g_autoptr (MtkRegion) grown = mtk_region_create ();
+  int reach = blur_node->reach;
+  int i;
+
+  for (i = 0; i < mtk_region_num_rectangles (area); i++)
+    {
+      MtkRectangle rect = mtk_region_get_rectangle (area, i);
+
+      mtk_region_union_rectangle (grown, &MTK_RECTANGLE_INIT (rect.x - reach,
+                                                              rect.y - reach,
+                                                              rect.width + 2 * reach,
+                                                              rect.height + 2 * reach));
+    }
+  mtk_region_intersect_rectangle (grown, &whole);
+
+  g_clear_pointer (&blur_node->area, g_array_unref);
+  if (mtk_region_contains_rectangle (grown, &whole) == MTK_REGION_OVERLAP_IN)
+    return;
+
+  blur_node->area = g_array_sized_new (FALSE, FALSE, sizeof (MtkRectangle),
+                                       mtk_region_num_rectangles (grown));
+  for (i = 0; i < mtk_region_num_rectangles (grown); i++)
+    {
+      MtkRectangle rect = mtk_region_get_rectangle (grown, i);
+
+      g_array_append_val (blur_node->area, rect);
+    }
+}
+
+/**
+ * clutter_blur_node_get_reach: (skip)
