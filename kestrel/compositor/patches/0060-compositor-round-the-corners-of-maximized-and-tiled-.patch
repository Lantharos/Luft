 src/compositor/meta-shaped-texture.c |   3 +-
 src/compositor/meta-surface-actor.c  |   3 +-
 src/compositor/meta-window-corners.c | 148 +++++++++++++++++++++++++--
 src/compositor/meta-window-corners.h |  14 +++
 src/compositor/meta-window-shadow.c  |   1 +
 src/meta/compositor.h                |   5 +
 7 files changed, 190 insertions(+), 19 deletions(-)

