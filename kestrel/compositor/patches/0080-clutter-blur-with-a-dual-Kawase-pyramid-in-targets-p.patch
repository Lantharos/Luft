-static CoglPipeline*
-create_blur_pipeline (CoglContext *ctx)
+static float
+interpolate_offset (const float *sigmas,
+                    float        sigma)
 {
-  static CoglPipelineKey blur_pipeline_key = "clutter-blur-pipeline-private";
-  CoglPipeline *blur_pipeline;
+  int i;
 
-  blur_pipeline =
-    cogl_context_get_named_pipeline (ctx, &blur_pipeline_key);
+  for (i = 1; i < OFFSETS - 1 && sigma > sigmas[i]; i++)
+    ;
+
+  return table_offsets[i - 1] +
+    (sigma - sigmas[i - 1]) / (sigmas[i] - sigmas[i - 1]) *
+    (table_offsets[i] - table_offsets[i - 1]);
+}
+
+/**
+ * clutter_blur_get_levels: (skip)
+ * @radius: blur radius, twice the sigma of the gaussian blur it matches
+ * @offset: (out): the sampling offset that matches @radius at that depth
+ *
+ * Returns: how many times the texture is halved, 0 for no blur
+ */
+int
+clutter_blur_get_levels (float  radius,
+                         float *offset)
+{
+  float sigma = radius / 2.0f;
+  float scale = 1.0f;
+  int levels;
+
+  if (sigma < 0.5f)
+    {
+      *offset = 0.0f;
+      return 0;
+    }
+
+  for (levels = SMALLEST_TABLE_LEVELS;
+       levels < LARGEST_TABLE_LEVELS &&
+       sigma > table_sigmas[levels - SMALLEST_TABLE_LEVELS][WIDEST_OFFSET];
+       levels++)
+    ;
+
+  while (levels < CLUTTER_BLUR_MAX_LEVELS &&
+         sigma / scale > table_sigmas[LARGEST_TABLE_LEVELS - SMALLEST_TABLE_LEVELS][WIDEST_OFFSET])
+    {
+      scale *= 2.0f;
+      levels++;
+    }
+
+  *offset = MAX (0.0f, interpolate_offset (table_sigmas[MIN (levels, LARGEST_TABLE_LEVELS) - SMALLEST_TABLE_LEVELS],
+                                           sigma / scale));
+  return levels;
+}
