[Unit]
Description=Set up installed apps
After=kestrel-session.target graphical-session.target luft-preinstall.service
PartOf=graphical-session.target
ConditionUser=!@system

[Service]
Type=oneshot
ExecStart=/usr/libexec/luft-launch /usr/bin/schelf --integrate-apps
Nice=10
IOSchedulingClass=idle

[Install]
WantedBy=kestrel-session.target
