diff --git a/clutter/clutter/clutter-view-filter.c b/clutter/clutter/clutter-view-filter.c
new file mode 100644
index 0000000000000000000000000000000000000000..5a7ee54867587de96f92b7b173e4c6b92d3cb90d
--- /dev/null
+++ b/clutter/clutter/clutter-view-filter.c
@@ -0,0 +1,373 @@
+/*
+ * Copyright (C) 2026 Lantharos
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library. If not, see <http://www.gnu.org/licenses/>.
+ */
+
+/**
+ * ClutterViewFilter:
+ *
+ * A chain of fragment shaders a [class@Clutter.StageView] sends what it painted
+ * through on its way to the screen.
+ *
+ * The view keeps the painted scene in a texture, so a frame only paints what
+ * changed and a frame that changes nothing isn't drawn at all, while the shaders
+ * run over the whole view. Each pass samples the scene as layer 0 and the result
+ * of earlier passes as the layers after it, and draws into a texture of its own
+ * at its scale of the view. The last pass draws to the screen.
+ */
+
+#include "config.h"
+
+#include "clutter/clutter-view-filter-private.h"
+
+#include <math.h>
+
+typedef struct _FilterPass
+{
+  CoglSnippet *snippet;
+  float scale;
+  CoglPipeline *pipeline;
+  CoglOffscreen *target;
+} FilterPass;
+
+typedef struct _FilterUniform
+{
+  int n_components;
+  int n_values;
+  float *values;
+} FilterUniform;
+
+struct _ClutterViewFilter
+{
+  GObject parent_instance;
+
+  GPtrArray *passes;
+  GHashTable *uniforms;
+  CoglPipeline *output;
+  gboolean captured;
+  int width;
+  int height;
+};
+
+G_DEFINE_FINAL_TYPE (ClutterViewFilter, clutter_view_filter, G_TYPE_OBJECT)
+
+static void
+filter_pass_free (FilterPass *pass)
+{
+  g_clear_object (&pass->snippet);
+  g_clear_object (&pass->pipeline);
+  g_clear_object (&pass->target);
+  g_free (pass);
+}
+
+static void
+filter_uniform_free (FilterUniform *uniform)
+{
+  g_free (uniform->values);
+  g_free (uniform);
+}
+
+static void
+apply_uniform (CoglPipeline  *pipeline,
+               const char    *name,
+               FilterUniform *uniform)
+{
+  int location = cogl_pipeline_get_uniform_location (pipeline, name);
+
+  cogl_pipeline_set_uniform_float (pipeline, location,
+                                   uniform->n_components,
+                                   uniform->n_values / uniform->n_components,
+                                   uniform->values);
+}
+
+static void
+apply_uniforms (ClutterViewFilter *filter,
+                CoglPipeline      *pipeline)
+{
+  GHashTableIter iter;
+  gpointer name, uniform;
+
+  g_hash_table_iter_init (&iter, filter->uniforms);
+  while (g_hash_table_iter_next (&iter, &name, &uniform))
+    apply_uniform (pipeline, name, uniform);
+}
+
+static void
+clear_targets (ClutterViewFilter *filter)
+{
+  unsigned int i;
+
+  for (i = 0; i < filter->passes->len; i++)
+    {
+      FilterPass *pass = g_ptr_array_index (filter->passes, i);
+
+      g_clear_object (&pass->pipeline);
+      g_clear_object (&pass->target);
+    }
+}
+
+static CoglPipeline *
+create_pipeline (ClutterViewFilter *filter,
+                 CoglContext       *context,
+                 FilterPass        *pass,
+                 unsigned int       index)
+{
+  CoglPipeline *pipeline = cogl_pipeline_new (context);
+  unsigned int i;
+
+  cogl_pipeline_set_static_name (pipeline, "ClutterViewFilter");
+  cogl_pipeline_set_blend (pipeline, "RGBA = ADD (SRC_COLOR, 0)", NULL);
+  cogl_pipeline_add_snippet (pipeline, pass->snippet);
+
+  for (i = 0; i <= index; i++)
+    {
+      cogl_pipeline_set_layer_filters (pipeline, i,
+                                       COGL_PIPELINE_FILTER_LINEAR,
+                                       COGL_PIPELINE_FILTER_LINEAR);
+      cogl_pipeline_set_layer_wrap_mode (pipeline, i,
+                                         COGL_PIPELINE_WRAP_MODE_CLAMP_TO_EDGE);
+    }
+
+  for (i = 0; i < index; i++)
+    {
+      FilterPass *earlier = g_ptr_array_index (filter->passes, i);
+
+      cogl_pipeline_set_layer_texture (pipeline, i + 1,
+                                       cogl_offscreen_get_texture (earlier->target));
+    }
+
+  apply_uniforms (filter, pipeline);
+  return pipeline;
+}
+
+static void
+ensure_passes (ClutterViewFilter *filter,
+               CoglTexture       *scene)
+{
+  CoglContext *context = cogl_texture_get_context (scene);
+  int width = cogl_texture_get_width (scene);
+  int height = cogl_texture_get_height (scene);
+  unsigned int i;
+
+  if (filter->width != width || filter->height != height)
+    {
+      clear_targets (filter);
+      filter->width = width;
+      filter->height = height;
+    }
+
+  for (i = 0; i < filter->passes->len; i++)
+    {
+      FilterPass *pass = g_ptr_array_index (filter->passes, i);
+      gboolean last = i == filter->passes->len - 1;
+
+      if (!last && !pass->target)
+        {
+          g_autoptr (CoglTexture) texture = NULL;
+          g_autoptr (GError) error = NULL;
+
+          texture = cogl_texture_2d_new_with_size (context,
+                                                   MAX ((int) roundf (width * pass->scale), 1),
+                                                   MAX ((int) roundf (height * pass->scale), 1));
+          pass->target = cogl_offscreen_new_with_texture (texture);
+          if (!cogl_framebuffer_allocate (COGL_FRAMEBUFFER (pass->target), &error))
+            g_warning ("Failed to allocate a filter pass: %s", error->message);
+        }
+
+      if (!pass->pipeline)
+        pass->pipeline = create_pipeline (filter, context, pass, i);
+    }
+}
+
+/*
+ * Draws every pass but the last over @scene, and returns the pipeline of the
+ * last, which samples them and @scene, for the caller to draw where it wants.
+ */
+CoglPipeline *
+clutter_view_filter_run (ClutterViewFilter *filter,
+                         CoglTexture       *scene)
+{
+  unsigned int last = filter->passes->len - 1;
+  FilterPass *final_pass;
+  unsigned int i;
+
+  ensure_passes (filter, scene);
+
+  for (i = 0; i < last; i++)
+    {
+      FilterPass *pass = g_ptr_array_index (filter->passes, i);
+
+      cogl_pipeline_set_layer_texture (pass->pipeline, 0, scene);
+      cogl_framebuffer_draw_textured_rectangle (COGL_FRAMEBUFFER (pass->target),
+                                                pass->pipeline,
+                                                -1, 1, 1, -1,
+                                                0, 0, 1, 1);
+    }
+
+  final_pass = g_ptr_array_index (filter->passes, last);
+  cogl_pipeline_set_layer_texture (final_pass->pipeline, 0, scene);
+  if (filter->output)
+    {
+      cogl_pipeline_set_layer_texture (filter->output, 0, scene);
+      return filter->output;
+    }
+
+  return final_pass->pipeline;
+}
+
+/* A copy of the last pass for the view to fit to its output. */
+CoglPipeline *
+clutter_view_filter_new_output (ClutterViewFilter *filter,
+                                CoglTexture       *scene)
+{
+  FilterPass *final_pass;
+
+  ensure_passes (filter, scene);
+  final_pass = g_ptr_array_index (filter->passes, filter->passes->len - 1);
+  return cogl_pipeline_copy (final_pass->pipeline);
+}
+
+void
+clutter_view_filter_set_output (ClutterViewFilter *filter,
+                                CoglPipeline      *output)
+{
+  g_set_object (&filter->output, output);
+}
+
+/**
+ * clutter_view_filter_add_pass:
+ * @filter: a #ClutterViewFilter
+ * @snippet: a fragment snippet
+ * @scale: the size of what the pass draws, as a part of the view's
+ *
+ * Adds a pass after those already there. The last pass always has the view's
+ * size, whatever its @scale says.
+ */
+void
+clutter_view_filter_add_pass (ClutterViewFilter *filter,
+                              CoglSnippet       *snippet,
+                              float              scale)
+{
+  FilterPass *pass = g_new0 (FilterPass, 1);
+
+  pass->snippet = g_object_ref (snippet);
+  pass->scale = scale;
+  g_ptr_array_add (filter->passes, pass);
+  clear_targets (filter);
+}
+
+/**
+ * clutter_view_filter_set_uniform:
+ * @filter: a #ClutterViewFilter
+ * @name: the uniform
+ * @n_components: floats per value
+ * @values: (array length=n_values): the values
+ * @n_values: how many floats @values holds
+ *
+ * Sets a uniform of every pass. It takes effect the next time the filter runs;
+ * [method@Clutter.StageView.queue_filter_frame] runs it without painting.
+ */
+void
+clutter_view_filter_set_uniform (ClutterViewFilter *filter,
+                                 const char        *name,
+                                 int                n_components,
+                                 const float       *values,
+                                 int                n_values)
+{
+  FilterUniform *uniform = g_new0 (FilterUniform, 1);
+  unsigned int i;
+
+  uniform->n_components = n_components;
+  uniform->n_values = n_values;
+  uniform->values = g_memdup2 (values, n_values * sizeof (float));
+  g_hash_table_replace (filter->uniforms, g_strdup (name), uniform);
+
+  for (i = 0; i < filter->passes->len; i++)
+    {
+      FilterPass *pass = g_ptr_array_index (filter->passes, i);
+
+      if (pass->pipeline)
+        apply_uniform (pass->pipeline, name, uniform);
+    }
+
+  if (filter->output)
+    apply_uniform (filter->output, name, uniform);
+}
+
+/**
+ * clutter_view_filter_set_captured:
+ * @filter: a #ClutterViewFilter
+ * @captured: whether screenshots and recordings show the filter
+ *
+ * Decides what [method@Clutter.Stage.paint_to_framebuffer] paints where the
+ * filter's view lies. Without it they see what the view paints, unfiltered.
+ */
+void
+clutter_view_filter_set_captured (ClutterViewFilter *filter,
+                                  gboolean           captured)
+{
+  filter->captured = captured;
+}
+
+/**
+ * clutter_view_filter_get_captured:
+ * @filter: a #ClutterViewFilter
+ *
+ * Returns: whether screenshots and recordings show the filter
+ */
+gboolean
+clutter_view_filter_get_captured (ClutterViewFilter *filter)
+{
+  return filter->captured;
+}
+
+static void
+clutter_view_filter_finalize (GObject *object)
+{
+  ClutterViewFilter *filter = CLUTTER_VIEW_FILTER (object);
+
+  g_clear_object (&filter->output);
+  g_clear_pointer (&filter->passes, g_ptr_array_unref);
+  g_clear_pointer (&filter->uniforms, g_hash_table_unref);
+
+  G_OBJECT_CLASS (clutter_view_filter_parent_class)->finalize (object);
+}
+
+static void
+clutter_view_filter_class_init (ClutterViewFilterClass *klass)
+{
+  GObjectClass *object_class = G_OBJECT_CLASS (klass);
+
+  object_class->finalize = clutter_view_filter_finalize;
+}
+
+static void
+clutter_view_filter_init (ClutterViewFilter *filter)
+{
+  filter->passes = g_ptr_array_new_with_free_func ((GDestroyNotify) filter_pass_free);
+  filter->uniforms = g_hash_table_new_full (g_str_hash, g_str_equal, g_free,
+                                            (GDestroyNotify) filter_uniform_free);
+}
+
+/**
+ * clutter_view_filter_new:
+ *
+ * Returns: (transfer full): a filter with no passes yet
+ */
+ClutterViewFilter *
+clutter_view_filter_new (void)
+{
+  return g_object_new (CLUTTER_TYPE_VIEW_FILTER, NULL);
+}
