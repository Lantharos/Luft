From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Kristof Imeri <kristof@lanth.me>
Date: Mon, 19 Oct 2026 03:09:02 +0200
Subject: [PATCH 47/51] keybindings: finish shortcuts that respond to release
 by their key

A shortcut that responds to its release only noticed it while its
modifiers were still held, so letting go of a modifier first, or
modifiers the shell treats as used up, left its key's release and
repeats to the focused window. Remember the keys held on such shortcuts
and match their repeats and release against the modifiers they were
pressed with.
---
 src/core/keybindings-private.h | 11 +++++++--
 src/core/keybindings.c         | 42 ++++++++++++++++++++++++++++------
 2 files changed, 44 insertions(+), 9 deletions(-)

diff --git a/src/core/keybindings-private.h b/src/core/keybindings-private.h
index 560c47eee33abecde9767a12c4e2e201557e68d9..26e7a74d561b05b3bbc4007e46e11f06a8811451 100644
--- a/src/core/keybindings-private.h
+++ b/src/core/keybindings-private.h
@@ -46,6 +46,12 @@ struct _MetaKeyHandler
   gboolean removed;
 };
 
+typedef struct
+{
+  xkb_keycode_t keycode;
+  xkb_mod_mask_t mask;
+} MetaPendingRelease;
+
 typedef struct _MetaResolvedKeyCombo {
   xkb_keycode_t *keycodes;
   int            len;
@@ -71,8 +77,6 @@ struct _MetaKeyBinding
   MetaKeyCombo combo;
   MetaResolvedKeyCombo resolved_combo;
   gint flags;
-  /* The binding should respond to release, and was just pressed */
-  gboolean release_pending;
   MetaKeyHandler *handler;
 };
 
@@ -129,6 +133,9 @@ typedef struct
 
   /* Alt+click button grabs */
   ClutterModifierType window_grab_modifiers;
+
+  /* Keys held down on bindings that respond to their release */
+  GArray *pending_releases;
 } MetaKeyBindingManager;
 
 void     meta_display_init_keys             (MetaDisplay *display);
diff --git a/src/core/keybindings.c b/src/core/keybindings.c
index 3fac255088c0ac30e5e2c4547c4a4ed06f1a68be..e12c070569898950f7c15768b150bdcee11048d6 100644
--- a/src/core/keybindings.c
+++ b/src/core/keybindings.c
@@ -1244,6 +1244,7 @@ meta_display_shutdown_keys (MetaDisplay *display)
 
   g_hash_table_destroy (keys->key_bindings_index);
   g_hash_table_destroy (keys->key_bindings);
+  g_array_unref (keys->pending_releases);
 
   resolved_key_combo_reset (&keys->overlay_resolved_key_combo);
   resolved_key_combo_reset (&keys->locate_pointer_resolved_key_combo);
@@ -1415,6 +1416,19 @@ get_modifiers (ClutterEvent *event)
   return pressed | latched | locked;
 }
 
+static int
+find_pending_release (MetaKeyBindingManager *keys,
+                      xkb_keycode_t          keycode)
+{
+  for (unsigned int i = 0; i < keys->pending_releases->len; i++)
+    {
+      if (g_array_index (keys->pending_releases, MetaPendingRelease, i).keycode == keycode)
+        return i;
+    }
+
+  return -1;
+}
+
 static gboolean
 process_event (MetaDisplay          *display,
                MetaWindow           *window,
@@ -1426,10 +1440,23 @@ process_event (MetaDisplay          *display,
   MetaResolvedKeyCombo resolved_combo = { &keycode, 1 };
   MetaKeyBinding *binding;
   ClutterModifierType modifiers;
+  gboolean is_release = clutter_event_type (event) == CLUTTER_KEY_RELEASE;
+  gboolean is_repeat =
+    (clutter_event_get_flags (event) & CLUTTER_EVENT_FLAG_REPEATED) != 0;
+  int pending = find_pending_release (keys, keycode);
 
   modifiers = get_modifiers (event);
   resolved_combo.mask = mask_from_event_params (keys, modifiers);
 
+  if (pending >= 0 && (is_release || is_repeat))
+    {
+      resolved_combo.mask =
+        g_array_index (keys->pending_releases, MetaPendingRelease, pending).mask;
+    }
+
+  if (pending >= 0 && is_release)
+    g_array_remove_index_fast (keys->pending_releases, pending);
+
   binding = get_keybinding (keys, &resolved_combo);
 
   if (!binding)
@@ -1463,8 +1490,7 @@ process_event (MetaDisplay          *display,
   if (meta_compositor_filter_keybinding (display->compositor, binding))
     goto not_found;
 
-  if (clutter_event_get_flags (event) & CLUTTER_EVENT_FLAG_REPEATED &&
-      binding->flags & META_KEY_BINDING_IGNORE_AUTOREPEAT)
+  if (is_repeat && binding->flags & META_KEY_BINDING_IGNORE_AUTOREPEAT)
     {
       meta_topic (META_DEBUG_KEYBINDINGS,
                   "Ignore autorepeat for handler %s",
@@ -1472,16 +1498,15 @@ process_event (MetaDisplay          *display,
       return CLUTTER_EVENT_STOP;
     }
 
-  if (clutter_event_type (event) == CLUTTER_KEY_RELEASE)
+  if (is_release)
     {
-      if (binding->release_pending)
+      if (pending >= 0)
         {
           meta_topic (META_DEBUG_KEYBINDINGS,
                       "Running release handler for %s",
                       binding->name);
 
           invoke_handler (display, binding->handler, window, event, binding);
-          binding->release_pending = FALSE;
           return CLUTTER_EVENT_STOP;
         }
       else
@@ -1499,13 +1524,15 @@ process_event (MetaDisplay          *display,
                   binding->name);
 
       invoke_handler (display, binding->handler, window, event, binding);
-      if (!binding->release_pending &&
+      if (pending < 0 &&
           ((binding->flags & META_KEY_BINDING_TRIGGER_RELEASE) != 0))
         {
+          MetaPendingRelease release = { keycode, resolved_combo.mask };
+
           meta_topic (META_DEBUG_KEYBINDINGS,
                       "Preparing release for handler %s",
                       binding->name);
-          binding->release_pending = TRUE;
+          g_array_append_val (keys->pending_releases, release);
         }
 
       return CLUTTER_EVENT_STOP;
@@ -2722,6 +2749,7 @@ meta_display_init_keys (MetaDisplay *display)
 
   keys->key_bindings = g_hash_table_new_full (NULL, NULL, NULL, (GDestroyNotify) meta_key_binding_free);
   keys->key_bindings_index = g_hash_table_new (NULL, NULL);
+  keys->pending_releases = g_array_new (FALSE, FALSE, sizeof (MetaPendingRelease));
 
   reload_modmap (keys);
 
