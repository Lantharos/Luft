+static MtkRegion *
+area_in_source (const MetaBackgroundPaint *paint,
+                const MtkRegion           *effect_region)
+{
+  MtkRegion *area = mtk_region_create ();
+  int i;
+
+  for (i = 0; i < mtk_region_num_rectangles (effect_region); i++)
+    {
+      MtkRectangle region_rect = mtk_region_get_rectangle (effect_region, i);
+      ClutterActorBox actor_box;
+      graphene_rect_t framebuffer_rect;
+      MtkRectangle rect;
+
+      if (!meta_background_region_rect_to_actor_box (&region_rect, paint->content_box,
+                                                     paint->content_width,
+                                                     paint->content_height,
+                                                     &actor_box) ||
+          !meta_background_actor_box_to_framebuffer (&actor_box, &paint->transform,
+                                                     &framebuffer_rect))
+        continue;
+
+      mtk_rectangle_from_graphene_rect (&framebuffer_rect, MTK_ROUNDING_STRATEGY_GROW, &rect);
