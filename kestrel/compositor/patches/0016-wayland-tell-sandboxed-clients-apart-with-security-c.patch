diff --git a/src/core/meta-sandbox.c b/src/core/meta-sandbox.c
new file mode 100644
index 0000000000000000000000000000000000000000..2cd3368f0163a3e8cd9ea928f8a05c716ea9b188
--- /dev/null
+++ b/src/core/meta-sandbox.c
@@ -0,0 +1,174 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "config.h"
+
+#include "core/meta-sandbox.h"
+
+#include <errno.h>
+#include <fcntl.h>
+#include <glib/gstdio.h>
+#include <sys/pidfd.h>
+#include <unistd.h>
+
+#include "meta/meta-context.h"
+
+#define PERMITTED_APPS_KEY "-meta-permitted-apps"
+#define SANDBOX_INFO "root/.flatpak-info"
+#define SANDBOX_INFO_MOUNT "/.flatpak-info"
+#define SANDBOX_INFO_LIMIT (64 * 1024)
+#define MOUNTS_LIMIT (4 * 1024 * 1024)
+
+static GHashTable *
+permitted_apps_of (MetaContext *context)
+{
+  GHashTable *permitted = g_object_get_data (G_OBJECT (context), PERMITTED_APPS_KEY);
+
+  if (permitted)
+    return permitted;
+
+  permitted = g_hash_table_new_full (g_str_hash, g_str_equal, g_free,
+                                     (GDestroyNotify) g_hash_table_unref);
+  g_object_set_data_full (G_OBJECT (context), PERMITTED_APPS_KEY, permitted,
+                          (GDestroyNotify) g_hash_table_unref);
+  return permitted;
+}
+
+/**
+ * meta_context_set_permitted_apps:
+ * @context: a #MetaContext
+ * @permission: a permission, such as "full-access" or "background-clipboard"
+ * @app_ids: (array zero-terminated=1) (nullable): the IDs of the sandboxed apps given it
+ *
+ * Replaces the apps given @permission. Apps given "full-access" count as
+ * unsandboxed.
+ */
+void
+meta_context_set_permitted_apps (MetaContext        *context,
+                                 const char         *permission,
+                                 const char * const *app_ids)
+{
+  GHashTable *apps;
+
+  g_return_if_fail (META_IS_CONTEXT (context));
+  g_return_if_fail (permission);
+
+  apps = g_hash_table_new_full (g_str_hash, g_str_equal, g_free, NULL);
+  for (; app_ids && *app_ids; app_ids++)
+    g_hash_table_add (apps, g_strdup (*app_ids));
+
+  g_hash_table_replace (permitted_apps_of (context), g_strdup (permission), apps);
+}
+
+/**
+ * meta_context_is_app_permitted:
+ * @context: a #MetaContext
+ * @permission: a permission, such as "full-access" or "background-clipboard"
+ * @app_id: the ID of a sandboxed app
+ *
+ * Returns: whether the app was given @permission
+ */
+gboolean
+meta_context_is_app_permitted (MetaContext *context,
+                               const char  *permission,
+                               const char  *app_id)
+{
+  GHashTable *apps;
+
+  g_return_val_if_fail (META_IS_CONTEXT (context), FALSE);
+  g_return_val_if_fail (permission, FALSE);
+  g_return_val_if_fail (app_id, FALSE);
+
+  apps = g_hash_table_lookup (permitted_apps_of (context), permission);
+  return apps && g_hash_table_contains (apps, app_id);
+}
+
+static GString *
+read_all (int   fd,
+          gsize limit)
+{
+  g_autoptr (GString) contents = g_string_new (NULL);
+  char buffer[4096];
+  ssize_t length;
+
+  while ((length = read (fd, buffer, sizeof (buffer))) > 0)
+    {
+      if (contents->len + length > limit)
+        return NULL;
+      g_string_append_len (contents, buffer, length);
+    }
+
+  return length < 0 ? NULL : g_steal_pointer (&contents);
+}
+
+static gboolean
+read_sandbox_info (int     info_fd,
+                   char  **app_id)
+{
+  g_autoptr (GString) contents = read_all (info_fd, SANDBOX_INFO_LIMIT);
+  g_autoptr (GKeyFile) info = g_key_file_new ();
+
+  if (!contents ||
+      !g_key_file_load_from_data (info, contents->str, contents->len,
+                                  G_KEY_FILE_NONE, NULL))
+    return FALSE;
+
+  *app_id = g_key_file_get_string (info, "Application", "name", NULL);
+  if (*app_id && **app_id)
+    return TRUE;
+
+  g_clear_pointer (app_id, g_free);
+  return FALSE;
+}
+
+static gboolean
+mounts_sandbox_info (int process_fd)
+{
+  g_autofd int mounts_fd = openat (process_fd, "mountinfo", O_RDONLY | O_CLOEXEC);
+  g_autoptr (GString) mounts = NULL;
+  g_auto (GStrv) lines = NULL;
+  char **line;
+
+  if (mounts_fd < 0 || !(mounts = read_all (mounts_fd, MOUNTS_LIMIT)))
+    return TRUE;
+
+  lines = g_strsplit (mounts->str, "\n", -1);
+  for (line = lines; *line; line++)
+    {
+      g_auto (GStrv) fields = g_strsplit (*line, " ", 6);
+
+      if (g_strv_length (fields) > 4 && g_str_equal (fields[4], SANDBOX_INFO_MOUNT))
+        return TRUE;
+    }
+
+  return FALSE;
+}
+
+gboolean
+meta_process_identify (int     pidfd,
+                       pid_t   pid,
+                       char  **app_id)
+{
+  g_autofree char *path = g_strdup_printf ("/proc/%d", pid);
+  g_autofd int process_fd = -1;
+  g_autofd int info_fd = -1;
+  gboolean identified;
+
+  *app_id = NULL;
+
+  process_fd = open (path, O_PATH | O_DIRECTORY | O_CLOEXEC);
+  if (process_fd < 0)
+    return FALSE;
+
+  info_fd = openat (process_fd, SANDBOX_INFO, O_RDONLY | O_NOFOLLOW | O_CLOEXEC);
+  if (info_fd >= 0)
+    identified = read_sandbox_info (info_fd, app_id);
+  else if (errno == ENOENT)
+    identified = TRUE;
+  else
+    identified = !mounts_sandbox_info (process_fd);
+
+  if (identified && pidfd_send_signal (pidfd, 0, NULL, 0) == 0)
+    return TRUE;
+
+  g_clear_pointer (app_id, g_free);
+  return FALSE;
+}
