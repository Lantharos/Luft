## Answers in Gust's search to questions about dates and times.
## The answer itself, such as "157 days" or "17:00", is formatted for the language; these describe it.

gust-search-answer-until = Do { $date }
gust-search-answer-since = Od { $date }
gust-search-answer-between = Od { $from } do { $to }
gust-search-answer-time-ahead = { $place }, { $hours ->
    [one] o { $hours } hodinu napřed
    [few] o { $hours } hodiny napřed
    [many] o { $hours } hodiny napřed
   *[other] o { $hours } hodin napřed
}
gust-search-answer-time-behind = { $place }, { $hours ->
    [one] o { $hours } hodinu pozadu
    [few] o { $hours } hodiny pozadu
    [many] o { $hours } hodiny pozadu
   *[other] o { $hours } hodin pozadu
}
gust-search-answer-time-same = { $place }, stejný čas jako tady
gust-search-answer-converted = { $place }, když je { $time } ({ $from })
gust-search-answer-converted-here = Tady, když je { $time } ({ $from })
gust-search-answer-converted-from-here = { $place }, když je tady { $time }

