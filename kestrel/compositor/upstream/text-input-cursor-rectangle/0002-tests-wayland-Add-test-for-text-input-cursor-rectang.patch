+
+#include "config.h"
+
+#include <glib.h>
+#include <wayland-client.h>
+
+#include "wayland-test-client-utils.h"
+
+#include "text-input-unstable-v3-client-protocol.h"
+
+static struct zwp_text_input_manager_v3 *text_input_manager;
+static struct wl_surface *entered_surface;
+
+static void
+text_input_handle_enter (void                     *data,
+                         struct zwp_text_input_v3 *text_input,
+                         struct wl_surface        *surface)
+{
+  entered_surface = surface;
+}
+
+static void
+text_input_handle_leave (void                     *data,
+                         struct zwp_text_input_v3 *text_input,
+                         struct wl_surface        *surface)
+{
+  entered_surface = NULL;
+}
+
+static void
+text_input_handle_preedit_string (void                     *data,
+                                  struct zwp_text_input_v3 *text_input,
+                                  const char               *text,
+                                  int32_t                   cursor_begin,
+                                  int32_t                   cursor_end)
+{
+}
+
+static void
+text_input_handle_commit_string (void                     *data,
+                                 struct zwp_text_input_v3 *text_input,
+                                 const char               *text)
+{
+}
+
+static void
+text_input_handle_delete_surrounding_text (void                     *data,
+                                           struct zwp_text_input_v3 *text_input,
+                                           uint32_t                  before_length,
+                                           uint32_t                  after_length)
+{
+}
+
+static void
+text_input_handle_done (void                     *data,
+                        struct zwp_text_input_v3 *text_input,
+                        uint32_t                  serial)
+{
+}
+
+static const struct zwp_text_input_v3_listener text_input_listener = {
+  text_input_handle_enter,
+  text_input_handle_leave,
+  text_input_handle_preedit_string,
+  text_input_handle_commit_string,
+  text_input_handle_delete_surrounding_text,
+  text_input_handle_done,
+};
+
+static void
+handle_registry_global (void               *user_data,
+                        struct wl_registry *registry,
+                        uint32_t            id,
+                        const char         *interface,
+                        uint32_t            version)
+{
+  if (strcmp (interface, "zwp_text_input_manager_v3") == 0)
+    {
+      text_input_manager = wl_registry_bind (registry, id,
+                                             &zwp_text_input_manager_v3_interface,
+                                             1);
+    }
+}
+
+static void
+handle_registry_global_remove (void               *user_data,
+                               struct wl_registry *registry,
+                               uint32_t            name)
+{
+}
+
+static const struct wl_registry_listener registry_listener = {
+  handle_registry_global,
+  handle_registry_global_remove
+};
+
+static void
+wait_for_enter (WaylandDisplay *display,
+                WaylandSurface *surface)
+{
+  while (entered_surface != surface->wl_surface)
+    wayland_display_dispatch (display);
+}
+
+static void
+cursor_rectangle_after_focus_change (WaylandDisplay           *display,
+                                     struct zwp_text_input_v3 *text_input)
+{
+  g_autoptr (WaylandSurface) closing_surface = NULL;
+  g_autoptr (WaylandSurface) surface = NULL;
+
+  closing_surface = wayland_surface_new (display, "text-input-closing",
+                                         100, 100, 0xffffffff);
+  wl_surface_commit (closing_surface->wl_surface);
+  wait_for_enter (display, closing_surface);
+
+  zwp_text_input_v3_enable (text_input);
+  zwp_text_input_v3_set_cursor_rectangle (text_input, 1, 2, 3, 4);
+  zwp_text_input_v3_commit (text_input);
+  g_clear_object (&closing_surface);
+  wl_display_roundtrip (display->display);
+
+  surface = wayland_surface_new (display, "text-input",
+                                 100, 100, 0xffffffff);
+  wl_surface_commit (surface->wl_surface);
+  wait_for_enter (display, surface);
+
+  zwp_text_input_v3_enable (text_input);
+  zwp_text_input_v3_set_cursor_rectangle (text_input, 10, 20, 30, 40);
+  zwp_text_input_v3_commit (text_input);
+  wl_surface_commit (surface->wl_surface);
+
+  test_driver_sync_point (display->test_driver, 0, NULL);
+  wait_for_sync_event (display, 0);
+}
+
+int
+main (int    argc,
+      char **argv)
+{
+  g_autoptr (WaylandDisplay) display = NULL;
+  struct wl_registry *registry;
+  struct zwp_text_input_v3 *text_input;
+
+  display = wayland_display_new (WAYLAND_DISPLAY_CAPABILITY_TEST_DRIVER);
+  registry = wl_display_get_registry (display->display);
+  wl_registry_add_listener (registry, &registry_listener, NULL);
+  wl_display_roundtrip (display->display);
+
+  g_assert_nonnull (text_input_manager);
+
+  text_input = zwp_text_input_manager_v3_get_text_input (text_input_manager,
+                                                         display->wl_seat);
+  zwp_text_input_v3_add_listener (text_input, &text_input_listener, NULL);
+
+  if (g_strcmp0 (argv[1], "cursor-rectangle-after-focus-change") == 0)
+    cursor_rectangle_after_focus_change (display, text_input);
+  else
+    g_assert_not_reached ();
+
+  zwp_text_input_v3_destroy (text_input);
+  zwp_text_input_manager_v3_destroy (text_input_manager);
+  wl_registry_destroy (registry);
+
+  return EXIT_SUCCESS;
+}
