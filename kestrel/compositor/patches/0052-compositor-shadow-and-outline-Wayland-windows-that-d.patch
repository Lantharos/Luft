 }
 
+/* Whether the compositor gives @window its shadow and outline: Wayland
+ * windows with rounded corners whose buffer doesn't reach past their frame,
+ * where a client would draw a shadow of its own. */
+gboolean
+meta_window_corners_casts_shadow (MetaWindow *window)
+{
+  MtkRectangle frame, buffer;
+
+  if (meta_window_get_client_type (window) != META_WINDOW_CLIENT_TYPE_WAYLAND ||
+      !meta_window_has_rounded_corners (window))
+    return FALSE;
+
+  switch (meta_window_get_window_type (window))
+    {
+    case META_WINDOW_NORMAL:
+    case META_WINDOW_DIALOG:
+    case META_WINDOW_MODAL_DIALOG:
+    case META_WINDOW_UTILITY:
+      break;
+    default:
+      return FALSE;
+    }
+
+  meta_window_get_frame_rect (window, &frame);
+  meta_window_get_buffer_rect (window, &buffer);
+  return frame.width > 0 && frame.height > 0 &&
+         mtk_rectangle_contains_rect (&frame, &buffer);
+}
+
 MetaWindowCorners
 meta_window_corners_for_actor (ClutterActor *actor)
 {
@@ -89,7 +118,7 @@ meta_window_corners_for_actor (ClutterActor *actor)
                                            bounds.size.width * x_scale,
                                            bounds.size.height * y_scale);
     }
-  corners.radius = MIN (15.0f * scale,
+  corners.radius = MIN (META_WINDOW_CORNER_RADIUS * scale,
                          MIN (corners.bounds.size.width,
                               corners.bounds.size.height) / 2.0f);
   return corners;
@@ -262,6 +291,24 @@ meta_window_corners_subtract_opaque (const MetaWindowCorners *corners,
     subtract_corners (corners, region, 0, corners->radius, corners->radius);
 }
 
+/* Leave only the pixels that lie wholly inside the rounded corners, so
+ * whatever goes under the window's antialiased edge stays there */
+void
+meta_window_corners_clip_inside (const MetaWindowCorners *corners,
+                                 MtkRegion               *region)
+{
+  float radius = corners->radius;
+
+  for (int y = 0; y < ceilf (radius); y++)
+    {
+      float distance = radius - y;
+      float width = ceilf (radius - sqrtf (MAX (radius * radius - distance * distance, 0)));
+
+      if (width > 0)
+        subtract_corners (corners, region, y, y + 1, width);
+    }
+}
+
 void
 meta_window_corners_clip_input (const MetaWindowCorners *corners,
                                 MtkRegion               *region)
@@ -277,3 +324,104 @@ meta_window_corners_clip_input (const MetaWindowCorners *corners,
         subtract_corners (corners, region, y, y + 1, width);
     }
 }
+
+#define OUTLINE_WIDTH 1.0f
+#define OUTLINE_GRAY 0.5f
+#define OUTLINE_ALPHA 0.3f
+
+static CoglPipeline *
+get_outline_pipeline (CoglContext *context)
+{
+  static CoglPipelineKey key = "kestrel-window-outline";
+  CoglPipeline *pipeline = cogl_context_get_named_pipeline (context, &key);
+
+  if (!pipeline)
+    {
+      g_autoptr (CoglSnippet) vertex = NULL;
+      g_autoptr (CoglSnippet) fragment = NULL;
+
+      /* Positions reach the shader already transformed, so the actor
+       * coordinates come in as texture coordinates of a blank layer */
+      pipeline = cogl_pipeline_new (context);
+      cogl_pipeline_set_layer_null_texture (pipeline, 0);
+      vertex = cogl_snippet_new (COGL_SNIPPET_HOOK_VERTEX,
+        "varying vec2 kestrel_position;\n",
+        "kestrel_position = cogl_tex_coord0_in.xy;\n");
+      fragment = cogl_snippet_new (COGL_SNIPPET_HOOK_FRAGMENT,
+        CORNER_DECLARATIONS
+        "uniform float kestrel_width;\n",
+        "vec2 half_size = kestrel_bounds.zw * 0.5;\n"
+        "vec2 q = abs(kestrel_position - kestrel_bounds.xy - half_size) - half_size + kestrel_radius;\n"
+        "float distance = length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - kestrel_radius;\n"
+        "float aa = max(fwidth(distance), 0.001);\n"
+        "float outside = smoothstep(-aa * 0.5, aa * 0.5, distance);\n"
+        "float inside = smoothstep(-aa * 0.5, aa * 0.5, distance + kestrel_width);\n"
+        "cogl_color_out *= inside - outside;\n");
+      cogl_pipeline_add_snippet (pipeline, vertex);
+      cogl_pipeline_add_snippet (pipeline, fragment);
+      cogl_pipeline_set_uniform_1f (pipeline,
+                                    cogl_pipeline_get_uniform_location (pipeline, "kestrel_width"),
+                                    OUTLINE_WIDTH);
+      cogl_context_set_named_pipeline (context, &key, pipeline);
+    }
+
+  return pipeline;
+}
+
+static void
+draw_band (CoglFramebuffer *framebuffer,
+           CoglPipeline    *pipeline,
+           float            x1,
+           float            y1,
+           float            x2,
+           float            y2)
+{
+  cogl_framebuffer_draw_textured_rectangle (framebuffer, pipeline,
+                                            x1, y1, x2, y2,
+                                            x1, y1, x2, y2);
+}
+
+/* Paint a thin neutral line along the inside of @frame's rounded edge. It
+ * lightens dark windows and darkens light ones, so windows stay apart from
+ * each other and from the wallpaper in either style. */
+void
+meta_window_corners_paint_outline (CoglFramebuffer    *framebuffer,
+                                   const MtkRectangle *frame,
+                                   guint8              opacity)
+{
+  CoglContext *context = cogl_framebuffer_get_context (framebuffer);
+  g_autoptr (CoglPipeline) pipeline = NULL;
+  float x1 = frame->x, y1 = frame->y;
+  float x2 = x1 + frame->width, y2 = y1 + frame->height;
+  float radius = MIN (META_WINDOW_CORNER_RADIUS,
+                      MIN (frame->width, frame->height) / 2.0f);
+  float band = ceilf (radius) + 1.0f;
+  float side = OUTLINE_WIDTH + 1.0f;
+  float bounds[4] = { x1, y1, frame->width, frame->height };
+  float alpha = OUTLINE_ALPHA * opacity / 255.0f;
+  CoglColor color;
+
+  if (opacity == 0 || frame->width <= 0 || frame->height <= 0)
+    return;
+
+  pipeline = cogl_pipeline_copy (get_outline_pipeline (context));
+  cogl_color_init_from_4f (&color, OUTLINE_GRAY * alpha, OUTLINE_GRAY * alpha,
+                           OUTLINE_GRAY * alpha, alpha);
+  cogl_pipeline_set_color (pipeline, &color);
+  cogl_pipeline_set_uniform_float (pipeline,
+                                   cogl_pipeline_get_uniform_location (pipeline, "kestrel_bounds"),
+                                   4, 1, bounds);
+  cogl_pipeline_set_uniform_1f (pipeline,
+                                cogl_pipeline_get_uniform_location (pipeline, "kestrel_radius"),
+                                radius);
+
+  /* Only the bands along the edges, so the line doesn't cost a full-size pass */
+  band = MIN (band, frame->height / 2.0f);
+  draw_band (framebuffer, pipeline, x1, y1, x2, y1 + band);
+  draw_band (framebuffer, pipeline, x1, y2 - band, x2, y2);
+  if (y2 - band > y1 + band)
+    {
+      draw_band (framebuffer, pipeline, x1, y1 + band, x1 + side, y2 - band);
+      draw_band (framebuffer, pipeline, x2 - side, y1 + band, x2, y2 - band);
+    }
+}
