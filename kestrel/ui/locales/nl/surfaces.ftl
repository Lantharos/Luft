gust-search-answer-since = Sinds { $date }
gust-search-answer-between = Tussen { $from } en { $to }
gust-search-answer-time-ahead = { $place }, { $hours ->
    [one] { $hours } uur
   *[other] { $hours } uur
} voor
gust-search-answer-time-behind = { $place }, { $hours ->
