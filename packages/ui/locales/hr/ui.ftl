## Fingerprints
## Each finger has a name used as a title (the message value) and a form used inside
## a sentence (.inline), like "Place your … on the sensor." Adjust the case of .inline
## to fit those sentences.

ui-finger-right-index = Desni kažiprst
    .inline = desni kažiprst
ui-finger-left-index = Lijevi kažiprst
    .inline = lijevi kažiprst
ui-finger-right-thumb = Desni palac
    .inline = desni palac
ui-finger-left-thumb = Lijevi palac
    .inline = lijevi palac
ui-finger-right-middle = Desni srednji prst
    .inline = desni srednji prst
ui-finger-left-middle = Lijevi srednji prst
    .inline = lijevi srednji prst
ui-finger-right-ring = Desni prstenjak
    .inline = desni prstenjak
ui-finger-left-ring = Lijevi prstenjak
    .inline = lijevi prstenjak
ui-finger-right-little = Desni mali prst
    .inline = desni mali prst
ui-finger-left-little = Lijevi mali prst
    .inline = lijevi mali prst

ui-fingerprint-place = Stavite { $finger } na senzor.
ui-fingerprint-swipe = Povucite { $finger } preko senzora.
ui-fingerprint-stage-passed = Dobro. Podignite prst pa ga ponovno stavite.
ui-fingerprint-stage-passed-swipe = Dobro. Povucite ponovno.
ui-fingerprint-retry = Očitavanje nije uspjelo. Pokušajte ponovno.
ui-fingerprint-swipe-too-short = Povucite malo sporije.
ui-fingerprint-not-centered = Postavite prst na sredinu senzora.
ui-fingerprint-remove-and-retry = Podignite prst i pokušajte ponovno.
ui-fingerprint-added = Otisak prsta je dodan.
ui-fingerprint-full = Na čitaču nema mjesta za još jedan otisak prsta.
ui-fingerprint-disconnected = Čitač otiska prsta prestao je odgovarati. Pokušajte ponovno za trenutak.
ui-fingerprint-duplicate = Čitač već ima spremljen ovaj prst, vjerojatno iz sustava Windows ili drugog računa. Upotrijebite drugi prst.
ui-fingerprint-failed = Dodavanje ovog otiska prsta nije uspjelo. Pokušajte ponovno.

