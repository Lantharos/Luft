 src/compositor/meta-glass.h                   |  3 +
 src/meta/compositor.h                         | 13 +++
 src/wayland/meta-wayland-kestrel-glass.c      | 18 +++-
 src/wayland/protocol/kestrel-glass-v1.xml     | 20 ++--
 10 files changed, 215 insertions(+), 54 deletions(-)

diff --git a/clutter/clutter/clutter-paint-node-private.h b/clutter/clutter/clutter-paint-node-private.h
