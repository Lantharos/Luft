## Fingerprints
## Each finger has a name used as a title (the message value) and a form used inside
## a sentence (.inline), like "Place your … on the sensor." Adjust the case of .inline
## to fit those sentences.

ui-finger-right-index = Indicador direito
    .inline = indicador direito
ui-finger-left-index = Indicador esquerdo
    .inline = indicador esquerdo
ui-finger-right-thumb = Polegar direito
    .inline = polegar direito
ui-finger-left-thumb = Polegar esquerdo
    .inline = polegar esquerdo
ui-finger-right-middle = Dedo médio direito
    .inline = dedo médio direito
ui-finger-left-middle = Dedo médio esquerdo
    .inline = dedo médio esquerdo
ui-finger-right-ring = Anelar direito
    .inline = anelar direito
ui-finger-left-ring = Anelar esquerdo
    .inline = anelar esquerdo
ui-finger-right-little = Mindinho direito
    .inline = mindinho direito
ui-finger-left-little = Mindinho esquerdo
    .inline = mindinho esquerdo

ui-fingerprint-place = Coloque o { $finger } no sensor.
ui-fingerprint-swipe = Deslize o { $finger } pelo sensor.
ui-fingerprint-stage-passed = Bom. Levante o dedo e volte a colocá-lo.
ui-fingerprint-stage-passed-swipe = Bom. Deslize novamente.
ui-fingerprint-retry = Não foi possível ler bem o dedo. Tente novamente.
ui-fingerprint-swipe-too-short = Deslize um pouco mais devagar.
ui-fingerprint-not-centered = Centre o dedo no sensor.
ui-fingerprint-remove-and-retry = Levante o dedo e tente novamente.
ui-fingerprint-added = Impressão digital adicionada.
ui-fingerprint-full = O leitor não tem espaço para mais impressões digitais.
ui-fingerprint-disconnected = O leitor de impressões digitais deixou de responder. Tente novamente daqui a pouco.
ui-fingerprint-duplicate = O leitor já tem este dedo guardado, provavelmente pelo Windows ou por outra conta. Utilize outro dedo.
ui-fingerprint-failed = Não foi possível adicionar esta impressão digital. Tente novamente.

