+static gboolean
+capture_source (ClutterBlurNode *blur_node)
+{
+  g_autoptr (GError) error = NULL;
+  MtkRectangle whole = { 0, 0, blur_node->width, blur_node->height };
+  const MtkRectangle *rects = blur_node->area ? (MtkRectangle *) blur_node->area->data : &whole;
+  unsigned int n_rects = blur_node->area ? blur_node->area->len : 1;
+  unsigned int i;
+
+  for (i = 0; i < n_rects; i++)
+    {
+      if (!cogl_framebuffer_blit (blur_node->source_framebuffer,
+                                  blur_node->target->offscreen,
+                                  blur_node->source_x + rects[i].x,
+                                  blur_node->source_y + rects[i].y,
+                                  rects[i].x,
+                                  rects[i].y,
+                                  rects[i].width,
+                                  rects[i].height,
+                                  &error))
+        {
+          g_warning ("Failed to capture blur node framebuffer: %s",
+                     error->message);
+          return FALSE;
+        }
+    }
+
+  return TRUE;
