## Errors shown in Install Luft and first-run setup

installer-not-allowed = M’għandekx permess tagħmel dan.
installer-stopped = L-installer waqaf għal għarrieda.
installer-request-invalid = It-talba mhix valida: { $error }
installer-settings-invalid = Is-settings mhumiex validi: { $error }
installer-busy = Luft diġà qed jiġi installat.
installer-account-exists = Il-kont diġà nħoloq.

## Choosing what to install

installer-no-image = M’hemm l-ebda image { $variant } x’tiġi installata.
installer-write-failed = Ma setax jinkiteb { $path }

## Checking the destination

installer-drive-gone = Dik id-diska m’għadhiex imqabbda.
installer-drive-unusable = Luft ma jistax jiġi installat fuq dik id-diska.
installer-system-gone = Dik is-sistema m’għadhiex hemm.
installer-system-unreplaceable = Luft għadu ma jistax jibdel { $system }.
installer-drive-running = Luft qed jibda minn dik id-diska bħalissa, għalhekk ma tistax titħassar.
installer-windows-unshrinkable = Windows fuq dik id-diska ma jistax jiċċekken.
installer-size-wont-fit = Dak id-daqs ma jidħolx ħdejn Windows.
installer-space-gone = Dak l-ispazju ħieles m’għadux hemm.
installer-space-too-small = Dak l-ispazju ħieles huwa żgħir wisq għal Luft.

## Account and regional settings

installer-user-name-invalid = Dak l-isem tal-utent ma jistax jintuża.
installer-full-name-invalid = Isem ma jistax ikun fih żewġ punti, virgoli jew linji ġodda.
installer-password-missing = Agħżel password.
installer-account-not-saved = Il-kont il-ġdid ma ġiex issejvjat
installer-account-missing = Il-kont il-ġdid mhux hemm
installer-regional-invalid = Dawk is-settings reġjonali mhumiex validi.
installer-unknown-zone = Is-sistema l-ġdida ma tafx iż-żona tal-ħin { $zone }.

## Installing

installer-esp-partition-failed = Il-partizzjoni tas-sistema EFI ma setgħetx issir
installer-startup-partition-failed = Il-partizzjoni għall-fajls tal-istartjar ta’ Luft ma setgħetx issir
installer-root-partition-failed = Il-partizzjoni għal Luft ma setgħetx issir
installer-shrink-failed = Windows ma setax jiċċekken
installer-no-esp = Id-diska m’għandhiex partizzjoni tas-sistema EFI
installer-no-root = Ma saret l-ebda partizzjoni għal Luft
installer-copy-failed = Luft ma setax jiġi kkopjat
installer-no-deployment = Is-sistema l-ġdida m’għandhiex deployment
installer-deployment-unnamed = Id-deployment tas-sistema l-ġdida m’għandux isem
installer-deployment-unopened = Is-sistema l-ġdida ma setgħetx tinfetaħ
installer-boot-menu-failed = Il-menù tal-boot ta’ Luft ma setax jitpoġġa fuq il-partizzjoni tas-sistema EFI
installer-key-queue-failed = Iċ-ċavetta Secure Boot ta’ Luft ma setgħetx titħejja għar-restart li jmiss

## Replacing a Linux system

installer-leftovers-failed = Dak li ħalla tentattiv preċedenti ma setax jitneħħa
installer-default-failed = Luft ma setax isir is-sistema li tibda
installer-relabel-failed = Il-fajls ma setgħux jiġu ttikkettjati għal Luft
installer-set-aside-failed = Is-sistema l-qadima ma setgħetx titwarrab

## Things packed with Meet Luft

installer-box-unopened = Il-kaxxa tat-trasferiment ma setgħetx tinfetaħ
installer-box-no-list = Il-kaxxa tat-trasferiment m’għandhiex lista ta’ x’fiha
installer-unpack-failed = Ma setax jinfetaħ { $path }
installer-wallpaper-unnamed = L-isfond m’għandux isem
