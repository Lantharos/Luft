+static MtkRegion *
+get_rounded_input_region (MetaSurfaceActor *self)
+{
+  MetaSurfaceActorPrivate *priv = meta_surface_actor_get_instance_private (self);
+  MetaWindowCorners corners = meta_window_corners_for_actor (CLUTTER_ACTOR (self));
+  MtkRectangle bounds = get_preferred_size_bounds (self);
+
+  if (corners.radius == 0)
+    return priv->input_region;
+
+  if (corners.radius != priv->input_corners.radius ||
+      !graphene_rect_equal (&corners.bounds, &priv->input_corners.bounds) ||
+      !mtk_rectangle_equal (&bounds, &priv->input_bounds))
+    g_clear_pointer (&priv->rounded_input_region, mtk_region_unref);
+
+  if (!priv->rounded_input_region)
+    {
+      priv->input_corners = corners;
+      priv->input_bounds = bounds;
+      priv->rounded_input_region = priv->input_region
+        ? mtk_region_copy (priv->input_region)
+        : mtk_region_create_rectangle (&bounds);
+      meta_window_corners_clip_input (&corners, priv->rounded_input_region);
+    }
+
+  return priv->rounded_input_region;
+}
