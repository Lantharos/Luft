## Shared by every page of luft.computer

site-skip = Skip to content
# Accessible name of the navigation at the top of every page
site-nav-label = Main
# Accessible name of the Luft logo, which links to the home page
site-home-label = Luft home
site-nav-download = Download
site-nav-docs = Docs
# Link to Luft's source code on GitHub
site-nav-source = Source
# { $lantharos } and { $fedora } are links showing those names.
site-footer-made = Made by { $lantharos }. Free and open source, built on { $fedora }.
# { $photographers } is a list of linked names, already joined the way the language joins lists ("A, B and C").
site-footer-photos = Photos by { $photographers } on Unsplash. Every one of them is a wallpaper in Luft.
# Button in the footer showing the current language's name, for screen readers
site-language-button = Language: { $language }
# Accessible name of the list of languages the button opens
site-languages = Languages

