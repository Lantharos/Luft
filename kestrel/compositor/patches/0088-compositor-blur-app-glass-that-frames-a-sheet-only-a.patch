+      const MtkRectangle *rect = &g_array_index (area, MtkRectangle, i);
+      float x1 = MIN (rect->x / scale, target_level->width);
+      float y1 = MIN (rect->y / scale, target_level->height);
+      float x2 = MIN ((rect->x + rect->width + scale - 1) / scale, target_level->width);
+      float y2 = MIN ((rect->y + rect->height + scale - 1) / scale, target_level->height);
+      float *rectangle = &coordinates[i * 8];
+
+      rectangle[0] = x1;
+      rectangle[1] = y1;
+      rectangle[2] = x2;
+      rectangle[3] = y2;
+      rectangle[4] = x1 * s_scale;
+      rectangle[5] = y1 * t_scale;
+      rectangle[6] = x2 * s_scale;
+      rectangle[7] = y2 * t_scale;
