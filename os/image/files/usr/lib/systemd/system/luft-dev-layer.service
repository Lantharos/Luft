[Unit]
Description=Lay the development build over the version of Luft it was made for
DefaultDependencies=no
After=local-fs.target
Before=systemd-sysext.service
Wants=systemd-sysext.service
ConditionPathExists=/var/lib/luft/dev-layer/release

[Service]
Type=oneshot
ExecStart=/usr/libexec/luft-dev-layer link
ReadWritePaths=/run /var/lib/luft
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=disconnected
PrivateDevices=yes
PrivateNetwork=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
CapabilityBoundingSet=CAP_DAC_OVERRIDE

[Install]
WantedBy=sysinit.target
