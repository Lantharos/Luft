---
import { shot } from '../../data/shots';
import movesMp4 from '../../assets/clips/moves.mp4?url';
import movesWebm from '../../assets/clips/moves.webm?url';
import movesPoster from '../../assets/clips/moves.webp';
import { localize } from '../../i18n/pages';
import Clip from '../media/Clip.astro';
import Shot from '../media/Shot.astro';
import Chapter from './Chapter.astro';
import Frame from './Frame.astro';

const { t } = localize(Astro);
---

<Chapter title={t('home-start-heading')}>
	<p>{t('home-start-text')}</p>
	<Frame slot="media">
		<Shot {...shot('search')} alt={t('home-start-alt')} sizes="(min-width: 76rem) 48rem, (min-width: 48rem) 64vw, 94vw" />
	</Frame>
</Chapter>

<Chapter title={t('home-essentials-heading')} flip>
	<p>{t('home-essentials-text')}</p>
	<div slot="media" class="grid grid-cols-2 gap-4 md:gap-6">
		<Frame>
			<Shot {...shot('quick')} alt={t('home-quick-settings-alt')} sizes="(min-width: 76rem) 24rem, (min-width: 48rem) 32vw, 47vw" />
		</Frame>
		<Frame class="translate-y-10">
			<Shot {...shot('notifications')} alt={t('home-notifications-alt')} sizes="(min-width: 76rem) 24rem, (min-width: 48rem) 32vw, 47vw" />
		</Frame>
	</div>
</Chapter>

<Chapter title={t('home-windows-heading')}>
	<p>{t('home-windows-text')}</p>
	<div slot="media" class="space-y-4 md:space-y-6">
		<Frame>
			<Shot {...shot('board')} alt={t('home-board-alt')} sizes="(min-width: 76rem) 48rem, (min-width: 48rem) 64vw, 94vw" />
		</Frame>
		<div class="grid grid-cols-2 gap-4 md:gap-6">
			<Frame>
				<Shot {...shot('snap')} alt={t('home-snap-alt')} sizes="(min-width: 76rem) 24rem, (min-width: 48rem) 32vw, 47vw" />
			</Frame>
			<Frame>
				<Shot {...shot('tasks')} alt={t('home-all-windows-alt')} sizes="(min-width: 76rem) 24rem, (min-width: 48rem) 32vw, 47vw" />
			</Frame>
		</div>
	</div>
</Chapter>

<Chapter title={t('home-motion-heading')} flip>
	<p>{t('home-motion-text')}</p>
	<Frame slot="media">
		<Clip webm={movesWebm} mp4={movesMp4} poster={movesPoster} label={t('home-motion-clip')} />
	</Frame>
</Chapter>
