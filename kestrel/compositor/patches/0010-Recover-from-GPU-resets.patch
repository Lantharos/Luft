+      g_clear_object (&buffer->dma_buf.texture);
+      break;
+    case META_WAYLAND_BUFFER_TYPE_SINGLE_PIXEL:
+      g_clear_object (&buffer->single_pixel.texture);
+      break;
+    case META_WAYLAND_BUFFER_TYPE_UNKNOWN:
+      g_assert_not_reached ();
+      break;
+    }
