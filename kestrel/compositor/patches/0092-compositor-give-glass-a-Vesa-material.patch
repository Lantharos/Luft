diff --git a/src/compositor/meta-window-corners.c b/src/compositor/meta-window-corners.c
index 913c5bd8668ec5399f21dc0134989aa587954274..5fac748f433d9c90eb7d185016a65058ce6a11c4 100644
--- a/src/compositor/meta-window-corners.c
+++ b/src/compositor/meta-window-corners.c
@@ -447,6 +447,50 @@ get_shadow_snippet (void)
   return snippet;
 }
 
+static CoglSnippet *
+get_rim_snippet (void)
+{
+  static CoglSnippet *snippet;
+
+  if (!snippet)
+    {
+      snippet = cogl_snippet_new (COGL_SNIPPET_HOOK_FRAGMENT,
+        CORNER_DECLARATIONS
+        "uniform vec4 kestrel_radii;\n",
+        "float pixel = kestrel_pixel_size ();\n"
+        "vec2 half_size = kestrel_bounds.zw * 0.5;\n"
+        "vec2 offset = kestrel_position - kestrel_bounds.xy - half_size;\n"
+        "float radius = offset.y < 0.0 ?\n"
+        "  (offset.x < 0.0 ? kestrel_radii.x : kestrel_radii.y) :\n"
+        "  (offset.x < 0.0 ? kestrel_radii.w : kestrel_radii.z);\n"
+        "vec2 q = abs(offset) - half_size + radius;\n"
+        "float distance = length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - radius;\n"
+        "cogl_color_out *= clamp(0.5 - distance / pixel, 0.0, 1.0);\n"
+        "vec2 outward = sign(offset) * (all(greaterThan(q, vec2(0.0))) ? normalize(q) :\n"
+        "  (q.x > q.y ? vec2(1.0, 0.0) : vec2(0.0, 1.0)));\n"
+        "float inside = max(-distance, 0.0);\n"
+        "float width = max(1.2, 1.5 * pixel);\n"
+        "float facing = dot(normalize(outward + offset / half_size * 1.5), vec2(-0.7071, -0.7071));\n"
+        "float lobe = pow(abs(facing), 3.0) * (facing > 0.0 ? 1.0 : 0.6);\n"
+        "float line = clamp(1.0 - inside / width, 0.0, 1.0) +\n"
+        "  0.21 * clamp(1.0 - inside / (4.0 * width), 0.0, 1.0);\n"
+        "vec3 color = cogl_color_out.rgb / max(cogl_color_out.a, 0.001);\n"
+        "float luma = dot(color, vec3(0.2126, 0.7152, 0.0722));\n"
+        "float groove = smoothstep(0.5 * width, 1.5 * width, inside) *\n"
+        "  (1.0 - smoothstep(1.5 * width, 3.5 * width, inside));\n"
+        "float shade = groove * 0.18 * smoothstep(0.45, 0.85, luma) * (1.0 - lobe);\n"
+        "color = mix(vec3(luma), color, 1.0 + shade) * (1.0 - shade);\n"
+        "float peak = max(max(color.r, color.g), color.b);\n"
+        "vec3 hue = mix(vec3(1.0), color / max(peak, 0.001), smoothstep(0.0, 0.08, peak));\n"
+        "hue = mix(vec3(dot(hue, vec3(0.2126, 0.7152, 0.0722))), hue, 1.3);\n"
+        "vec3 glare = mix(mix(color, hue, 0.78), vec3(1.0), 0.08 * lobe * lobe);\n"
+        "color = mix(color, glare, min(line * mix(0.1, 1.0, lobe) * 0.5, 1.0));\n"
+        "cogl_color_out.rgb = clamp(color, 0.0, 1.0) * cogl_color_out.a;\n");
+    }
+
+  return snippet;
+}
+
 void
 meta_window_corners_apply (const MetaWindowCorners *corners,
                            MetaWindowCornerFill     fill,
@@ -461,9 +505,18 @@ meta_window_corners_apply (const MetaWindowCorners *corners,
     return;
 
   cogl_pipeline_add_snippet (pipeline, get_vertex_snippet ());
-  cogl_pipeline_add_snippet (pipeline,
-                             fill == META_WINDOW_CORNER_FILL_SHADOW ?
-                             get_shadow_snippet () : get_clear_snippet ());
+  switch (fill)
+    {
+    case META_WINDOW_CORNER_FILL_CLEAR:
+      cogl_pipeline_add_snippet (pipeline, get_clear_snippet ());
+      break;
+    case META_WINDOW_CORNER_FILL_SHADOW:
+      cogl_pipeline_add_snippet (pipeline, get_shadow_snippet ());
+      break;
+    case META_WINDOW_CORNER_FILL_RIM:
+      cogl_pipeline_add_snippet (pipeline, get_rim_snippet ());
+      break;
+    }
   bounds[0] = width;
   bounds[1] = height;
   location = cogl_pipeline_get_uniform_location (pipeline, "kestrel_size");
diff --git a/src/compositor/meta-window-corners.h b/src/compositor/meta-window-corners.h
