// Administrators can look for, download and prepare system updates without
// a password, so updates also arrive in the background. Going back to an
// earlier version and adding or removing packages still asks.
polkit.addRule(function (action, subject) {
    if (!subject.isInGroup("wheel")) {
        return polkit.Result.NOT_HANDLED;
    }
    switch (action.id) {
        case "org.projectatomic.rpmostree1.repo-refresh":
        case "org.projectatomic.rpmostree1.upgrade":
        case "org.projectatomic.rpmostree1.cleanup":
            return polkit.Result.YES;
    }
    return polkit.Result.NOT_HANDLED;
});
