window-menu-new-window = Nova janela
window-menu-restore = Restaurar
window-menu-minimize = Minimizar
window-menu-maximize = Maximizar
window-menu-unmaximize = Restaurar tamanho
window-menu-pin = Afixar na barra de tarefas
window-menu-unpin = Desafixar da barra de tarefas
window-menu-close = { $count ->
    [one] Fechar janela
   *[other] Fechar todas as janelas
}

## Context menus

