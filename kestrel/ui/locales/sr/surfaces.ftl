## Answers in Gust's search to questions about dates and times.
## The answer itself, such as "157 days" or "17:00", is formatted for the language; these describe it.

gust-search-answer-until = До { $date }
gust-search-answer-since = Од { $date }
gust-search-answer-between = Од { $from } до { $to }
gust-search-answer-time-ahead = { $place }, { $hours ->
    [one] { $hours } сат
    [few] { $hours } сата
   *[other] { $hours } сати
} испред
gust-search-answer-time-behind = { $place }, { $hours ->
    [one] { $hours } сат
    [few] { $hours } сата
   *[other] { $hours } сати
} иза
gust-search-answer-time-same = { $place }, исто време као овде
gust-search-answer-converted = { $place }, кад је { $time } у граду { $from }
gust-search-answer-converted-here = Овде, кад је { $time } у граду { $from }
gust-search-answer-converted-from-here = { $place }, кад је овде { $time }

