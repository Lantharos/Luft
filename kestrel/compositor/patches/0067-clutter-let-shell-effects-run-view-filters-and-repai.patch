 CLUTTER_EXPORT
 gboolean clutter_actor_has_transitions (ClutterActor *actor);
 
diff --git a/clutter/clutter/clutter-stage-view.c b/clutter/clutter/clutter-stage-view.c
index 735023669d61dda69a56f8820810a1367cfae867..827d66bf631f8a84ceba6e9b453833cfc668b479 100644
--- a/clutter/clutter/clutter-stage-view.c
+++ b/clutter/clutter/clutter-stage-view.c
@@ -686,6 +686,30 @@ clutter_stage_view_queue_filter_frame (ClutterStageView *view)
   clutter_stage_view_schedule_update (view);
 }
 
+/**
+ * clutter_stage_view_queue_redraw_region:
+ * @view: a #ClutterStageView
+ * @region: what to paint again, in stage coordinates
+ *
+ * Paints @region of @view again without any actor having changed, for
+ * something that looks different from one frame to the next by itself.
+ */
+void
+clutter_stage_view_queue_redraw_region (ClutterStageView *view,
+                                        const MtkRegion  *region)
+{
+  int i;
+
+  for (i = 0; i < mtk_region_num_rectangles (region); i++)
+    {
+      MtkRectangle rect = mtk_region_get_rectangle (region, i);
+
+      clutter_stage_view_add_redraw_clip (view, &rect);
+    }
+
+  clutter_stage_view_schedule_update (view);
+}
+
 static CoglOffscreen *
 ensure_capture_target (CoglOffscreen    **target,
                        CoglFramebuffer   *like)
