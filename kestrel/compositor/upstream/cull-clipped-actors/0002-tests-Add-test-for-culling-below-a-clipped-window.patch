From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Kristof Imeri <kristof@lanth.me>
Date: Tue, 27 Oct 2026 19:08:38 +0100
Subject: [PATCH 2/2] tests: Add test for culling below a clipped window

Check that a window below a clipped window is only culled where the
clip lets the window above paint.
---
 src/compositor/meta-surface-actor.h           |   2 +
 src/tests/meson.build                         |  11 ++
 src/tests/wayland-test-clients/meson.build    |   3 +
 .../wayland-test-clients/window-culling.c     |  46 ++++++++
 src/tests/window-culling-tests.c              | 104 ++++++++++++++++++
 5 files changed, 166 insertions(+)
 create mode 100644 src/tests/wayland-test-clients/window-culling.c
 create mode 100644 src/tests/window-culling-tests.c

diff --git a/src/compositor/meta-surface-actor.h b/src/compositor/meta-surface-actor.h
index 9dce861587..3a2aee98ee 100644
--- a/src/compositor/meta-surface-actor.h
+++ b/src/compositor/meta-surface-actor.h
@@ -3,6 +3,7 @@
 #pragma once
 
 #include "backends/meta-backend-types.h"
+#include "core/util-private.h"
 #include "meta/meta-shaped-texture.h"
 #include "meta/window.h"
 
@@ -33,6 +34,7 @@ gboolean meta_surface_actor_is_obscured (MetaSurfaceActor *self);
 
 gboolean meta_surface_actor_is_effectively_obscured (MetaSurfaceActor *self);
 
+META_EXPORT_TEST
 gboolean meta_surface_actor_is_obscured_on_stage_view (MetaSurfaceActor *self,
                                                        ClutterStageView *stage_view,
                                                        float            *unobscurred_fraction);
diff --git a/src/tests/meson.build b/src/tests/meson.build
