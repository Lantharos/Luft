+/// Find the partition that holds the UKIs and Type #1 entries for `bootloader`,
+/// walking up from `device` to the root disk(s).
+///
+/// A BLS-compatible bootloader reads them from an XBOOTLDR partition next to
+/// the ESP when there is one, per the Boot Loader Specification, and from the
+/// ESP otherwise.
+pub(crate) fn find_boot_partition(
+    device: &bootc_blockdev::Device,
+    bootloader: &Bootloader,
+) -> Result<bootc_blockdev::Device> {
+    if matches!(bootloader.kind()?, BootloaderKind::BLSCompatible) {
+        if let Some(xbootldr) = device.find_first_colocated_xbootldr()? {
+            return Ok(xbootldr);
+        }
+    }
+    device.find_first_colocated_esp()
+}
