diff --git a/src/wayland/meta-wayland-foreign-toplevel-list.c b/src/wayland/meta-wayland-foreign-toplevel-list.c
new file mode 100644
index 0000000000000000000000000000000000000000..d05405e98bd1bc72e42c648851165da7d4370137
--- /dev/null
+++ b/src/wayland/meta-wayland-foreign-toplevel-list.c
@@ -0,0 +1,290 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "config.h"
+
+#include "wayland/meta-wayland-foreign-toplevel-list.h"
+
+#include "core/window-private.h"
+#include "wayland/meta-wayland-private.h"
+#include "wayland/meta-wayland-sandbox.h"
+#include "wayland/meta-wayland-versions.h"
+
+#include "ext-foreign-toplevel-list-v1-server-protocol.h"
+
+typedef struct _ForeignToplevel
+{
+  MetaWaylandForeignToplevelList *list;
+  MetaWindow *window;
+  char *identifier;
+  GList *handles;
+  gulong title_handler_id;
+  gulong wm_class_handler_id;
+  gulong shell_app_id_handler_id;
+  gulong unmanaged_handler_id;
+} ForeignToplevel;
+
+struct _MetaWaylandForeignToplevelList
+{
+  MetaWaylandCompositor *compositor;
+  GList *lists;
+  GHashTable *toplevels;
+  char *run_id;
+  gulong window_created_handler_id;
+  gulong display_closing_handler_id;
+};
+
+static const struct ext_foreign_toplevel_handle_v1_interface handle_interface;
+
+static gboolean
+is_listed (MetaWindow *window)
+{
+  return !window->override_redirect && !meta_window_is_skip_taskbar (window);
+}
+
+static void
+send_details (struct wl_resource *handle,
+              MetaWindow         *window)
+{
+  ext_foreign_toplevel_handle_v1_send_title (handle, meta_window_get_title (window) ?: "");
+  ext_foreign_toplevel_handle_v1_send_app_id (handle,
+                                              meta_window_get_shell_app_id (window) ?:
+                                              meta_window_get_wm_class (window) ?: "");
+  ext_foreign_toplevel_handle_v1_send_done (handle);
+}
+
+static void
+handle_destructor (struct wl_resource *resource)
+{
+  ForeignToplevel *toplevel = wl_resource_get_user_data (resource);
+
+  if (toplevel)
+    toplevel->handles = g_list_remove (toplevel->handles, resource);
+}
+
+static void
+handle_destroy (struct wl_client   *client,
+                struct wl_resource *resource)
+{
+  wl_resource_destroy (resource);
+}
+
+static const struct ext_foreign_toplevel_handle_v1_interface handle_interface = {
+  handle_destroy,
+};
+
+static void
+announce (ForeignToplevel    *toplevel,
+          struct wl_resource *list)
+{
+  struct wl_resource *handle;
+
+  handle = wl_resource_create (wl_resource_get_client (list),
+                               &ext_foreign_toplevel_handle_v1_interface,
+                               wl_resource_get_version (list), 0);
+  wl_resource_set_implementation (handle, &handle_interface, toplevel, handle_destructor);
+  toplevel->handles = g_list_prepend (toplevel->handles, handle);
+
+  ext_foreign_toplevel_list_v1_send_toplevel (list, handle);
+  ext_foreign_toplevel_handle_v1_send_identifier (handle, toplevel->identifier);
+  send_details (handle, toplevel->window);
+}
+
+static void
+on_details_changed (MetaWindow      *window,
+                    GParamSpec      *pspec,
+                    ForeignToplevel *toplevel)
+{
+  for (GList *l = toplevel->handles; l; l = l->next)
+    send_details (l->data, window);
+}
+
+static void
+toplevel_free (ForeignToplevel *toplevel)
+{
+  for (GList *l = toplevel->handles; l; l = l->next)
+    {
+      ext_foreign_toplevel_handle_v1_send_closed (l->data);
+      wl_resource_set_user_data (l->data, NULL);
+    }
+  g_list_free (toplevel->handles);
+  g_clear_signal_handler (&toplevel->title_handler_id, toplevel->window);
+  g_clear_signal_handler (&toplevel->wm_class_handler_id, toplevel->window);
+  g_clear_signal_handler (&toplevel->shell_app_id_handler_id, toplevel->window);
+  g_clear_signal_handler (&toplevel->unmanaged_handler_id, toplevel->window);
+  g_free (toplevel->identifier);
+  g_free (toplevel);
+}
+
+static void
+on_unmanaged (MetaWindow      *window,
+              ForeignToplevel *toplevel)
+{
+  g_hash_table_remove (toplevel->list->toplevels, window);
+}
+
+static void
+track (MetaWaylandForeignToplevelList *self,
+       MetaWindow                     *window)
+{
+  ForeignToplevel *toplevel;
+
+  if (!is_listed (window) || g_hash_table_contains (self->toplevels, window))
+    return;
+
+  toplevel = g_new0 (ForeignToplevel, 1);
+  toplevel->list = self;
+  toplevel->window = window;
+  toplevel->identifier = g_strdup_printf ("%s-%" G_GUINT64_FORMAT, self->run_id, meta_window_get_id (window));
+  toplevel->title_handler_id =
+    g_signal_connect (window, "notify::title", G_CALLBACK (on_details_changed), toplevel);
+  toplevel->wm_class_handler_id =
+    g_signal_connect (window, "notify::wm-class", G_CALLBACK (on_details_changed), toplevel);
+  toplevel->shell_app_id_handler_id =
+    g_signal_connect (window, "notify::shell-app-id", G_CALLBACK (on_details_changed), toplevel);
+  toplevel->unmanaged_handler_id =
+    g_signal_connect (window, "unmanaged", G_CALLBACK (on_unmanaged), toplevel);
+  g_hash_table_insert (self->toplevels, window, toplevel);
+
+  for (GList *l = self->lists; l; l = l->next)
+    announce (toplevel, l->data);
+}
+
+static void
+on_window_created (MetaDisplay                    *display,
+                   MetaWindow                     *window,
+                   MetaWaylandForeignToplevelList *self)
+{
+  track (self, window);
+}
+
+static void
+on_display_closing (MetaDisplay                    *display,
+                    MetaWaylandForeignToplevelList *self)
+{
+  g_clear_signal_handler (&self->window_created_handler_id, display);
+  g_clear_signal_handler (&self->display_closing_handler_id, display);
+  g_hash_table_remove_all (self->toplevels);
+}
+
+static void
+follow_windows (MetaWaylandForeignToplevelList *self)
+{
+  MetaDisplay *display = meta_context_get_display (self->compositor->context);
+  g_autoptr (GList) windows = NULL;
+
+  if (self->window_created_handler_id)
+    return;
+
+  self->window_created_handler_id =
+    g_signal_connect (display, "window-created", G_CALLBACK (on_window_created), self);
+  self->display_closing_handler_id =
+    g_signal_connect (display, "closing", G_CALLBACK (on_display_closing), self);
+  windows = meta_display_list_all_windows (display);
+  for (GList *l = windows; l; l = l->next)
+    track (self, l->data);
+}
+
+static void
+list_destructor (struct wl_resource *resource)
+{
+  MetaWaylandForeignToplevelList *self = wl_resource_get_user_data (resource);
+
+  self->lists = g_list_remove (self->lists, resource);
+}
+
+static void
+list_stop (struct wl_client   *client,
+           struct wl_resource *resource)
+{
+  MetaWaylandForeignToplevelList *self = wl_resource_get_user_data (resource);
+
+  if (!g_list_find (self->lists, resource))
+    return;
+
+  self->lists = g_list_remove (self->lists, resource);
+  ext_foreign_toplevel_list_v1_send_finished (resource);
+}
+
+static void
+list_destroy (struct wl_client   *client,
+              struct wl_resource *resource)
+{
+  wl_resource_destroy (resource);
+}
+
+static const struct ext_foreign_toplevel_list_v1_interface list_interface = {
+  list_stop,
+  list_destroy,
+};
+
+static void
+bind_list (struct wl_client *client,
+           void             *data,
+           uint32_t          version,
+           uint32_t          id)
+{
+  MetaWaylandForeignToplevelList *self = data;
+  struct wl_resource *resource;
+  GHashTableIter iter;
+  ForeignToplevel *toplevel;
+
+  follow_windows (self);
+  resource = wl_resource_create (client, &ext_foreign_toplevel_list_v1_interface, version, id);
+  wl_resource_set_implementation (resource, &list_interface, self, list_destructor);
+  self->lists = g_list_prepend (self->lists, resource);
+
+  g_hash_table_iter_init (&iter, self->toplevels);
+  while (g_hash_table_iter_next (&iter, NULL, (gpointer *) &toplevel))
+    announce (toplevel, resource);
+}
+
+/**
+ * meta_wayland_foreign_toplevel_handle_get_window:
+ * @handle: an ext_foreign_toplevel_handle_v1 resource
+ *
+ * Returns: (nullable): the window behind @handle, or %NULL once it closed
+ */
+MetaWindow *
+meta_wayland_foreign_toplevel_handle_get_window (struct wl_resource *handle)
+{
+  ForeignToplevel *toplevel;
+
+  g_return_val_if_fail (wl_resource_instance_of (handle, &ext_foreign_toplevel_handle_v1_interface,
+                                                 &handle_interface), NULL);
+
+  toplevel = wl_resource_get_user_data (handle);
+  return toplevel ? toplevel->window : NULL;
+}
+
+static void
+foreign_toplevel_list_free (MetaWaylandForeignToplevelList *self)
+{
+  g_clear_pointer (&self->toplevels, g_hash_table_destroy);
+  g_list_free (self->lists);
+  g_free (self->run_id);
+  g_free (self);
+}
+
+void
+meta_wayland_init_foreign_toplevel_list (MetaWaylandCompositor *compositor)
+{
+  MetaWaylandForeignToplevelList *self = g_new0 (MetaWaylandForeignToplevelList, 1);
+  struct wl_global *global;
+
+  self->compositor = compositor;
+  self->run_id = g_strdup_printf ("%08x", g_random_int ());
+  self->toplevels = g_hash_table_new_full (NULL, NULL, NULL, (GDestroyNotify) toplevel_free);
+
+  global = wl_global_create (compositor->wayland_display,
+                             &ext_foreign_toplevel_list_v1_interface,
+                             META_EXT_FOREIGN_TOPLEVEL_LIST_V1_VERSION,
+                             self, bind_list);
+  if (!global)
+    g_error ("Failed to register a global ext-foreign-toplevel-list object");
+
+  meta_wayland_filter_manager_add_global (meta_wayland_compositor_get_filter_manager (compositor),
+                                          global, meta_wayland_filter_window_capture,
+                                          compositor->context);
+
+  g_object_set_data_full (G_OBJECT (compositor), "-meta-wayland-foreign-toplevel-list",
+                          self, (GDestroyNotify) foreign_toplevel_list_free);
+}
