[Unit]
Description=Install Luft encrypted next to Windows on a SATA drive, with an NVMe data drive and an empty drive
After=dbus.service local-fs.target
ConditionPathExists=/dev/disk/by-label/luft-source

[Service]
Type=oneshot
ExecStart=/usr/libexec/luft-move-prepare
ExecStopPost=/usr/bin/systemctl poweroff --no-block

[Install]
WantedBy=multi-user.target
