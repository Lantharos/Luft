From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Kristof Imeri <kristof@lanth.me>
Date: Wed, 7 Oct 2026 14:05:26 +0200
Subject: [PATCH 19/57] core: let the shell check and restore inhibited
 shortcuts

The shell can bind its own action to the shortcut that restores inhibited
shortcuts, and needs to know whether a window inhibits them to keep
restoring them first.

Upstream-Status: luft-only API for Kestrel's shell that GNOME Shell has no use for
---
 src/core/window-private.h |  5 -----
 src/core/window.c         | 16 ++++++++++++++++
 src/meta/window.h         |  8 ++++++++
 3 files changed, 24 insertions(+), 5 deletions(-)

diff --git a/src/core/window-private.h b/src/core/window-private.h
index 2eb84858a8effe7ea13c0b921c5c135dc33810f0..cd182346abb33fd122cf3d6a137cb99fe1f92c31 100644
--- a/src/core/window-private.h
+++ b/src/core/window-private.h
@@ -830,11 +830,6 @@ MetaPlacementRule *meta_window_get_placement_rule (MetaWindow *window);
 void meta_window_force_placement (MetaWindow    *window,
                                   MetaPlaceFlag  flags);
 
-void meta_window_force_restore_shortcuts (MetaWindow         *window,
-                                          ClutterInputDevice *source);
-
-gboolean meta_window_shortcuts_inhibited (MetaWindow         *window,
-                                          ClutterInputDevice *source);
 gboolean meta_window_is_stackable (MetaWindow *window);
 gboolean meta_window_is_focus_async (MetaWindow *window);
 
diff --git a/src/core/window.c b/src/core/window.c
index c88c475840b558d29ae8cdb75aa7fb746376cd50..79012c12d37da3339bd9265bb2e9da0ca722da2a 100644
--- a/src/core/window.c
+++ b/src/core/window.c
@@ -8111,6 +8111,14 @@ meta_window_emit_configure (MetaWindow       *window,
   g_signal_emit (window, window_signals[CONFIGURE], 0, window_config);
 }
 
+/**
+ * meta_window_force_restore_shortcuts:
+ * @window: a #MetaWindow
+ * @source: the device whose shortcuts are restored
+ *
+ * Gives keyboard shortcuts that @window inhibits for @source back to the
+ * compositor.
+ */
 void
 meta_window_force_restore_shortcuts (MetaWindow         *window,
                                      ClutterInputDevice *source)
@@ -8118,6 +8126,14 @@ meta_window_force_restore_shortcuts (MetaWindow         *window,
   META_WINDOW_GET_CLASS (window)->force_restore_shortcuts (window, source);
 }
 
+/**
+ * meta_window_shortcuts_inhibited:
+ * @window: a #MetaWindow
+ * @source: the device to check
+ *
+ * Returns: whether @window currently inhibits the compositor's keyboard
+ *   shortcuts for @source
+ */
 gboolean
 meta_window_shortcuts_inhibited (MetaWindow         *window,
                                  ClutterInputDevice *source)
diff --git a/src/meta/window.h b/src/meta/window.h
index 7378569a6a4c37c006a44edc4606c89d1695463a..4c653105cbfec58ff1923751d31052c7c21fbb95 100644
--- a/src/meta/window.h
+++ b/src/meta/window.h
@@ -514,3 +514,11 @@ META_EXPORT
 gboolean meta_window_get_max_size (MetaWindow *window,
                                    int        *width,
                                    int        *height);
+
+META_EXPORT
+void meta_window_force_restore_shortcuts (MetaWindow         *window,
+                                          ClutterInputDevice *source);
+
+META_EXPORT
+gboolean meta_window_shortcuts_inhibited (MetaWindow         *window,
+                                          ClutterInputDevice *source);
