+/**
+ * clutter_virtual_input_device_notify_touchpad_pinch:
+ * @virtual_device: a virtual pointer device
+ * @time_us: the time of the event, in microseconds
+ * @phase: the phase of the pinch
+ * @fingers: how many fingers pinch
+ * @dx: how far the fingers' center moved horizontally
+ * @dy: how far the fingers' center moved vertically
+ * @angle_delta: how far the fingers turned since the last update, in degrees
+ * @scale: the distance between the fingers relative to the start
+ *
+ * Sends a touchpad pinch at the pointer, as a touchpad would.
+ */
+void
+clutter_virtual_input_device_notify_touchpad_pinch (ClutterVirtualInputDevice   *virtual_device,
+                                                    uint64_t                     time_us,
+                                                    ClutterTouchpadGesturePhase  phase,
+                                                    uint32_t                     fingers,
+                                                    double                       dx,
+                                                    double                       dy,
+                                                    double                       angle_delta,
+                                                    double                       scale)
+{
+  ClutterVirtualInputDeviceClass *klass =
+    CLUTTER_VIRTUAL_INPUT_DEVICE_GET_CLASS (virtual_device);
+
+  g_return_if_fail (CLUTTER_IS_VIRTUAL_INPUT_DEVICE (virtual_device));
+  g_return_if_fail (klass->notify_touchpad_pinch != NULL);
+
+  klass->notify_touchpad_pinch (virtual_device, time_us, phase, fingers,
+                                dx, dy, angle_delta, scale);
+}
+
+/**
+ * clutter_virtual_input_device_notify_touchpad_swipe:
+ * @virtual_device: a virtual pointer device
+ * @time_us: the time of the event, in microseconds
+ * @phase: the phase of the swipe
+ * @fingers: how many fingers swipe
+ * @dx: how far the fingers moved horizontally
+ * @dy: how far the fingers moved vertically
+ *
+ * Sends a touchpad swipe at the pointer, as a touchpad would.
+ */
+void
+clutter_virtual_input_device_notify_touchpad_swipe (ClutterVirtualInputDevice   *virtual_device,
+                                                    uint64_t                     time_us,
+                                                    ClutterTouchpadGesturePhase  phase,
+                                                    uint32_t                     fingers,
+                                                    double                       dx,
+                                                    double                       dy)
+{
+  ClutterVirtualInputDeviceClass *klass =
+    CLUTTER_VIRTUAL_INPUT_DEVICE_GET_CLASS (virtual_device);
+
+  g_return_if_fail (CLUTTER_IS_VIRTUAL_INPUT_DEVICE (virtual_device));
+  g_return_if_fail (klass->notify_touchpad_swipe != NULL);
+
+  klass->notify_touchpad_swipe (virtual_device, time_us, phase, fingers,
+                                dx, dy);
+}
+
+/**
+ * clutter_virtual_input_device_notify_tablet_mode:
+ * @virtual_device: a virtual input device
+ * @tablet_mode: whether the device is folded or detached into a tablet
+ *
+ * Flips a tablet mode switch on the device, as a convertible's hinge or
+ * keyboard dock would. The device counts as the seat's tablet mode switch
+ * from then on.
+ */
+void
+clutter_virtual_input_device_notify_tablet_mode (ClutterVirtualInputDevice *virtual_device,
+                                                 gboolean                   tablet_mode)
+{
+  ClutterVirtualInputDeviceClass *klass =
+    CLUTTER_VIRTUAL_INPUT_DEVICE_GET_CLASS (virtual_device);
+
+  g_return_if_fail (CLUTTER_IS_VIRTUAL_INPUT_DEVICE (virtual_device));
+  g_return_if_fail (klass->notify_tablet_mode != NULL);
+
+  klass->notify_tablet_mode (virtual_device, tablet_mode);
+}
+
