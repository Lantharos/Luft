---
import logo from '@luft/web/logo.svg?raw';
const { siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="flex min-w-0 items-center gap-2.5 text-lg font-semibold tracking-tight text-ink no-underline">
	<span class="inline-block size-6 [&>svg]:size-full" aria-hidden="true" set:html={logo} />
	<span translate="no">Luft</span>
	<span class="font-medium text-ink-muted">Docs</span>
</a>
