@@ -0,0 +1,66 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "config.h"
+
+#include "backends/meta-backend-private.h"
+#include "core/window-private.h"
+#include "meta/meta-context.h"
+#include "wayland/meta-wayland-surface-private.h"
+
+/**
+ * meta_window_get_content_type:
+ * @window: a #MetaWindow
+ *
+ * Returns: the kind of content the client says the window shows
+ */
+MetaWindowContentType
+meta_window_get_content_type (MetaWindow *window)
+{
+  MetaWaylandSurface *surface = meta_window_get_wayland_surface (window);
+
+  return surface ? surface->content_type : META_WINDOW_CONTENT_TYPE_NONE;
+}
+
+void
+meta_window_content_type_changed (MetaWindow *window)
+{
+  g_object_notify (G_OBJECT (window), "content-type");
+}
+
+/**
+ * meta_window_get_variable_refresh:
+ * @window: a #MetaWindow
+ *
+ * Returns: whether a display may follow the window's frame rate with
+ *   variable refresh while the window covers it
+ */
+gboolean
+meta_window_get_variable_refresh (MetaWindow *window)
+{
+  return window->variable_refresh;
+}
+
+/**
+ * meta_window_set_variable_refresh:
+ * @window: a #MetaWindow
+ * @variable_refresh: whether displays may use variable refresh for it
+ *
+ * Lets a display that has variable refresh turned on follow the window's
+ * frame rate while the window covers the whole display. Other windows keep
+ * the display at its fixed refresh rate.
+ */
+void
+meta_window_set_variable_refresh (MetaWindow *window,
+                                  gboolean    variable_refresh)
+{
+  MetaBackend *backend;
+
+  variable_refresh = !!variable_refresh;
+  if (window->variable_refresh == variable_refresh)
+    return;
+
+  window->variable_refresh = variable_refresh;
+  g_object_notify (G_OBJECT (window), "variable-refresh");
+
+  backend = meta_context_get_backend (meta_display_get_context (window->display));
+  clutter_stage_schedule_update (CLUTTER_STAGE (meta_backend_get_stage (backend)));
+}
