--- /dev/null
+++ b/src/wayland/meta-wayland-data-control.c
@@ -0,0 +1,515 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "config.h"
+
+#include "wayland/meta-wayland-data-control.h"
+
+#include <gio/gio.h>
+#include <gio/gunixoutputstream.h>
+#include <unistd.h>
+
+#include "core/display-private.h"
+#include "meta/meta-selection-source-memory.h"
+#include "wayland/meta-selection-source-wayland-private.h"
+#include "wayland/meta-wayland-data-source.h"
+#include "wayland/meta-wayland-filter-manager.h"
+#include "wayland/meta-wayland-private.h"
+#include "wayland/meta-wayland-versions.h"
+
+#include "ext-data-control-v1-server-protocol.h"
+
+#define SETTINGS_SCHEMA "com.lantharos.kestrel"
+#define SANDBOXED_APPS_KEY "clipboard-access-apps"
+
+typedef struct _MetaWaylandDataControl MetaWaylandDataControl;
+
+typedef struct _ControlledSelection
+{
+  MetaWaylandDataControl *data_control;
+  MetaSelectionType type;
+  MetaWaylandDataSource *source;
+  MetaSelectionSource *owner;
+} ControlledSelection;
+
+struct _MetaWaylandDataControl
+{
+  MetaWaylandCompositor *compositor;
+  GSettings *settings;
+  struct wl_list device_resources;
+  ControlledSelection clipboard;
+  ControlledSelection primary;
+  gulong owner_changed_id;
+};
+
+typedef struct _DataControlOffer
+{
+  MetaWaylandDataControl *data_control;
+  MetaSelectionType type;
+} DataControlOffer;
+
+#define META_TYPE_WAYLAND_DATA_SOURCE_CONTROL (meta_wayland_data_source_control_get_type ())
+G_DECLARE_FINAL_TYPE (MetaWaylandDataSourceControl,
+                      meta_wayland_data_source_control,
+                      META, WAYLAND_DATA_SOURCE_CONTROL,
+                      MetaWaylandDataSource)
+
+struct _MetaWaylandDataSourceControl
+{
+  MetaWaylandDataSource parent;
+  gboolean used;
+};
+
+G_DEFINE_TYPE (MetaWaylandDataSourceControl, meta_wayland_data_source_control,
+               META_TYPE_WAYLAND_DATA_SOURCE)
+
+static MetaSelection *
+selection_of (MetaWaylandDataControl *data_control)
+{
+  MetaContext *context =
+    meta_wayland_compositor_get_context (data_control->compositor);
+
+  return meta_display_get_selection (meta_context_get_display (context));
+}
+
+static void
+default_destroy (struct wl_client   *client,
+                 struct wl_resource *resource)
+{
+  wl_resource_destroy (resource);
+}
+
+static void
+meta_wayland_data_source_control_send (MetaWaylandDataSource *source,
+                                       const char            *mime_type,
+                                       int                    fd)
+{
+  struct wl_resource *resource = meta_wayland_data_source_get_resource (source);
+
+  if (resource)
+    ext_data_control_source_v1_send_send (resource, mime_type, fd);
+  close (fd);
+}
+
+static void
+meta_wayland_data_source_control_cancel (MetaWaylandDataSource *source)
+{
+  struct wl_resource *resource = meta_wayland_data_source_get_resource (source);
+
+  if (resource)
+    ext_data_control_source_v1_send_cancelled (resource);
+}
+
+static void
+meta_wayland_data_source_control_init (MetaWaylandDataSourceControl *source)
+{
+}
+
+static void
+meta_wayland_data_source_control_class_init (MetaWaylandDataSourceControlClass *klass)
+{
+  MetaWaylandDataSourceClass *data_source_class =
+    META_WAYLAND_DATA_SOURCE_CLASS (klass);
+
+  data_source_class->send = meta_wayland_data_source_control_send;
+  data_source_class->cancel = meta_wayland_data_source_control_cancel;
+}
+
+static void
+source_offer (struct wl_client   *client,
+              struct wl_resource *resource,
+              const char         *mime_type)
+{
+  MetaWaylandDataSourceControl *source = wl_resource_get_user_data (resource);
+
+  if (source->used)
+    {
+      wl_resource_post_error (resource,
+                              EXT_DATA_CONTROL_SOURCE_V1_ERROR_INVALID_OFFER,
+                              "the source was already used for a selection");
+      return;
+    }
+
+  if (!meta_wayland_data_source_add_mime_type (META_WAYLAND_DATA_SOURCE (source),
+                                               mime_type))
+    wl_resource_post_no_memory (resource);
+}
+
+static const struct ext_data_control_source_v1_interface source_interface =
+{
+  source_offer,
+  default_destroy,
+};
+
+static void
+source_destructor (struct wl_resource *resource)
+{
+  MetaWaylandDataSource *source = wl_resource_get_user_data (resource);
+
+  meta_wayland_data_source_set_resource (source, NULL);
+  g_object_unref (source);
+}
+
+static void
+transfer_cb (MetaSelection *selection,
+             GAsyncResult  *res,
+             GOutputStream *stream)
+{
+  g_autoptr (GError) error = NULL;
+
+  if (!meta_selection_transfer_finish (selection, res, &error))
+    g_warning ("Could not fetch selection data: %s", error->message);
+
+  g_output_stream_close (stream, NULL, NULL);
+  g_object_unref (stream);
+}
+
+static void
+offer_receive (struct wl_client   *client,
+               struct wl_resource *resource,
+               const char         *mime_type,
+               int32_t             fd)
+{
+  DataControlOffer *offer = wl_resource_get_user_data (resource);
+  MetaSelection *selection = selection_of (offer->data_control);
+  GList *mime_types;
+  gboolean offered;
+  GOutputStream *stream;
+
+  mime_types = meta_selection_get_mimetypes (selection, offer->type);
+  offered = g_list_find_custom (mime_types, mime_type,
+                                (GCompareFunc) g_strcmp0) != NULL;
+  g_list_free_full (mime_types, g_free);
+
+  if (!offered)
+    {
+      close (fd);
+      return;
+    }
+
+  stream = g_unix_output_stream_new (fd, TRUE);
+  meta_selection_transfer_async (selection, offer->type, mime_type, -1,
+                                 stream, NULL,
+                                 (GAsyncReadyCallback) transfer_cb, stream);
+}
+
+static const struct ext_data_control_offer_v1_interface offer_interface =
+{
+  offer_receive,
+  default_destroy,
+};
+
+static void
+offer_destructor (struct wl_resource *resource)
+{
+  g_free (wl_resource_get_user_data (resource));
+}
+
+static struct wl_resource *
+send_offer (MetaWaylandDataControl *data_control,
+            struct wl_resource     *device_resource,
+            MetaSelectionType       type)
+{
+  GList *mime_types, *l;
+  DataControlOffer *offer;
+  struct wl_resource *offer_resource;
+
+  mime_types = meta_selection_get_mimetypes (selection_of (data_control), type);
+  if (!mime_types)
+    return NULL;
+
+  offer = g_new0 (DataControlOffer, 1);
+  offer->data_control = data_control;
+  offer->type = type;
+
+  offer_resource = wl_resource_create (wl_resource_get_client (device_resource),
+                                       &ext_data_control_offer_v1_interface,
+                                       wl_resource_get_version (device_resource),
+                                       0);
+  wl_resource_set_implementation (offer_resource, &offer_interface,
+                                  offer, offer_destructor);
+  ext_data_control_device_v1_send_data_offer (device_resource, offer_resource);
+
+  for (l = mime_types; l; l = l->next)
+    ext_data_control_offer_v1_send_offer (offer_resource, l->data);
+  g_list_free_full (mime_types, g_free);
+
+  return offer_resource;
+}
+
+static void
+send_selection (MetaWaylandDataControl *data_control,
+                struct wl_resource     *device_resource,
+                MetaSelectionType       type)
+{
+  struct wl_resource *offer_resource;
+
+  offer_resource = send_offer (data_control, device_resource, type);
+
+  if (type == META_SELECTION_CLIPBOARD)
+    ext_data_control_device_v1_send_selection (device_resource, offer_resource);
+  else
+    ext_data_control_device_v1_send_primary_selection (device_resource,
+                                                       offer_resource);
+}
+
+static void
+on_owner_changed (MetaSelection          *selection,
+                  MetaSelectionType       type,
+                  MetaSelectionSource    *new_owner,
+                  MetaWaylandDataControl *data_control)
+{
+  struct wl_resource *device_resource;
+
+  if (type != META_SELECTION_CLIPBOARD && type != META_SELECTION_PRIMARY)
+    return;
+
+  wl_resource_for_each (device_resource, &data_control->device_resources)
+    send_selection (data_control, device_resource, type);
+}
+
+static void
+controlled_source_destroyed (gpointer  data,
+                             GObject  *source_was_here)
+{
+  ControlledSelection *controlled = data;
+
+  controlled->source = NULL;
+  meta_selection_unset_owner (selection_of (controlled->data_control),
+                              controlled->type, controlled->owner);
+  g_clear_object (&controlled->owner);
+}
+
+static void
+release_source (ControlledSelection *controlled)
+{
+  if (!controlled->source)
+    return;
+
+  g_object_weak_unref (G_OBJECT (controlled->source),
+                       controlled_source_destroyed, controlled);
+  controlled->source = NULL;
+}
+
+static void
+set_controlled_selection (ControlledSelection *controlled,
+                          struct wl_resource  *device_resource,
+                          struct wl_resource  *source_resource)
+{
+  MetaWaylandDataSourceControl *source = NULL;
+  g_autoptr (MetaSelectionSource) owner = NULL;
+
+  if (source_resource)
+    {
+      source = wl_resource_get_user_data (source_resource);
+
+      if (source->used)
+        {
+          wl_resource_post_error (device_resource,
+                                  EXT_DATA_CONTROL_DEVICE_V1_ERROR_USED_SOURCE,
+                                  "the source was already used for a selection");
+          return;
+        }
+
+      source->used = TRUE;
+    }
+
+  release_source (controlled);
+
+  if (source)
+    {
+      controlled->source = META_WAYLAND_DATA_SOURCE (source);
+      g_object_weak_ref (G_OBJECT (source), controlled_source_destroyed,
+                         controlled);
+      owner = meta_selection_source_wayland_new (controlled->source);
+    }
+  else
+    {
+      owner = g_object_new (META_TYPE_SELECTION_SOURCE_MEMORY, NULL);
+    }
+
+  g_set_object (&controlled->owner, owner);
+  meta_selection_set_owner (selection_of (controlled->data_control),
+                            controlled->type, owner);
+}
+
+static void
+device_set_selection (struct wl_client   *client,
+                      struct wl_resource *resource,
+                      struct wl_resource *source_resource)
+{
+  MetaWaylandDataControl *data_control = wl_resource_get_user_data (resource);
+
+  set_controlled_selection (&data_control->clipboard, resource, source_resource);
+}
+
+static void
+device_set_primary_selection (struct wl_client   *client,
+                              struct wl_resource *resource,
+                              struct wl_resource *source_resource)
+{
+  MetaWaylandDataControl *data_control = wl_resource_get_user_data (resource);
+
+  set_controlled_selection (&data_control->primary, resource, source_resource);
+}
+
+static const struct ext_data_control_device_v1_interface device_interface =
+{
+  device_set_selection,
+  default_destroy,
+  device_set_primary_selection,
+};
+
+static void
+device_destructor (struct wl_resource *resource)
+{
+  wl_list_remove (wl_resource_get_link (resource));
+}
+
+static void
+manager_create_data_source (struct wl_client   *client,
+                            struct wl_resource *resource,
+                            uint32_t            id)
+{
+  MetaWaylandDataControl *data_control = wl_resource_get_user_data (resource);
+  MetaWaylandDataSource *source;
+  struct wl_resource *source_resource;
+
+  source_resource = wl_resource_create (client,
+                                        &ext_data_control_source_v1_interface,
+                                        wl_resource_get_version (resource), id);
+  source = g_object_new (META_TYPE_WAYLAND_DATA_SOURCE_CONTROL,
+                         "compositor", data_control->compositor,
+                         NULL);
+  meta_wayland_data_source_set_resource (source, source_resource);
+  wl_resource_set_implementation (source_resource, &source_interface,
+                                  source, source_destructor);
+}
+
+static void
+manager_get_data_device (struct wl_client   *client,
+                         struct wl_resource *resource,
+                         uint32_t            id,
+                         struct wl_resource *seat_resource)
+{
+  MetaWaylandDataControl *data_control = wl_resource_get_user_data (resource);
+  struct wl_resource *device_resource;
+
+  device_resource = wl_resource_create (client,
+                                        &ext_data_control_device_v1_interface,
+                                        wl_resource_get_version (resource), id);
+  wl_resource_set_implementation (device_resource, &device_interface,
+                                  data_control, device_destructor);
+  wl_list_insert (&data_control->device_resources,
+                  wl_resource_get_link (device_resource));
+
+  send_selection (data_control, device_resource, META_SELECTION_CLIPBOARD);
+  send_selection (data_control, device_resource, META_SELECTION_PRIMARY);
+}
+
+static const struct ext_data_control_manager_v1_interface manager_interface =
+{
+  manager_create_data_source,
+  manager_get_data_device,
+  default_destroy,
+};
+
+static void
+bind_manager (struct wl_client *client,
+              void             *data,
+              uint32_t          version,
+              uint32_t          id)
+{
+  MetaWaylandDataControl *data_control = data;
+  struct wl_resource *resource;
+
+  resource = wl_resource_create (client, &ext_data_control_manager_v1_interface,
+                                 version, id);
+  wl_resource_set_implementation (resource, &manager_interface,
+                                  data_control, NULL);
+
+  if (!data_control->owner_changed_id)
+    {
+      data_control->owner_changed_id =
+        g_signal_connect (selection_of (data_control), "owner-changed",
+                          G_CALLBACK (on_owner_changed), data_control);
+    }
+}
+
+static char *
+flatpak_app_id (const struct wl_client *client)
+{
+  g_autoptr (GKeyFile) info = g_key_file_new ();
+  g_autofree char *info_path = NULL;
+  pid_t pid;
+
+  wl_client_get_credentials ((struct wl_client *) client, &pid, NULL, NULL);
+  info_path = g_strdup_printf ("/proc/%d/root/.flatpak-info", pid);
+
+  if (!g_key_file_load_from_file (info, info_path, G_KEY_FILE_NONE, NULL))
+    return NULL;
+
+  return g_key_file_get_string (info, "Application", "name", NULL);
+}
+
+static MetaWaylandAccess
+data_control_filter (const struct wl_client *client,
+                     const struct wl_global *global,
+                     gpointer                user_data)
+{
+  MetaWaylandDataControl *data_control = user_data;
+  g_autofree char *app_id = flatpak_app_id (client);
+  g_auto (GStrv) allowed = NULL;
+
+  if (!app_id)
+    return META_WAYLAND_ACCESS_ALLOWED;
+
+  allowed = g_settings_get_strv (data_control->settings, SANDBOXED_APPS_KEY);
+  if (g_strv_contains ((const char * const *) allowed, app_id))
+    return META_WAYLAND_ACCESS_ALLOWED;
+
+  return META_WAYLAND_ACCESS_DENIED;
+}
+
+static void
+data_control_free (MetaWaylandDataControl *data_control)
+{
+  release_source (&data_control->clipboard);
+  release_source (&data_control->primary);
+  g_clear_object (&data_control->clipboard.owner);
+  g_clear_object (&data_control->primary.owner);
+  g_clear_object (&data_control->settings);
+  g_free (data_control);
+}
+
+void
+meta_wayland_init_data_control (MetaWaylandCompositor *compositor)
+{
+  MetaWaylandDataControl *data_control;
+  struct wl_global *global;
+
+  data_control = g_new0 (MetaWaylandDataControl, 1);
+  data_control->compositor = compositor;
+  data_control->settings = g_settings_new (SETTINGS_SCHEMA);
+  data_control->clipboard = (ControlledSelection) {
+    .data_control = data_control,
+    .type = META_SELECTION_CLIPBOARD,
+  };
+  data_control->primary = (ControlledSelection) {
+    .data_control = data_control,
+    .type = META_SELECTION_PRIMARY,
+  };
+  wl_list_init (&data_control->device_resources);
+
+  global = wl_global_create (compositor->wayland_display,
+                             &ext_data_control_manager_v1_interface,
+                             META_EXT_DATA_CONTROL_MANAGER_V1_VERSION,
+                             data_control, bind_manager);
+  if (!global)
+    g_error ("Failed to register a global ext_data_control_manager_v1 object");
+
+  meta_wayland_filter_manager_add_global (meta_wayland_compositor_get_filter_manager (compositor),
+                                          global, data_control_filter,
+                                          data_control);
+
+  g_object_set_data_full (G_OBJECT (compositor), "-meta-wayland-data-control",
+                          data_control, (GDestroyNotify) data_control_free);
+}
