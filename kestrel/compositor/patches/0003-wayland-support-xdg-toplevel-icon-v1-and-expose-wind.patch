@@ -0,0 +1,24 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "config.h"
+
+#include "core/window-private.h"
+
+/**
+ * meta_window_get_toplevel_icon:
+ * @window: a #MetaWindow
+ *
+ * Returns: (transfer none) (nullable): the icon supplied by the toplevel
+ */
+GIcon *
+meta_window_get_toplevel_icon (MetaWindow *window)
+{
+  return window->toplevel_icon;
+}
+
+void
+meta_window_set_toplevel_icon (MetaWindow *window,
+                              GIcon      *icon)
+{
+  if (g_set_object (&window->toplevel_icon, icon))
+    g_object_notify (G_OBJECT (window), "toplevel-icon");
+}
