## Fingerprints
## Each finger has a name used as a title (the message value) and a form used inside
## a sentence (.inline), like "Place your … on the sensor." Adjust the case of .inline
## to fit those sentences.

ui-finger-right-index = Правый указательный палец
    .inline = правым указательным пальцем
ui-finger-left-index = Левый указательный палец
    .inline = левым указательным пальцем
ui-finger-right-thumb = Правый большой палец
    .inline = правым большим пальцем
ui-finger-left-thumb = Левый большой палец
    .inline = левым большим пальцем
ui-finger-right-middle = Правый средний палец
    .inline = правым средним пальцем
ui-finger-left-middle = Левый средний палец
    .inline = левым средним пальцем
ui-finger-right-ring = Правый безымянный палец
    .inline = правым безымянным пальцем
ui-finger-left-ring = Левый безымянный палец
    .inline = левым безымянным пальцем
ui-finger-right-little = Правый мизинец
    .inline = правым мизинцем
ui-finger-left-little = Левый мизинец
    .inline = левым мизинцем

ui-fingerprint-place = Прикоснитесь к сканеру { $finger }.
ui-fingerprint-swipe = Проведите { $finger } по сканеру.
ui-fingerprint-stage-passed = Хорошо. Поднимите палец и приложите его снова.
ui-fingerprint-stage-passed-swipe = Хорошо. Проведите ещё раз.
ui-fingerprint-retry = Отпечаток не распознан. Попробуйте ещё раз.
ui-fingerprint-swipe-too-short = Проведите чуть медленнее.
ui-fingerprint-not-centered = Приложите палец к центру сканера.
ui-fingerprint-remove-and-retry = Поднимите палец и попробуйте ещё раз.
ui-fingerprint-added = Отпечаток пальца добавлен.
ui-fingerprint-full = В сканере не осталось места для нового отпечатка.
ui-fingerprint-disconnected = Сканер отпечатков перестал отвечать. Попробуйте ещё раз чуть позже.
ui-fingerprint-duplicate = Этот палец уже сохранён в сканере — вероятно, в Windows или другой учётной записи. Используйте другой палец.
ui-fingerprint-failed = Не удалось добавить этот отпечаток. Попробуйте ещё раз.

