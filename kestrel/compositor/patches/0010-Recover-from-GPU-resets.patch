+
+dummy:
+  /* Mimmick allocated texture / prevent allocation. */
+  COGL_TEXTURE_2D (texture)->internal_format = format;
+  _cogl_texture_set_allocated (texture, format, width, height);
+
+  return meta_multi_texture_new_simple (texture);
+}
+
+static void
+reattach_buffer (MetaWaylandBuffer  *buffer,
+                 MetaMultiTexture  **texture)
+{
+  const char *error_message = NULL;
+  g_autoptr (GError) error = NULL;
