[Unit]
Description=Carry on changing Luft's partition, and take back the space Meet Luft used
Documentation=https://docs.luft.computer/developers/system/resizing/
ConditionKernelCommandLine=!rd.live.image
After=local-fs.target dbus.service udisks2.service trustd-follow-up.service
Wants=udisks2.service

[Service]
Type=exec
ExecStart=/usr/bin/trustctl system-disk continue
SyslogIdentifier=trustd
Nice=10
IOSchedulingClass=idle
TimeoutStopSec=1min
KeyringMode=shared
ProtectHome=read-only
PrivateTmp=yes
NoNewPrivileges=yes
UMask=0077
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectKernelModules=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_ALG
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
