+static void
+paint_scene_to_framebuffer (ClutterStage       *stage,
+                            CoglFramebuffer    *framebuffer,
+                            const MtkRectangle *rect,
+                            float               scale,
+                            ClutterColorState  *color_state,
+                            const MtkRegion    *redraw_clip,
+                            ClutterPaintFlag    paint_flags)
+{
+  ClutterStagePrivate *priv = clutter_stage_get_instance_private (stage);
+  ClutterPaintContext *paint_context;
+  g_autoptr (MtkRegion) intersection = NULL;
+  float exact_viewport[4];
+  float viewport[4];
+  graphene_matrix_t projection;
+
+  COGL_TRACE_BEGIN_SCOPED (PaintToFramebuffer,
+                           "Clutter::Stage::paint_to_framebuffer()");
+
+  if (paint_flags & CLUTTER_PAINT_FLAG_CLEAR)
+    {
+      CoglColor clear_color;
+
+      cogl_color_init_from_4f (&clear_color, 0.0, 0.0, 0.0, 0.0);
+      cogl_framebuffer_clear (framebuffer, COGL_BUFFER_BIT_COLOR, &clear_color);
+    }
+
+  intersection = mtk_region_create_rectangle (rect);
+
+  if (redraw_clip)
+    mtk_region_intersect (intersection, redraw_clip);
+
+  if (!color_state)
+    color_state = clutter_actor_get_color_state (CLUTTER_ACTOR (stage));
+
+  paint_context =
+    clutter_paint_context_new_for_framebuffer (framebuffer,
+                                               intersection,
+                                               paint_flags,
+                                               color_state);
+
+  exact_viewport[0] = -(rect->x * scale);
+  exact_viewport[1] = -(rect->y * scale);
+  exact_viewport[2] = priv->viewport[2] * scale;
+  exact_viewport[3] = priv->viewport[3] * scale;
+  clutter_stage_calculate_viewport_and_projection (&priv->projection,
+                                                   exact_viewport,
+                                                   viewport,
+                                                   &projection);
+
+  cogl_framebuffer_push_matrix (framebuffer);
+  cogl_framebuffer_set_projection_matrix (framebuffer, &projection);
+  cogl_framebuffer_set_viewport (framebuffer,
+                                 viewport[0], viewport[1],
+                                 viewport[2], viewport[3]);
+  clutter_actor_paint (CLUTTER_ACTOR (stage), paint_context);
+  cogl_framebuffer_pop_matrix (framebuffer);
+
+  clutter_paint_context_destroy (paint_context);
+
+  cogl_framebuffer_flush (framebuffer);
+}
+
+static gboolean
+paint_filtered_views (ClutterStage       *stage,
+                      ClutterColorState  *color_state,
+                      ClutterPaintFlag    paint_flags,
+                      const MtkRectangle *rect)
+{
+  ClutterStagePrivate *priv = clutter_stage_get_instance_private (stage);
+  gboolean filtered = FALSE;
+  GList *l;
+
+  for (l = _clutter_stage_window_get_views (priv->impl); l; l = l->next)
+    {
+      ClutterStageView *view = l->data;
+      ClutterViewFilter *filter = clutter_stage_view_get_filter (view);
+      MtkRectangle layout;
+
+      clutter_stage_view_get_layout (view, &layout);
+      if (!filter || !clutter_view_filter_get_captured (filter) ||
+          !mtk_rectangle_overlap (&layout, rect))
+        continue;
+
+      paint_scene_to_framebuffer (stage,
+                                  clutter_stage_view_get_capture_scene (view),
+                                  &layout,
+                                  clutter_stage_view_get_scale (view),
+                                  color_state, NULL, paint_flags);
+      filtered = TRUE;
+    }
+
+  return filtered;
+}
+
+static void
+draw_filtered_views (ClutterStage       *stage,
+                     CoglFramebuffer    *framebuffer,
+                     const MtkRectangle *rect,
+                     float               scale)
+{
+  ClutterStagePrivate *priv = clutter_stage_get_instance_private (stage);
+  CoglContext *context = cogl_framebuffer_get_context (framebuffer);
+  int width = cogl_framebuffer_get_width (framebuffer);
+  int height = cogl_framebuffer_get_height (framebuffer);
+  GList *l;
+
+  cogl_framebuffer_push_matrix (framebuffer);
+  cogl_framebuffer_orthographic (framebuffer, 0, 0, width, height, -1, 1);
+  cogl_framebuffer_set_viewport (framebuffer, 0, 0, width, height);
+
+  for (l = _clutter_stage_window_get_views (priv->impl); l; l = l->next)
+    {
+      ClutterStageView *view = l->data;
+      ClutterViewFilter *filter = clutter_stage_view_get_filter (view);
+      g_autoptr (CoglPipeline) pipeline = NULL;
+      MtkRectangle layout;
+      float x, y;
+
+      clutter_stage_view_get_layout (view, &layout);
+      if (!filter || !clutter_view_filter_get_captured (filter) ||
+          !mtk_rectangle_overlap (&layout, rect))
+        continue;
+
+      pipeline = cogl_pipeline_new (context);
+      cogl_pipeline_set_blend (pipeline, "RGBA = ADD (SRC_COLOR, 0)", NULL);
+      cogl_pipeline_set_layer_texture (pipeline, 0,
+                                       clutter_stage_view_filter_capture (view));
+      x = (layout.x - rect->x) * scale;
+      y = (layout.y - rect->y) * scale;
+      cogl_framebuffer_draw_textured_rectangle (framebuffer, pipeline,
+                                                x, y,
+                                                x + layout.width * scale,
+                                                y + layout.height * scale,
+                                                0, 0, 1, 1);
+    }
+
+  cogl_framebuffer_pop_matrix (framebuffer);
+  cogl_framebuffer_flush (framebuffer);
+}
