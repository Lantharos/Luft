-static void
-add_glass_effect (const MetaBackgroundPaint *paint,
-                  CoglPipeline              *pipeline)
+gboolean
+meta_background_is_niko (MetaGlassMaterial material)
+{
+  return material == META_GLASS_MATERIAL_NIKO ||
+    material == META_GLASS_MATERIAL_NIKO_WALLPAPER;
+}
+
+void
+meta_background_add_glass_effect (const MetaBackgroundPaint *paint,
+                                  CoglPipeline              *pipeline)
 {
-  const CoglColor *surface;
+  const CoglColor *tint;
   float luminosity;
 
-  if (paint->material != META_GLASS_MATERIAL_SURFACE)
