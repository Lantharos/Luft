 clutter/clutter/clutter-paint-nodes.c |  55 ++++--
 clutter/clutter/clutter-paint-nodes.h |   5 +
 src/compositor/compositor.c           |   4 +-
 4 files changed, 312 insertions(+), 14 deletions(-)
 create mode 100644 clutter/clutter/clutter-grain.h

