+static int
+sample_reach (MetaBackgroundBlur *blur)
+{
+  float radius, saturation, noise;
+  int reach = 0;
+  GList *l;
+
+  if (mtk_region_num_rectangles (blur->blur_region) <= 1 ||
+      meta_background_shows_wallpaper (blur->compositor,
+                                       meta_compositor_get_glass_material (blur->compositor,
+                                                                           blur->role,
+                                                                           blur->preference)))
+    return 0;
+
+  meta_compositor_get_background_blur_params (blur->compositor, &radius, &saturation, &noise);
+  for (l = clutter_actor_peek_stage_views (blur->actor); l; l = l->next)
+    {
+      float scale = clutter_stage_view_get_scale (l->data);
+
+      reach = MAX (reach, (int) ceilf (clutter_blur_node_get_reach (radius * scale) / scale) + 1);
+    }
+
+  return reach;
+}
+
+const MtkRegion *
+meta_background_blur_get_sample_region (MetaBackgroundBlur *blur)
+{
+  int reach = sample_reach (blur);
+  MtkRectangle extents;
+  int i;
+
+  if (blur->sample_region && blur->sample_reach == reach)
+    return blur->sample_region;
+
+  g_clear_pointer (&blur->sample_region, mtk_region_unref);
+  blur->sample_reach = reach;
+  blur->sample_region = mtk_region_copy (blur->blur_region);
+  if (reach == 0)
+    return blur->sample_region;
+
+  for (i = 0; i < mtk_region_num_rectangles (blur->blur_region); i++)
+    {
+      MtkRectangle rect = mtk_region_get_rectangle (blur->blur_region, i);
+
+      mtk_region_union_rectangle (blur->sample_region,
+                                  &MTK_RECTANGLE_INIT (rect.x - reach,
+                                                       rect.y - reach,
+                                                       rect.width + 2 * reach,
+                                                       rect.height + 2 * reach));
+    }
+  extents = mtk_region_get_extents (blur->blur_region);
+  mtk_region_intersect_rectangle (blur->sample_region, &extents);
+  return blur->sample_region;
+}
