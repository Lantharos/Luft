## USB devices

usb-title = { $count ->
    [one] Darf { $appName } dieses Gerät verwenden?
   *[other] Darf { $appName } diese Geräte verwenden?
}
usb-description = { $count ->
    [one] { $appName } kann dann direkt mit dem Gerät kommunizieren, solange es angeschlossen ist.
