<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
 "https://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<node name="/com/lantharos/Packages1">
  <!--
    Packages added to the system as a system extension, rebuilt for every version of Luft on the
    computer, from Fedora, the repositories that were added in
    /var/lib/luft/system-packages/repositories, and package files installed by themselves. Started on demand and stops when idle.

    Install, InstallFile and Remove need com.lantharos.packages.change, AddRepository and
    RemoveRepository com.lantharos.packages.sources. Those that change the packages return once
    the running system uses the new set; Step tells how far they are. List, Provider and
    DescribeRepository need nothing. Only root can call Rebuild and Update. InstallExtension and
    RemoveExtension need com.lantharos.packages.extensions and only change the caller's own folder.
    InstallUnreviewedExtension and AllowExtensionFolder are refused while Developer tools is off and to
    any program but Luft's Settings, and need com.lantharos.packages.unreviewed-extensions every time.
    RemoveUnreviewedExtension needs nothing. All three only change the caller's own records.
  -->
  <interface name="com.lantharos.Packages1">
    <!-- JSON: {"requested": [names], "packages": [{"name", "version", "arch", "summary",
         "requested", "units", "apps": [desktop entries], "origin": "fedora", "file" or
         {"repository": file}}] merged now,
         dependencies included, "services": [units turned on], "pending": true when the merged
         set isn't the requested one yet, "repositories": [{"file", "sources": [{"id", "name",
         "url"}]}]}. -->
    <method name="List">
      <arg name="packages" type="s" direction="out"/>
    </method>
    <method name="Install">
      <arg name="names" type="as" direction="in"/>
    </method>
    <!-- Installs a package file, kept so every version builds it again. Its digests are
         checked, not a signature. -->
    <method name="InstallFile">
      <arg name="package" type="h" direction="in"/>
    </method>
    <method name="Remove">
      <arg name="names" type="as" direction="in"/>
    </method>
    <!-- The package in Fedora or the added repositories that provides a capability, such as
         "libfoo.so.1()(64bit)", "unpaper" or "perl(Foo::Bar)", or "" when none does,
         from the metadata the last build downloaded. -->
    <method name="Provider">
      <arg name="capability" type="s" direction="in"/>
      <arg name="package" type="s" direction="out"/>
    </method>
    <!-- Checks a repository file to be kept as /var/lib/luft/system-packages/repositories/FILE.repo,
         and the keys it names, each given by the address its gpgkey has. Every source that's turned
         on must check signatures and be reached over HTTPS. JSON: {"file", "sources": [...], "keys":
         [{"fingerprint", "user"}]}. -->
    <method name="DescribeRepository">
      <arg name="file" type="s" direction="in"/>
      <arg name="text" type="s" direction="in"/>
      <arg name="keys" type="a{ss}" direction="in"/>
      <arg name="repository" type="s" direction="out"/>
    </method>
    <!-- Adds what DescribeRepository described, with its keys kept in
         /var/lib/luft/system-packages/keys. -->
    <method name="AddRepository">
      <arg name="file" type="s" direction="in"/>
      <arg name="text" type="s" direction="in"/>
      <arg name="keys" type="a{ss}" direction="in"/>
    </method>
    <!-- Removes a repository and the packages that came from it. -->
    <method name="RemoveRepository">
      <arg name="file" type="s" direction="in"/>
    </method>
    <!-- Installs a Luft extension release into /var/lib/luft/extensions/UID/ID for the caller, where
         only root can change it, in place of any earlier version. The listing is schelf.store's signed
         index/v1/apps/ID.json and the keys its trust/v1/store-keys.json, each with its .sig seal as
         sent. The service checks the keys against schelf.store's root key and the listing against the
         keys, that the listing hasn't expired, that its publisher is verified, and that the archive is
         the file of a release it marks runs_in_shell. Anything else is refused. -->
    <method name="InstallExtension">
      <arg name="id" type="s" direction="in"/>
      <arg name="listing" type="ay" direction="in"/>
      <arg name="listing_seal" type="ay" direction="in"/>
      <arg name="keys" type="ay" direction="in"/>
      <arg name="keys_seal" type="ay" direction="in"/>
      <arg name="archive" type="h" direction="in"/>
    </method>
    <!-- Removes an extension InstallExtension installed for the caller. -->
    <method name="RemoveExtension">
      <arg name="id" type="s" direction="in"/>
    </method>
    <!-- Copies the extension folder, which has to be the caller's own entirely, with no links and
         nothing on another drive, into /var/lib/luft/unreviewed-extensions/UID/ID, where only root
         can change it, in place of an earlier copy. Kestrel runs it inside the shell while Developer
         tools is on. -->
    <method name="InstallUnreviewedExtension">
      <arg name="id" type="s" direction="in"/>
      <arg name="folder" type="h" direction="in"/>
    </method>
    <!-- Records in /var/lib/luft/unreviewed-extensions/UID/.folders.json that the caller's extension
         ID runs inside the shell from PATH, a full path ending in ID, while Developer tools is on. -->
    <method name="AllowExtensionFolder">
      <arg name="id" type="s" direction="in"/>
      <arg name="path" type="s" direction="in"/>
    </method>
    <!-- Removes the caller's copy of ID and the approval of its folder. -->
    <method name="RemoveUnreviewedExtension">
      <arg name="id" type="s" direction="in"/>
    </method>
    <!-- Builds the packages for the running version when it has none for the current list, and
         for the other versions on the computer, such as an update that was just staged. Returns
         when they're built. -->
    <method name="Rebuild"/>
    <!-- Builds the packages again for every version on the computer whose packages have newer
         versions out, and has the running system use its new build, or the one before when that
         fails. com.lantharos.Updater1 calls it when it checks for updates on schedule. Returns
         when it's done. -->
    <method name="Update"/>
    <!-- "downloading", "building" or "starting". -->
    <signal name="Step">
      <arg name="step" type="s"/>
    </signal>
  </interface>
</node>
