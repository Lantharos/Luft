#!/bin/sh
if [ -z "$KESTREL_LOGIN_SHELL" ]; then
  export KESTREL_LOGIN_SHELL=1
  exec "${SHELL:-/bin/sh}" -l -c 'exec "$0" "$@"' "$0" "$@"
fi
unset KESTREL_LOGIN_SHELL

export XDG_SESSION_TYPE=wayland
export XDG_SESSION_DESKTOP="${XDG_SESSION_DESKTOP:-kestrel}"
export XDG_CURRENT_DESKTOP="${XDG_CURRENT_DESKTOP:-Kestrel:GNOME}"
XDG_DATA_DIRS="${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
case ":$XDG_DATA_DIRS:" in
  *:@datadir@:*) ;;
  *) XDG_DATA_DIRS="@datadir@:$XDG_DATA_DIRS" ;;
esac
export XDG_DATA_DIRS
export IBUS_DAEMON_ARGS="--panel disable"

DCONF_PROFILE="${XDG_RUNTIME_DIR:-/tmp}/kestrel/dconf-profile"
mkdir -p "${DCONF_PROFILE%/*}"
{ cat /etc/dconf/profile/user 2> /dev/null || echo user-db:user; printf "\nfile-db:%s\n" "@pkgdatadir@/dconf/kestrel"; } > "$DCONF_PROFILE"
export DCONF_PROFILE

region="$(gsettings get org.gnome.system.locale region 2> /dev/null | tr -d "'")"
formats="${region:-$LANG}"
if [ -n "$formats" ]; then
  export LC_TIME="$formats" LC_NUMERIC="$formats" LC_MONETARY="$formats" LC_MEASUREMENT="$formats" LC_PAPER="$formats"
fi

systemctl --user reset-failed
dbus-update-activation-environment --systemd --all

run_until_stopped() {
  target="$1"
  systemctl --user start --wait "$target" &
  trap 'systemctl --user stop "$target"; exit' HUP INT TERM
  wait $!
}

SETUP_PENDING=/var/lib/luft-installer/first-boot
if [ "$1" = --setup ] || [ "$(cat "$SETUP_PENDING" 2> /dev/null)" = "$USER" ]; then
  run_until_stopped kestrel-setup.target
fi

run_until_stopped kestrel-session.target
