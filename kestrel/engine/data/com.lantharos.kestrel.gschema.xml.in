<schemalist>
  <enum id="com.lantharos.kestrel.DarkSchedule">
    <value nick="off" value="0"/>
    <value nick="sunset" value="1"/>
    <value nick="custom" value="2"/>
  </enum>

  <enum id="com.lantharos.kestrel.Accent">
    <value nick="wallpaper" value="0"/>
    <value nick="white" value="1"/>
  </enum>

  <enum id="com.lantharos.kestrel.AppIconStyle">
    <value nick="default" value="0"/>
    <value nick="tinted" value="1"/>
    <value nick="clear" value="2"/>
  </enum>

  <enum id="com.lantharos.kestrel.SkinTone">
    <value nick="none" value="0"/>
    <value nick="light" value="1"/>
    <value nick="medium-light" value="2"/>
    <value nick="medium" value="3"/>
    <value nick="medium-dark" value="4"/>
    <value nick="dark" value="5"/>
  </enum>

  <enum id="com.lantharos.kestrel.VariableRefresh">
    <value nick="games" value="0"/>
    <value nick="fullscreen" value="1"/>
  </enum>

  <enum id="com.lantharos.kestrel.WeekStart">
    <value nick="automatic" value="0"/>
    <value nick="monday" value="1"/>
    <value nick="sunday" value="2"/>
  </enum>

  <enum id="com.lantharos.kestrel.WindowTiling">
    <value nick="off" value="0"/>
    <value nick="tiling" value="1"/>
    <value nick="scrolling" value="2"/>
  </enum>

  <enum id="com.lantharos.kestrel.TilingLayout">
    <value nick="dwindle" value="0"/>
    <value nick="master" value="1"/>
  </enum>

  <enum id="com.lantharos.kestrel.TilingGaps">
    <value nick="none" value="0"/>
    <value nick="small" value="1"/>
    <value nick="medium" value="2"/>
    <value nick="large" value="3"/>
  </enum>

  <enum id="com.lantharos.kestrel.TilingNewWindows">
    <value nick="beside-focused" value="0"/>
    <value nick="at-end" value="1"/>
  </enum>

  <enum id="com.lantharos.kestrel.TaskbarPosition">
    <value nick="bottom" value="0"/>
    <value nick="left" value="1"/>
    <value nick="top" value="2"/>
    <value nick="right" value="3"/>
  </enum>

  <enum id="com.lantharos.kestrel.TaskbarAlignment">
    <value nick="center" value="0"/>
    <value nick="left" value="1"/>
  </enum>

  <enum id="com.lantharos.kestrel.TaskbarLook">
    <value nick="glass" value="0"/>
    <value nick="solid" value="1"/>
    <value nick="transparent" value="2"/>
    <value nick="accent" value="3"/>
  </enum>

  <enum id="com.lantharos.kestrel.TaskbarStyle">
    <value nick="bar" value="0"/>
    <value nick="floating" value="1"/>
    <value nick="separate" value="2"/>
  </enum>

  <enum id="com.lantharos.kestrel.TaskbarSize">
    <value nick="compact" value="0"/>
    <value nick="normal" value="1"/>
    <value nick="large" value="2"/>
  </enum>

  <enum id="com.lantharos.kestrel.RainIntensity">
    <value nick="drizzle" value="0"/>
    <value nick="rain" value="1"/>
    <value nick="storm" value="2"/>
  </enum>

  <enum id="com.lantharos.kestrel.TaskbarAutoHide">
    <value nick="never" value="0"/>
    <value nick="always" value="1"/>
    <value nick="windows" value="2"/>
  </enum>

  <enum id="com.lantharos.kestrel.StartStyle">
    <value nick="menu" value="0"/>
    <value nick="palette" value="1"/>
  </enum>

  <enum id="com.lantharos.kestrel.WebSearch">
    <value nick="duckduckgo" value="0"/>
    <value nick="google" value="1"/>
    <value nick="bing" value="2"/>
    <value nick="brave" value="3"/>
    <value nick="ecosia" value="4"/>
    <value nick="startpage" value="5"/>
    <value nick="kagi" value="6"/>
  </enum>

  <enum id="com.lantharos.kestrel.TaskbarDisplays">
    <value nick="all" value="0"/>
    <value nick="primary" value="1"/>
  </enum>

  <schema id="com.lantharos.kestrel" path="/com/lantharos/kestrel/"
          gettext-domain="@GETTEXT_PACKAGE@">
    <key name="lock-screen-content" type="b">
      <default>true</default>
      <summary>Show notification content on the lock screen</summary>
      <description>
        When enabled, the lock screen shows the titles and text of new
        notifications. When disabled, only apps that allow it individually
        show their content; other apps show their name and a count.
      </description>
    </key>
    <key name="start-layout" type="s">
      <default>'{"items":[],"folders":{}}'</default>
      <summary>Start app order and folders</summary>
    </key>
    <key name="quick-tile-order" type="as">
      <default>[]</default>
      <summary>Order of the Quick Settings tiles</summary>
    </key>
    <key name="quick-tiles-removed" type="as">
      <default>["screenshot", "settings", "lock", "rotation-0", "rain-0"]</default>
      <summary>Quick Settings tiles removed by the user</summary>
    </key>
    <key name="quick-tiles-known" type="as">
      <default>["screenshot", "settings", "lock"]</default>
      <summary>Tiles hidden by default that the Quick Settings layout already knows about</summary>
      <description>Tiles hidden by default that are not listed here are new, and stay hidden in a customized layout until the user adds them.</description>
    </key>
    <key name="live-wallpaper" type="s">
      <default>''</default>
      <summary>Video shown as a live wallpaper in light mode</summary>
      <description>
        URI of a video that plays behind the desktop while the light style
        is active. Kestrel sets the org.gnome.desktop.background picture-uri
        to a still frame of it, which the lock screen and other surfaces use.
        Empty when the light wallpaper is a picture; choosing a picture for
        light mode clears it.
      </description>
    </key>
    <key name="live-wallpaper-dark" type="s">
      <default>''</default>
      <summary>Video shown as a live wallpaper in dark mode</summary>
      <description>
        URI of a video that plays behind the desktop while the dark style
        is active. Kestrel sets the org.gnome.desktop.background
        picture-uri-dark to a still frame of it. Empty when the dark
        wallpaper is a picture; choosing a picture for dark mode clears it.
      </description>
    </key>
    <key name="wallpaper-focus" type="(dd)">
      <default>(0.5, 0.5)</default>
      <summary>Part of the light wallpaper kept on screen</summary>
      <description>
        Horizontal and vertical position, from 0 to 1, of the visible area
        when the Fill style crops the light wallpaper to a display of a
        different shape. (0.5, 0.5) keeps the middle; (0.5, 1) keeps the
        bottom. Applies to live wallpapers too.
      </description>
    </key>
    <key name="wallpaper-focus-dark" type="(dd)">
      <default>(0.5, 0.5)</default>
      <summary>Part of the dark wallpaper kept on screen</summary>
      <description>
        Like wallpaper-focus, for the wallpaper shown while the dark style
        is active.
      </description>
    </key>
    <key name="wallpaper-focus-chosen" type="a{s(dd)}">
      <default>{}</default>
      <summary>Wallpaper positions chosen by hand</summary>
      <description>
        Focus points the user set in Settings, by wallpaper URI, so a
        wallpaper keeps its position when it is chosen again.
      </description>
    </key>
    <key name="dark-schedule" enum="com.lantharos.kestrel.DarkSchedule">
      <default>'off'</default>
      <summary>When the dark style turns on by itself</summary>
      <description>
        'sunset' switches to dark at sunset and back to light at sunrise,
        using the location when location services are on and the time
        zone's main city otherwise. 'custom' uses dark-schedule-from and
        dark-schedule-to. Choosing a style by hand lasts until the next
        change in the schedule.
      </description>
    </key>
    <key name="dark-schedule-from" type="d">
      <range min="0" max="23.99"/>
      <default>20.0</default>
      <summary>Hour, in local time, when a custom schedule turns the dark style on</summary>
    </key>
    <key name="dark-schedule-to" type="d">
      <range min="0" max="23.99"/>
      <default>7.0</default>
      <summary>Hour, in local time, when a custom schedule turns the dark style off</summary>
    </key>
    <key name="variable-refresh" enum="com.lantharos.kestrel.VariableRefresh">
      <default>'games'</default>
      <summary>Which fullscreen windows displays with variable refresh follow</summary>
      <description>
        On displays with variable refresh turned on, 'games' lets the
        refresh rate follow fullscreen games only: windows that say they
        show a game, Steam, Lutris and Heroic games, gamescope, and apps in
        the Game category. Video players, browsers and other apps keep the
        display at its fixed refresh rate, which avoids the flicker some
        panels show when the rate changes with a video's frame timing.
        'fullscreen' lets it follow every fullscreen window except ones that
        say they show video or photos.
      </description>
    </key>
    <key name="pure-black" type="b">
      <default>false</default>
      <summary>Use true black for dark surfaces</summary>
      <description>
        Makes Kestrel's surfaces, Luft apps and the dark colors generated
        for other apps fully black, which saves power on OLED displays.
      </description>
    </key>
    <key name="accent" enum="com.lantharos.kestrel.Accent">
      <default>'wallpaper'</default>
      <summary>Accent color of the desktop and apps</summary>
      <description>
        Wallpaper picks the accent from the wallpaper, and turns white when
        the wallpaper has hardly any color. White keeps the accent white in
        the dark style and black in the light style.
      </description>
    </key>
    <key name="theme-apps" type="b">
      <default>false</default>
      <summary>Color other apps from the wallpaper</summary>
      <description>
        Generates colors from the wallpaper palette for GTK 4, GTK 3, Qt,
        KDE and Ghostty in the user's configuration directory. Turning it
        off removes everything that was generated.
      </description>
    </key>
    <key name="app-icon-style" enum="com.lantharos.kestrel.AppIconStyle">
      <default>'tinted'</default>
      <summary>How app icons are drawn</summary>
      <description>
        Tinted draws a single-color
        glyph on a plain plate, Original shows each app's own colors, and Clear draws a light glyph on glass.
      </description>
    </key>
    <key name="app-icon-tint" type="s">
      <default>''</default>
      <summary>Color of tinted app icons</summary>
      <description>
        A color such as #3584e4 for tinted app icons. Empty uses the
        accent color.
      </description>
    </key>
    <key name="live-wallpaper-on-battery" type="b">
      <default>false</default>
      <summary>Keep live wallpapers playing on battery power</summary>
      <description>
        When disabled, live wallpapers pause on their still frame while the
        computer runs on battery.
      </description>
    </key>
    <key name="rain" type="b">
      <default>false</default>
      <summary>Let it rain</summary>
      <description>
        Turns rain on, shown on the desktop when rain-visible is on and heard
        when rain-sound is on. The Rain tile in Quick Settings switches this.
      </description>
    </key>
    <key name="rain-visible" type="b">
      <default>true</default>
      <summary>Show rain on the desktop</summary>
      <description>
        Rain falls over the wallpaper, lands on the top edges of windows and
        the taskbar and splashes there. It stops while the wallpaper is
        hidden, animations are off or reduced, or the power saver is on.
      </description>
    </key>
    <key name="rain-sound" type="b">
      <default>false</default>
      <summary>Play the sound of rain</summary>
      <description>
        The sound is made as it plays, so it never loops. It keeps playing
        behind windows and stops while the screen is locked.
      </description>
    </key>
    <key name="rain-volume" type="d">
      <range min="0" max="1"/>
      <default>0.6</default>
      <summary>Volume of the rain sound</summary>
    </key>
    <key name="rain-intensity" enum="com.lantharos.kestrel.RainIntensity">
      <default>'rain'</default>
      <summary>How hard it rains</summary>
    </key>
    <key name="global-shortcuts" type="s">
      <default>'{}'</default>
      <summary>Shortcuts that apps have registered through the global shortcuts portal</summary>
    </key>
    <key name="emoji-recent" type="as">
      <default>[]</default>
      <summary>Emoji, symbols and kaomoji picked most recently, newest first</summary>
    </key>
    <key name="emoji-skin-tone" enum="com.lantharos.kestrel.SkinTone">
      <default>'none'</default>
      <summary>Skin tone used for emoji of people and hands</summary>
    </key>
    <key name="week-start" enum="com.lantharos.kestrel.WeekStart">
      <default>'automatic'</default>
      <summary>First day of the week in calendars</summary>
      <description>
        “automatic” follows the region formats, from the region setting or LC_TIME.
      </description>
    </key>
    <key name="start-style" enum="com.lantharos.kestrel.StartStyle">
      <default>'menu'</default>
      <summary>How Start looks</summary>
      <description>
        'menu' opens Start with its search, apps and folders above the
        taskbar. 'palette' opens Gust, a search bar in the middle of the
        screen. Super and the Start button open whichever is chosen.
      </description>
    </key>
    <key name="search-web-engine" enum="com.lantharos.kestrel.WebSearch">
      <default>'duckduckgo'</default>
      <summary>Where Start's search looks up the web</summary>
    </key>
    <key name="taskbar-shown" type="b">
      <default>true</default>
      <summary>Show the taskbar</summary>
      <description>
        When disabled, the taskbar is gone and a small corner with the
        clock and status icons opens quick settings and notifications.
        Tablet mode always shows the taskbar.
      </description>
    </key>
    <key name="taskbar-start-button" type="b">
      <default>true</default>
      <summary>Show the Start button</summary>
      <description>
        When disabled, Super still opens Start.
      </description>
    </key>
    <key name="taskbar-position" enum="com.lantharos.kestrel.TaskbarPosition">
      <default>'bottom'</default>
      <summary>Which edge of the screen the taskbar runs along</summary>
      <description>
        Start, quick settings, notifications and the taskbar's menus open
        from the same edge. Tablet mode always keeps the taskbar at the
        bottom.
      </description>
    </key>
    <key name="taskbar-alignment" enum="com.lantharos.kestrel.TaskbarAlignment">
      <default>'center'</default>
      <summary>Where Start and the apps sit on the taskbar</summary>
      <description>
        'left' puts them at the start of the taskbar: the left end of a
        horizontal taskbar, or the top of one along the left or right edge.
      </description>
    </key>
    <key name="taskbar-look" enum="com.lantharos.kestrel.TaskbarLook">
      <default>'glass'</default>
      <summary>How the taskbar's background looks</summary>
      <description>
        'glass' blurs what is behind the taskbar, 'solid' paints it in the
        dark surface color, 'transparent' leaves only the icons and text on
        the wallpaper, and 'accent' tints the glass with the accent color.
      </description>
    </key>
    <key name="taskbar-style" enum="com.lantharos.kestrel.TaskbarStyle">
      <default>'bar'</default>
      <summary>Whether the taskbar spans the screen or floats above its edge</summary>
      <description>
        'bar' runs along the whole edge. 'floating' leaves a margin
        around the taskbar and rounds its ends. 'separate' floats the
        Start button and apps, and the status icons and clock, as two
        pieces of their own with nothing between them.
      </description>
    </key>
    <key name="taskbar-size" enum="com.lantharos.kestrel.TaskbarSize">
      <default>'normal'</default>
      <summary>Thickness of the taskbar and size of its icons</summary>
    </key>
    <key name="taskbar-auto-hide" enum="com.lantharos.kestrel.TaskbarAutoHide">
      <default>'never'</default>
      <summary>When the taskbar hides itself</summary>
      <description>
        'always' keeps the taskbar hidden until the pointer reaches its
        edge or Start opens. 'windows' hides it only while a window
        touches it. While the taskbar hides itself, windows can use the
        whole screen.
      </description>
    </key>
    <key name="taskbar-show-pinned" type="b">
      <default>true</default>
      <summary>Show pinned apps on the taskbar</summary>
      <description>
        When disabled, the taskbar shows only apps that are running, and
        Start lists pinned apps along with the others.
      </description>
    </key>
    <key name="taskbar-displays" enum="com.lantharos.kestrel.TaskbarDisplays">
      <default>'all'</default>
      <summary>Which displays show a taskbar</summary>
    </key>
    <key name="taskbar-windows-per-display" type="b">
      <default>false</default>
      <summary>Show each display's own windows on its taskbar</summary>
      <description>
        When enabled, each taskbar shows pinned apps and the apps with
        windows on its own display, and its running indicators, previews
        and clicks use only those windows.
      </description>
    </key>
    <key name="rounded-window-corners" type="b">
      <default>true</default>
      <summary>Round corners across the desktop</summary>
      <description>
        When disabled, everything is square: windows even when they float,
        Kestrel's taskbar, panels and menus, such as Quick Settings and
        Start, and the Luft apps along with their controls. Apps that draw
        their own corners, such as GTK and Chromium apps, are told to draw
        them square. Maximized, tiled and fullscreen windows are always
        square.
      </description>
    </key>
    <key name="window-tiling" enum="com.lantharos.kestrel.WindowTiling">
      <default>'off'</default>
      <summary>How windows are arranged</summary>
      <description>
        'off' lets windows float, with snapping, corner snap and snap
        layouts. 'tiling' places new windows next to each other so they
        fill the screen. 'scrolling' opens each window as a column on a
        strip that scrolls sideways.
      </description>
    </key>
    <key name="tiling-layout" enum="com.lantharos.kestrel.TilingLayout">
      <default>'dwindle'</default>
      <summary>How tiled windows share the screen</summary>
      <description>
        'dwindle' splits the focused window's space in two for every new
        window. 'master' keeps one large window on the left and stacks the
        others on the right.
      </description>
    </key>
    <key name="tiling-gaps" enum="com.lantharos.kestrel.TilingGaps">
      <default>'medium'</default>
      <summary>Space between tiled windows and around them</summary>
    </key>
    <key name="tiling-new-windows" enum="com.lantharos.kestrel.TilingNewWindows">
      <default>'beside-focused'</default>
      <summary>Where new tiled windows open</summary>
      <description>
        'beside-focused' opens them next to the focused window, or as the
        column to its right while scrolling. 'at-end' opens them after the
        last window or column.
      </description>
    </key>
    <key name="taskbar-windows-per-workspace" type="b">
      <default>false</default>
      <summary>Show only the current workspace's windows on the taskbar</summary>
      <description>
        When enabled, the taskbar shows pinned apps and the apps with windows
        on the current workspace, and its running indicators, previews and
        clicks use only those windows. Opening an app whose windows are all
        on other workspaces opens a new window here when the app supports it.
      </description>
    </key>
    <key name="favorite-apps" type="as">
      <default>
        @DASH_APPS@
      </default>
      <summary>List of desktop file IDs for favorite applications</summary>
      <description>
        The applications corresponding to these identifiers
        will be displayed in the favorites area.
      </description>
    </key>
    <key name="remember-mount-password" type="b">
      <default>false</default>
      <summary>Whether to remember password for mounting encrypted or remote filesystems</summary>
      <description>
        The shell will request a password when an encrypted device or a
        remote filesystem is mounted.  If the password can be saved for
        future use a “Remember Password” checkbox will be present.
        This key sets the default state of the checkbox.
      </description>
    </key>
    <key name="last-selected-power-profile" type="s">
      <default>"power-saver"</default>
      <summary>The last selected non-default power profile</summary>
      <description>
        Some systems support more than two power profiles. In order to still support
        toggling between two profiles, this key records the last selected non-default
        profile.
      </description>
    </key>
    <child name="keybindings" schema="com.lantharos.kestrel.keybindings"/>
    <child name="app-switcher" schema="com.lantharos.kestrel.app-switcher"/>
    <child name="window-switcher" schema="com.lantharos.kestrel.window-switcher"/>
  </schema>

  <schema id="com.lantharos.kestrel.keybindings" path="/com/lantharos/kestrel/keybindings/"
          gettext-domain="@GETTEXT_PACKAGE@">
    <key name="toggle-message-tray" type="as">
      <default>["&lt;Super&gt;n","&lt;Super&gt;m"]</default>
      <summary>Keybinding to toggle the visibility of the notification list</summary>
      <description>
        Keybinding to toggle the visibility of the notification list.
      </description>
    </key>
    <key name="toggle-start" type="as">
      <default>[]</default>
      <summary>Open Start</summary>
      <description>
        Opens Start, or Gust when chosen, in addition to tapping Super.
      </description>
    </key>
    <key name="toggle-quick-settings" type="as">
      <default>["&lt;Super&gt;s"]</default>
      <summary>Keybinding to toggle the quick settings menu</summary>
      <description>
        Keybinding to toggle the quick settings menu.
      </description>
    </key>
    <key name="focus-active-notification" type="as">
      <default>[]</default>
      <summary>Keybinding to focus the active notification</summary>
      <description>
        Keybinding to focus the active notification.
      </description>
    </key>
    <key name="clipboard-history" type="as">
      <default>["&lt;Super&gt;v"]</default>
      <summary>Show clipboard history</summary>
    </key>
    <key name="emoji-picker" type="as">
      <default>["&lt;Super&gt;period","&lt;Super&gt;semicolon"]</default>
      <summary>Insert emoji</summary>
    </key>
    <key name="snap-layouts" type="as">
      <default>["&lt;Super&gt;z"]</default>
      <summary>Show snap layouts for the focused window</summary>
    </key>
    <key name="board-zoom-in" type="as">
      <default>["&lt;Super&gt;equal","&lt;Super&gt;KP_Add"]</default>
      <summary>Zoom in on the board</summary>
    </key>
    <key name="board-zoom-out" type="as">
      <default>["&lt;Super&gt;minus","&lt;Super&gt;KP_Subtract"]</default>
      <summary>Zoom out of the board</summary>
    </key>
    <key name="board-enter-window" type="as">
      <default>["&lt;Super&gt;Return","&lt;Super&gt;KP_Enter"]</default>
      <summary>Enter the focused window on the board</summary>
    </key>
    <key name="tiling-focus-left" type="as">
      <default>["&lt;Super&gt;Left"]</default>
      <summary>Focus the tiled window to the left</summary>
    </key>
    <key name="tiling-focus-right" type="as">
      <default>["&lt;Super&gt;Right"]</default>
      <summary>Focus the tiled window to the right</summary>
    </key>
    <key name="tiling-focus-up" type="as">
      <default>["&lt;Super&gt;Up"]</default>
      <summary>Focus the tiled window above</summary>
    </key>
    <key name="tiling-focus-down" type="as">
      <default>["&lt;Super&gt;Down"]</default>
      <summary>Focus the tiled window below</summary>
    </key>
    <key name="tiling-move-left" type="as">
      <default>["&lt;Super&gt;&lt;Shift&gt;Left"]</default>
      <summary>Move the tiled window left</summary>
    </key>
    <key name="tiling-move-right" type="as">
      <default>["&lt;Super&gt;&lt;Shift&gt;Right"]</default>
      <summary>Move the tiled window right</summary>
    </key>
    <key name="tiling-move-up" type="as">
      <default>["&lt;Super&gt;&lt;Shift&gt;Up"]</default>
      <summary>Move the tiled window up</summary>
    </key>
    <key name="tiling-move-down" type="as">
      <default>["&lt;Super&gt;&lt;Shift&gt;Down"]</default>
      <summary>Move the tiled window down</summary>
    </key>
    <key name="tiling-resize-left" type="as">
      <default>["&lt;Super&gt;&lt;Control&gt;Left"]</default>
      <summary>Move the edge between tiled windows left</summary>
    </key>
    <key name="tiling-resize-right" type="as">
      <default>["&lt;Super&gt;&lt;Control&gt;Right"]</default>
      <summary>Move the edge between tiled windows right</summary>
    </key>
    <key name="tiling-resize-up" type="as">
      <default>["&lt;Super&gt;&lt;Control&gt;Up"]</default>
      <summary>Move the edge between tiled windows up</summary>
    </key>
    <key name="tiling-resize-down" type="as">
      <default>["&lt;Super&gt;&lt;Control&gt;Down"]</default>
      <summary>Move the edge between tiled windows down</summary>
    </key>
    <key name="tiling-toggle-floating" type="as">
      <default>["&lt;Super&gt;f"]</default>
      <summary>Let the focused window float or tile it again</summary>
    </key>
    <key name="tiling-cycle-width" type="as">
      <default>["&lt;Super&gt;r"]</default>
      <summary>Switch the focused column between a third, half, two thirds and the full width</summary>
    </key>
    <key name="tiling-center-column" type="as">
      <default>["&lt;Super&gt;c"]</default>
      <summary>Center the focused column</summary>
    </key>
    <key name="tiling-maximize-column" type="as">
      <default>["&lt;Super&gt;&lt;Shift&gt;f"]</default>
      <summary>Make the focused column as wide as the screen, or give it back its width</summary>
    </key>
    <key name="tiling-expand-column" type="as">
      <default>["&lt;Super&gt;&lt;Control&gt;f"]</default>
      <summary>Widen the focused column over the space the columns beside it leave</summary>
    </key>
    <key name="tiling-focus-first" type="as">
      <default>["&lt;Super&gt;Home"]</default>
      <summary>Focus the first column</summary>
    </key>
    <key name="tiling-focus-last" type="as">
      <default>["&lt;Super&gt;End"]</default>
      <summary>Focus the last column</summary>
    </key>
    <key name="tiling-move-first" type="as">
      <default>["&lt;Super&gt;&lt;Shift&gt;Home"]</default>
      <summary>Move the focused column to the start of the strip</summary>
    </key>
    <key name="tiling-move-last" type="as">
      <default>["&lt;Super&gt;&lt;Shift&gt;End"]</default>
      <summary>Move the focused column to the end of the strip</summary>
    </key>
    <key name="tiling-overview" type="as">
      <default>["&lt;Super&gt;w"]</default>
      <summary>Zoom out to see the whole strip of columns</summary>
    </key>
    <key name="tiling-stack-left" type="as">
      <default>["&lt;Super&gt;&lt;Control&gt;&lt;Shift&gt;Left","&lt;Super&gt;bracketleft"]</default>
      <summary>Stack the focused window into the column on the left, or take it out of its column</summary>
    </key>
    <key name="tiling-stack-right" type="as">
      <default>["&lt;Super&gt;&lt;Control&gt;&lt;Shift&gt;Right","&lt;Super&gt;bracketright"]</default>
      <summary>Stack the focused window into the column on the right, or take it out of its column</summary>
    </key>
    <key name="dictate" type="as">
      <default>["&lt;Super&gt;&lt;Alt&gt;"]</default>
      <summary>Dictate</summary>
      <description>
        Hold to talk and let go to type what was said, or press to start and stop listening. Modifiers alone, such as the default Super and Alt, count when pressed together with no other key.
      </description>
    </key>
    <key name="system-monitor" type="as">
      <default>["&lt;Control&gt;&lt;Shift&gt;Escape"]</default>
      <summary>Open the system monitor</summary>
    </key>
    <key name="relight-displays" type="as">
      <default>["&lt;Super&gt;&lt;Control&gt;&lt;Shift&gt;b"]</default>
      <summary>Light the displays again when one shows no picture</summary>
    </key>
    <key name="workspace-1" type="as">
      <default>["&lt;Super&gt;1"]</default>
      <summary>Switch to workspace 1</summary>
    </key>
    <key name="workspace-2" type="as">
      <default>["&lt;Super&gt;2"]</default>
      <summary>Switch to workspace 2</summary>
    </key>
    <key name="workspace-3" type="as">
      <default>["&lt;Super&gt;3"]</default>
      <summary>Switch to workspace 3</summary>
    </key>
    <key name="workspace-4" type="as">
      <default>["&lt;Super&gt;4"]</default>
      <summary>Switch to workspace 4</summary>
    </key>
    <key name="workspace-5" type="as">
      <default>["&lt;Super&gt;5"]</default>
      <summary>Switch to workspace 5</summary>
    </key>
    <key name="workspace-6" type="as">
      <default>["&lt;Super&gt;6"]</default>
      <summary>Switch to workspace 6</summary>
    </key>
    <key name="workspace-7" type="as">
      <default>["&lt;Super&gt;7"]</default>
      <summary>Switch to workspace 7</summary>
    </key>
    <key name="workspace-8" type="as">
      <default>["&lt;Super&gt;8"]</default>
      <summary>Switch to workspace 8</summary>
    </key>
    <key name="workspace-9" type="as">
      <default>["&lt;Super&gt;9"]</default>
      <summary>Switch to workspace 9</summary>
    </key>
    <key name="workspace-10" type="as">
      <default>["&lt;Super&gt;0"]</default>
      <summary>Switch to workspace 10</summary>
    </key>
    <key name="show-screenshot-ui" type="as">
      <default>["Print", "&lt;Super&gt;&lt;Shift&gt;s"]</default>
      <summary>Take a screenshot interactively</summary>
    </key>
    <key name="show-screen-recording-ui" type="as">
      <default>["&lt;Ctrl&gt;&lt;Shift&gt;&lt;Alt&gt;R"]</default>
      <summary>Record a screencast interactively</summary>
    </key>
    <key name="screenshot-window" type="as">
      <default>["&lt;Alt&gt;Print"]</default>
      <summary>Take a screenshot of a window</summary>
    </key>
    <key name="screenshot" type="as">
      <default>["&lt;Shift&gt;Print"]</default>
      <summary>Take a screenshot</summary>
    </key>
    <key name="screen-brightness-up" type="as">
      <default>['XF86MonBrightnessUp']</default>
      <summary>Screen brightness up</summary>
    </key>
    <key name="screen-brightness-up-monitor" type="as">
      <default>['&lt;Shift&gt;XF86MonBrightnessUp']</default>
      <summary>Screen brightness up on current monitor</summary>
    </key>
    <key name="screen-brightness-down" type="as">
      <default>['XF86MonBrightnessDown']</default>
      <summary>Screen brightness down</summary>
    </key>
    <key name="screen-brightness-down-monitor" type="as">
      <default>['&lt;Shift&gt;XF86MonBrightnessDown']</default>
      <summary>Screen brightness down on current monitor</summary>
    </key>
    <key name="screen-brightness-cycle" type="as">
      <default>['XF86MonBrightnessCycle']</default>
      <summary>Screen brightness cycle</summary>
    </key>
    <key name="screen-brightness-cycle-monitor" type="as">
      <default>['&lt;Shift&gt;XF86MonBrightnessCycle']</default>
      <summary>Screen brightness cycle on current monitor</summary>
    </key>
  </schema>

  <schema id="com.lantharos.kestrel.app-switcher"
          path="/com/lantharos/kestrel/app-switcher/"
          gettext-domain="@GETTEXT_PACKAGE@">
    <key type="b" name="current-workspace-only">
      <default>false</default>
      <summary>Limit switcher to current workspace.</summary>
      <description>
	If true, only applications that have windows on the current workspace are shown in the switcher.
	Otherwise, all applications are included.
      </description>
    </key>
  </schema>

  <schema id="com.lantharos.kestrel.window-switcher"
          path="/com/lantharos/kestrel/window-switcher/"
          gettext-domain="@GETTEXT_PACKAGE@">
    <key type="b" name="current-workspace-only">
      <default>true</default>
      <summary>Limit switcher to current workspace.</summary>
      <description>
	If true, only windows from the current workspace are shown in the switcher.
	Otherwise, all windows are included.
      </description>
    </key>
  </schema>

  <enum id="com.lantharos.kestrel.notifications.DoNotDisturb">
    <value value="0" nick="never"/>
    <value value="1" nick="urgent"/>
    <value value="2" nick="always"/>
  </enum>
  <enum id="com.lantharos.kestrel.notifications.Sound">
    <value value="0" nick="automatic"/>
    <value value="1" nick="luft"/>
    <value value="2" nick="app"/>
    <value value="3" nick="none"/>
  </enum>
  <schema id="com.lantharos.kestrel.notifications.application"
          gettext-domain="@GETTEXT_PACKAGE@">
    <key name="during-do-not-disturb" enum="com.lantharos.kestrel.notifications.DoNotDisturb">
      <default>'urgent'</default>
      <summary>Which notifications from the app show during Do Not Disturb</summary>
      <description>
        “never” keeps every notification quiet while Do Not Disturb is on,
        “urgent” lets critical notifications through and “always” shows
        banners and plays sounds as usual.
      </description>
    </key>
    <key name="keep-in-list" type="b">
      <default>true</default>
      <summary>Keep the app’s notifications in the notification list</summary>
      <description>
        When disabled, notifications from the app are removed once their
        banner closes, or right away when no banner is shown.
      </description>
    </key>
    <key name="sound" enum="com.lantharos.kestrel.notifications.Sound">
      <default>'automatic'</default>
      <summary>Which sound the app’s notifications play</summary>
      <description>
        “automatic” plays the sound the app asks for, or Luft’s sound unless
        the app starts playing its own, “luft” always plays Luft’s sound,
        “app” plays only sounds the app asks for and “none” stays silent.
      </description>
    </key>
  </schema>
</schemalist>
