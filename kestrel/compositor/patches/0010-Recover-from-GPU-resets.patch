+
+gboolean
+cogl_context_is_defunct (CoglContext *context)
+{
+  CoglContextPrivate *priv;
+
+  g_return_val_if_fail (COGL_IS_CONTEXT (context), TRUE);
+
+  priv = cogl_context_get_instance_private (context);
+  return priv->is_defunct;
+}
+
+void
+cogl_context_destroy (CoglContext *context)
+{
+  CoglContextPrivate *priv;
+
+  g_return_if_fail (COGL_IS_CONTEXT (context));
+
+  /* `CoglContext` holds references to objects which hold references to itself,
+   * some of which may also attempt to use it after it has been disposed.
+   * Hence, the nature of its destruction. This is primarily due to the
+   * recreation of the context during graphics reset recovery. */
+
+  COGL_NOTE (CONTEXT, "Destroying CoglContext [%p]", context);
+
+  priv = cogl_context_get_instance_private (context);
+
+  g_object_run_dispose (G_OBJECT (context));
+  priv->is_defunct = TRUE;
+  g_object_unref (context);
+}
