<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
 "https://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<node name="/com/lantharos/Printers1">
  <!--
    The printers CUPS keeps for everyone on the computer. Started on demand and stops when idle.
    Add, Remove and Configure need com.lantharos.printers.manage.
  -->
  <interface name="com.lantharos.Printers1">
    <!-- Printers CUPS finds within a few seconds, by USB and on the network:
         device URI, class (direct or network), description, make and model, IEEE 1284 device ID. -->
    <method name="Devices">
      <arg type="a(sssss)" direction="out"/>
    </method>
    <!-- The drivers for a device's make, best first: driver name, description, and whether it suits the model. -->
    <method name="Drivers">
      <arg name="device_id" type="s" direction="in"/>
      <arg name="make_and_model" type="s" direction="in"/>
      <arg type="a(ssb)" direction="out"/>
    </method>
    <!-- Keeps a printer and returns its queue name. An empty driver prints without one, over IPP.
         A device that already has a queue keeps it, and a temporary one becomes permanent. -->
    <method name="Add">
      <arg name="device" type="s" direction="in"/>
      <arg name="driver" type="s" direction="in"/>
      <arg name="info" type="s" direction="in"/>
      <arg name="location" type="s" direction="in"/>
      <arg type="s" direction="out"/>
    </method>
    <method name="Remove">
      <arg name="name" type="s" direction="in"/>
    </method>
    <!-- Sets defaults for everyone: media, sides and print-color-mode, as IPP keywords.
         A temporary queue becomes permanent. -->
    <method name="Configure">
      <arg name="name" type="s" direction="in"/>
      <arg name="options" type="a{ss}" direction="in"/>
    </method>
  </interface>
</node>
