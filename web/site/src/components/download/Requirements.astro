---
import { localize } from '../../i18n/pages';

const { t } = localize(Astro);
const requirements = [
	[t('download-needs-processor'), t('download-needs-processor-value')],
	[t('download-needs-firmware'), t('download-needs-firmware-value')],
	[t('download-needs-space'), t('download-needs-space-value')],
	[t('download-needs-graphics'), t('download-needs-graphics-value')],
	[t('download-needs-security-chip'), t('download-needs-security-chip-value')],
	[t('download-needs-usb'), t('download-needs-usb-value')]
];
---

<section class="page grid gap-12 py-24 md:grid-cols-12 md:py-36">
	<div class="reveal md:col-span-4">
		<h2 class="text-3xl font-semibold tracking-tight text-balance">{t('download-needs-heading')}</h2>
		<p class="mt-4 text-ink-soft">{t('download-needs-text')}</p>
	</div>
	<dl class="reveal md:col-span-8">
		{
			requirements.map(([name, value]) => (
				<div class="grid grid-cols-[9rem_1fr] gap-4 border-b border-hairline py-4 sm:grid-cols-[12rem_1fr]">
					<dt class="font-semibold hyphens-auto">{name}</dt>
					<dd class="text-ink-soft">{value}</dd>
				</div>
			))
		}
	</dl>
</section>

<section class="page grid gap-12 pb-28 md:grid-cols-12 md:pb-40">
	<div class="reveal md:col-span-4">
		<h2 class="text-3xl font-semibold tracking-tight text-balance">{t('download-usb-heading')}</h2>
	</div>
	<div class="reveal space-y-4 text-ink-soft md:col-span-8">
		<p>{t('download-usb-write')}</p>
		<p>{t('download-usb-start')}</p>
		<p
			class="[&_code]:rounded-md [&_code]:bg-well [&_code]:px-1.5 [&_code]:py-0.5 [&_code]:font-mono [&_code]:text-[0.9em] [&_code]:text-ink"
			set:html={t('download-usb-check')}
		/>
	</div>
</section>
