[Unit]
Description=Tell that the development build was taken off after an update
After=kestrel-session.target graphical-session.target
PartOf=graphical-session.target
ConditionPathExists=/run/luft-dev-layer-dropped

[Service]
Type=oneshot
ExecStart=/usr/libexec/luft-dev-layer notice
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service

[Install]
WantedBy=kestrel-session.target
