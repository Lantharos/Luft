# The name of the extension in Settings and the store
extension-name = Playthings
extension-description = Lanterns, clouds, a campfire and stars on your wallpaper that sway, part, flare and twinkle when you brush past them with the pointer or a finger
# Quick settings tile title and the switch in Settings, keep short
playthings = Playthings
# Under the tile title
around = { $count ->
    [0] Nothing out
    [one] One out
   *[other] { $count } out
}
lanterns = Lanterns
lanterns-detail = Swing when you brush past them, and light up when clicked
lantern-count = How many lanterns
lantern-paper = Paper
paper-mixed = A mix
paper-amber = Amber
paper-coral = Coral
paper-jade = Jade
clouds = Clouds
clouds-detail = Part around the pointer, and rain a little when poked
cloud-count = How many clouds
campfire = Campfire
campfire-detail = Leans away from the pointer, sparks when clicked and catches when you fan it
campfire-count = How many fires
stars = Stars
stars-detail = Brighten and join up near the pointer. Flick across them for a shooting star
star-count = How many constellations
# Which part of the desktop a kind of plaything goes on
place = Where
place-left = Left
place-middle = Middle
place-right = Right
place-across = All across
# A section of the Settings page with what goes for every plaything
everywhere = For all of them
size = How big
small = Small
medium = Medium
large = Large
displays = Displays
displays-main = Main display
displays-every = Every display
ambient = Gentle motion
    .description = They rest during full screen, with battery saver and when you ask for less motion
# Dragging playthings to where you like them
arrange = Arrange
arrange-detail = Drag things to where you like them, on each display
arrange-button = Arrange
arrange-hint = Drag things to where you like them.
arrange-done = Done
arrange-reset = Put everything back
reset-detail = Forget where you dragged things
reset-button = Put back
# What screen readers call each kind of plaything
label-lantern = Lantern
label-cloud = Cloud
label-campfire = Campfire
label-stars = Star
