---
import { localize } from '../../i18n/pages';
import FileLink from './FileLink.astro';

const { t } = localize(Astro);
const logos = [
	{ name: t('brand-logo-wordmark'), file: 'luft-wordmark-on-light', backdrop: 'light', wide: true },
	{ name: t('brand-logo-wordmark-light'), file: 'luft-wordmark-on-dark', backdrop: 'dark', wide: true },
	{ name: t('brand-logo-mark'), file: 'luft-mark-on-light', backdrop: 'light', wide: false },
	{ name: t('brand-logo-mark-light'), file: 'luft-mark-on-dark', backdrop: 'dark', wide: false }
];
const rules = [t('brand-rule-space'), t('brand-rule-background'), t('brand-rule-as-is'), t('brand-rule-name')];
---

<section class="page pb-24 md:pb-32" aria-labelledby="logo">
	<h2 id="logo" class="text-3xl font-semibold tracking-tight">{t('brand-logo-heading')}</h2>
	<div class="mt-8 grid gap-x-6 gap-y-10 sm:grid-cols-2">
		{
			logos.map(({ name, file, backdrop, wide }) => (
				<figure>
					<div class:list={['grid aspect-[16/10] place-items-center rounded-[1.5rem] ring-1 ring-hairline ring-inset', backdrop === 'light' ? 'bg-[#fcf9f3]' : 'bg-[#12110e]']}>
						<img src={`/brand/${file}.svg`} alt="" class:list={[wide ? 'h-14 sm:h-16' : 'h-20 sm:h-24']} />
					</div>
					<figcaption class="mt-3 flex items-center gap-2 px-1">
						<span class="min-w-0 flex-1 truncate text-ink-soft">{name}</span>
						<FileLink name={name} format="SVG" href={`/brand/${file}.svg`} file={`${file}.svg`} />
						<FileLink name={name} format="PNG" href={`/brand/${file}.png`} file={`${file}.png`} />
					</figcaption>
				</figure>
			))
		}
	</div>
	<ul class="mt-12 grid max-w-4xl gap-x-12 gap-y-4 text-ink-soft sm:grid-cols-2">
		{
			rules.map((rule) => (
				<li class="flex gap-3">
					<span aria-hidden="true" class="mt-2.5 size-1.5 shrink-0 rounded-full bg-accent" />
					{rule}
				</li>
			))
		}
	</ul>
</section>
