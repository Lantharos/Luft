---
import Base from '../layouts/Base.astro';
import Backdrop from '../components/home/Backdrop.astro';
---

<Base title="Not found · Luft" description="This page doesn’t exist." credits={['Hush']} overFog>
	<section class="relative isolate flex min-h-svh items-center overflow-hidden">
		<Backdrop name="Hush" position="50% 60%" eager />
		<div class="page text-ink scheme-light">
			<h1 class="enter text-[clamp(3rem,8vw,6.5rem)] leading-none font-semibold tracking-[-0.04em]">Nothing here</h1>
			<p class="enter mt-5 max-w-md text-lede text-ink-soft" style="--order: 1">This page doesn’t exist, or it moved somewhere else.</p>
			<a class="enter button button-primary mt-9" style="--order: 2" href="/">Back to Luft</a>
		</div>
	</section>
</Base>
