+
+#include "config.h"
+
+#include <math.h>
+
+#include "backends/native/meta-input-thread.h"
+#include "meta/util.h"
+
+#define FRESH_US (1500 * G_TIME_SPAN_MILLISECOND)
+#define SETTLING_US (4500 * G_TIME_SPAN_MILLISECOND)
+#define SETTLING_HOLD_MS 450
+#define EDGE_HOLD_MS 150
+
+#define ZONE_BEHIND_MM 50.0
+#define ZONE_AHEAD_MM 140.0
+#define ZONE_ABOVE_MM 45.0
+#define ZONE_BELOW_MM 95.0
+#define EDGE_MM 20.0
+#define CROWD_MM 50.0
+#define DRAG_MM 6.0
+#define STILL_MM 2.0
+#define VIRTUAL_PX_PER_MM 4.0f
+
+typedef enum
+{
+  TOUCH_DROPPED,
+  TOUCH_AT_EDGE,
+  TOUCH_SETTLING,
+} TouchVerdict;
+
+typedef struct
+{
+  ClutterEventType type;
+  uint64_t time_us;
+  float x;
+  float y;
+} HeldEvent;
+
+typedef struct
+{
+  MetaPalmFilter *filter;
+  ClutterInputDevice *device;
+  int slot;
+  TouchVerdict verdict;
+  float start_x;
+  float start_y;
+  float px_per_mm;
+  double travel_mm;
+  gboolean ended;
+  GArray *events;
+  GSource *timeout;
+} Touch;
+
+struct _MetaPalmFilter
+{
+  MetaSeatImpl *seat_impl;
+  MetaPalmHand hand;
+  ClutterInputDevice *pen;
+  gboolean pen_near;
+  float pen_x;
+  float pen_y;
+  uint64_t pen_left_us;
+  GHashTable *touches;
+};
+
+static const char *verdict_names[] = { "dropped", "at the edge", "settling" };
+
+static void
+touch_free (Touch *touch)
+{
+  if (touch->timeout)
+    {
+      g_source_destroy (touch->timeout);
+      g_source_unref (touch->timeout);
+    }
+  g_array_unref (touch->events);
+  g_object_unref (touch->device);
+  g_free (touch);
+}
+
+MetaPalmFilter *
+meta_palm_filter_new (MetaSeatImpl *seat_impl)
+{
+  MetaPalmFilter *filter = g_new0 (MetaPalmFilter, 1);
+
+  filter->seat_impl = seat_impl;
+  filter->touches = g_hash_table_new_full (NULL, NULL, NULL,
+                                           (GDestroyNotify) touch_free);
+
+  return filter;
+}
+
+void
+meta_palm_filter_free (MetaPalmFilter *filter)
+{
+  g_hash_table_unref (filter->touches);
+  g_clear_object (&filter->pen);
+  g_free (filter);
+}
+
+void
+meta_palm_filter_set_hand (MetaPalmFilter *filter,
+                           MetaPalmHand    hand)
+{
+  filter->hand = hand;
+}
+
+static gboolean
+on_same_screen (ClutterInputDevice *pen,
+                ClutterInputDevice *touchscreen)
+{
+  struct libinput_device *pen_device =
+    meta_input_device_native_get_libinput_device (pen);
+  struct libinput_device *touch_device =
+    meta_input_device_native_get_libinput_device (touchscreen);
+
+  if (!pen_device || !touch_device)
+    return !pen_device && !touch_device;
+
+  return (libinput_device_get_device_group (pen_device) ==
+          libinput_device_get_device_group (touch_device));
+}
+
+static float
+px_per_mm (MetaPalmFilter     *filter,
+           ClutterInputDevice *touchscreen)
+{
+  MetaSeatImpl *seat_impl = filter->seat_impl;
+  struct libinput_device *device =
+    meta_input_device_native_get_libinput_device (touchscreen);
+  float x0 = 0, y0 = 0, x1, y1;
+  double width_mm, height_mm;
+
+  if (!device || libinput_device_get_size (device, &width_mm, &height_mm) != 0)
+    return VIRTUAL_PX_PER_MM;
+
+  meta_viewport_info_get_extents (seat_impl->viewports, &x1, &y1);
+  meta_input_device_native_translate_coordinates_in_impl (touchscreen,
+                                                          seat_impl->viewports,
+                                                          &x0, &y0);
+  meta_input_device_native_translate_coordinates_in_impl (touchscreen,
+                                                          seat_impl->viewports,
+                                                          &x1, &y1);
+
+  return (float) (hypot (x1 - x0, y1 - y0) / hypot (width_mm, height_mm));
+}
+
+static gboolean
+in_palm_zone (MetaPalmFilter *filter,
+              double          ahead_mm,
+              double          below_mm,
+              double          grow_mm)
+{
+  if (filter->hand == META_PALM_HAND_LEFT)
+    ahead_mm = -ahead_mm;
+
+  return (ahead_mm >= -ZONE_BEHIND_MM - grow_mm &&
+          ahead_mm <= ZONE_AHEAD_MM + grow_mm &&
+          below_mm >= -ZONE_ABOVE_MM - grow_mm &&
+          below_mm <= ZONE_BELOW_MM + grow_mm);
+}
+
+static void
+hold_event (Touch            *touch,
+            ClutterEventType  type,
+            uint64_t          time_us,
+            float             x,
+            float             y)
+{
+  HeldEvent event = { type, time_us, x, y };
+
+  g_array_append_val (touch->events, event);
+}
+
+static void
+let_through (Touch *touch)
+{
+  MetaPalmFilter *filter = touch->filter;
+  unsigned int i;
+
+  meta_topic (META_DEBUG_INPUT, "Palm filter: touch %d is a finger",
+              touch->slot);
+
+  for (i = 0; i < touch->events->len; i++)
+    {
+      HeldEvent *event = &g_array_index (touch->events, HeldEvent, i);
+
+      meta_seat_impl_deliver_touch_in_impl (filter->seat_impl, touch->device,
+                                            event->type, event->time_us,
+                                            touch->slot, event->x, event->y);
+    }
+
+  g_hash_table_remove (filter->touches, GINT_TO_POINTER (touch->slot));
+}
+
+static void
+stop_hold (Touch *touch)
+{
+  if (!touch->timeout)
+    return;
+
+  g_source_destroy (touch->timeout);
+  g_clear_pointer (&touch->timeout, g_source_unref);
+}
+
+static gboolean
+discard (Touch *touch)
+{
+  meta_topic (META_DEBUG_INPUT, "Palm filter: touch %d is a palm",
+              touch->slot);
+
+  stop_hold (touch);
+  touch->verdict = TOUCH_DROPPED;
+  g_array_set_size (touch->events, 0);
+
+  return touch->ended;
+}
+
+static gboolean
+hold_expired (gpointer user_data)
+{
+  Touch *touch = user_data;
+
+  g_clear_pointer (&touch->timeout, g_source_unref);
+
+  if (touch->verdict == TOUCH_AT_EDGE && touch->travel_mm > STILL_MM)
+    {
+      if (discard (touch))
+        g_hash_table_remove (touch->filter->touches, GINT_TO_POINTER (touch->slot));
+    }
+  else
+    {
+      let_through (touch);
+    }
+
+  return G_SOURCE_REMOVE;
+}
+
+static void
+start_hold (Touch        *touch,
+            unsigned int  ms)
+{
+  touch->timeout = g_timeout_source_new (ms);
+  g_source_set_callback (touch->timeout, hold_expired, touch, NULL);
+  g_source_attach (touch->timeout, touch->filter->seat_impl->input_context);
+}
+
+static gboolean
+crowds_a_palm (MetaPalmFilter *filter,
+               float           x,
+               float           y,
+               float           px_per_mm)
+{
+  GHashTableIter iter;
+  Touch *touch;
+  gboolean crowded = FALSE;
+
+  g_hash_table_iter_init (&iter, filter->touches);
+  while (g_hash_table_iter_next (&iter, NULL, (gpointer *) &touch))
+    {
+      if (hypot (touch->start_x - x, touch->start_y - y) / px_per_mm > CROWD_MM)
+        continue;
+
+      crowded = TRUE;
+      if (touch->verdict != TOUCH_DROPPED && discard (touch))
+        g_hash_table_iter_remove (&iter);
+    }
+
+  return crowded;
+}
+
+static gboolean
+judge_new_touch (MetaPalmFilter     *filter,
+                 ClutterInputDevice *device,
+                 uint64_t            time_us,
+                 int                 slot,
+                 float               x,
+                 float               y)
+{
+  int64_t since_pen;
+  gboolean fresh;
+  double ahead_mm, below_mm;
+  float scale;
+  Touch *touch;
+  TouchVerdict verdict;
+
+  since_pen = filter->pen_near ? 0 : MAX (0, (int64_t) (time_us - filter->pen_left_us));
+  if (since_pen > SETTLING_US || !on_same_screen (filter->pen, device))
+    return FALSE;
+
+  scale = px_per_mm (filter, device);
+  ahead_mm = (x - filter->pen_x) / scale;
+  below_mm = (y - filter->pen_y) / scale;
+  fresh = since_pen < FRESH_US;
+
+  if (crowds_a_palm (filter, x, y, scale))
+    verdict = TOUCH_DROPPED;
+  else if (in_palm_zone (filter, ahead_mm, below_mm, 0))
+    verdict = fresh ? TOUCH_DROPPED : TOUCH_SETTLING;
+  else if (fresh && in_palm_zone (filter, ahead_mm, below_mm, EDGE_MM))
+    verdict = TOUCH_AT_EDGE;
+  else
+    return FALSE;
+
+  meta_topic (META_DEBUG_INPUT,
+              "Palm filter: touch %d at %.0f, %.0f mm from the pen, "
+              "%" G_GINT64_FORMAT " ms after it, %s",
+              slot, ahead_mm, below_mm, since_pen / 1000,
+              verdict_names[verdict]);
+
+  touch = g_new0 (Touch, 1);
+  touch->filter = filter;
+  touch->device = g_object_ref (device);
+  touch->slot = slot;
+  touch->verdict = verdict;
+  touch->start_x = x;
+  touch->start_y = y;
+  touch->px_per_mm = scale;
+  touch->events = g_array_new (FALSE, FALSE, sizeof (HeldEvent));
+  g_hash_table_insert (filter->touches, GINT_TO_POINTER (slot), touch);
+
+  if (verdict == TOUCH_DROPPED)
+    return TRUE;
+
+  hold_event (touch, CLUTTER_TOUCH_BEGIN, time_us, x, y);
+  start_hold (touch, verdict == TOUCH_AT_EDGE ? EDGE_HOLD_MS : SETTLING_HOLD_MS);
+  return TRUE;
+}
+
+gboolean
+meta_palm_filter_take_touch (MetaPalmFilter     *filter,
+                             ClutterInputDevice *device,
+                             ClutterEventType    type,
+                             uint64_t            time_us,
+                             int                 slot,
+                             float               x,
+                             float               y)
+{
+  Touch *touch;
+
+  if (!filter->pen)
+    return FALSE;
+
+  if (type == CLUTTER_TOUCH_BEGIN)
+    return judge_new_touch (filter, device, time_us, slot, x, y);
+
+  if (g_hash_table_size (filter->touches) == 0)
+    return FALSE;
+
+  touch = g_hash_table_lookup (filter->touches, GINT_TO_POINTER (slot));
+  if (!touch)
+    return FALSE;
+
+  if (touch->verdict == TOUCH_DROPPED || type == CLUTTER_TOUCH_CANCEL)
+    {
+      if (type != CLUTTER_TOUCH_UPDATE)
+        g_hash_table_remove (filter->touches, GINT_TO_POINTER (slot));
+      return TRUE;
+    }
+
+  hold_event (touch, type, time_us, x, y);
+
+  if (type == CLUTTER_TOUCH_UPDATE)
+    {
+      touch->travel_mm = MAX (touch->travel_mm,
+                              hypot (x - touch->start_x, y - touch->start_y) /
+                              touch->px_per_mm);
+      if (touch->verdict == TOUCH_AT_EDGE && touch->travel_mm >= DRAG_MM)
+        let_through (touch);
+    }
+  else
+    {
+      touch->ended = TRUE;
+      if (touch->verdict == TOUCH_AT_EDGE)
+        let_through (touch);
+    }
+
+  return TRUE;
+}
+
+void
+meta_palm_filter_pen_proximity (MetaPalmFilter     *filter,
+                                ClutterInputDevice *pen,
+                                uint64_t            time_us,
+                                gboolean            in)
+{
+  GHashTableIter iter;
+  Touch *touch;
+
+  filter->pen_near = in;
+  if (!in)
+    {
+      filter->pen_left_us = time_us;
+      return;
+    }
+
+  g_set_object (&filter->pen, pen);
+
+  g_hash_table_iter_init (&iter, filter->touches);
+  while (g_hash_table_iter_next (&iter, NULL, (gpointer *) &touch))
+    {
+      if (touch->verdict != TOUCH_DROPPED && discard (touch))
+        g_hash_table_iter_remove (&iter);
+    }
+}
+
+void
+meta_palm_filter_pen_moved (MetaPalmFilter     *filter,
+                            ClutterInputDevice *pen,
+                            float               x,
+                            float               y)
+{
+  if (pen != filter->pen)
+    return;
+
+  filter->pen_x = x;
+  filter->pen_y = y;
+}
