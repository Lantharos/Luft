## Fingerprints
## Each finger has a name used as a title (the message value) and a form used inside
## a sentence (.inline), like "Place your … on the sensor." Adjust the case of .inline
## to fit those sentences.

ui-finger-right-index = Dit índex dret
    .inline = dit índex dret
ui-finger-left-index = Dit índex esquerre
    .inline = dit índex esquerre
ui-finger-right-thumb = Polze dret
    .inline = polze dret
ui-finger-left-thumb = Polze esquerre
    .inline = polze esquerre
ui-finger-right-middle = Dit del mig dret
    .inline = dit del mig dret
ui-finger-left-middle = Dit del mig esquerre
    .inline = dit del mig esquerre
ui-finger-right-ring = Dit anular dret
    .inline = dit anular dret
ui-finger-left-ring = Dit anular esquerre
    .inline = dit anular esquerre
ui-finger-right-little = Dit petit dret
    .inline = dit petit dret
ui-finger-left-little = Dit petit esquerre
    .inline = dit petit esquerre

ui-fingerprint-place = Col·loqueu el { $finger } sobre el sensor.
ui-fingerprint-swipe = Llisqueu el { $finger } pel sensor.
ui-fingerprint-stage-passed = Bé. Aixequeu el dit i torneu a col·locar-lo.
ui-fingerprint-stage-passed-swipe = Bé. Torneu a lliscar el dit.
ui-fingerprint-retry = No s’ha pogut llegir bé. Torneu-ho a provar.
ui-fingerprint-swipe-too-short = Llisqueu el dit una mica més a poc a poc.
ui-fingerprint-not-centered = Centreu el dit sobre el sensor.
ui-fingerprint-remove-and-retry = Aixequeu el dit i torneu-ho a provar.
ui-fingerprint-added = S’ha afegit l’empremta digital.
ui-fingerprint-full = El lector no té espai per a cap més empremta.
ui-fingerprint-disconnected = El lector d’empremtes ha deixat de respondre. Torneu-ho a provar d’aquí a un moment.
ui-fingerprint-duplicate = El lector ja té desat aquest dit, probablement des de Windows o des d’un altre compte. Feu servir un altre dit.
ui-fingerprint-failed = No s’ha pogut afegir aquesta empremta. Torneu-ho a provar.

