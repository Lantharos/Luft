+void
+meta_window_x11_sync_origin (MetaWindow *window)
+{
+  MetaWindowX11 *window_x11 = META_WINDOW_X11 (window);
+  MetaWindowX11Private *priv = meta_window_x11_get_instance_private (window_x11);
+  Display *xdisplay = window->display->x11_display->xdisplay;
+  int x, y;
+
+  if (window->override_redirect || window->unmanaging)
+    return;
+
+  if (priv->frame)
+    {
+      meta_frame_sync_to_window (priv->frame, FALSE);
+    }
+  else
+    {
+      meta_window_stage_to_root_point (window,
+                                       priv->client_rect.x,
+                                       priv->client_rect.y,
+                                       &x, &y);
+      mtk_x11_error_trap_push (xdisplay);
+      XMoveWindow (xdisplay, priv->xwindow, x, y);
+      mtk_x11_error_trap_pop (xdisplay);
+    }
+
+  send_configure_notify (window);
+}
