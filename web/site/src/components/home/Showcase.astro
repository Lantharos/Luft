---
import { shot } from '../../data/shots';
import Shot from '../media/Shot.astro';
import Frame from './Frame.astro';
import { localize } from '../../i18n/pages';

const { t } = localize(Astro);
---

<section id="tour" class="page relative z-10 -mt-[22svh] scroll-mt-24">
	<div class="settle">
		<Frame>
			<Shot
				{...shot('desktop')}
				alt={t('home-desktop-alt')}
				sizes="(min-width: 76rem) 72rem, 94vw"
			/>
		</Frame>
	</div>
	<p class="reveal mx-auto mt-16 max-w-3xl text-center text-lede text-ink-soft text-pretty md:mt-24">{t('home-intro')}</p>
</section>
