diff --git a/src/core/meta-sandbox.c b/src/core/meta-sandbox.c
index 034b2b79d1120659ac12a95d88cb03a555a6557a..ac866cdda39b66a900780857f870093fc03559e7 100644
--- a/src/core/meta-sandbox.c
+++ b/src/core/meta-sandbox.c
@@ -4,6 +4,9 @@
 #include "core/meta-sandbox.h"
 
 #include <fcntl.h>
+#include <limits.h>
+#include <gio/gio.h>
+#include <gio/gunixfdlist.h>
 #include <glib/gstdio.h>
 #include <sys/pidfd.h>
 
@@ -93,3 +96,210 @@ meta_process_identify (int     pidfd,
   g_clear_pointer (app_id, g_free);
   return FALSE;
 }
+
+static gboolean
+identify_open_process (int    process_fd,
+                       char **app_id,
+                       char **executable)
+{
+  char target[PATH_MAX];
+  ssize_t length;
+
+  if (!meta_process_identify_at (process_fd, app_id))
+    return FALSE;
+  if (*app_id)
+    return TRUE;
+
+  length = readlinkat (process_fd, "exe", target, sizeof (target));
+  if (length <= 0 || length == sizeof (target))
+    return FALSE;
+
+  *executable = g_strndup (target, length);
+  return TRUE;
+}
+
+/**
+ * meta_process_identify_pid:
+ * @pid: the ID of a running process
+ * @app_id: (out) (transfer full) (nullable): the app ID its sandbox names
+ * @executable: (out) (transfer full) (nullable): the program it runs, when
+ *   it runs outside a sandbox
+ *
+ * Judges a process by the same rules as Wayland clients, pinned by a pidfd
+ * while it is read. Full access is not taken into account.
+ *
+ * Returns: whether the process could be judged
+ */
+gboolean
+meta_process_identify_pid (int    pid,
+                           char **app_id,
+                           char **executable)
+{
+  g_autofd int pidfd = pidfd_open (pid, 0);
+  g_autofree char *path = g_strdup_printf ("/proc/%d", pid);
+  g_autofd int process_fd = open (path, O_PATH | O_DIRECTORY | O_CLOEXEC);
+
+  *app_id = NULL;
+  *executable = NULL;
+  if (pidfd >= 0 && process_fd >= 0 &&
+      identify_open_process (process_fd, app_id, executable) &&
+      pidfd_send_signal (pidfd, 0, NULL, 0) == 0)
+    return TRUE;
+
+  g_clear_pointer (app_id, g_free);
+  g_clear_pointer (executable, g_free);
+  return FALSE;
+}
+
+static gboolean
+pidfd_of_credentials (GVariant     *reply,
+                      GUnixFDList  *fd_list,
+                      int          *pidfd,
+                      pid_t        *pid)
+{
+  g_autoptr (GVariant) credentials = NULL;
+  int32_t pidfd_handle;
+  uint32_t process_id;
+
+  if (!reply || !fd_list)
+    return FALSE;
+
+  credentials = g_variant_get_child_value (reply, 0);
+  if (!g_variant_lookup (credentials, "ProcessFD", "h", &pidfd_handle) ||
+      !g_variant_lookup (credentials, "ProcessID", "u", &process_id))
+    return FALSE;
+
+  *pidfd = g_unix_fd_list_get (fd_list, pidfd_handle, NULL);
+  *pid = process_id;
+  return *pidfd >= 0;
+}
+
+static gboolean
+identify_credentials (MetaContext  *context,
+                      GVariant     *reply,
+                      GUnixFDList  *fd_list,
+                      char        **app_id)
+{
+  g_autofd int pidfd = -1;
+  pid_t pid;
+
+  *app_id = NULL;
+  if (!pidfd_of_credentials (reply, fd_list, &pidfd, &pid) ||
+      !meta_process_identify (pidfd, pid, app_id))
+    return FALSE;
+
+  if (*app_id &&
+      meta_context_is_app_permitted (context, META_PERMISSION_FULL_ACCESS, *app_id))
+    g_clear_pointer (app_id, g_free);
+
+  return TRUE;
+}
+
+gboolean
+meta_dbus_sender_is_unsandboxed (MetaContext     *context,
+                                 GDBusConnection *connection,
+                                 const char      *sender_name)
+{
+  g_autoptr (GUnixFDList) fd_list = NULL;
+  g_autoptr (GVariant) reply = NULL;
+  g_autofree char *app_id = NULL;
+
+  reply = g_dbus_connection_call_with_unix_fd_list_sync (connection,
+                                                         "org.freedesktop.DBus",
+                                                         "/org/freedesktop/DBus",
+                                                         "org.freedesktop.DBus",
+                                                         "GetConnectionCredentials",
+                                                         g_variant_new ("(s)", sender_name),
+                                                         G_VARIANT_TYPE ("(a{sv})"),
+                                                         G_DBUS_CALL_FLAGS_NONE,
+                                                         -1, NULL, &fd_list,
+                                                         NULL, NULL);
+  return identify_credentials (context, reply, fd_list, &app_id) && !app_id;
+}
+
+static void
+on_sender_credentials (GObject      *source,
+                       GAsyncResult *result,
+                       gpointer      user_data)
+{
+  g_autoptr (GTask) task = user_data;
+  g_autoptr (GUnixFDList) fd_list = NULL;
+  g_autoptr (GVariant) reply = NULL;
+  g_autoptr (GError) error = NULL;
+  char *app_id;
+
+  reply = g_dbus_connection_call_with_unix_fd_list_finish (G_DBUS_CONNECTION (source),
+                                                           &fd_list, result, &error);
+  if (!reply)
+    {
+      g_task_return_error (task, g_steal_pointer (&error));
+      return;
+    }
+
+  if (!identify_credentials (g_task_get_source_object (task), reply, fd_list, &app_id))
+    {
+      g_task_return_new_error (task, G_IO_ERROR, G_IO_ERROR_PERMISSION_DENIED,
+                               "The sender can't be identified");
+      return;
+    }
+
+  g_task_return_pointer (task, app_id ? app_id : g_strdup (""), g_free);
+}
+
+/**
+ * meta_context_identify_sender:
+ * @context: a #MetaContext
+ * @connection: the bus the sender is connected to
+ * @sender: the unique bus name of the sender
+ * @cancellable: (nullable): a #GCancellable
+ * @callback: called once the sender is identified
+ * @user_data: data for @callback
+ *
+ * Identifies the process behind a D-Bus connection the same way Wayland
+ * clients are identified.
+ */
+void
+meta_context_identify_sender (MetaContext         *context,
+                              GDBusConnection     *connection,
+                              const char          *sender,
+                              GCancellable        *cancellable,
+                              GAsyncReadyCallback  callback,
+                              gpointer             user_data)
+{
+  g_return_if_fail (META_IS_CONTEXT (context));
+  g_return_if_fail (G_IS_DBUS_CONNECTION (connection));
+  g_return_if_fail (sender);
+
+  g_dbus_connection_call_with_unix_fd_list (connection,
+                                            "org.freedesktop.DBus",
+                                            "/org/freedesktop/DBus",
+                                            "org.freedesktop.DBus",
+                                            "GetConnectionCredentials",
+                                            g_variant_new ("(s)", sender),
+                                            G_VARIANT_TYPE ("(a{sv})"),
+                                            G_DBUS_CALL_FLAGS_NONE,
+                                            -1, NULL, cancellable,
+                                            on_sender_credentials,
+                                            g_task_new (context, cancellable,
+                                                        callback, user_data));
+}
+
+/**
+ * meta_context_identify_sender_finish:
+ * @context: a #MetaContext
+ * @result: the result passed to the callback
+ * @error: return location for an error, set when the sender can't be identified
+ *
+ * Returns: (transfer full): the ID of the sandboxed app that sent the
+ *   message, or an empty string when it runs outside a sandbox or has
+ *   full access
+ */
+char *
+meta_context_identify_sender_finish (MetaContext   *context,
+                                     GAsyncResult  *result,
+                                     GError       **error)
+{
+  g_return_val_if_fail (g_task_is_valid (result, context), NULL);
+
+  return g_task_propagate_pointer (G_TASK (result), error);
+}
