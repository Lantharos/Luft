diff --git a/src/wayland/meta-wayland-icon-pixels.c b/src/wayland/meta-wayland-icon-pixels.c
new file mode 100644
index 0000000000000000000000000000000000000000..c49290a690b92242a08c5fa9b0858f6b3ae4be1b
--- /dev/null
+++ b/src/wayland/meta-wayland-icon-pixels.c
@@ -0,0 +1,129 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "config.h"
+
+#include <gdk-pixbuf/gdk-pixbuf.h>
+#include <stdint.h>
+#include <string.h>
+#include <wayland-server-core.h>
+
+#include "wayland/meta-wayland-icon-pixels.h"
+#include "wayland/meta-wayland-buffer.h"
+#include "compositor/meta-multi-texture-format-private.h"
+
+static GIcon *
+copy_packed_pixels (struct wl_shm_buffer *buffer)
+{
+  int width = wl_shm_buffer_get_width (buffer);
+  int size = MIN (width, 512);
+  uint32_t format = wl_shm_buffer_get_format (buffer);
+  gboolean has_alpha = format == WL_SHM_FORMAT_ARGB8888 ||
+    format == WL_SHM_FORMAT_ABGR8888;
+  gboolean blue_first = format == WL_SHM_FORMAT_ARGB8888 ||
+    format == WL_SHM_FORMAT_XRGB8888;
+  GdkPixbuf *pixbuf = gdk_pixbuf_new (GDK_COLORSPACE_RGB, TRUE, 8, size, size);
+  int source_stride = wl_shm_buffer_get_stride (buffer);
+  int stride = gdk_pixbuf_get_rowstride (pixbuf);
+  uint8_t *dest = gdk_pixbuf_get_pixels (pixbuf);
+  const uint8_t *source;
+
+  wl_shm_buffer_begin_access (buffer);
+  source = wl_shm_buffer_get_data (buffer);
+  for (int y = 0; y < size; y++)
+    {
+      int source_y = (int64_t) y * width / size;
+      for (int x = 0; x < size; x++)
+        {
+          int source_x = (int64_t) x * width / size;
+          uint32_t pixel;
+          uint8_t *out = dest + y * stride + x * 4;
+          unsigned int alpha;
+          unsigned int red, green, blue;
+
+          memcpy (&pixel, source + (size_t) source_y * source_stride + source_x * 4, 4);
+          alpha = has_alpha ? pixel >> 24 : 255;
+          red = blue_first ? (pixel >> 16) & 255 : pixel & 255;
+          green = (pixel >> 8) & 255;
+          blue = blue_first ? pixel & 255 : (pixel >> 16) & 255;
+          out[0] = alpha ? MIN (255, (red * 255 + alpha / 2) / alpha) : 0;
+          out[1] = alpha ? MIN (255, (green * 255 + alpha / 2) / alpha) : 0;
+          out[2] = alpha ? MIN (255, (blue * 255 + alpha / 2) / alpha) : 0;
+          out[3] = alpha;
+        }
+    }
+  wl_shm_buffer_end_access (buffer);
+  return G_ICON (pixbuf);
+}
+
+static GIcon *
+convert_pixels (MetaWaylandCompositor *compositor,
+                struct wl_resource    *resource,
+                GError               **error)
+{
+  MetaWaylandBuffer *buffer = meta_wayland_buffer_from_resource (compositor, resource);
+  g_autoptr (MetaMultiTexture) texture = NULL;
+  g_autoptr (CoglTexture) output = NULL;
+  g_autoptr (CoglOffscreen) offscreen = NULL;
+  g_autoptr (CoglPipeline) pipeline = NULL;
+  g_autoptr (GdkPixbuf) pixbuf = NULL;
+  CoglContext *context;
+  CoglFramebuffer *framebuffer;
+  MetaMultiTextureCoefficients coeffs;
+  int size;
+
+  if (!meta_wayland_buffer_realize (buffer) ||
+      !meta_wayland_buffer_attach (buffer, &texture, error))
+    return NULL;
+
+  size = MIN (meta_multi_texture_get_width (texture), 512);
+  context = cogl_texture_get_context (meta_multi_texture_get_plane (texture, 0));
+  output = cogl_texture_2d_new_with_size (context, size, size);
+  offscreen = cogl_offscreen_new_with_texture (output);
+  framebuffer = COGL_FRAMEBUFFER (offscreen);
+  if (!cogl_framebuffer_allocate (framebuffer, error))
+    return NULL;
+  cogl_framebuffer_orthographic (framebuffer, 0, 0, size, size, -1, 1);
+  pipeline = cogl_pipeline_new (context);
+  for (int i = 0; i < meta_multi_texture_get_n_planes (texture); i++)
+    {
+      cogl_pipeline_set_layer_texture (pipeline, i, meta_multi_texture_get_plane (texture, i));
+      cogl_pipeline_set_layer_filters (pipeline, i, COGL_PIPELINE_FILTER_LINEAR,
+                                       COGL_PIPELINE_FILTER_LINEAR);
+      cogl_pipeline_set_layer_combine (pipeline, i, "RGBA = REPLACE (TEXTURE)", NULL);
+    }
+  coeffs = meta_multi_texture_is_simple (texture)
+    ? META_MULTI_TEXTURE_COEFFICIENTS_IDENTITY_FULL
+    : META_MULTI_TEXTURE_COEFFICIENTS_BT709_LIMITED;
+  meta_multi_texture_add_pipeline_sampling (texture, coeffs,
+                                            META_MULTI_TEXTURE_ALPHA_MODE_PREMULT_ELECTRICAL,
+                                            pipeline);
+  cogl_pipeline_set_blend (pipeline, "RGBA = ADD (SRC_COLOR, 0)", NULL);
+  cogl_framebuffer_draw_rectangle (framebuffer, pipeline, 0, 0, size, size);
+  pixbuf = gdk_pixbuf_new (GDK_COLORSPACE_RGB, TRUE, 8, size, size);
+  if (!cogl_framebuffer_read_pixels (framebuffer, 0, 0, size, size,
+                                     COGL_PIXEL_FORMAT_RGBA_8888,
+                                     gdk_pixbuf_get_pixels (pixbuf)))
+    {
+      g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_FAILED, "Cannot read icon pixels");
+      return NULL;
+    }
+  return G_ICON (g_steal_pointer (&pixbuf));
+}
+
+GIcon *
+meta_wayland_icon_pixels_new (MetaWaylandCompositor *compositor,
+                             struct wl_resource    *resource,
+                             GError               **error)
+{
+  struct wl_shm_buffer *buffer = wl_shm_buffer_get (resource);
+
+  switch (wl_shm_buffer_get_format (buffer))
+    {
+    case WL_SHM_FORMAT_ARGB8888:
+    case WL_SHM_FORMAT_XRGB8888:
+    case WL_SHM_FORMAT_ABGR8888:
+    case WL_SHM_FORMAT_XBGR8888:
+      return copy_packed_pixels (buffer);
+    default:
+      return convert_pixels (compositor, resource, error);
+    }
+}
