--- /dev/null
+++ b/src/compositor/meta-variable-refresh-log.c
@@ -0,0 +1,82 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "config.h"
+
+#include "compositor/meta-variable-refresh-log.h"
+
+#include <gio/gio.h>
+
+#include "compositor/meta-scanout-log.h"
+
+#define SETTINGS_SCHEMA "com.lantharos.kestrel.diagnostics"
+#define SETTINGS_KEY "log-variable-refresh"
+
+struct _MetaVariableRefreshLog
+{
+  GSettings *settings;
+  gboolean enabled;
+};
+
+static void
+sync_enabled (MetaVariableRefreshLog *log)
+{
+  log->enabled = g_settings_get_boolean (log->settings, SETTINGS_KEY);
+}
+
+MetaVariableRefreshLog *
+meta_variable_refresh_log_new (void)
+{
+  MetaVariableRefreshLog *log = g_new0 (MetaVariableRefreshLog, 1);
+
+  log->settings = g_settings_new (SETTINGS_SCHEMA);
+  g_signal_connect_swapped (log->settings, "changed::" SETTINGS_KEY,
+                            G_CALLBACK (sync_enabled), log);
+  sync_enabled (log);
+  return log;
+}
+
+void
+meta_variable_refresh_log_free (MetaVariableRefreshLog *log)
+{
+  g_clear_object (&log->settings);
+  g_free (log);
+}
+
+static const char *
+describe_fixed (MetaWindow *window)
+{
+  switch (meta_window_get_content_type (window))
+    {
+    case META_WINDOW_CONTENT_TYPE_VIDEO:
+      return "it shows video";
+    case META_WINDOW_CONTENT_TYPE_PHOTO:
+      return "it shows photos";
+    default:
+      return "it is not a game";
+    }
+}
+
+void
+meta_variable_refresh_log_changed (MetaVariableRefreshLog *log,
+                                   ClutterStageView       *view,
+                                   MetaWindow             *window,
+                                   gboolean                display_enabled)
+{
+  const char *name = clutter_stage_view_get_name (view);
+  const char *display_off =
+    display_enabled ? "" : " (variable refresh is off for this display)";
+
+  if (!log->enabled)
+    return;
+
+  if (!window)
+    g_message ("Variable refresh: %s: no window covers the display, "
+               "the refresh rate stays fixed%s", name, display_off);
+  else if (meta_window_get_variable_refresh (window))
+    g_message ("Variable refresh: %s: the refresh rate follows %s%s",
+               name, meta_log_window_name (window), display_off);
+  else
+    g_message ("Variable refresh: %s: the refresh rate stays fixed for %s, "
+               "since %s%s",
+               name, meta_log_window_name (window), describe_fixed (window),
+               display_off);
+}
