+static void
+switch_tool (MetaSeatImpl           *seat_impl,
+             ClutterInputDevice     *input_device,
+             ClutterInputDeviceTool *to,
+             uint64_t                time_us)
+{
+  MetaInputDeviceNative *device_native = META_INPUT_DEVICE_NATIVE (input_device);
+  gboolean tip_down = (device_native->button_state & CLUTTER_BUTTON1_MASK) != 0;
+
+  if (tip_down)
+    meta_seat_impl_notify_button_in_impl (seat_impl, input_device, time_us,
+                                          BTN_TOUCH, FALSE);
+
+  meta_seat_impl_notify_tablet_proximity_in_impl (seat_impl, input_device,
+                                                  device_native->last_tool,
+                                                  time_us, FALSE);
+  meta_seat_impl_notify_tablet_proximity_in_impl (seat_impl, input_device,
+                                                  to, time_us, TRUE);
+
+  if (tip_down)
+    meta_seat_impl_notify_button_in_impl (seat_impl, input_device, time_us,
+                                          BTN_TOUCH, TRUE);
+}
+
+static void
+erase_with_pen (MetaSeatImpl       *seat_impl,
+                ClutterInputDevice *input_device,
+                uint64_t            time_us,
+                gboolean            pressed)
+{
+  MetaInputDeviceNative *device_native = META_INPUT_DEVICE_NATIVE (input_device);
+  ClutterInputDeviceTool *pen = device_native->last_tool;
+
+  if (pressed && !device_native->erasing_pen &&
+      clutter_input_device_tool_get_tool_type (pen) != CLUTTER_INPUT_DEVICE_TOOL_ERASER)
+    {
+      device_native->erasing_pen = g_object_ref (pen);
+      switch_tool (seat_impl, input_device,
+                   meta_input_device_tool_native_ensure_eraser_in_impl (pen),
+                   time_us);
+    }
+  else if (!pressed && device_native->erasing_pen)
+    {
+      g_autoptr (ClutterInputDeviceTool) erasing_pen =
+        g_steal_pointer (&device_native->erasing_pen);
+
+      switch_tool (seat_impl, input_device, erasing_pen, time_us);
+    }
+}
