## Errors shown in Install Luft and first-run setup

installer-not-allowed = Jums neleidžiama to daryti.
installer-stopped = Diegimo programa netikėtai sustojo.
installer-request-invalid = Užklausa netinkama: { $error }
installer-settings-invalid = Nustatymai netinkami: { $error }
installer-busy = Sistema Luft jau diegiama.
installer-account-exists = Paskyra jau sukurta.

## Choosing what to install

installer-no-image = Nėra { $variant } atvaizdo, kurį būtų galima įdiegti.
installer-read-failed = Nepavyko perskaityti { $path }
installer-parse-failed = Nepavyko išanalizuoti { $path }
installer-write-failed = Nepavyko įrašyti { $path }

## Checking the destination

installer-drive-gone = Šis diskas nebeprijungtas.
installer-drive-unusable = Šiame diske sistemos Luft įdiegti negalima.
installer-system-gone = Šios sistemos nebėra.
installer-system-unreplaceable = Luft kol kas negali pakeisti sistemos { $system }.
installer-drive-running = Sistema Luft šiuo metu paleista iš šio disko, todėl jo ištrinti negalima.
installer-windows-unshrinkable = Šiame diske esančios sistemos Windows sumažinti negalima.
installer-size-wont-fit = Toks dydis netelpa šalia Windows.
installer-space-gone = Šios laisvos vietos nebėra.
installer-space-too-small = Šios laisvos vietos sistemai Luft per mažai.

## Account and regional settings

installer-user-name-invalid = Tokio naudotojo vardo naudoti negalima.
installer-full-name-invalid = Varde negali būti dvitaškių, kablelių ar eilučių lūžių.
installer-password-missing = Sugalvokite slaptažodį.
installer-account-not-saved = Naujoji paskyra neįrašyta
installer-account-missing = Naujosios paskyros nėra
installer-regional-invalid = Šie regioniniai nustatymai netinkami.
installer-unknown-zone = Naujoji sistema nežino laiko juostos { $zone }.

## Installing

installer-esp-partition-failed = Nepavyko sukurti EFI sistemos skaidinio
installer-startup-partition-failed = Nepavyko sukurti skaidinio sistemos Luft paleidimo failams
installer-root-partition-failed = Nepavyko sukurti skaidinio sistemai Luft
installer-shrink-failed = Nepavyko sumažinti Windows
installer-no-esp = Diske nėra EFI sistemos skaidinio
installer-no-root = Skaidinys sistemai Luft nesukurtas
installer-copy-failed = Nepavyko nukopijuoti sistemos Luft
installer-no-deployment = Naujoji sistema neturi diegimo
installer-deployment-unnamed = Naujosios sistemos diegimas neturi pavadinimo
installer-deployment-unopened = Nepavyko atidaryti naujosios sistemos
installer-boot-menu-failed = Nepavyko įrašyti sistemos Luft paleidimo meniu į EFI sistemos skaidinį
installer-key-queue-failed = Nepavyko paruošti sistemos Luft Secure Boot rakto kitam paleidimui iš naujo

## Replacing a Linux system

installer-leftovers-failed = Nepavyko išvalyti to, kas liko po ankstesnio bandymo
installer-default-failed = Nepavyko nustatyti, kad būtų paleidžiama sistema Luft
installer-relabel-failed = Nepavyko paženklinti jūsų failų sistemai Luft
installer-set-aside-failed = Nepavyko atidėti senosios sistemos

## Things packed with Meet Luft

installer-box-unopened = Nepavyko atidaryti persikraustymo dėžės
installer-box-no-list = Persikraustymo dėžėje nėra turinio sąrašo
installer-unpack-failed = Nepavyko išpakuoti { $path }
installer-wallpaper-unnamed = Fono paveikslėlis neturi pavadinimo
