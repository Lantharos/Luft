index e661cbe0ad..ed31e50d66 100644
--- a/src/tests/x11-tests.c
+++ b/src/tests/x11-tests.c
@@ -23,6 +23,7 @@
 #include "backends/meta-virtual-monitor.h"
 #include "compositor/meta-surface-actor.h"
 #include "compositor/meta-window-actor-private.h"
+#include "meta/meta-selection.h"
 #include "meta-test/meta-context-test.h"
 #include "tests/meta-ref-test.h"
 #include "tests/meta-test-utils.h"
@@ -180,6 +181,98 @@ meta_test_x11_user_position (void)
   meta_x11_test_client_finish (test_client);
 }
 
+static gboolean
+clipboard_has_mimetype (const char *mimetype)
+{
+  MetaDisplay *display = meta_context_get_display (test_context);
+  MetaSelection *selection = meta_display_get_selection (display);
+  GList *mimetypes;
+  gboolean found;
+
+  mimetypes = meta_selection_get_mimetypes (selection,
+                                            META_SELECTION_CLIPBOARD);
+  found = g_list_find_custom (mimetypes, mimetype,
+                              (GCompareFunc) g_strcmp0) != NULL;
+  g_list_free_full (mimetypes, g_free);
+
+  return found;
+}
+
+static void
+cancelled_transfer_cb (GObject      *source_object,
+                       GAsyncResult *res,
+                       gpointer      user_data)
+{
+  gboolean *done = user_data;
+  g_autoptr (GError) error = NULL;
+
+  g_assert_false (meta_selection_transfer_finish (META_SELECTION (source_object),
+                                                  res, &error));
+  g_assert_error (error, G_IO_ERROR, G_IO_ERROR_CANCELLED);
+
+  *done = TRUE;
+}
+
+static void
+cancel_transfer_from_unresponsive_owner (const char *mode)
+{
+  MetaDisplay *display = meta_context_get_display (test_context);
+  MetaSelection *selection = meta_display_get_selection (display);
+  g_autoptr (GOutputStream) output = NULL;
+  g_autoptr (GCancellable) cancellable = NULL;
+  MetaX11TestClient *test_client;
+  gboolean done = FALSE;
+
+  test_client = meta_x11_test_client_new_with_args (test_context,
+                                                    "unresponsive-selection-owner",
+                                                    mode,
+                                                    NULL);
+  while (!clipboard_has_mimetype ("application/mutter-test"))
+    g_main_context_iteration (NULL, TRUE);
+
+  output = g_memory_output_stream_new_resizable ();
+  cancellable = g_cancellable_new ();
+  meta_selection_transfer_async (selection,
+                                 META_SELECTION_CLIPBOARD,
+                                 "application/mutter-test",
+                                 -1,
+                                 output,
+                                 cancellable,
+                                 cancelled_transfer_cb,
+                                 &done);
+
+  if (g_strcmp0 (mode, "stall-incr") == 0)
+    {
+      GMemoryOutputStream *memory_output = G_MEMORY_OUTPUT_STREAM (output);
+
+      while (g_memory_output_stream_get_data_size (memory_output) == 0)
+        g_main_context_iteration (NULL, TRUE);
+    }
+
+  g_cancellable_cancel (cancellable);
+
+  while (!done)
+    g_main_context_iteration (NULL, TRUE);
+
+  meta_x11_test_client_send_sigterm (test_client);
+  meta_x11_test_client_finish (test_client);
+
+  while (clipboard_has_mimetype ("application/mutter-test"))
+    g_main_context_iteration (NULL, TRUE);
+}
+
+static void
+meta_test_x11_selection_cancel_unanswered (void)
+{
+  cancel_transfer_from_unresponsive_owner ("never-answer");
+}
+
+static void
+meta_test_x11_selection_cancel_stalled_incr (void)
+{
+  cancel_transfer_from_unresponsive_owner ("stall-incr");
+}
+
 static void
 on_before_tests (void)
 {
@@ -200,6 +293,10 @@ init_tests (void)
                    meta_test_x11_allow_commits_race);
   g_test_add_func ("/x11/client/user-position",
                    meta_test_x11_user_position);
+  g_test_add_func ("/x11/selection/cancel-unanswered",
+                   meta_test_x11_selection_cancel_unanswered);
+  g_test_add_func ("/x11/selection/cancel-stalled-incr",
+                   meta_test_x11_selection_cancel_stalled_incr);
 }
 
