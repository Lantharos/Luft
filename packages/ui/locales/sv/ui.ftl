## Fingerprints
## Each finger has a name used as a title (the message value) and a form used inside
## a sentence (.inline), like "Place your … on the sensor." Adjust the case of .inline
## to fit those sentences.

ui-finger-right-index = Höger pekfinger
    .inline = ditt högra pekfinger
ui-finger-left-index = Vänster pekfinger
    .inline = ditt vänstra pekfinger
ui-finger-right-thumb = Höger tumme
    .inline = din högra tumme
ui-finger-left-thumb = Vänster tumme
    .inline = din vänstra tumme
ui-finger-right-middle = Höger långfinger
    .inline = ditt högra långfinger
ui-finger-left-middle = Vänster långfinger
    .inline = ditt vänstra långfinger
ui-finger-right-ring = Höger ringfinger
    .inline = ditt högra ringfinger
ui-finger-left-ring = Vänster ringfinger
    .inline = ditt vänstra ringfinger
ui-finger-right-little = Höger lillfinger
    .inline = ditt högra lillfinger
ui-finger-left-little = Vänster lillfinger
    .inline = ditt vänstra lillfinger

ui-fingerprint-place = Lägg { $finger } på sensorn.
ui-fingerprint-swipe = Dra { $finger } över sensorn.
ui-fingerprint-stage-passed = Bra. Lyft fingret och lägg det på igen.
ui-fingerprint-stage-passed-swipe = Bra. Dra igen.
ui-fingerprint-retry = Det gick inte att läsa av. Försök igen.
ui-fingerprint-swipe-too-short = Dra lite långsammare.
ui-fingerprint-not-centered = Lägg fingret mitt på sensorn.
ui-fingerprint-remove-and-retry = Lyft fingret och försök igen.
ui-fingerprint-added = Fingeravtrycket har lagts till.
ui-fingerprint-full = Läsaren har inte plats för fler fingeravtryck.
ui-fingerprint-disconnected = Fingeravtrycksläsaren slutade svara. Försök igen om en stund.
ui-fingerprint-duplicate = Läsaren har redan det här fingret sparat, förmodligen från Windows eller ett annat konto. Använd ett annat finger.
ui-fingerprint-failed = Det gick inte att lägga till fingeravtrycket. Försök igen.

