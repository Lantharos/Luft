## Fingerprints
## Each finger has a name used as a title (the message value) and a form used inside
## a sentence (.inline), like "Place your … on the sensor." Adjust the case of .inline
## to fit those sentences.

ui-finger-right-index = Dešinės rankos smilius
    .inline = dešinės rankos smilių
ui-finger-left-index = Kairės rankos smilius
    .inline = kairės rankos smilių
ui-finger-right-thumb = Dešinės rankos nykštys
    .inline = dešinės rankos nykštį
ui-finger-left-thumb = Kairės rankos nykštys
    .inline = kairės rankos nykštį
ui-finger-right-middle = Dešinės rankos didysis pirštas
    .inline = dešinės rankos didįjį pirštą
ui-finger-left-middle = Kairės rankos didysis pirštas
    .inline = kairės rankos didįjį pirštą
ui-finger-right-ring = Dešinės rankos bevardis pirštas
    .inline = dešinės rankos bevardį pirštą
ui-finger-left-ring = Kairės rankos bevardis pirštas
    .inline = kairės rankos bevardį pirštą
ui-finger-right-little = Dešinės rankos mažylis
    .inline = dešinės rankos mažylį
ui-finger-left-little = Kairės rankos mažylis
    .inline = kairės rankos mažylį

ui-fingerprint-place = Uždėkite { $finger } ant jutiklio.
ui-fingerprint-swipe = Perbraukite { $finger } per jutiklį.
ui-fingerprint-stage-passed = Gerai. Pakelkite pirštą ir vėl jį uždėkite.
ui-fingerprint-stage-passed-swipe = Gerai. Perbraukite dar kartą.
ui-fingerprint-retry = Nepavyko gerai nuskaityti. Bandykite dar kartą.
ui-fingerprint-swipe-too-short = Braukite šiek tiek lėčiau.
ui-fingerprint-not-centered = Uždėkite pirštą jutiklio viduryje.
ui-fingerprint-remove-and-retry = Pakelkite pirštą ir bandykite dar kartą.
ui-fingerprint-added = Piršto atspaudas pridėtas.
ui-fingerprint-full = Skaitytuve nebeliko vietos dar vienam piršto atspaudui.
ui-fingerprint-disconnected = Piršto atspaudų skaitytuvas nustojo atsakyti. Po akimirkos bandykite dar kartą.
ui-fingerprint-duplicate = Šis pirštas skaitytuve jau įrašytas, tikriausiai per Windows ar kitą paskyrą. Naudokite kitą pirštą.
ui-fingerprint-failed = Nepavyko pridėti šio piršto atspaudo. Bandykite dar kartą.

