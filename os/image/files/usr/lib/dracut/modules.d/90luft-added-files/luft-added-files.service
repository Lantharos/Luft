[Unit]
Description=Keep the TPM from unlocking after files were added beside the startup image
DefaultDependencies=no
Conflicts=shutdown.target
Wants=tpm2.target cryptsetup-pre.target
After=tpm2.target systemd-pcrphase-initrd.service
Before=cryptsetup-pre.target systemd-cryptsetup@root.service sysinit.target shutdown.target
ConditionSecurity=tpm2
ConditionDirectoryNotEmpty=|/.extra/credentials
ConditionDirectoryNotEmpty=|/.extra/global_credentials
ConditionDirectoryNotEmpty=|/.extra/sysext
ConditionDirectoryNotEmpty=|/.extra/global_sysext
ConditionDirectoryNotEmpty=|/.extra/confext
ConditionDirectoryNotEmpty=|/.extra/global_confext
FailureAction=reboot-force

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/systemd/systemd-pcrextend --pcr=11 luft-added-files
ExecStart=/usr/lib/systemd/systemd-pcrextend --pcr=15 luft-added-files
