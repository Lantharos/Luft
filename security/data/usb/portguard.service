[Unit]
Description=USB protection
ConditionKernelCommandLine=!systemd.unit=rescue.target
Before=display-manager.service systemd-user-sessions.service
StartLimitIntervalSec=0

[Service]
Type=dbus
BusName=com.lantharos.UsbProtection1
ExecStart=@libexecdir@/portguard
Restart=on-failure
RestartSec=1
UMask=0077
StateDirectory=portguard
StateDirectoryMode=0700
RuntimeDirectory=portguard
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
ReadWritePaths=/sys/devices /sys/bus/usb /sys/module/usbcore/parameters
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
CapabilityBoundingSet=CAP_SYS_PTRACE

[Install]
WantedBy=multi-user.target
