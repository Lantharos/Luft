---
import { shot } from '../../data/shots';
import Shot from '../media/Shot.astro';
import Frame from './Frame.astro';
---

<section id="tour" class="page relative z-10 -mt-[22svh] scroll-mt-24">
	<div class="settle">
		<Frame>
			<Shot
				{...shot('desktop')}
				alt="The Luft desktop with Rover, Settings and Tern open over a misty forest"
				sizes="(min-width: 76rem) 72rem, 94vw"
			/>
		</Frame>
	</div>
	<p class="reveal mx-auto mt-16 max-w-3xl text-center text-lede text-ink-soft text-pretty md:mt-24">
		Luft is a complete system for your PC, built on Fedora. It has its own desktop, its own apps and a core that keeps itself in one piece, so you can get on with your day.
	</p>
</section>
