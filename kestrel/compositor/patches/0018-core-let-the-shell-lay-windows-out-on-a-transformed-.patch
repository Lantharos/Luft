+static void
+cull_unobscured_group (ClutterActor       *group,
+                       ClutterActor       *stage,
+                       const MtkRectangle *stage_rect)
+{
+  g_autoptr (MtkRegion) stage_region = mtk_region_create_rectangle (stage_rect);
+  g_autoptr (MtkRegion) group_region = NULL;
+  graphene_matrix_t group_to_stage, stage_to_group;
+
+  clutter_actor_get_relative_transformation_matrix (group, stage,
+                                                    &group_to_stage);
+  if (graphene_matrix_is_identity (&group_to_stage))
+    {
+      meta_cullable_cull_unobscured (META_CULLABLE (group), stage_region);
+      return;
+    }
+
+  if (!graphene_matrix_is_2d (&group_to_stage) ||
+      !graphene_matrix_inverse (&group_to_stage, &stage_to_group))
+    {
+      meta_cullable_cull_unobscured (META_CULLABLE (group), NULL);
+      return;
+    }
+
+  group_region = mtk_region_apply_matrix_transform_expand (stage_region,
+                                                           &stage_to_group);
+  meta_cullable_cull_unobscured (META_CULLABLE (group), group_region);
+}
