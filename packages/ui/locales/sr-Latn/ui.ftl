## Fingerprints
## Each finger has a name used as a title (the message value) and a form used inside
## a sentence (.inline), like "Place your … on the sensor." Adjust the case of .inline
## to fit those sentences.

ui-finger-right-index = Desni kažiprst
    .inline = desni kažiprst
ui-finger-left-index = Levi kažiprst
    .inline = levi kažiprst
ui-finger-right-thumb = Desni palac
    .inline = desni palac
ui-finger-left-thumb = Levi palac
    .inline = levi palac
ui-finger-right-middle = Desni srednji prst
    .inline = desni srednji prst
ui-finger-left-middle = Levi srednji prst
    .inline = levi srednji prst
ui-finger-right-ring = Desni domali prst
    .inline = desni domali prst
ui-finger-left-ring = Levi domali prst
    .inline = levi domali prst
ui-finger-right-little = Desni mali prst
    .inline = desni mali prst
ui-finger-left-little = Levi mali prst
    .inline = levi mali prst

ui-fingerprint-place = Stavite { $finger } na senzor.
ui-fingerprint-swipe = Prevucite { $finger } preko senzora.
ui-fingerprint-stage-passed = Dobro. Podignite prst, pa ga ponovo stavite.
ui-fingerprint-stage-passed-swipe = Dobro. Prevucite ponovo.
ui-fingerprint-retry = Očitavanje nije uspelo. Pokušajte ponovo.
ui-fingerprint-swipe-too-short = Prevucite malo sporije.
ui-fingerprint-not-centered = Postavite prst na sredinu senzora.
ui-fingerprint-remove-and-retry = Podignite prst i pokušajte ponovo.
ui-fingerprint-added = Otisak prsta je dodat.
ui-fingerprint-full = Čitač nema mesta za još jedan otisak prsta.
ui-fingerprint-disconnected = Čitač otiska prsta je prestao da odgovara. Pokušajte ponovo za trenutak.
ui-fingerprint-duplicate = Čitač već ima sačuvan ovaj prst, verovatno preko sistema Windows ili drugog naloga. Koristite drugi prst.
ui-fingerprint-failed = Dodavanje ovog otiska prsta nije uspelo. Pokušajte ponovo.

