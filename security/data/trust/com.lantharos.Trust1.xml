<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
 "https://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<node name="/com/lantharos/Trust1">
  <!--
    Device trust: Secure Boot, the TPM, the signed startup and disk encryption.

    SecureBoot: "on", "off", "setup" (no platform key, anything boots) or "unsupported" (no UEFI).

    Tpm: Present (b), Version (s, "2.0" or "1.2"), Usable (b), Reason (s, why it can't be used, empty when usable).

    SigningKey: Luft's Secure Boot key, which signs the boot menu, the startup images and drivers.
      State (s: "none", "pending" until the next restart adds it, "enrolled"),
      Available (b), Reason (s, why it can't be added here),
      Missed (u, restarts that went by without the key being added since it was requested; after three,
      it is no longer requested again by itself and State goes back to "none"),
      MissedThisBoot (b, the restart that started this boot was one of them),
      OtherKeys (as, names of keys added to shim from elsewhere, which shim also trusts for drivers;
      Luft's key and shim's own don't count), RemovingOtherKeys (b, the next restart asks to remove them).

    Startup: Installed (b, shim and Luft's boot menu are on the EFI system partition),
      Measured (b, this boot came through them and recorded what started), Available (b), Reason (s).

    Disk: Device (s), Encrypted (b), State (s: "off", "starting" until the restart, "encrypting",
      "decrypting", "on"), Progress (d, 0 to 1 while encrypting or decrypting), Remaining (t, seconds, 0 when unknown),
      Unlock (as, any of "tpm", "pin", "passphrase", "recovery-key", "security-key"),
      RecoveryKeyStored (b, the recovery key can be shown again), TpmRefused (b, the TPM didn't unlock the disk
      at the last startup, so the recovery key or passphrase was needed).

    AntiCheat: what games with anti-cheat (such as Epic's Easy Anti-Cheat) check about how the computer started.
      Checks (a(sbs): id, met, a sentence for people saying what's missing, empty when met), for "signed-system",
      "tpm", "secure-boot", "measured-startup", "iommu", "lockdown", "kexec" and "bpf-lsm".
      UsesLuftKey (b, the computer starts with Luft's key, which Epic hasn't listed as well-known yet; nothing to fix).

    Methods that change the disk take "unlock": a passphrase or recovery key typed by the person, or "" to use
    the recovery key kept sealed by the TPM.
  -->
  <interface name="com.lantharos.Trust1">
    <property name="SecureBoot" type="s" access="read"/>
    <property name="Tpm" type="a{sv}" access="read"/>
    <property name="SigningKey" type="a{sv}" access="read"/>
    <property name="Startup" type="a{sv}" access="read"/>
    <property name="Disk" type="a{sv}" access="read"/>
    <property name="AntiCheat" type="a{sv}" access="read"/>

    <method name="GenerateRecoveryKey">
      <arg name="key" type="s" direction="out"/>
    </method>
    <!-- Each check: id, passed, a sentence for people. -->
    <method name="CheckEncryption">
      <arg name="checks" type="a(sbs)" direction="out"/>
    </method>
    <!-- pin: "" for none. passphrase: only without a usable TPM, "" otherwise. Takes effect at the next restart. -->
    <method name="TurnOnEncryption">
      <arg name="recovery_key" type="s" direction="in"/>
      <arg name="pin" type="s" direction="in"/>
      <arg name="passphrase" type="s" direction="in"/>
    </method>
    <method name="TurnOffEncryption">
      <arg name="unlock" type="s" direction="in"/>
    </method>
    <!-- Links the TPM again, adds, changes or removes the PIN (pin ""). Returns a new recovery key when the disk had none. -->
    <method name="SetUpTpmUnlock">
      <arg name="unlock" type="s" direction="in"/>
      <arg name="pin" type="s" direction="in"/>
      <arg name="recovery_key" type="s" direction="out"/>
    </method>
    <method name="RemoveTpmUnlock">
      <arg name="unlock" type="s" direction="in"/>
    </method>
    <method name="ShowRecoveryKey">
      <arg name="key" type="s" direction="out"/>
    </method>
    <method name="ReplaceRecoveryKey">
      <arg name="unlock" type="s" direction="in"/>
      <arg name="key" type="s" direction="out"/>
    </method>
    <!-- Returns the one-time code to type in the key enrollment screen after the restart. -->
    <method name="EnrollSigningKey">
      <arg name="code" type="s" direction="out"/>
    </method>
    <method name="CancelSigningKeyEnrollment"/>
    <!-- Asks shim to remove OtherKeys at the next restart. Returns the one-time code to type in its blue screen. -->
    <method name="RemoveOtherKeys">
      <arg name="code" type="s" direction="out"/>
    </method>
    <method name="KeepOtherKeys"/>
    <method name="InstallSignedStartup"/>
    <!-- Other systems' boot loaders: each folder of one on the EFI system partition this computer started from, and
         each folder on another EFI system partition that a firmware entry starts. esp: that partition's GUID,
         folder: such as "EFI/Microsoft", kind: "windows" or "grub", entries: the firmware entries that start from
         it (number, label), partitions: the partition GUIDs its settings name (Windows Boot Manager's store, the
         file systems GRUB looks for). Empty while Luft's own startup isn't installed. Open to everyone. -->
    <method name="OtherStartups">
      <arg name="startups" type="a(sssa(qs)as)" direction="out"/>
    </method>
    <!-- Run before deleting another system's partitions. Puts Luft's startup in place and first, then removes the
         firmware entries that start from the folders (esp, folder) or from any of the partitions, and the folders
         themselves from the EFI system partition this computer started from. Refuses Luft's own folders and the
         entry this computer started from. -->
    <method name="RemoveStartups">
      <arg name="folders" type="a(ss)" direction="in"/>
      <arg name="partitions" type="as" direction="in"/>
    </method>
    <!-- Deletes the old system that Install Luft kept when it replaced it, as /var/lib/luft-installer/old-system.json
         records, then that record. -->
    <method name="RemoveOldSystem"/>
    <!-- Grows the system's partition into the free space right after it, then its encryption and file system.
         Returns the bytes Luft gained. -->
    <method name="GrowSystem">
      <arg name="unlock" type="s" direction="in"/>
      <arg name="grown" type="t" direction="out"/>
    </method>
    <!-- Called by the login screen or the desktop once it has been shown for a moment. Remembers the running version
         as one that starts, so an update that never gets this far goes back to it. -->
    <method name="ConfirmStartup"/>
  </interface>

  <!--
    Encrypting and decrypting drives other than the system disk, in place, while they stay in use.

    Drives: one entry per drive that is being changed or that this computer keeps something for, keyed by the
      LUKS UUID: Device (s, its device node, "" while it's disconnected), State (s: "encrypting", "decrypting",
      "paused", "waiting" until it's connected and unlocked, or "on"), Change (s: "encrypt", "decrypt", ""),
      Progress (d), Remaining (t, seconds), AutoUnlock (b, it unlocks on this computer without asking:
      at startup when it's inside the computer, when it's plugged in otherwise), RecoveryKeyStored (b).

    Unlocking automatically keeps a key for the drive on this computer's own disk, so it needs device encryption
    to be on. Methods that take "unlock" accept a passphrase or recovery key, or "" for a key this computer keeps.
  -->
  <interface name="com.lantharos.Trust1.Drives">
    <property name="Drives" type="a{sa{sv}}" access="read"/>

    <!-- method: "in-place" (keeps the files), "reformat" (only formatting can encrypt it) or "none".
         auto_unlock: why it can't unlock automatically on this computer, "" when it can. -->
    <method name="Check">
      <arg name="device" type="s" direction="in"/>
      <arg name="method" type="s" direction="out"/>
      <arg name="checks" type="a(sbs)" direction="out"/>
      <arg name="auto_unlock" type="s" direction="out"/>
    </method>
    <!-- The partition must be unmounted. It is unlocked as soon as encrypting starts and stays usable
         meanwhile. passphrase: "" for none. Returns the drive's LUKS UUID. -->
    <method name="Encrypt">
      <arg name="device" type="s" direction="in"/>
      <arg name="recovery_key" type="s" direction="in"/>
      <arg name="passphrase" type="s" direction="in"/>
      <arg name="auto_unlock" type="b" direction="in"/>
      <arg name="uuid" type="s" direction="out"/>
    </method>
    <method name="Decrypt">
      <arg name="device" type="s" direction="in"/>
      <arg name="unlock" type="s" direction="in"/>
    </method>
    <!-- Adds the recovery key when the drive has none (recovery_key "" to leave it), and turns unlocking
         automatically on or off. -->
    <method name="SetUpUnlocking">
      <arg name="device" type="s" direction="in"/>
      <arg name="unlock" type="s" direction="in"/>
      <arg name="recovery_key" type="s" direction="in"/>
      <arg name="auto_unlock" type="b" direction="in"/>
    </method>
    <method name="Pause">
      <arg name="uuid" type="s" direction="in"/>
    </method>
    <method name="Resume">
      <arg name="uuid" type="s" direction="in"/>
      <arg name="unlock" type="s" direction="in"/>
    </method>
    <method name="ShowRecoveryKey">
      <arg name="uuid" type="s" direction="in"/>
      <arg name="key" type="s" direction="out"/>
    </method>
    <!-- Open to everyone: picks up drives that were waiting and are unlocked now. -->
    <method name="Continue"/>
  </interface>
</node>
