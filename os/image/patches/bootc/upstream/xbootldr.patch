 #[derive(Debug, Deserialize)]
 struct DevicesOutput {
     blockdevices: Vec<Device>,
@@ -217,6 +220,21 @@ impl Device {
             .ok_or_else(|| anyhow!("No ESP partition found among backing devices"))
     }
 
+    /// Find the VFAT Extended Boot Loader Partition (XBOOTLDR) on the disk of
+    /// the first ESP among all root devices backing this device.
+    ///
+    /// Per the Boot Loader Specification, boot loaders read Type #1 entries and
+    /// UKIs from an XBOOTLDR partition on the same disk as the ESP, which lets
+    /// them live outside a small ESP (e.g. one shared with Windows).
+    pub fn find_first_colocated_xbootldr(&self) -> Result<Option<Device>> {
+        for root in &self.find_all_roots()? {
+            if root.find_partition_of_esp_optional()?.is_some() {
+                return Ok(root.find_partition_of_xbootldr().cloned());
+            }
+        }
+        Ok(None)
+    }
+
     /// Find all BIOS boot partitions across all root devices backing this device.
     /// Calls find_all_roots() to discover physical disks, then searches each for a BIOS boot partition.
     /// Returns None if no BIOS boot partitions are found.
@@ -240,6 +258,15 @@ impl Device {
         })
     }
 
+    /// Find the Extended Boot Loader Partition (XBOOTLDR) among children.
+    ///
+    /// Only VFAT partitions count, since the firmware reads the boot entries
+    /// and UKIs on it.
+    pub fn find_partition_of_xbootldr(&self) -> Option<&Device> {
+        self.find_partition_of_type(XBOOTLDR)
+            .filter(|part| part.fstype.as_deref() == Some("vfat"))
+    }
+
     /// Find the EFI System Partition (ESP) among children.
     ///
     /// For GPT disks, this matches by the ESP partition type GUID.
@@ -870,6 +897,30 @@ mod test {
         assert_eq!(bios.parttype.as_deref().unwrap(), BIOS_BOOT);
     }
 
+    #[test]
+    fn test_find_xbootldr() {
+        let disk = |xbootldr_fstype: &str| -> Device {
+            serde_json::from_value(serde_json::json!({
+                "name": "nvme0n1", "size": 512_110_190_592_u64, "pttype": "gpt",
+                "children": [
+                    {"name": "nvme0n1p1", "size": 104_857_600, "partn": 1, "parttype": ESP, "fstype": "vfat"},
+                    {"name": "nvme0n1p2", "size": 16_777_216, "partn": 2, "parttype": "e3c9e316-0b5c-4db8-817d-f92df00215ae"},
+                    {"name": "nvme0n1p3", "size": 250_000_000_000_u64, "partn": 3, "parttype": "ebd0a0a2-b9e5-4433-87c0-68b6b72699c7", "fstype": "ntfs"},
+                    {"name": "nvme0n1p4", "size": 2_147_483_648_u64, "partn": 4, "parttype": XBOOTLDR, "fstype": xbootldr_fstype},
+                ]
+            }))
+            .unwrap()
+        };
+        assert_eq!(
+            disk("vfat").find_partition_of_xbootldr().unwrap().partn,
+            Some(4)
+        );
+        assert!(disk("ext4").find_partition_of_xbootldr().is_none());
+        let dev: DevicesOutput =
+            serde_json::from_str(include_str!("../tests/fixtures/lsblk.json")).unwrap();
+        assert!(dev.blockdevices[0].find_partition_of_xbootldr().is_none());
+    }
+
