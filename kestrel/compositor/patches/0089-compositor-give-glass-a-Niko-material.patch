+    {
+      tint = meta_compositor_get_niko_tint (paint->compositor, &luminosity);
+      clutter_blur_add_niko_effect (pipeline, tint, luminosity);
+    }
+  else if (paint->material == META_GLASS_MATERIAL_SURFACE)
