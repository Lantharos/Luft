(type luft_nvpcr_t)
(roletype object_r luft_nvpcr_t)
(typeattributeset file_type (luft_nvpcr_t))
(typeattributeset non_security_file_type (luft_nvpcr_t))
(typeattributeset non_auth_file_type (luft_nvpcr_t))
(filecon "/run/systemd/nvpcr" dir (system_u object_r luft_nvpcr_t ((s0) (s0))))
(filecon "/run/systemd/nvpcr/.*" file (system_u object_r luft_nvpcr_t ((s0) (s0))))
(allow systemd_pcrextend_t luft_nvpcr_t (dir (getattr search open read)))
(allow systemd_pcrextend_t luft_nvpcr_t (file (getattr ioctl lock open read)))
(allow init_t luft_nvpcr_t (dir (getattr setattr search open read write add_name remove_name create rmdir relabelfrom relabelto)))
(allow init_t luft_nvpcr_t (file (getattr setattr ioctl lock open read write create rename unlink relabelfrom relabelto)))
