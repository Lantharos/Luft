<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE martif PUBLIC "ISO 12200:1999A//DTD MARTIF core (DXFcdV04)//EN" "TBXcdv04.dtd">
<martif type="TBX" xml:lang="en">
  <martifHeader>
    <fileDesc>
      <sourceDesc>
        <p>Luft glossary for ga</p>
      </sourceDesc>
    </fileDesc>
  </martifHeader>
  <text>
    <body>
      <termEntry id="1">
        <descrip type="Translation needed">No</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>Luft</term>
          </tig>
        </langSet>
        <langSet xml:lang="ga">
          <tig>
            <term>Luft</term>
            <note from="translator">Not translated. Name of the operating system; never mutated: ar Luft, do Luft</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="2">
        <descrip type="Translation needed">No</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>Kestrel</term>
          </tig>
        </langSet>
        <langSet xml:lang="ga">
          <tig>
            <term>Kestrel</term>
            <note from="translator">Not translated. Name of Luft's desktop</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="3">
        <descrip type="Translation needed">No</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>Rover</term>
          </tig>
        </langSet>
        <langSet xml:lang="ga">
          <tig>
            <term>Rover</term>
            <note from="translator">Not translated. App name, the file manager</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="4">
        <descrip type="Translation needed">No</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>Magpie</term>
          </tig>
        </langSet>
        <langSet xml:lang="ga">
          <tig>
            <term>Magpie</term>
            <note from="translator">Not translated. App name, the viewer for photos, videos, music and PDFs</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="5">
        <descrip type="Translation needed">No</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>Mailman</term>
          </tig>
        </langSet>
        <langSet xml:lang="ga">
          <tig>
            <term>Mailman</term>
            <note from="translator">Not translated. App name, the mail app</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="6">
        <descrip type="Translation needed">No</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>Draft</term>
          </tig>
        </langSet>
        <langSet xml:lang="ga">
          <tig>
            <term>Draft</term>
            <note from="translator">Not translated. App name, the text and code editor</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="7">
        <descrip type="Translation needed">No</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>Tern</term>
          </tig>
        </langSet>
        <langSet xml:lang="ga">
          <tig>
            <term>Tern</term>
            <note from="translator">Not translated. App name, the terminal</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="8">
        <descrip type="Translation needed">No</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>Schelf</term>
          </tig>
        </langSet>
        <langSet xml:lang="ga">
          <tig>
            <term>Schelf</term>
            <note from="translator">Not translated. App name, the app store</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="9">
        <descrip type="Translation needed">No</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>Barometer</term>
          </tig>
        </langSet>
        <langSet xml:lang="ga">
          <tig>
            <term>Barometer</term>
            <note from="translator">Not translated. App name, the system monitor</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="10">
        <descrip type="Translation needed">No</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>Keys</term>
          </tig>
        </langSet>
        <langSet xml:lang="ga">
          <tig>
            <term>Keys</term>
            <note from="translator">Not translated. App name, makes keyboard layouts and input methods</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="11">
        <descrip type="Translation needed">No</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>Meet Luft</term>
          </tig>
        </langSet>
        <langSet xml:lang="ga">
          <tig>
            <term>Meet Luft</term>
            <note from="translator">Not translated. Name of the Windows app that prepares a PC for Luft</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="12">
        <descrip type="Translation needed">No</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>Helium</term>
          </tig>
        </langSet>
        <langSet xml:lang="ga">
          <tig>
            <term>Helium</term>
            <note from="translator">Not translated. Name of the default browser</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="13">
        <descrip type="Translation needed">No</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>Flatpak</term>
          </tig>
        </langSet>
        <langSet xml:lang="ga">
          <tig>
            <term>Flatpak</term>
            <note from="translator">Not translated. App packaging format</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="14">
        <descrip type="Translation needed">No</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>Secure Boot</term>
          </tig>
        </langSet>
        <langSet xml:lang="ga">
          <tig>
            <term>Secure Boot</term>
            <note from="translator">Not translated. UEFI feature, named this way in every PC's firmware setup</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="15">
        <descrip type="Translation needed">No</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>TPM</term>
          </tig>
        </langSet>
        <langSet xml:lang="ga">
          <tig>
            <term>TPM</term>
            <note from="translator">Not translated. Trusted Platform Module; in the interface usually called the security chip</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="16">
        <descrip type="Translation needed">No</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>Bluetooth</term>
          </tig>
        </langSet>
        <langSet xml:lang="ga">
          <tig>
            <term>Bluetooth</term>
            <note from="translator">Not translated. Trademark</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="17">
        <langSet xml:lang="en">
          <tig>
            <term>Wi-Fi</term>
          </tig>
        </langSet>
        <langSet xml:lang="ga">
          <tig>
            <term>Wi-Fi</term>
            <note from="translator">Wireless network; masculine, never mutated</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="18">
        <langSet xml:lang="en">
          <tig>
            <term>Settings</term>
          </tig>
        </langSet>
        <langSet xml:lang="ga">
          <tig>
            <term>Socruithe</term>
            <note from="translator">App name and the general word for settings; plural, genitive plural socruithe: Socruithe taispeána</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="19">
        <langSet xml:lang="en">
          <tig>
            <term>Disks</term>
          </tig>
        </langSet>
        <langSet xml:lang="ga">
          <tig>
            <term>Dioscaí</term>
            <note from="translator">App name for the disk utility; plural of diosca</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="20">
        <langSet xml:lang="en">
          <tig>
            <term>Install Luft</term>
          </tig>
        </langSet>
        <langSet xml:lang="ga">
          <tig>
            <term>Suiteáil Luft</term>
            <note from="translator">App name of the installer</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="21">
        <langSet xml:lang="en">
          <tig>
            <term>Network Sign-In</term>
          </tig>
        </langSet>
        <langSet xml:lang="ga">
          <tig>
            <term>Síniú isteach ar líonra</term>
            <note from="translator">App that opens the sign-in page of a public Wi-Fi</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="22">
        <langSet xml:lang="en">
          <tig>
            <term>File Manager</term>
          </tig>
        </langSet>
        <langSet xml:lang="ga">
          <tig>
            <term>Bainisteoir comhad</term>
            <note from="translator">Generic name of Rover</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="23">
        <langSet xml:lang="en">
          <tig>
            <term>Media Viewer</term>
          </tig>
        </langSet>
        <langSet xml:lang="ga">
          <tig>
            <term>Amharcán meán</term>
            <note from="translator">Generic name of Magpie</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="24">
        <langSet xml:lang="en">
          <tig>
            <term>Mail</term>
          </tig>
        </langSet>
        <langSet xml:lang="ga">
          <tig>
            <term>Ríomhphost</term>
            <note from="translator">Generic name of Mailman</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="25">
        <langSet xml:lang="en">
          <tig>
            <term>Text Editor</term>
          </tig>
        </langSet>
        <langSet xml:lang="ga">
          <tig>
            <term>Eagarthóir téacs</term>
            <note from="translator">Generic name of Draft</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="26">
        <langSet xml:lang="en">
          <tig>
            <term>App Store</term>
          </tig>
        </langSet>
        <langSet xml:lang="ga">
          <tig>
            <term>Siopa aipeanna</term>
            <note from="translator">Generic name of Schelf</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="27">
        <langSet xml:lang="en">
          <tig>
            <term>System Monitor</term>
          </tig>
        </langSet>
        <langSet xml:lang="ga">
          <tig>
            <term>Monatóir córais</term>
            <note from="translator">Generic name of Barometer</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="28">
        <langSet xml:lang="en">
          <tig>
            <term>Keyboard Layouts</term>
          </tig>
        </langSet>
        <langSet xml:lang="ga">
          <tig>
            <term>Leaganacha amach méarchláir</term>
            <note from="translator">Generic name of Keys</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="29">
        <langSet xml:lang="en">
          <tig>
            <term>Start</term>
          </tig>
        </langSet>
        <langSet xml:lang="ga">
          <tig>
            <term>Tosaigh</term>
            <note from="translator">The menu opened with Super or the Luft mark; a name, as in Windows; never mutated; in sentences say an roghchlár Tosaigh, sa roghchlár Tosaigh</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="30">
        <langSet xml:lang="en">
          <tig>
            <term>board</term>
          </tig>
        </langSet>
        <langSet xml:lang="ga">
          <tig>
            <term>clár</term>
            <note from="translator">Mode that lays a workspace's windows side by side on an endless canvas; masculine, plural cláir, genitive an chláir</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="31">
        <langSet xml:lang="en">
          <tig>
            <term>Quick settings</term>
          </tig>
        </langSet>
        <langSet xml:lang="ga">
          <tig>
            <term>Socruithe tapa</term>
            <note from="translator">Panel of switches and sliders opened from the status icons; plural</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="32">
        <langSet xml:lang="en">
          <tig>
            <term>notification center</term>
          </tig>
        </langSet>
        <langSet xml:lang="ga">
          <tig>
            <term>ionad fógraí</term>
            <note from="translator">Panel with notifications, media and the calendar, opened from the clock; masculine, genitive an ionaid fógraí</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="33">
        <langSet xml:lang="en">
          <tig>
            <term>All windows</term>
          </tig>
        </langSet>
        <langSet xml:lang="ga">
          <tig>
            <term>Gach fuinneog</term>
            <note from="translator">The task view: every window of a workspace and the workspaces, Super+Tab</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="34">
        <langSet xml:lang="en">
          <tig>
            <term>snap</term>
          </tig>
        </langSet>
        <langSet xml:lang="ga">
          <tig>
            <term>snapáil</term>
            <note from="translator">verb and verbal noun: put a window into a half, third or quarter of the screen</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="35">
        <langSet xml:lang="en">
          <tig>
            <term>snap layout</term>
          </tig>
        </langSet>
        <langSet xml:lang="ga">
          <tig>
            <term>leagan amach snapála</term>
            <note from="translator">One of the arrangements offered by Super+Z; masculine</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="36">
        <langSet xml:lang="en">
          <tig>
            <term>snap group</term>
          </tig>
        </langSet>
        <langSet xml:lang="ga">
          <tig>
            <term>grúpa snapála</term>
            <note from="translator">Windows snapped side by side that come back together; masculine</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="37">
        <langSet xml:lang="en">
          <tig>
            <term>taskbar</term>
          </tig>
        </langSet>
        <langSet xml:lang="ga">
          <tig>
            <term>tascbharra</term>
            <note from="translator">The bar along the bottom of the screen; masculine, an tascbharra, ar an tascbharra</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="38">
        <langSet xml:lang="en">
          <tig>
            <term>tray</term>
          </tig>
        </langSet>
        <langSet xml:lang="ga">
          <tig>
            <term>tráidire</term>
            <note from="translator">Taskbar button holding the icons of apps running in the background; masculine, an tráidire</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="39">
        <langSet xml:lang="en">
          <tig>
            <term>status icons</term>
          </tig>
        </langSet>
        <langSet xml:lang="ga">
          <tig>
            <term>deilbhíní stádais</term>
            <note from="translator">Taskbar icons for network, sound and battery that open Quick settings; masculine plural</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="40">
        <langSet xml:lang="en">
          <tig>
            <term>lock screen</term>
          </tig>
        </langSet>
        <langSet xml:lang="ga">
          <tig>
            <term>scáileán glasála</term>
            <note from="translator">Screen shown while the session is locked; masculine, an scáileán glasála</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="41">
        <langSet xml:lang="en">
          <tig>
            <term>login screen</term>
          </tig>
        </langSet>
        <langSet xml:lang="ga">
          <tig>
            <term>scáileán sínithe isteach</term>
            <note from="translator">Screen listing the people on the computer before anyone signs in; masculine</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="42">
        <langSet xml:lang="en">
          <tig>
            <term>workspace</term>
          </tig>
        </langSet>
        <langSet xml:lang="ga">
          <tig>
            <term>spás oibre</term>
            <note from="translator">One of up to ten separate desktops; masculine, plural spásanna oibre</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="43">
        <langSet xml:lang="en">
          <tig>
            <term>desktop</term>
          </tig>
        </langSet>
        <langSet xml:lang="ga">
          <tig>
            <term>deasc</term>
            <note from="translator">The background area behind the windows; also the whole desktop environment; feminine, an deasc</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="44">
        <langSet xml:lang="en">
          <tig>
            <term>wallpaper</term>
          </tig>
        </langSet>
        <langSet xml:lang="ga">
          <tig>
            <term>cúlbhrat</term>
            <note from="translator">Picture behind the desktop; masculine, an cúlbhrat</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="45">
        <langSet xml:lang="en">
          <tig>
            <term>accent color</term>
          </tig>
        </langSet>
        <langSet xml:lang="ga">
          <tig>
            <term>dath béime</term>
            <note from="translator">Color taken from the wallpaper and used for highlights; masculine</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="46">
        <langSet xml:lang="en">
          <tig>
            <term>dark style</term>
          </tig>
        </langSet>
        <langSet xml:lang="ga">
          <tig>
            <term>Stíl dhorcha</term>
            <note from="translator">Quick settings tile and running text for the dark look; feminine, an stíl dhorcha, light style an stíl gheal</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="47">
        <langSet xml:lang="en">
          <tig>
            <term>Night light</term>
          </tig>
        </langSet>
        <langSet xml:lang="ga">
          <tig>
            <term>Solas oíche</term>
            <note from="translator">Warmer screen colors in the evening; masculine</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="48">
        <langSet xml:lang="en">
          <tig>
            <term>Do Not Disturb</term>
          </tig>
        </langSet>
        <langSet xml:lang="ga">
          <tig>
            <term>Ná cuir isteach orm</term>
            <note from="translator">Holds back notification banners and sounds</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="49">
        <langSet xml:lang="en">
          <tig>
            <term>Airplane mode</term>
          </tig>
        </langSet>
        <langSet xml:lang="ga">
          <tig>
            <term>Mód eitleáin</term>
            <note from="translator">Turns off every radio; masculine</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="50">
        <langSet xml:lang="en">
          <tig>
            <term>Keep awake</term>
          </tig>
        </langSet>
        <langSet xml:lang="ga">
          <tig>
            <term>Coinnigh múscailte</term>
            <note from="translator">Keeps the screen on for a while</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="51">
        <langSet xml:lang="en">
          <tig>
            <term>Power mode</term>
          </tig>
        </langSet>
        <langSet xml:lang="ga">
          <tig>
            <term>Mód cumhachta</term>
            <note from="translator">Performance, Balanced or Power saver; masculine</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="52">
        <langSet xml:lang="en">
          <tig>
            <term>Power saver</term>
          </tig>
        </langSet>
        <langSet xml:lang="ga">
          <tig>
            <term>Coigilteoir cumhachta</term>
            <note from="translator">Power mode; masculine</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="53">
        <langSet xml:lang="en">
          <tig>
            <term>Dictation</term>
          </tig>
        </langSet>
        <langSet xml:lang="ga">
          <tig>
            <term>Deachtú</term>
            <note from="translator">Typing by speaking; masculine verbal noun, genitive deachtaithe</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="54">
        <langSet xml:lang="en">
          <tig>
            <term>clipboard</term>
          </tig>
        </langSet>
        <langSet xml:lang="ga">
          <tig>
            <term>gearrthaisce</term>
            <note from="translator">Holds what was copied; feminine, an ghearrthaisce, genitive na gearrthaisce</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="55">
        <langSet xml:lang="en">
          <tig>
            <term>clipboard history</term>
          </tig>
        </langSet>
        <langSet xml:lang="ga">
          <tig>
            <term>stair na gearrthaisce</term>
            <note from="translator">List of recently copied items, Super+V</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="56">
        <langSet xml:lang="en">
          <tig>
            <term>emoji</term>
          </tig>
        </langSet>
        <langSet xml:lang="ga">
          <tig>
            <term>emoji</term>
            <note from="translator">noun; masculine, plural emojithe</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="57">
        <langSet xml:lang="en">
          <tig>
            <term>screenshot</term>
          </tig>
        </langSet>
        <langSet xml:lang="ga">
          <tig>
            <term>gabháil scáileáin</term>
            <note from="translator">Picture of the screen; feminine, plural gabhálacha scáileáin</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="58">
        <langSet xml:lang="en">
          <tig>
            <term>screen recording</term>
          </tig>
        </langSet>
        <langSet xml:lang="ga">
          <tig>
            <term>taifeadadh scáileáin</term>
            <note from="translator">Video of the screen; masculine</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="59">
        <langSet xml:lang="en">
          <tig>
            <term>privacy indicator</term>
          </tig>
        </langSet>
        <langSet xml:lang="ga">
          <tig>
            <term>táscaire príobháideachais</term>
            <note from="translator">Taskbar icon shown while the camera, microphone, location or screen is in use; masculine</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="60">
        <langSet xml:lang="en">
          <tig>
            <term>Full access</term>
          </tig>
        </langSet>
        <langSet xml:lang="ga">
          <tig>
            <term>Rochtain iomlán</term>
