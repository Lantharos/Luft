# Settings page titles, shown in the Settings sidebar and in Start search results.
# Each page's .keywords are search terms, separated by commas. Translate them into
# the words people would type when looking for the page; they never show on screen.
# .copilot-key holds extra search terms used only on computers with a Copilot key.

## Panels

settings-page-network = Network
    .keywords = wifi, wireless, ethernet, wired, vpn, internet, airplane, proxy, dns, ip address, hardware address, metered
settings-page-bluetooth = Bluetooth
    .keywords = devices, pair, headphones, speaker, visible, discoverable
settings-page-display = Displays
    .keywords = monitor, screen, resolution, scale, refresh rate, night light, arrangement, brightness
settings-page-sound = Sound
    .keywords = audio, volume, speakers, microphone, output, input, alerts
settings-page-power = Power & Battery
    .keywords = battery, sleep, suspend, power mode, screen blank, lid, charge limit
settings-page-appearance = Appearance
    .keywords = wallpaper, background, dark, light, style, accent, app icons, tinted, cursor, pointer, mouse pointer, cursor size, text size, animations, fonts, typefaces, install fonts
settings-page-notifications = Notifications
