## Fingerprints
## Each finger has a name used as a title (the message value) and a form used inside
## a sentence (.inline), like "Place your … on the sensor." Adjust the case of .inline
## to fit those sentences.

ui-finger-right-index = Rechter Zeigefinger
    .inline = rechten Zeigefinger
ui-finger-left-index = Linker Zeigefinger
    .inline = linken Zeigefinger
ui-finger-right-thumb = Rechter Daumen
    .inline = rechten Daumen
ui-finger-left-thumb = Linker Daumen
    .inline = linken Daumen
ui-finger-right-middle = Rechter Mittelfinger
    .inline = rechten Mittelfinger
ui-finger-left-middle = Linker Mittelfinger
    .inline = linken Mittelfinger
ui-finger-right-ring = Rechter Ringfinger
    .inline = rechten Ringfinger
ui-finger-left-ring = Linker Ringfinger
    .inline = linken Ringfinger
ui-finger-right-little = Rechter kleiner Finger
    .inline = rechten kleinen Finger
ui-finger-left-little = Linker kleiner Finger
    .inline = linken kleinen Finger

ui-fingerprint-place = Leg deinen { $finger } auf den Sensor.
ui-fingerprint-swipe = Zieh deinen { $finger } über den Sensor.
ui-fingerprint-stage-passed = Gut. Heb den Finger an und leg ihn wieder auf.
ui-fingerprint-stage-passed-swipe = Gut. Zieh noch einmal.
ui-fingerprint-retry = Das wurde nicht gut erkannt. Versuch es noch einmal.
ui-fingerprint-swipe-too-short = Zieh etwas langsamer.
ui-fingerprint-not-centered = Leg den Finger mittig auf den Sensor.
ui-fingerprint-remove-and-retry = Heb den Finger an und versuch es noch einmal.
ui-fingerprint-added = Fingerabdruck hinzugefügt.
ui-fingerprint-full = Auf dem Sensor ist kein Platz mehr für einen weiteren Fingerabdruck.
ui-fingerprint-disconnected = Der Fingerabdrucksensor reagiert nicht mehr. Versuch es gleich noch einmal.
ui-fingerprint-duplicate = Dieser Finger ist auf dem Sensor bereits gespeichert, wahrscheinlich von Windows oder einem anderen Konto. Verwende einen anderen Finger.
ui-fingerprint-failed = Dieser Fingerabdruck konnte nicht hinzugefügt werden. Versuch es noch einmal.

