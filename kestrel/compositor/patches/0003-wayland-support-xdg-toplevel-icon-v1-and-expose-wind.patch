diff --git a/src/wayland/meta-wayland-toplevel-icon.c b/src/wayland/meta-wayland-toplevel-icon.c
new file mode 100644
index 0000000000000000000000000000000000000000..495eb2727bc018d6a4373abc2c6cd6d5d6dc2591
--- /dev/null
+++ b/src/wayland/meta-wayland-toplevel-icon.c
@@ -0,0 +1,259 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "config.h"
+
+#include <wayland-server-core.h>
+
+#include "wayland/meta-wayland-toplevel-icon.h"
+#include "wayland/meta-wayland-icon-pixels.h"
+#include "wayland/meta-wayland-private.h"
+#include "wayland/meta-wayland-surface-private.h"
+#include "wayland/meta-wayland-xdg-shell.h"
+#include "xdg-toplevel-icon-v1-server-protocol.h"
+
+typedef struct
+{
+  struct wl_resource *resource;
+  MetaWaylandCompositor *compositor;
+  char *name;
+  GPtrArray *buffers;
+  GIcon *icon;
+  gboolean immutable;
+} ToplevelIcon;
+
+typedef struct
+{
+  ToplevelIcon *icon;
+  struct wl_resource *resource;
+  struct wl_listener destroy_listener;
+  int size;
+  int scale;
+} IconBuffer;
+
+static void
+buffer_destroyed (struct wl_listener *listener,
+                  void               *data)
+{
+  IconBuffer *buffer = wl_container_of (listener, buffer, destroy_listener);
+
+  wl_list_remove (&buffer->destroy_listener.link);
+  wl_list_init (&buffer->destroy_listener.link);
+  buffer->resource = NULL;
+  wl_resource_post_error (buffer->icon->resource, XDG_TOPLEVEL_ICON_V1_ERROR_NO_BUFFER,
+                           "Icon buffer destroyed before its icon");
+}
+
+static void
+icon_buffer_free (gpointer data)
+{
+  IconBuffer *buffer = data;
+
+  wl_list_remove (&buffer->destroy_listener.link);
+  g_free (buffer);
+}
+
+static void
+icon_free (struct wl_resource *resource)
+{
+  ToplevelIcon *icon = wl_resource_get_user_data (resource);
+
+  g_ptr_array_unref (icon->buffers);
+  g_clear_object (&icon->icon);
+  g_free (icon->name);
+  g_free (icon);
+}
+
+static void
+destroy_resource (struct wl_client   *client,
+                  struct wl_resource *resource)
+{
+  wl_resource_destroy (resource);
+}
+
+static gboolean
+icon_is_mutable (ToplevelIcon *icon)
+{
+  if (!icon->immutable)
+    return TRUE;
+
+  wl_resource_post_error (icon->resource, XDG_TOPLEVEL_ICON_V1_ERROR_IMMUTABLE,
+                           "Cannot change an assigned toplevel icon");
+  return FALSE;
+}
+
+static void
+icon_set_name (struct wl_client   *client,
+               struct wl_resource *resource,
+               const char         *name)
+{
+  ToplevelIcon *icon = wl_resource_get_user_data (resource);
+
+  if (!icon_is_mutable (icon))
+    return;
+  g_free (icon->name);
+  icon->name = g_strdup (name);
+}
+
+static void
+icon_add_buffer (struct wl_client   *client,
+                 struct wl_resource *resource,
+                 struct wl_resource *buffer_resource,
+                 int32_t             scale)
+{
+  ToplevelIcon *icon = wl_resource_get_user_data (resource);
+  struct wl_shm_buffer *shm;
+  IconBuffer *buffer;
+  int size;
+
+  if (!icon_is_mutable (icon))
+    return;
+  shm = wl_shm_buffer_get (buffer_resource);
+  if (!shm || scale <= 0 || wl_shm_buffer_get_width (shm) != wl_shm_buffer_get_height (shm))
+    {
+      wl_resource_post_error (resource, XDG_TOPLEVEL_ICON_V1_ERROR_INVALID_BUFFER,
+                               "Icon buffers must be square wl_shm buffers with a positive scale");
+      return;
+    }
+  size = wl_shm_buffer_get_width (shm);
+  for (guint i = 0; i < icon->buffers->len; i++)
+    {
+      IconBuffer *previous = g_ptr_array_index (icon->buffers, i);
+      if (previous->size == size && previous->scale == scale)
+        {
+          g_ptr_array_remove_index (icon->buffers, i);
+          break;
+        }
+    }
+  buffer = g_new0 (IconBuffer, 1);
+  buffer->icon = icon;
+  buffer->resource = buffer_resource;
+  buffer->size = size;
+  buffer->scale = scale;
+  buffer->destroy_listener.notify = buffer_destroyed;
+  wl_resource_add_destroy_listener (buffer_resource, &buffer->destroy_listener);
+  g_ptr_array_add (icon->buffers, buffer);
+}
+
+static const struct xdg_toplevel_icon_v1_interface icon_implementation = {
+  .destroy = destroy_resource,
+  .set_name = icon_set_name,
+  .add_buffer = icon_add_buffer,
+};
+
+static void
+manager_create_icon (struct wl_client   *client,
+                     struct wl_resource *resource,
+                     uint32_t            id)
+{
+  ToplevelIcon *icon = g_new0 (ToplevelIcon, 1);
+
+  icon->resource = wl_resource_create (client, &xdg_toplevel_icon_v1_interface, 1, id);
+  if (!icon->resource)
+    {
+      g_free (icon);
+      wl_client_post_no_memory (client);
+      return;
+    }
+  icon->compositor = wl_resource_get_user_data (resource);
+  icon->buffers = g_ptr_array_new_with_free_func (icon_buffer_free);
+  wl_resource_set_implementation (icon->resource, &icon_implementation, icon, icon_free);
+}
+
+static int64_t
+buffer_score (IconBuffer *buffer)
+{
+  int64_t logical_size = buffer->size / buffer->scale;
+
+  return ABS (logical_size - 128) * 1024 - MIN (buffer->size, 512);
+}
+
+static gboolean
+resolve_icon (ToplevelIcon *icon)
+{
+  IconBuffer *best = NULL;
+
+  if (icon->immutable)
+    return TRUE;
+  icon->immutable = TRUE;
+  for (guint i = 0; i < icon->buffers->len; i++)
+    {
+      IconBuffer *buffer = g_ptr_array_index (icon->buffers, i);
+      if (!buffer->resource)
+        return FALSE;
+      if (!best || buffer_score (buffer) < buffer_score (best))
+        best = buffer;
+    }
+  if (best)
+    {
+      g_autoptr (GError) error = NULL;
+
+      icon->icon = meta_wayland_icon_pixels_new (icon->compositor, best->resource, &error);
+      if (!icon->icon)
+        {
+          wl_resource_post_error (icon->resource, XDG_TOPLEVEL_ICON_V1_ERROR_INVALID_BUFFER,
+                                   "Cannot read icon buffer: %s", error ? error->message : "unavailable storage");
+          return FALSE;
+        }
+    }
+  else if (icon->name && *icon->name)
+    {
+      icon->icon = g_themed_icon_new (icon->name);
+    }
+  return TRUE;
+}
+
+static void
+manager_set_icon (struct wl_client   *client,
+                  struct wl_resource *resource,
+                  struct wl_resource *toplevel_resource,
+                  struct wl_resource *icon_resource)
+{
+  MetaWaylandXdgToplevel *toplevel = wl_resource_get_user_data (toplevel_resource);
+  MetaWaylandSurface *surface;
+  MetaWaylandSurfaceState *pending;
+  ToplevelIcon *icon = icon_resource ? wl_resource_get_user_data (icon_resource) : NULL;
+
+  if (icon && !resolve_icon (icon))
+    return;
+  if (!toplevel)
+    return;
+  surface = meta_wayland_surface_role_get_surface (META_WAYLAND_SURFACE_ROLE (toplevel));
+  pending = meta_wayland_surface_get_pending_state (surface);
+  g_set_object (&pending->toplevel_icon, (icon ? icon->icon : NULL));
+  pending->toplevel_icon_set = TRUE;
+}
+
+static const struct xdg_toplevel_icon_manager_v1_interface manager_implementation = {
+  .destroy = destroy_resource,
+  .create_icon = manager_create_icon,
+  .set_icon = manager_set_icon,
+};
+
+static void
+bind_manager (struct wl_client *client,
+              void             *data,
+              uint32_t          version,
+              uint32_t          id)
+{
+  struct wl_resource *resource =
+    wl_resource_create (client, &xdg_toplevel_icon_manager_v1_interface, version, id);
+
+  if (!resource)
+    {
+      wl_client_post_no_memory (client);
+      return;
+    }
+  wl_resource_set_implementation (resource, &manager_implementation, data, NULL);
+  xdg_toplevel_icon_manager_v1_send_icon_size (resource, 32);
+  xdg_toplevel_icon_manager_v1_send_icon_size (resource, 64);
+  xdg_toplevel_icon_manager_v1_send_icon_size (resource, 128);
+  xdg_toplevel_icon_manager_v1_send_done (resource);
+}
+
+void
+meta_wayland_init_toplevel_icon (MetaWaylandCompositor *compositor)
+{
+  if (!wl_global_create (compositor->wayland_display,
+                         &xdg_toplevel_icon_manager_v1_interface, 1,
+                         compositor, bind_manager))
+    g_error ("Cannot register xdg-toplevel-icon-v1");
+}
