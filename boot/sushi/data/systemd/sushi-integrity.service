[Unit]
Description=Stop before the login screen when a system file doesn't match this version
Documentation=https://github.com/Lantharos/Luft/blob/main/docs/boot.md#when-luft-cant-start
DefaultDependencies=no
After=sysinit.target
Before=display-manager.service greetd.service
ConditionPathExists=!/etc/initrd-release
OnFailure=emergency.target
OnFailureJobMode=replace-irreversibly

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/sushictl check-files
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=disconnected
PrivateNetwork=yes
NoNewPrivileges=yes
DevicePolicy=closed
DeviceAllow=/dev/kmsg r
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
CapabilityBoundingSet=CAP_SYSLOG

[Install]
WantedBy=multi-user.target
