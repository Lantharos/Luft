[Unit]
Description=Tell Meet Luft how full Luft is, and change Luft's size the way it asked from Windows
After=local-fs.target dbus.service
ConditionPathExists=/sys/firmware/efi/efivars
ConditionKernelCommandLine=!rd.live.image

[Service]
Type=exec
ExecStart=/usr/libexec/luft-installer resize
SELinuxContext=system_u:system_r:install_t:s0
SyslogIdentifier=luft-installer
TimeoutStopSec=1min

[Install]
WantedBy=multi-user.target
