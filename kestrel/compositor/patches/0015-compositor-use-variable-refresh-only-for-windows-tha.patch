diff --git a/src/wayland/meta-wayland-content-type.c b/src/wayland/meta-wayland-content-type.c
new file mode 100644
index 0000000000000000000000000000000000000000..8cc2b2c1711ac4b142ba9549008e20c05520b926
--- /dev/null
+++ b/src/wayland/meta-wayland-content-type.c
@@ -0,0 +1,171 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "config.h"
+
+#include "wayland/meta-wayland-content-type.h"
+
+#include <wayland-server.h>
+
+#include "content-type-v1-server-protocol.h"
+#include "wayland/meta-wayland-private.h"
+#include "wayland/meta-wayland-surface-private.h"
+#include "wayland/meta-wayland-versions.h"
+
+#define CONTENT_TYPE_DATA "-meta-wayland-content-type"
+
+typedef struct _MetaWaylandContentType
+{
+  MetaWaylandSurface *surface;
+  gulong destroy_handler_id;
+} MetaWaylandContentType;
+
+static MetaWindowContentType
+window_content_type (uint32_t type)
+{
+  switch (type)
+    {
+    case WP_CONTENT_TYPE_V1_TYPE_PHOTO:
+      return META_WINDOW_CONTENT_TYPE_PHOTO;
+    case WP_CONTENT_TYPE_V1_TYPE_VIDEO:
+      return META_WINDOW_CONTENT_TYPE_VIDEO;
+    case WP_CONTENT_TYPE_V1_TYPE_GAME:
+      return META_WINDOW_CONTENT_TYPE_GAME;
+    default:
+      return META_WINDOW_CONTENT_TYPE_NONE;
+    }
+}
+
+static void
+set_pending_content_type (MetaWaylandSurface    *surface,
+                          MetaWindowContentType  content_type)
+{
+  MetaWaylandSurfaceState *pending =
+    meta_wayland_surface_get_pending_state (surface);
+
+  pending->has_new_content_type = TRUE;
+  pending->content_type = content_type;
+}
+
+static void
+content_type_destructor (struct wl_resource *resource)
+{
+  MetaWaylandContentType *content_type = wl_resource_get_user_data (resource);
+
+  if (content_type->surface)
+    {
+      set_pending_content_type (content_type->surface,
+                                META_WINDOW_CONTENT_TYPE_NONE);
+      g_object_set_data (G_OBJECT (content_type->surface),
+                         CONTENT_TYPE_DATA, NULL);
+      g_clear_signal_handler (&content_type->destroy_handler_id,
+                              content_type->surface);
+    }
+
+  g_free (content_type);
+}
+
+static void
+content_type_destroy (struct wl_client   *client,
+                      struct wl_resource *resource)
+{
+  wl_resource_destroy (resource);
+}
+
+static void
+content_type_set_content_type (struct wl_client   *client,
+                               struct wl_resource *resource,
+                               uint32_t            type)
+{
+  MetaWaylandContentType *content_type = wl_resource_get_user_data (resource);
+
+  if (content_type->surface)
+    set_pending_content_type (content_type->surface, window_content_type (type));
+}
+
+static const struct wp_content_type_v1_interface meta_wayland_content_type_interface =
+{
+  content_type_destroy,
+  content_type_set_content_type,
+};
+
+static void
+on_surface_destroyed (MetaWaylandSurface     *surface,
+                      MetaWaylandContentType *content_type)
+{
+  content_type->surface = NULL;
+}
+
+static void
+manager_destroy (struct wl_client   *client,
+                 struct wl_resource *resource)
+{
+  wl_resource_destroy (resource);
+}
+
+static void
+manager_get_surface_content_type (struct wl_client   *client,
+                                  struct wl_resource *resource,
+                                  uint32_t            id,
+                                  struct wl_resource *surface_resource)
+{
+  MetaWaylandSurface *surface = wl_resource_get_user_data (surface_resource);
+  MetaWaylandContentType *content_type;
+  struct wl_resource *content_type_resource;
+
+  if (g_object_get_data (G_OBJECT (surface), CONTENT_TYPE_DATA))
+    {
+      wl_resource_post_error (resource,
+                              WP_CONTENT_TYPE_MANAGER_V1_ERROR_ALREADY_CONSTRUCTED,
+                              "The surface already has a content type object");
+      return;
+    }
+
+  content_type_resource = wl_resource_create (client,
+                                              &wp_content_type_v1_interface,
+                                              wl_resource_get_version (resource),
+                                              id);
+
+  content_type = g_new0 (MetaWaylandContentType, 1);
+  content_type->surface = surface;
+  content_type->destroy_handler_id =
+    g_signal_connect (surface, "destroy",
+                      G_CALLBACK (on_surface_destroyed), content_type);
+  g_object_set_data (G_OBJECT (surface), CONTENT_TYPE_DATA, content_type);
+
+  wl_resource_set_implementation (content_type_resource,
+                                  &meta_wayland_content_type_interface,
+                                  content_type,
+                                  content_type_destructor);
+}
+
+static const struct wp_content_type_manager_v1_interface meta_wayland_content_type_manager_interface =
+{
+  manager_destroy,
+  manager_get_surface_content_type,
+};
+
+static void
+bind_content_type_manager (struct wl_client *client,
+                           void             *data,
+                           uint32_t          version,
+                           uint32_t          id)
+{
+  struct wl_resource *resource;
+
+  resource = wl_resource_create (client,
+                                 &wp_content_type_manager_v1_interface,
+                                 version, id);
+  wl_resource_set_implementation (resource,
+                                  &meta_wayland_content_type_manager_interface,
+                                  NULL, NULL);
+}
+
+void
+meta_wayland_init_content_type (MetaWaylandCompositor *compositor)
+{
+  if (!wl_global_create (compositor->wayland_display,
+                         &wp_content_type_manager_v1_interface,
+                         META_WP_CONTENT_TYPE_V1_VERSION,
+                         NULL,
+                         bind_content_type_manager))
+    g_error ("Failed to register a global content type object");
+}
