## Fingerprints
## Each finger has a name used as a title (the message value) and a form used inside
## a sentence (.inline), like "Place your … on the sensor." Adjust the case of .inline
## to fit those sentences.

ui-finger-right-index = Prawy palec wskazujący
    .inline = prawy palec wskazujący
ui-finger-left-index = Lewy palec wskazujący
    .inline = lewy palec wskazujący
ui-finger-right-thumb = Prawy kciuk
    .inline = prawy kciuk
ui-finger-left-thumb = Lewy kciuk
    .inline = lewy kciuk
ui-finger-right-middle = Prawy palec środkowy
    .inline = prawy palec środkowy
ui-finger-left-middle = Lewy palec środkowy
    .inline = lewy palec środkowy
ui-finger-right-ring = Prawy palec serdeczny
    .inline = prawy palec serdeczny
ui-finger-left-ring = Lewy palec serdeczny
    .inline = lewy palec serdeczny
ui-finger-right-little = Prawy mały palec
    .inline = prawy mały palec
ui-finger-left-little = Lewy mały palec
    .inline = lewy mały palec

ui-fingerprint-place = Przyłóż { $finger } do czytnika.
ui-fingerprint-swipe = Przesuń { $finger } po czytniku.
ui-fingerprint-stage-passed = Dobrze. Unieś palec i przyłóż go ponownie.
ui-fingerprint-stage-passed-swipe = Dobrze. Przesuń jeszcze raz.
ui-fingerprint-retry = Nie udało się dobrze odczytać. Spróbuj ponownie.
ui-fingerprint-swipe-too-short = Przesuń palec trochę wolniej.
ui-fingerprint-not-centered = Przyłóż palec na środku czytnika.
ui-fingerprint-remove-and-retry = Unieś palec i spróbuj ponownie.
ui-fingerprint-added = Dodano odcisk palca.
ui-fingerprint-full = W czytniku nie ma już miejsca na kolejny odcisk palca.
ui-fingerprint-disconnected = Czytnik linii papilarnych przestał odpowiadać. Spróbuj ponownie za chwilę.
ui-fingerprint-duplicate = Ten palec jest już zapisany w czytniku, prawdopodobnie przez system Windows lub inne konto. Użyj innego palca.
ui-fingerprint-failed = Nie udało się dodać tego odcisku palca. Spróbuj ponownie.

