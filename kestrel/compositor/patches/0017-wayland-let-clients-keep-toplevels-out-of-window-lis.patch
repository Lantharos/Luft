+
+#include "config.h"
+
+#include "wayland/meta-wayland-kestrel-window.h"
+
+#include "core/window-private.h"
+#include "wayland/meta-wayland-private.h"
+#include "wayland/meta-wayland-versions.h"
+#include "wayland/meta-wayland-xdg-shell.h"
+
+#include "kestrel-window-v1-server-protocol.h"
+
+static GQuark quark_window_state_data = 0;
+
+typedef struct _MetaWaylandKestrelWindowState
+{
+  struct wl_resource *resource;
+  MetaWaylandXdgSurface *toplevel;
+  MetaDisplay *display;
+  gulong window_created_handler_id;
+  gboolean skip_window_list;
+  gboolean keep_above;
+} MetaWaylandKestrelWindowState;
+
+struct _MetaWaylandKestrelWindowManager
+{
+  GObject parent;
+  MetaWaylandCompositor *compositor;
+};
+
+#define META_TYPE_WAYLAND_KESTREL_WINDOW_MANAGER \
+  (meta_wayland_kestrel_window_manager_get_type ())
+G_DECLARE_FINAL_TYPE (MetaWaylandKestrelWindowManager,
+                      meta_wayland_kestrel_window_manager,
+                      META, WAYLAND_KESTREL_WINDOW_MANAGER, GObject)
+
+G_DEFINE_TYPE (MetaWaylandKestrelWindowManager,
+               meta_wayland_kestrel_window_manager,
+               G_TYPE_OBJECT)
+
+static MetaWindow *
+window_of (MetaWaylandKestrelWindowState *state)
+{
+  MetaWaylandSurface *surface;
+
+  if (!state->toplevel)
+    return NULL;
+
+  surface = meta_wayland_surface_role_get_surface (
+    META_WAYLAND_SURFACE_ROLE (state->toplevel));
+  return meta_wayland_surface_get_window (surface);
+}
+
+static void
+apply_skip_window_list (MetaWindow *window,
+                        gboolean    skip)
+{
+  if (skip)
+    meta_window_hide_from_window_list (window);
+  else
+    meta_window_show_in_window_list (window);
+}
+
+static void
+apply_keep_above (MetaWindow *window,
+                  gboolean    above)
+{
+  if (meta_window_is_above (window) == above)
+    return;
+
+  if (above)
+    meta_window_make_above (window);
+  else
+    meta_window_unmake_above (window);
+}
+
+static void
+update_skip_window_list (MetaWaylandKestrelWindowState *state,
+                         gboolean                       skip)
+{
+  MetaWindow *window = window_of (state);
+
+  state->skip_window_list = skip;
+  if (window)
+    apply_skip_window_list (window, skip);
+}
+
+static void
+update_keep_above (MetaWaylandKestrelWindowState *state,
+                   gboolean                       above)
+{
+  MetaWindow *window = window_of (state);
+
+  state->keep_above = above;
+  if (window)
+    apply_keep_above (window, above);
+}
+
+static void
+on_window_created (MetaDisplay                   *display,
+                   MetaWindow                    *window,
+                   MetaWaylandKestrelWindowState *state)
+{
+  if (window != window_of (state))
+    return;
+
+  if (state->skip_window_list)
+    apply_skip_window_list (window, TRUE);
+  if (state->keep_above)
+    apply_keep_above (window, TRUE);
+}
+
+static void
+window_state_destructor (struct wl_resource *resource)
+{
+  MetaWaylandKestrelWindowState *state = wl_resource_get_user_data (resource);
+
+  if (state->toplevel)
+    {
+      if (state->skip_window_list)
+        update_skip_window_list (state, FALSE);
+      if (state->keep_above)
+        update_keep_above (state, FALSE);
+      g_object_steal_qdata (G_OBJECT (state->toplevel),
+                            quark_window_state_data);
+    }
+
+  g_clear_signal_handler (&state->window_created_handler_id, state->display);
+  g_free (state);
+}
+
+static void
+window_state_destroy (struct wl_client   *client,
+                      struct wl_resource *resource)
+{
+  wl_resource_destroy (resource);
+}
+
+static void
+window_state_set_skip_window_list (struct wl_client   *client,
+                                   struct wl_resource *resource)
+{
+  update_skip_window_list (wl_resource_get_user_data (resource), TRUE);
+}
+
+static void
+window_state_unset_skip_window_list (struct wl_client   *client,
+                                     struct wl_resource *resource)
+{
+  update_skip_window_list (wl_resource_get_user_data (resource), FALSE);
+}
+
+static void
+window_state_set_keep_above (struct wl_client   *client,
+                             struct wl_resource *resource)
+{
+  update_keep_above (wl_resource_get_user_data (resource), TRUE);
+}
+
+static void
+window_state_unset_keep_above (struct wl_client   *client,
+                               struct wl_resource *resource)
+{
+  update_keep_above (wl_resource_get_user_data (resource), FALSE);
+}
+
+static const struct kestrel_window_state_v1_interface
+  meta_wayland_kestrel_window_state_interface = {
+  window_state_destroy,
+  window_state_set_skip_window_list,
+  window_state_unset_skip_window_list,
+  window_state_set_keep_above,
+  window_state_unset_keep_above,
+};
+
+static void
+window_state_toplevel_destroyed (MetaWaylandKestrelWindowState *state)
+{
+  state->toplevel = NULL;
+}
+
+static void
+window_manager_destroy (struct wl_client   *client,
+                        struct wl_resource *resource)
+{
+  wl_resource_destroy (resource);
+}
+
+static void
+window_manager_get_window_state (struct wl_client   *client,
+                                 struct wl_resource *resource,
+                                 uint32_t            id,
+                                 struct wl_resource *toplevel_resource)
+{
+  MetaWaylandKestrelWindowManager *manager =
+    wl_resource_get_user_data (resource);
+  MetaWaylandXdgSurface *toplevel =
+    wl_resource_get_user_data (toplevel_resource);
+  MetaWaylandKestrelWindowState *state;
+
+  if (g_object_get_qdata (G_OBJECT (toplevel), quark_window_state_data))
+    {
+      wl_resource_post_error (resource,
+                              KESTREL_WINDOW_MANAGER_V1_ERROR_ALREADY_REQUESTED,
+                              "kestrel_window_manager_v1::get_window_state already requested");
+      return;
+    }
+
+  state = g_new0 (MetaWaylandKestrelWindowState, 1);
+  state->toplevel = toplevel;
+  state->display = meta_context_get_display (manager->compositor->context);
+  state->resource = wl_resource_create (client,
+                                        &kestrel_window_state_v1_interface,
+                                        wl_resource_get_version (resource),
+                                        id);
+  wl_resource_set_implementation (state->resource,
+                                  &meta_wayland_kestrel_window_state_interface,
+                                  state, window_state_destructor);
+  state->window_created_handler_id =
+    g_signal_connect (state->display, "window-created",
+                      G_CALLBACK (on_window_created), state);
+
+  g_object_set_qdata_full (G_OBJECT (toplevel),
+                           quark_window_state_data,
+                           state,
+                           (GDestroyNotify) window_state_toplevel_destroyed);
+}
+
+static const struct kestrel_window_manager_v1_interface
+  meta_wayland_kestrel_window_manager_interface = {
+  window_manager_destroy,
+  window_manager_get_window_state,
+};
+
+static void
+bind_kestrel_window_manager (struct wl_client *client,
+                             void             *data,
+                             uint32_t          version,
+                             uint32_t          id)
+{
+  struct wl_resource *resource;
+
+  resource = wl_resource_create (client, &kestrel_window_manager_v1_interface,
+                                 version, id);
+  wl_resource_set_implementation (resource,
+                                  &meta_wayland_kestrel_window_manager_interface,
+                                  data, NULL);
+}
+
+static void
+meta_wayland_kestrel_window_manager_init (MetaWaylandKestrelWindowManager *manager)
+{
+}
+
+static void
+meta_wayland_kestrel_window_manager_class_init (MetaWaylandKestrelWindowManagerClass *klass)
+{
+  quark_window_state_data =
+    g_quark_from_static_string ("-meta-wayland-kestrel-window-state-data");
+}
+
+static MetaWaylandKestrelWindowManager *
+meta_wayland_kestrel_window_manager_new (MetaWaylandCompositor *compositor)
+{
+  MetaWaylandKestrelWindowManager *manager;
+
+  manager = g_object_new (META_TYPE_WAYLAND_KESTREL_WINDOW_MANAGER, NULL);
+  manager->compositor = compositor;
+
+  if (wl_global_create (compositor->wayland_display,
+                        &kestrel_window_manager_v1_interface,
+                        META_KESTREL_WINDOW_V1_VERSION,
+                        manager, bind_kestrel_window_manager) == NULL)
+    g_error ("Failed to register a global kestrel-window object");
+
+  return manager;
+}
+
+void
+meta_wayland_init_kestrel_window (MetaWaylandCompositor *compositor)
+{
+  g_object_set_data_full (G_OBJECT (compositor), "-meta-wayland-kestrel-window",
+                          meta_wayland_kestrel_window_manager_new (compositor),
+                          g_object_unref);
+}
