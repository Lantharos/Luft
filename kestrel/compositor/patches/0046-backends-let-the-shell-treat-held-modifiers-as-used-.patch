 gboolean clutter_seat_get_touch_mode (ClutterSeat *seat);
 
diff --git a/src/backends/native/meta-seat-impl.c b/src/backends/native/meta-seat-impl.c
index dfc60e1934091b2e029874d083f8bb39e7aa0762..8238e77dd6feb6d1dc6eeb798c81c76f86784ce9 100644
--- a/src/backends/native/meta-seat-impl.c
+++ b/src/backends/native/meta-seat-impl.c
@@ -3511,6 +3511,76 @@ meta_seat_impl_warp_pointer (MetaSeatImpl *seat_impl,
   g_object_unref (task);
 }
 
+static ClutterInputDevice *
+find_keyboard (MetaSeatImpl *seat_impl)
+{
+  GSList *l;
+
+  for (l = seat_impl->devices; l; l = l->next)
+    {
+      ClutterInputDevice *device = l->data;
+
+      if (clutter_input_device_get_capabilities (device) &
+          CLUTTER_INPUT_CAPABILITY_KEYBOARD)
+        return device;
+    }
+
+  return NULL;
+}
+
+static gboolean
+consume_held_modifiers_in_impl (GTask *task)
+{
+  MetaSeatImpl *seat_impl = g_task_get_source_object (task);
+  ClutterInputDevice *keyboard = find_keyboard (seat_impl);
+  xkb_mod_mask_t latched_mods;
+  xkb_mod_mask_t locked_mods;
+  xkb_layout_index_t layout_index;
+
+  g_task_return_boolean (task, TRUE);
+
+  if (!keyboard ||
+      !xkb_state_serialize_mods (seat_impl->xkb, XKB_STATE_MODS_DEPRESSED))
+    return G_SOURCE_REMOVE;
+
+  g_rw_lock_writer_lock (&seat_impl->state_lock);
+
+  latched_mods =
+    xkb_state_serialize_mods (seat_impl->xkb, XKB_STATE_MODS_LATCHED);
+  locked_mods =
+    xkb_state_serialize_mods (seat_impl->xkb, XKB_STATE_MODS_LOCKED);
+  layout_index =
+    xkb_state_serialize_layout (seat_impl->xkb, XKB_STATE_LAYOUT_EFFECTIVE);
+  xkb_state_update_mask (seat_impl->xkb,
+                         0,
+                         latched_mods,
+                         locked_mods,
+                         0, 0, layout_index);
+  meta_keymap_native_update_in_impl (seat_impl->keymap, seat_impl->xkb);
+
+  g_rw_lock_writer_unlock (&seat_impl->state_lock);
+
+  queue_event (seat_impl,
+               meta_key_state_event_new (keyboard,
+                                         CLUTTER_EVENT_NONE,
+                                         seat_impl->xkb,
+                                         seat_impl->button_state,
+                                         g_get_monotonic_time ()));
+
+  return G_SOURCE_REMOVE;
+}
+
+void
+meta_seat_impl_consume_held_modifiers (MetaSeatImpl *seat_impl)
+{
+  GTask *task;
+
+  task = g_task_new (seat_impl, NULL, NULL, NULL);
+  meta_seat_impl_run_input_task (seat_impl, task,
+                                 (GSourceFunc) consume_held_modifiers_in_impl);
+  g_object_unref (task);
+}
+
 typedef struct
 {
   graphene_point_t position;
