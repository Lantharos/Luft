+ * along with this program; if not, see <http://www.gnu.org/licenses/>.
+ */
+
+#include "config.h"
+
+#include <glib-unix.h>
+#include <X11/Xatom.h>
+#include <X11/Xlib.h>
+#include <stdio.h>
+#include <stdlib.h>
+
+#include "x11-test-client-utils.h"
+
+static Atom atom_targets;
+static Atom atom_incr;
+static Atom atom_test_target;
+
+static gboolean stall_incr;
+
+static Window incr_requestor = None;
+static Atom incr_property = None;
+static gboolean incr_chunk_sent;
+
+static void
+send_selection_notify (Display                *xdisplay,
+                       XSelectionRequestEvent *request)
+{
+  XEvent xevent = { 0 };
+
+  xevent.xselection.type = SelectionNotify;
+  xevent.xselection.requestor = request->requestor;
+  xevent.xselection.selection = request->selection;
+  xevent.xselection.target = request->target;
+  xevent.xselection.property = request->property;
+  xevent.xselection.time = request->time;
+
+  XSendEvent (xdisplay, request->requestor, False, NoEventMask, &xevent);
+}
+
+static void
+handle_selection_request (Display                *xdisplay,
+                          XSelectionRequestEvent *request)
+{
+  if (request->target == atom_targets)
+    {
+      Atom targets[] = { atom_targets, atom_test_target };
+
+      XChangeProperty (xdisplay, request->requestor, request->property,
+                       XA_ATOM, 32, PropModeReplace,
+                       (unsigned char *) targets, G_N_ELEMENTS (targets));
+      send_selection_notify (xdisplay, request);
+    }
+  else if (request->target == atom_test_target && stall_incr)
+    {
+      long size = 1024;
+
+      incr_requestor = request->requestor;
+      incr_property = request->property;
+
+      XSelectInput (xdisplay, incr_requestor, PropertyChangeMask);
+      XChangeProperty (xdisplay, incr_requestor, incr_property,
+                       atom_incr, 32, PropModeReplace,
+                       (unsigned char *) &size, 1);
+      send_selection_notify (xdisplay, request);
+    }
+
+  XFlush (xdisplay);
+}
+
+static void
+handle_property_notify (Display        *xdisplay,
+                        XPropertyEvent *event)
+{
+  const char chunk[] = "first chunk";
+
+  if (event->window != incr_requestor ||
+      event->atom != incr_property ||
+      event->state != PropertyDelete ||
+      incr_chunk_sent)
+    return;
+
+  XChangeProperty (xdisplay, incr_requestor, incr_property,
+                   atom_test_target, 8, PropModeReplace,
+                   (unsigned char *) chunk, strlen (chunk));
+  XFlush (xdisplay);
+  incr_chunk_sent = TRUE;
+}
+
+static gboolean
+on_xevent (XEvent   *xevent,
+           gpointer  user_data)
+{
+  Display *xdisplay = user_data;
+
+  switch (xevent->type)
+    {
+    case SelectionRequest:
+      handle_selection_request (xdisplay, &xevent->xselectionrequest);
+      break;
+    case PropertyNotify:
+      handle_property_notify (xdisplay, &xevent->xproperty);
+      break;
+    }
+
+  return G_SOURCE_CONTINUE;
+}
+
+static gboolean
+on_sigterm (gpointer user_data)
+{
+  GMainLoop *loop = user_data;
+
+  g_main_loop_quit (loop);
+
+  return G_SOURCE_REMOVE;
+}
+
+int
+main (int    argc,
+      char **argv)
+{
+  g_autoptr (GMainLoop) loop = NULL;
+  Display *xdisplay;
+  Window window;
+  GSource *source;
+
+  g_assert_cmpint (argc, ==, 2);
+  if (g_strcmp0 (argv[1], "stall-incr") == 0)
+    stall_incr = TRUE;
+  else
+    g_assert_cmpstr (argv[1], ==, "never-answer");
+
+  xdisplay = XOpenDisplay (NULL);
+  if (!xdisplay)
+    {
+      fprintf (stderr, "Failed to open display\n");
+      return EXIT_FAILURE;
+    }
+
+  loop = g_main_loop_new (NULL, FALSE);
+  g_unix_signal_add (SIGTERM, on_sigterm, loop);
+
+  atom_targets = XInternAtom (xdisplay, "TARGETS", False);
+  atom_incr = XInternAtom (xdisplay, "INCR", False);
+  atom_test_target = XInternAtom (xdisplay, "application/mutter-test", False);
+
+  window = XCreateSimpleWindow (xdisplay, DefaultRootWindow (xdisplay),
+                                0, 0, 1, 1, 0, 0, 0);
+  XSetSelectionOwner (xdisplay,
+                      XInternAtom (xdisplay, "CLIPBOARD", False),
+                      window, CurrentTime);
+  XFlush (xdisplay);
+
+  source = x11_event_source_new (xdisplay, on_xevent, xdisplay);
+
+  g_main_loop_run (loop);
+
+  g_source_destroy (source);
+  g_source_unref (source);
+  XDestroyWindow (xdisplay, window);
+  XCloseDisplay (xdisplay);
+
+  return EXIT_SUCCESS;
+}
