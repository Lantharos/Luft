+static void
+draw_texture_on_whole_pixels (CoglFramebuffer *fb,
+                              CoglPipeline    *pipeline,
+                              const float     *rect)
+{
+  CoglTexture *texture = cogl_pipeline_get_layer_texture (pipeline, 0);
+  float offset_x, offset_y;
+  gboolean aligned;
+
+  aligned = texture && rect[2] != rect[0] &&
+    _clutter_util_offset_to_whole_pixel (fb, rect[0], rect[1],
+                                         cogl_texture_get_width (texture) *
+                                         (rect[6] - rect[4]) / (rect[2] - rect[0]),
+                                         &offset_x, &offset_y);
+  if (aligned)
+    {
+      cogl_framebuffer_push_matrix (fb);
+      cogl_framebuffer_translate (fb, offset_x, offset_y, 0.0f);
+    }
+
+  cogl_framebuffer_draw_textured_rectangle (fb, pipeline,
+                                            rect[0], rect[1], rect[2], rect[3],
+                                            rect[4], rect[5], rect[6], rect[7]);
+
+  if (aligned)
+    cogl_framebuffer_pop_matrix (fb);
+}
