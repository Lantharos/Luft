From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Kristof Imeri <kristof@lanth.me>
Date: Sun, 18 Oct 2026 23:56:49 +0200
Subject: [PATCH 43/53] stage: let the shell grow redraw clips

Blurred glass in the shell changes wherever what is behind it changes, and
also as far around that as the blur reaches. Only the damaged part of the
glass was repainted, so the rest kept showing the old blur until something
else repainted it.

The shell can now add redraw clip filters to the stage, as the compositor
already does for the backgrounds that clients blur, and repaint the glass
the blur reaches.

Upstream-Status: luft-only API for Kestrel's glass
---
 src/backends/meta-stage-private.h | 11 -----------
 src/backends/meta-stage.c         | 18 ++++++++++++++++++
 src/meta/meta-stage.h             | 17 +++++++++++++++++
 3 files changed, 35 insertions(+), 11 deletions(-)

diff --git a/src/backends/meta-stage-private.h b/src/backends/meta-stage-private.h
index ed3063c68a027d76a213bcb325dd4c5e9844f13c..75af016b0df91200204dcc87bda05defba225c6c 100644
--- a/src/backends/meta-stage-private.h
+++ b/src/backends/meta-stage-private.h
@@ -26,7 +26,6 @@ G_BEGIN_DECLS
 
 typedef struct _MetaStageWatch MetaStageWatch;
 typedef struct _MetaOverlay    MetaOverlay;
-typedef struct _MetaStageRedrawClipFilter MetaStageRedrawClipFilter;
 
 typedef enum
 {
@@ -44,11 +43,6 @@ typedef void (* MetaStageWatchFunc) (MetaStage        *stage,
                                      ClutterFrame     *frame,
                                      gpointer          user_data);
 
-typedef gboolean (* MetaStageRedrawClipFilterFunc) (MetaStage        *stage,
-                                                    ClutterStageView *stage_view,
-                                                    MtkRegion        *redraw_clip,
-                                                    gpointer          user_data);
-
 ClutterActor     *meta_stage_new                     (MetaBackend *backend);
 
 MetaOverlay      *meta_stage_create_cursor_overlay   (MetaStage   *stage);
@@ -79,11 +73,6 @@ META_EXPORT_TEST
 void meta_stage_remove_watch (MetaStage      *stage,
                               MetaStageWatch *watch);
 
-MetaStageRedrawClipFilter * meta_stage_add_redraw_clip_filter (MetaStage                     *stage,
-                                                               MetaStageRedrawClipFilterFunc  filter_func,
-                                                               gpointer                       user_data,
-                                                               GDestroyNotify                 destroy_notify);
-void meta_stage_remove_redraw_clip_filter (MetaStageRedrawClipFilter *filter);
 void meta_stage_apply_redraw_clip_filters (MetaStage        *stage,
                                            ClutterStageView *stage_view,
                                            MtkRegion        *redraw_clip);
diff --git a/src/backends/meta-stage.c b/src/backends/meta-stage.c
index c1862b544dfe3d8a58714f5407faff3b3a16d430..ce29309768ad478ad369ae27f7f8fa38d6879716 100644
--- a/src/backends/meta-stage.c
+++ b/src/backends/meta-stage.c
@@ -624,6 +624,20 @@ meta_stage_remove_watch (MetaStage      *stage,
   g_assert (removed);
 }
 
+/**
+ * meta_stage_add_redraw_clip_filter: (skip)
+ * @stage: a #MetaStage
+ * @filter_func: called with each view's redraw clip before the view is painted
+ * @user_data: data passed to @filter_func
+ * @destroy_notify: frees @user_data when the filter is removed
+ *
+ * Lets @filter_func grow a view's redraw clip, in stage coordinates, before
+ * the view is painted, so that anything whose look depends on what changed
+ * around it is repainted too. @filter_func returns %TRUE when it grew the
+ * clip, and filters run again until none of them grows it.
+ *
+ * Returns: the filter, for meta_stage_remove_redraw_clip_filter()
+ */
 MetaStageRedrawClipFilter *
 meta_stage_add_redraw_clip_filter (MetaStage                     *stage,
                                    MetaStageRedrawClipFilterFunc  filter_func,
@@ -647,6 +661,10 @@ meta_stage_add_redraw_clip_filter (MetaStage                     *stage,
   return filter;
 }
 
+/**
+ * meta_stage_remove_redraw_clip_filter: (skip)
+ * @filter: a filter from meta_stage_add_redraw_clip_filter()
+ */
 void
 meta_stage_remove_redraw_clip_filter (MetaStageRedrawClipFilter *filter)
 {
diff --git a/src/meta/meta-stage.h b/src/meta/meta-stage.h
