## App menu (right-click on a taskbar app)

window-menu-open = Отвори
window-menu-new-window = Нови прозор
window-menu-restore = Врати
window-menu-minimize = Умањи
window-menu-maximize = Увећај
window-menu-unmaximize = Врати величину
window-menu-pin = Закачи на траку задатака
window-menu-unpin = Откачи са траке задатака
window-menu-close = { $count ->
    [one] Затвори прозор
    [few] Затвори све прозоре
   *[other] Затвори све прозоре
}

## Context menus

context-menu-back = Назад

## Window previews (hovering a taskbar app)

previews-close-window = Затвори { $title }

## Tray

tray-apps = Апликације у системској палети
tray-open-app = Отвори { $appName }

## Board (tablet window layout)

board-open-start = Отвори Старт
board-show-all-windows = Прикажи све прозоре
board-quick-settings = Брза подешавања

## Task view

task-view-close-window = Затвори прозор
task-view-desktop = Радни простор { $number }

## Snap layouts

snap-zone = Поравнај у област од { $width }% × { $height }%

## Window title bars

title-bar-minimize = Умањи
title-bar-maximize = Увећај
