diff --git a/src/compositor/meta-window-corners.c b/src/compositor/meta-window-corners.c
index c2ae1746a2b3d876be0bb815165758957b2a4f62..4d51e1602015767b67e80830815ee9a4e453a859 100644
--- a/src/compositor/meta-window-corners.c
+++ b/src/compositor/meta-window-corners.c
@@ -8,11 +8,13 @@
 #include "compositor/meta-shaped-texture-private.h"
 #include "compositor/meta-window-actor-private.h"
 #include "core/window-private.h"
+#include "meta/display.h"
 #include "meta/meta-window-actor.h"
 #include "meta/window.h"
 #include "wayland/meta-window-wayland.h"
 
 static gboolean corners_rounded = TRUE;
+static guint64 gapped_monitors;
 
 /* Whether people want rounded window corners, from the Kestrel setting the
  * compositor follows */
@@ -22,6 +24,24 @@ meta_window_corners_set_rounded (gboolean rounded)
   corners_rounded = rounded;
 }
 
+/* Whether the shell leaves a gap between @monitor's work area and its edge,
+ * as a floating taskbar does, so windows filling the work area keep the
+ * corners that face it rounded */
+gboolean
+meta_window_corners_set_monitor_gap (int      monitor,
+                                     gboolean gap)
+{
+  guint64 before = gapped_monitors;
+
+  if (monitor < 0 || monitor >= 64)
+    return FALSE;
+  if (gap)
+    gapped_monitors |= G_GUINT64_CONSTANT (1) << monitor;
+  else
+    gapped_monitors &= ~(G_GUINT64_CONSTANT (1) << monitor);
+  return gapped_monitors != before;
+}
+
 float
 meta_window_corners_get_radius (void)
 {
@@ -50,6 +70,90 @@ is_floating (MetaWindow *window)
          window->edge_constraints.left == META_EDGE_CONSTRAINT_NONE;
 }
 
+typedef enum
+{
+  EDGE_FREE,
+  EDGE_AGAINST_SCREEN,
+  EDGE_AGAINST_WINDOW,
+} EdgeContact;
+
+/* Only an edge left short of the screen edge by the shell's gap faces open
+ * space; the free edges of a snapped window lead on to where other windows go */
+static EdgeContact
+edge_contact (MetaEdgeConstraint constraint,
+              gboolean           at_monitor_edge,
+              gboolean           gapped)
+{
+  if (constraint != META_EDGE_CONSTRAINT_MONITOR)
+    return EDGE_AGAINST_WINDOW;
+  if (at_monitor_edge || !gapped)
+    return EDGE_AGAINST_SCREEN;
+  return EDGE_FREE;
+}
+
+static gboolean
+corner_rounded (EdgeContact one,
+                EdgeContact other)
+{
+  return one != EDGE_AGAINST_WINDOW && other != EDGE_AGAINST_WINDOW &&
+         (one == EDGE_FREE || other == EDGE_FREE);
+}
+
+/* Which corners of @window face open space: a corner stays square where the
+ * window meets another one, or where both its edges meet the screen */
+static MetaWindowCornerMask
+rounded_corners (MetaWindow *window)
+{
+  int monitor = meta_window_get_monitor (window);
+  gboolean gapped = monitor >= 0 && monitor < 64 &&
+                    (gapped_monitors & (G_GUINT64_CONSTANT (1) << monitor));
+  MtkRectangle frame, area;
+  EdgeContact top, right, bottom, left;
+  MetaWindowCornerMask mask = 0;
+
+  if (!corners_rounded || meta_window_is_fullscreen (window) || monitor < 0)
+    return 0;
+  if (is_floating (window))
+    return META_WINDOW_CORNERS_ALL;
+
+  switch (meta_window_get_window_type (window))
+    {
+    case META_WINDOW_DESKTOP:
+    case META_WINDOW_DOCK:
+    case META_WINDOW_DND:
+      return 0;
+    default:
+      break;
+    }
+
+  meta_window_get_frame_rect (window, &frame);
+  meta_display_get_monitor_geometry (meta_window_get_display (window), monitor, &area);
+  top = edge_contact (window->edge_constraints.top, frame.y <= area.y, gapped);
+  right = edge_contact (window->edge_constraints.right,
+                        frame.x + frame.width >= area.x + area.width, gapped);
+  bottom = edge_contact (window->edge_constraints.bottom,
+                         frame.y + frame.height >= area.y + area.height, gapped);
+  left = edge_contact (window->edge_constraints.left, frame.x <= area.x, gapped);
+
+  if (corner_rounded (top, left))
+    mask |= META_WINDOW_CORNER_TOP_LEFT;
+  if (corner_rounded (top, right))
+    mask |= META_WINDOW_CORNER_TOP_RIGHT;
+  if (corner_rounded (bottom, right))
+    mask |= META_WINDOW_CORNER_BOTTOM_RIGHT;
+  if (corner_rounded (bottom, left))
+    mask |= META_WINDOW_CORNER_BOTTOM_LEFT;
+  return mask;
+}
+
+gboolean
+meta_window_corners_equal (const MetaWindowCorners *a,
+                           const MetaWindowCorners *b)
+{
+  return a->radius == b->radius && a->rounded == b->rounded &&
+         graphene_rect_equal (&a->bounds, &b->bounds);
+}
+
 /**
  * meta_window_has_rounded_corners:
  * @window: a #MetaWindow
@@ -161,6 +265,7 @@ meta_window_corners_for_actor (ClutterActor *actor)
   graphene_matrix_t transform, inverse;
   graphene_rect_t bounds;
   float scale, border, radius;
+  MetaWindowCornerMask rounded;
 
   while (ancestor && !META_IS_WINDOW_ACTOR (ancestor))
     ancestor = clutter_actor_get_parent (ancestor);
@@ -168,7 +273,8 @@ meta_window_corners_for_actor (ClutterActor *actor)
     return corners;
 
   window = meta_window_actor_get_meta_window (META_WINDOW_ACTOR (ancestor));
-  if (!window || !meta_window_has_rounded_corners (window) ||
+  rounded = window ? rounded_corners (window) : 0;
+  if (!rounded ||
       !get_frame_bounds (META_WINDOW_ACTOR (ancestor), &bounds, &border))
     return corners;
 
@@ -200,13 +306,13 @@ meta_window_corners_for_actor (ClutterActor *actor)
   corners.radius = MIN (radius * scale,
                          MIN (corners.bounds.size.width,
                               corners.bounds.size.height) / 2.0f);
+  corners.rounded = rounded;
   return corners;
 }
 
 #define CORNER_DECLARATIONS \
   "varying vec2 kestrel_position;\n" \
   "uniform vec4 kestrel_bounds;\n" \
-  "uniform float kestrel_radius;\n" \
   "float kestrel_pixel_size ()\n" \
   "{\n" \
   "  vec2 dx = dFdx(kestrel_position);\n" \
@@ -218,10 +324,14 @@ meta_window_corners_for_actor (ClutterActor *actor)
   "float pixel = kestrel_pixel_size ();\n" \
   "vec2 half_size = kestrel_bounds.zw * 0.5;\n" \
   "vec2 center = kestrel_bounds.xy + half_size;\n" \
-  "vec2 p = abs(kestrel_position - center);\n" \
-  "vec2 q = p - half_size + kestrel_radius;\n" \
-  "if (all(greaterThan(q, vec2(0.0))) && all(lessThan(p, half_size))) {\n" \
-  "  float distance = length(q) - kestrel_radius;\n" \
+  "vec2 offset = kestrel_position - center;\n" \
+  "float radius = offset.y < 0.0 ?\n" \
+  "  (offset.x < 0.0 ? kestrel_radii.x : kestrel_radii.y) :\n" \
+  "  (offset.x < 0.0 ? kestrel_radii.w : kestrel_radii.z);\n" \
+  "vec2 p = abs(offset);\n" \
+  "vec2 q = p - half_size + radius;\n" \
+  "if (radius > 0.0 && all(greaterThan(q, vec2(0.0))) && all(lessThan(p, half_size))) {\n" \
+  "  float distance = length(q) - radius;\n" \
   "  float coverage = clamp(0.5 - distance / pixel, 0.0, 1.0);\n"
 
 static CoglSnippet *
@@ -254,7 +364,8 @@ get_clear_snippet (void)
   if (!snippet)
     {
       snippet = cogl_snippet_new (COGL_SNIPPET_HOOK_FRAGMENT,
-        CORNER_DECLARATIONS,
+        CORNER_DECLARATIONS
