[Unit]
Description=Copy Luft onto the drive it moves to, before the system uses its files
DefaultDependencies=no
ConditionPathExists=/sys/firmware/efi/efivars/MovingSystemDisk-b6a4c1e2-3f5d-4c8a-9e71-2d0f6a8b5c3e
Wants=tpm2.target
After=tpm2.target systemd-pcrphase-initrd.service initrd-root-device.target trustd-move.service
Before=sysroot.mount

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/trustctl system-disk move
SyslogIdentifier=trustd
TimeoutSec=infinity
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_ALG
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
