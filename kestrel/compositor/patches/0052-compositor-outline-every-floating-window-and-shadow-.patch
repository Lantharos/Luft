+#ifdef HAVE_XWAYLAND
+static gboolean
+get_shadow_frame (MetaWindowActorWayland *self,
+                  const graphene_rect_t  *outline,
+                  MtkRectangle           *frame)
+{
+  MetaWindow *window = meta_window_actor_get_meta_window (META_WINDOW_ACTOR (self));
+
+  if (!meta_window_corners_casts_shadow (window))
+    return FALSE;
+
+  mtk_rectangle_from_graphene_rect (outline, MTK_ROUNDING_STRATEGY_ROUND, frame);
+  return TRUE;
+}
+#endif
+
+static void
+meta_window_actor_wayland_paint (ClutterActor        *actor,
+                                 ClutterPaintContext *paint_context)
+{
+  MetaWindowActorWayland *self = META_WINDOW_ACTOR_WAYLAND (actor);
+  CoglFramebuffer *framebuffer = clutter_paint_context_get_framebuffer (paint_context);
+  guint8 opacity = clutter_actor_get_paint_opacity (actor);
+  graphene_rect_t outline;
+  gboolean outlined =
+    meta_window_corners_get_outline (META_WINDOW_ACTOR (self), &outline);
+#ifdef HAVE_XWAYLAND
+  MtkRectangle frame;
+
+  if (outlined && get_shadow_frame (self, &outline, &frame))
+    meta_window_shadow_paint (&self->shadow, actor, framebuffer, &frame, opacity);
+#endif
+
+  CLUTTER_ACTOR_CLASS (meta_window_actor_wayland_parent_class)->paint (actor,
+                                                                       paint_context);
+
+  if (outlined)
+    meta_window_corners_paint_outline (framebuffer, &outline, opacity);
+}
+
+static gboolean
+meta_window_actor_wayland_get_paint_volume (ClutterActor       *actor,
+                                            ClutterPaintVolume *volume)
+{
+  ClutterActorClass *parent_class =
+    CLUTTER_ACTOR_CLASS (meta_window_actor_wayland_parent_class);
+#ifdef HAVE_XWAYLAND
+  MetaWindowActorWayland *self = META_WINDOW_ACTOR_WAYLAND (actor);
+  graphene_rect_t outline;
+  MtkRectangle frame;
+#endif
+
+  if (!parent_class->get_paint_volume (actor, volume))
+    return FALSE;
+
+#ifdef HAVE_XWAYLAND
+  if (meta_window_corners_get_outline (META_WINDOW_ACTOR (self), &outline) &&
+      get_shadow_frame (self, &outline, &frame))
+    {
+      MtkRectangle bounds;
+
+      meta_window_shadow_get_bounds (&self->shadow, actor, &frame, &bounds);
+      clutter_paint_volume_union_box (volume,
+                                      &(ClutterActorBox) {
+                                        bounds.x, bounds.y,
+                                        bounds.x + bounds.width,
+                                        bounds.y + bounds.height,
+                                      });
+    }
+#endif
+
+  return TRUE;
+}
