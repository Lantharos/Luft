     anyhow::bail!("ESP with uuid {device_uuid} not found")
 }
 
+/// Find the partition that holds the UKIs and Type #1 entries of the booted
+/// system: an XBOOTLDR partition on the disk of the booted ESP for
+/// BLS-compatible bootloaders when there is one, per the Boot Loader
+/// Specification, and the booted ESP otherwise.
+pub(crate) fn find_booted_boot_partition(
+    physical_root: &Dir,
+    bootloader: &Bootloader,
+) -> Result<String> {
+    let esp = find_booted_from_esp(physical_root)?;
+    if matches!(bootloader.kind()?, BootloaderKind::BLSCompatible) {
+        let esp_dev = bootc_blockdev::list_dev(Utf8Path::new(&esp))?;
+        for disk in esp_dev.list_parents()?.unwrap_or_default() {
+            let disk = bootc_blockdev::list_dev(Utf8Path::new(&disk.path()))?;
+            if let Some(xbootldr) = disk.find_partition_of_xbootldr() {
+                return Ok(xbootldr.path());
+            }
+        }
+    }
+    Ok(esp)
+}
