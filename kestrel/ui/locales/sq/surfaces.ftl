    [one] { $hours } orë
   *[other] { $hours } orë
} përpara
start-search-answer-time-behind = { $place }, { $hours ->
    [one] { $hours } orë
   *[other] { $hours } orë
} prapa
start-search-answer-time-same = { $place }, e njëjta orë si këtu
