bun = find_program('bun')

kestrel_ui_js = custom_target('kestrel-ui',
  input: files(
    '../../../ui/src/kestrelUi.ts',
    '../../../ui/src/panel.ts',
    '../../../ui/src/taskbar.ts',
    '../../../ui/src/caret.ts',
    '../../../ui/src/launcher.ts',
    '../../../ui/src/assets/luft-primary.svg',
    '../../../ui/src/assets/luft-secondary.svg',
    '../../../ui/src/panelLayout.ts',
    '../../../ui/src/surface.ts',
    '../../../ui/src/motion.ts',
    '../../../ui/src/startMenu.ts',
    '../../../ui/src/quickSettings.ts',
    '../../../ui/src/quickControls.ts',
    '../../../ui/src/pagedPane.ts',
    '../../../ui/src/notificationCenter.ts',
    '../../../ui/src/powerMenu.ts',
    '../../../ui/src/upstream.d.ts',
    '../../../ui/build.ts',
  ),
  output: 'kestrelUi.js',
  command: [bun, files('../../../ui/build.ts'), '@OUTPUT@'],
)
