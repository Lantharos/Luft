<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-Bus Object Introspection 1.0//EN"
 "https://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<node name="/com/lantharos/RemoteLogin1">
  <!--
    Remote login: signing in to the computer from other devices over SSH.

    Enabled: whether sshd runs and starts with the computer. Off, sshd doesn't run at all.
    PasswordLogin: whether accounts may also sign in with their password; otherwise only keys.
    PublicNetworks: whether devices on public networks reach sshd too, not just home networks.
    Accounts: the user names that may sign in.
    HostKeys: the computer's own keys, as (type, SHA256 fingerprint), for checking the first
    connection. Empty until remote login was first turned on.

    SetEnabled(true) needs an administrator; it lets the caller's account sign in when no
    account may yet, opens port 22 on home networks and starts sshd. SetEnabled(false) stops
    sshd, ends every SSH session and closes the port. Letting an account in, passwords or public
    networks need an administrator; going back is allowed for the person at the computer.

    AuthorizedKeys, AddAuthorizedKey and RemoveAuthorizedKey change the caller's own
    ~/.ssh/authorized_keys, as (type, comment, SHA256 fingerprint), and need no password.
    AddAuthorizedKey takes one public key as a .pub file holds it.
  -->
  <interface name="com.lantharos.RemoteLogin1">
    <property name="Enabled" type="b" access="read"/>
    <property name="PasswordLogin" type="b" access="read"/>
    <property name="PublicNetworks" type="b" access="read"/>
    <property name="Accounts" type="as" access="read"/>
    <property name="HostKeys" type="a(ss)" access="read"/>
    <method name="SetEnabled">
      <arg name="enabled" type="b" direction="in"/>
    </method>
    <method name="SetPasswordLogin">
      <arg name="allowed" type="b" direction="in"/>
    </method>
    <method name="SetPublicNetworks">
      <arg name="allowed" type="b" direction="in"/>
    </method>
    <method name="SetAccountAllowed">
      <arg name="account" type="s" direction="in"/>
      <arg name="allowed" type="b" direction="in"/>
    </method>
    <method name="AuthorizedKeys">
      <arg name="keys" type="a(sss)" direction="out"/>
    </method>
    <method name="AddAuthorizedKey">
      <arg name="key" type="s" direction="in"/>
      <arg name="added" type="(sss)" direction="out"/>
    </method>
    <method name="RemoveAuthorizedKey">
      <arg name="fingerprint" type="s" direction="in"/>
    </method>
  </interface>
</node>
