+/* The window's frame in actor coordinates, when the compositor draws its
+ * shadow and outline */
+static gboolean
+get_outlined_frame (MetaWindowActorWayland *self,
+                    MtkRectangle           *frame)
+{
+  MetaWindowActor *actor = META_WINDOW_ACTOR (self);
+  MetaWindow *window = meta_window_actor_get_meta_window (actor);
+  MtkRectangle frame_rect, buffer_rect;
+  int geometry_scale;
+
+  if (!window || window->unmanaging ||
+      !meta_window_corners_casts_shadow (window))
+    return FALSE;
+
+  geometry_scale = meta_window_actor_get_geometry_scale (actor);
+  meta_window_get_frame_rect (window, &frame_rect);
+  meta_window_get_buffer_rect (window, &buffer_rect);
+  *frame = (MtkRectangle) {
+    .x = (frame_rect.x - buffer_rect.x) / geometry_scale,
+    .y = (frame_rect.y - buffer_rect.y) / geometry_scale,
+    .width = frame_rect.width / geometry_scale,
+    .height = frame_rect.height / geometry_scale,
+  };
+  return frame->width > 0 && frame->height > 0;
+}
+
+#ifdef HAVE_XWAYLAND
+static MetaShadow *
+ensure_shadow (MetaWindowActorWayland *self,
+               const MtkRectangle     *frame,
+               gboolean                focused)
+{
+  ClutterContext *clutter_context =
+    clutter_actor_get_context (CLUTTER_ACTOR (self));
+  CoglContext *cogl_context =
+    clutter_backend_get_cogl_context (clutter_context_get_backend (clutter_context));
+  MtkRectangle rect = { 0, 0, frame->width, frame->height };
+  MetaWindowCorners corners = {
+    .bounds = GRAPHENE_RECT_INIT (0, 0, frame->width, frame->height),
+    .radius = MIN (META_WINDOW_CORNER_RADIUS,
+                   MIN (frame->width, frame->height) / 2.0f),
+  };
+  g_autoptr (MtkRegion) region = NULL;
+  MetaWindowShape *shape;
+
+  if (self->shadow &&
+      self->shadow_width == frame->width &&
+      self->shadow_height == frame->height &&
+      self->shadow_focused == focused)
+    return self->shadow;
+
+  g_clear_pointer (&self->shadow, meta_shadow_unref);
+  g_clear_pointer (&self->shadow_hole, mtk_region_unref);
+
+  region = mtk_region_create_rectangle (&rect);
+  meta_window_corners_clip_input (&corners, region);
+  shape = meta_window_shape_new (region);
+  self->shadow_hole = mtk_region_create_rectangle (&rect);
+  meta_window_corners_clip_inside (&corners, self->shadow_hole);
+  self->shadow = meta_shadow_factory_get_shadow (meta_shadow_factory_get_default (),
+                                                 shape, frame->width, frame->height,
+                                                 "normal", focused, cogl_context);
+  meta_window_shape_unref (shape);
+  self->shadow_width = frame->width;
+  self->shadow_height = frame->height;
+  self->shadow_focused = focused;
+  return self->shadow;
+}
+
+static void
+get_shadow_bounds (MetaWindowActorWayland *self,
+                   const MtkRectangle     *frame,
+                   MetaShadowParams       *params,
+                   MtkRectangle           *bounds)
+{
+  MetaWindow *window = meta_window_actor_get_meta_window (META_WINDOW_ACTOR (self));
+  gboolean focused = meta_window_appears_focused (window);
+  MetaShadow *shadow = ensure_shadow (self, frame, focused);
+
+  meta_shadow_factory_get_params (meta_shadow_factory_get_default (),
+                                  "normal", focused, params);
+  meta_shadow_get_bounds (shadow,
+                          frame->x + params->x_offset,
+                          frame->y + params->y_offset,
+                          frame->width, frame->height,
+                          bounds);
+}
+
+/* Like the shadows of X11 windows, but never under the window, where it
+ * would darken translucent and blurred parts of it */
+static void
+paint_shadow (MetaWindowActorWayland *self,
+              CoglFramebuffer        *framebuffer,
+              const MtkRectangle     *frame,
+              guint8                  opacity)
+{
+  MetaShadowParams params;
+  MtkRectangle bounds;
+  g_autoptr (MtkRegion) clip = NULL;
+
+  get_shadow_bounds (self, frame, &params, &bounds);
+  clip = mtk_region_create_rectangle (&bounds);
+  mtk_region_translate (self->shadow_hole, frame->x, frame->y);
+  mtk_region_subtract (clip, self->shadow_hole);
+  mtk_region_translate (self->shadow_hole, -frame->x, -frame->y);
+
+  meta_shadow_paint (self->shadow, framebuffer,
+                     frame->x + params.x_offset,
+                     frame->y + params.y_offset,
+                     frame->width, frame->height,
+                     opacity * params.opacity / 255,
+                     clip, TRUE);
+}
+#endif
+
+static void
+meta_window_actor_wayland_paint (ClutterActor        *actor,
+                                 ClutterPaintContext *paint_context)
+{
+  MetaWindowActorWayland *self = META_WINDOW_ACTOR_WAYLAND (actor);
+  CoglFramebuffer *framebuffer = clutter_paint_context_get_framebuffer (paint_context);
+  guint8 opacity = clutter_actor_get_paint_opacity (actor);
+  MtkRectangle frame;
+  gboolean outlined = get_outlined_frame (self, &frame);
+
+#ifdef HAVE_XWAYLAND
+  if (outlined)
+    paint_shadow (self, framebuffer, &frame, opacity);
+#endif
+
+  CLUTTER_ACTOR_CLASS (meta_window_actor_wayland_parent_class)->paint (actor,
+                                                                       paint_context);
+
+  if (outlined)
+    meta_window_corners_paint_outline (framebuffer, &frame, opacity);
+}
+
+static gboolean
+meta_window_actor_wayland_get_paint_volume (ClutterActor       *actor,
+                                            ClutterPaintVolume *volume)
+{
+  ClutterActorClass *parent_class =
+    CLUTTER_ACTOR_CLASS (meta_window_actor_wayland_parent_class);
+#ifdef HAVE_XWAYLAND
+  MetaWindowActorWayland *self = META_WINDOW_ACTOR_WAYLAND (actor);
+  MtkRectangle frame;
+#endif
+
+  if (!parent_class->get_paint_volume (actor, volume))
+    return FALSE;
+
+#ifdef HAVE_XWAYLAND
+  if (get_outlined_frame (self, &frame))
+    {
+      MetaShadowParams params;
+      MtkRectangle bounds;
+
+      get_shadow_bounds (self, &frame, &params, &bounds);
+      clutter_paint_volume_union_box (volume,
+                                      &(ClutterActorBox) {
+                                        bounds.x, bounds.y,
+                                        bounds.x + bounds.width,
+                                        bounds.y + bounds.height,
+                                      });
+    }
+#endif
+
+  return TRUE;
+}
+
+static void
+on_appears_focused_changed (MetaWindowActorWayland *self)
+{
+  clutter_actor_invalidate_paint_volume (CLUTTER_ACTOR (self));
+  clutter_actor_queue_redraw (CLUTTER_ACTOR (self));
+}
