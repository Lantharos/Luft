## Answers in Gust's search to questions about dates and times.
## The answer itself, such as "157 days" or "17:00", is formatted for the language; these describe it.

gust-search-answer-until = Līdz: { $date }
gust-search-answer-since = Kopš: { $date }
gust-search-answer-between = Periods: { $from } – { $to }
gust-search-answer-time-ahead = { $place }, { $hours ->
    [zero] par { $hours } stundām uz priekšu
    [one] par { $hours } stundu uz priekšu
   *[other] par { $hours } stundām uz priekšu
}
gust-search-answer-time-behind = { $place }, { $hours ->
    [zero] par { $hours } stundām atpakaļ
    [one] par { $hours } stundu atpakaļ
   *[other] par { $hours } stundām atpakaļ
}
gust-search-answer-time-same = { $place }, tāds pats laiks kā šeit
gust-search-answer-converted = { $place }, kad ir { $time } ({ $from })
gust-search-answer-converted-here = Šeit, kad ir { $time } ({ $from })
gust-search-answer-converted-from-here = { $place }, kad šeit ir { $time }

