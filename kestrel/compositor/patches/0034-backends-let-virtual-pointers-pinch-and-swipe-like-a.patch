+                                                         uint64_t                     time_us,
+                                                         ClutterTouchpadGesturePhase  phase,
+                                                         uint32_t                     fingers,
+                                                         double                       dx,
+                                                         double                       dy,
+                                                         double                       angle_delta,
+                                                         double                       scale);
+
+CLUTTER_EXPORT
+void clutter_virtual_input_device_notify_touchpad_swipe (ClutterVirtualInputDevice   *virtual_device,
+                                                         uint64_t                     time_us,
