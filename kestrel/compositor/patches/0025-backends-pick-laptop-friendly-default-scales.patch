From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Kristof Imeri <kristof@lanth.me>
Date: Wed, 14 Oct 2026 16:22:39 +0200
Subject: [PATCH 25/26] backends: pick laptop-friendly default scales

Monitors without a saved configuration got 100% on 15.6" 1080p laptop
panels and thirds such as 133% elsewhere. Aim for 120 DPI on screens
under 20", like other systems do, and prefer quarter steps unless a third
fits clearly better. Scales people chose are stored and never recalculated.
---
 src/backends/meta-monitor.c | 66 +++++++++++++++++++++++++++----------
 1 file changed, 49 insertions(+), 17 deletions(-)

diff --git a/src/backends/meta-monitor.c b/src/backends/meta-monitor.c
index 04a91104bc2ddc8194f83708f154286e8bf9e4b4..3f67457c91db6142959f08bd79374327259776aa 100644
--- a/src/backends/meta-monitor.c
+++ b/src/backends/meta-monitor.c
@@ -2423,13 +2423,11 @@ meta_monitor_calculate_crtc_pos (MetaMonitor         *monitor,
  * We choose a default scale factor such that the UI is as big
  * as it would be on a display with this DPI without scaling.
  *
- * Through experiementing, a value of 135 has been found to best
- * line up with the UI size chosen as default by other operating
- * systems (macOS, Android, iOS, Windows) and the community-decided
- * "known-good" scale factors for GNOME for various mobile devices
- * such as phones, tablets, and laptops
+ * A value of 120 lines up with the scale other operating systems
+ * pick for common laptop panels: 125% for 14" to 16" 1080p panels,
+ * 150% for 13" 1080p panels and 200% for 13" to 14" HiDPI panels.
  */
-#define UI_SCALE_MOBILE_TARGET_DPI 135
+#define UI_SCALE_MOBILE_TARGET_DPI 120
 
 /*
  * People tend to sit further away from larger stationary displays
@@ -2443,6 +2441,45 @@ meta_monitor_calculate_crtc_pos (MetaMonitor         *monitor,
 #define UI_SCALE_LARGE_TARGET_DPI 110
 #define UI_SCALE_LARGE_MIN_SIZE_INCHES 20
 
+/*
+ * Quarter steps (125%, 150%, 175%) are what people recognize and render
+ * most evenly, so they win over thirds unless a third fits much better.
+ */
+#define UI_SCALE_STEPS_PER_INTEGER 4
+#define UI_SCALE_STEP_TOLERANCE 0.1f
+
+static gboolean
+is_quarter_step (float scale)
+{
+  return fmodf (scale * UI_SCALE_STEPS_PER_INTEGER, 1.0f) == 0.0f;
+}
+
+static float
+find_closest_scale (const float *scales,
+                    int          n_scales,
+                    float        perfect_scale,
+                    gboolean     quarter_steps_only)
+{
+  float best_scale = 1.0f;
+  float best_scale_error = G_MAXFLOAT;
+
+  for (int i = 0; i < n_scales; i++)
+    {
+      float scale_error = fabsf (scales[i] - perfect_scale);
+
+      if (quarter_steps_only && !is_quarter_step (scales[i]))
+        continue;
+
+      if (scale_error < best_scale_error)
+        {
+          best_scale = scales[i];
+          best_scale_error = scale_error;
+        }
+    }
+
+  return best_scale;
+}
+
 static float
 calculate_scale (MetaMonitor                *monitor,
                  MetaMonitorMode            *monitor_mode,
@@ -2452,7 +2489,7 @@ calculate_scale (MetaMonitor                *monitor,
   float diag_inches;
   g_autofree float *scales = NULL;
   int n_scales;
-  float best_scale, physical_dpi, perfect_scale, best_scale_error = 0.0f;
+  float best_scale, quarter_scale, physical_dpi, perfect_scale;
   int target_dpi;
 
   /*
@@ -2487,17 +2524,12 @@ calculate_scale (MetaMonitor                *monitor,
   scales = meta_monitor_calculate_supported_scales (monitor, monitor_mode,
                                                     constraints,
                                                     &n_scales);
-  best_scale = scales[0];
-  for (int i = 0; i < n_scales; i++)
-    {
-      float scale_error = fabsf (scales[i] - perfect_scale);
+  best_scale = find_closest_scale (scales, n_scales, perfect_scale, FALSE);
+  quarter_scale = find_closest_scale (scales, n_scales, perfect_scale, TRUE);
 
-      if (i == 0 || scale_error < best_scale_error)
-        {
-          best_scale = scales[i];
-          best_scale_error = scale_error;
-        }
-    }
+  if (fabsf (quarter_scale - perfect_scale) <=
+      fabsf (best_scale - perfect_scale) + UI_SCALE_STEP_TOLERANCE)
+    return quarter_scale;
 
   return best_scale;
 }
