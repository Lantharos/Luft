[Unit]
Description=Tell about Windows' Fast Startup once
After=kestrel-session.target graphical-session.target
PartOf=graphical-session.target
ConditionPathExists=!%S/luft/windows-notice
ConditionPathExists=|/run/luft-windows/hibernated
ConditionPathExists=|!%S/luft/windows-checked

[Service]
Type=exec
ExecStart=/usr/libexec/luft-windows notice
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service

[Install]
WantedBy=kestrel-session.target
