+/**
+ * clutter_stage_view_set_filter:
+ * @view: a #ClutterStageView
+ * @filter: (nullable): the filter, or %NULL for none
+ *
+ * Sends what @view paints through @filter on its way to the screen. Without
+ * one the view paints straight to the screen, and can scan out directly, as
+ * if this was never called.
+ */
+void
+clutter_stage_view_set_filter (ClutterStageView  *view,
+                               ClutterViewFilter *filter)
+{
+  ClutterStageViewPrivate *priv =
+    clutter_stage_view_get_instance_private (view);
+  gboolean had_filter = priv->filter != NULL;
+
+  if (priv->filter == filter)
+    return;
+
+  if (priv->filter)
+    clutter_view_filter_set_output (priv->filter, NULL);
+
+  g_set_object (&priv->filter, filter);
+
+  if (had_filter && filter && priv->offscreen)
+    {
+      ensure_stage_view_filter_output (view);
+      clutter_stage_view_queue_filter_frame (view);
+      return;
+    }
+
+  if (!filter)
+    {
+      g_clear_object (&priv->capture_scene);
+      g_clear_object (&priv->capture_result);
+    }
+
+  clutter_stage_view_invalidate_offscreen (view);
+
+  if (filter)
+    ensure_stage_view_offscreen_now (view);
+}
+
+/**
+ * clutter_stage_view_get_filter:
+ * @view: a #ClutterStageView
+ *
+ * Returns: (transfer none) (nullable): the filter @view sends what it paints through
+ */
+ClutterViewFilter *
+clutter_stage_view_get_filter (ClutterStageView *view)
+{
+  ClutterStageViewPrivate *priv =
+    clutter_stage_view_get_instance_private (view);
+
+  return priv->filter;
+}
+
+/**
+ * clutter_stage_view_queue_filter_frame:
+ * @view: a #ClutterStageView with a filter
+ *
+ * Draws the next frame through the filter again, without painting anything
+ * that hasn't changed, for a filter that moves by itself.
+ */
+void
+clutter_stage_view_queue_filter_frame (ClutterStageView *view)
+{
+  ClutterStageViewPrivate *priv =
+    clutter_stage_view_get_instance_private (view);
+
+  if (!priv->has_redraw_clip)
+    {
+      priv->redraw_clip = mtk_region_create ();
+      priv->has_redraw_clip = TRUE;
+    }
+
+  clutter_stage_view_schedule_update (view);
+}
+
+static CoglOffscreen *
+ensure_capture_target (CoglOffscreen    **target,
+                       CoglFramebuffer   *like)
+{
+  CoglContext *context = cogl_framebuffer_get_context (like);
+  g_autoptr (CoglTexture) texture = NULL;
+  g_autoptr (GError) error = NULL;
+
+  if (*target)
+    return *target;
+
+  texture = cogl_texture_2d_new_with_size (context,
+                                           cogl_framebuffer_get_width (like),
+                                           cogl_framebuffer_get_height (like));
+  *target = cogl_offscreen_new_with_texture (texture);
+  if (!cogl_framebuffer_allocate (COGL_FRAMEBUFFER (*target), &error))
+    g_warning ("Failed to allocate a filter capture: %s", error->message);
+
+  return *target;
+}
+
+CoglFramebuffer *
+clutter_stage_view_get_capture_scene (ClutterStageView *view)
+{
+  ClutterStageViewPrivate *priv =
+    clutter_stage_view_get_instance_private (view);
+
+  return COGL_FRAMEBUFFER (ensure_capture_target (&priv->capture_scene,
+                                                  COGL_FRAMEBUFFER (priv->offscreen)));
+}
+
+/* Runs the filter over the capture scene, and returns the result. */
+CoglTexture *
+clutter_stage_view_filter_capture (ClutterStageView *view)
+{
+  ClutterStageViewPrivate *priv =
+    clutter_stage_view_get_instance_private (view);
+  CoglOffscreen *result = ensure_capture_target (&priv->capture_result,
+                                                 COGL_FRAMEBUFFER (priv->offscreen));
+  CoglTexture *scene = cogl_offscreen_get_texture (priv->capture_scene);
+  g_autoptr (CoglPipeline) pipeline =
+    cogl_pipeline_copy (clutter_view_filter_run (priv->filter, scene));
+  graphene_matrix_t identity;
+
+  graphene_matrix_init_identity (&identity);
+  cogl_pipeline_set_layer_matrix (pipeline, 0, &identity);
+  cogl_framebuffer_draw_textured_rectangle (COGL_FRAMEBUFFER (result), pipeline,
+                                            -1, 1, 1, -1,
+                                            0, 0, 1, 1);
+  cogl_framebuffer_flush (COGL_FRAMEBUFFER (result));
+
+  return cogl_offscreen_get_texture (result);
+}
