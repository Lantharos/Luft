--- a/src/compositor/compositor.c
+++ b/src/compositor/compositor.c
@@ -157,6 +157,8 @@ typedef struct _MetaCompositorPrivate
   gboolean luca_from_wallpaper;
   CoglColor glass_surface;
   float glass_luminosity;
+  CoglColor niko_tint;
+  float niko_luminosity;
   unsigned int maris_requests;
 
   GSettings *kestrel_settings;
@@ -1687,6 +1689,49 @@ meta_compositor_get_glass_surface (MetaCompositor *compositor,
   return &priv->glass_surface;
 }
 
+/**
+ * meta_compositor_set_niko_tint:
+ * @compositor: a #MetaCompositor
+ * @tint: the colour Niko glass takes its lightness from, its alpha how much
+ *   of its hue and saturation the glass takes
+ * @luminosity: how far the blur under Niko glass takes the luminosity of
+ *   @tint
+ */
+void
+meta_compositor_set_niko_tint (MetaCompositor  *compositor,
+                               const CoglColor *tint,
+                               float            luminosity)
+{
+  MetaCompositorPrivate *priv =
+    meta_compositor_get_instance_private (compositor);
+
+  if (cogl_color_equal (&priv->niko_tint, tint) &&
+      priv->niko_luminosity == luminosity)
+    return;
+
+  priv->niko_tint = *tint;
+  priv->niko_luminosity = luminosity;
+  invalidate_background_blurs (compositor);
+}
+
+/**
+ * meta_compositor_get_niko_tint:
+ * @compositor: a #MetaCompositor
+ * @luminosity: (out): how far the blur takes the luminosity of the tint
+ *
+ * Returns: (transfer none): the tint of Niko glass
+ */
+const CoglColor *
+meta_compositor_get_niko_tint (MetaCompositor *compositor,
+                               float          *luminosity)
+{
+  MetaCompositorPrivate *priv =
+    meta_compositor_get_instance_private (compositor);
+
+  *luminosity = priv->niko_luminosity;
+  return &priv->niko_tint;
+}
+
 static MetaGlassMaterial
 luca_material (MetaCompositor *compositor)
 {
@@ -1696,6 +1741,15 @@ luca_material (MetaCompositor *compositor)
   return priv->luca_from_wallpaper ? META_GLASS_MATERIAL_WALLPAPER : META_GLASS_MATERIAL_LIVE;
 }
 
+static MetaGlassMaterial
+niko_material (MetaCompositor *compositor)
+{
+  MetaCompositorPrivate *priv =
+    meta_compositor_get_instance_private (compositor);
+
+  return priv->luca_from_wallpaper ? META_GLASS_MATERIAL_NIKO_WALLPAPER : META_GLASS_MATERIAL_NIKO;
+}
+
 MetaGlassMaterial
 meta_compositor_get_glass_material (MetaCompositor       *compositor,
                                     MetaGlassRole         role,
@@ -1711,12 +1765,24 @@ meta_compositor_get_glass_material (MetaCompositor       *compositor,
       return META_GLASS_MATERIAL_SURFACE;
     case META_GLASS_PREFERENCE_LUCA:
       return luca_material (compositor);
+    case META_GLASS_PREFERENCE_NIKO:
+      return niko_material (compositor);
     case META_GLASS_PREFERENCE_USER:
       break;
     }
 
   style = role == META_GLASS_ROLE_TRANSIENT ? priv->glass_transients : priv->glass_windows;
-  return style == META_GLASS_STYLE_MARIS ? META_GLASS_MATERIAL_SURFACE : luca_material (compositor);
+  switch (style)
+    {
+    case META_GLASS_STYLE_MARIS:
+      return META_GLASS_MATERIAL_SURFACE;
+    case META_GLASS_STYLE_NIKO:
+      return niko_material (compositor);
+    case META_GLASS_STYLE_LUCA:
+      break;
+    }
+
+  return luca_material (compositor);
 }
 
 void
