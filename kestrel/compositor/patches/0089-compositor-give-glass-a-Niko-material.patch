+                                   float            luminosity);
+
 #define CLUTTER_TYPE_EFFECT_NODE                (clutter_effect_node_get_type ())
 #define CLUTTER_EFFECT_NODE(obj)                (G_TYPE_CHECK_INSTANCE_CAST ((obj), CLUTTER_TYPE_EFFECT_NODE, ClutterEffectNode))
 #define CLUTTER_IS_EFFECT_NODE(obj)             (G_TYPE_CHECK_INSTANCE_TYPE ((obj), CLUTTER_TYPE_EFFECT_NODE))
diff --git a/clutter/clutter/clutter-paint-nodes.c b/clutter/clutter/clutter-paint-nodes.c
index ccf8992188249099a3d26de02402b136b29d816e..84303b15bb460b6e41c38f75db5a401b9a6fac91 100644
--- a/clutter/clutter/clutter-paint-nodes.c
+++ b/clutter/clutter/clutter-paint-nodes.c
@@ -1674,11 +1674,15 @@ clutter_blur_node_get_grain (CoglContext *context)
   return grain;
 }
 
+#define NIKO_SPECKLE 0.02f
+
 static const char *blur_framebuffer_effect_declarations =
   "uniform float blur_framebuffer_saturation;                               \n"
   "uniform float blur_framebuffer_noise;                                    \n"
   "uniform vec4 blur_framebuffer_tint;                                      \n"
   "uniform float blur_framebuffer_luminosity;                               \n"
+  "uniform float blur_framebuffer_hue;                                      \n"
+  "uniform float blur_framebuffer_speckle;                                  \n"
   "                                                                          \n"
   "float blur_framebuffer_lum (vec3 color)                                  \n"
   "{                                                                        \n"
@@ -1710,7 +1714,11 @@ static const char *blur_framebuffer_effect_source =
   "                   blur_framebuffer_luminosity);                          \n"
   "      color = mix (color, blur_framebuffer_tint.rgb,                      \n"
   "                   blur_framebuffer_tint.a);                              \n"
-  "      if (blur_framebuffer_noise > 0.0)                                   \n"
+  "      color = mix (color,                                                 \n"
+  "                   blur_framebuffer_set_lum (blur_framebuffer_tint.rgb,   \n"
+  "                     blur_framebuffer_lum (color)),                       \n"
+  "                   blur_framebuffer_hue);                                 \n"
+  "      if (blur_framebuffer_noise > 0.0 || blur_framebuffer_speckle > 0.0) \n"
   "        {                                                                 \n"
   "          vec2 grain_cell = mod (floor (gl_FragCoord.xy), 64.0);          \n"
   "          float grain = texture2D (cogl_sampler1,                         \n"
@@ -1719,26 +1727,31 @@ static const char *blur_framebuffer_effect_source =
   "            (mod (grain_cell + vec2 (32.0, 21.0), 64.0) + 0.5) / 64.0).r; \n"
   "          color += vec3 ((grain - 1.0) * blur_framebuffer_noise *         \n"
   "            mix (0.5, 1.0, dot (color, vec3 (0.2126, 0.7152, 0.0722)))); \n"
+  "          color = mix (color, vec3 (grain * 0.5), blur_framebuffer_speckle); \n"
   "        }                                                                 \n"
   "      color = clamp (color, vec3 (0.0), vec3 (1.0));                      \n"
   "                                                                          \n"
   "      cogl_color_out.rgb = color * cogl_color_out.a;                      \n"
   "    }                                                                     \n";
 
-void
-clutter_blur_add_framebuffer_effect (CoglPipeline    *pipeline,
-                                     float            saturation,
-                                     float            noise,
-                                     const CoglColor *tint,
-                                     float            luminosity)
+static void
+set_uniform (CoglPipeline *pipeline,
+             const char   *name,
+             float         value)
 {
-  static CoglSnippet *snippet;
-  int saturation_uniform;
-  int noise_uniform;
-  float tint_color[4] = { 0.f, 0.f, 0.f, 0.f };
+  cogl_pipeline_set_uniform_1f (pipeline, cogl_pipeline_get_uniform_location (pipeline, name), value);
+}
 
-  if (saturation == 1.0f && noise == 0.0f && !tint)
-    return;
+static void
+add_effect (CoglPipeline    *pipeline,
+            float            saturation,
+            float            noise,
+            const float     *tint,
+            float            luminosity,
+            float            hue,
+            float            speckle)
+{
+  static CoglSnippet *snippet;
 
   if (!snippet)
     snippet = cogl_snippet_new (COGL_SNIPPET_HOOK_FRAGMENT,
@@ -1752,16 +1765,28 @@ clutter_blur_add_framebuffer_effect (CoglPipeline    *pipeline,
   cogl_pipeline_set_layer_combine (pipeline, 1, "RGBA = REPLACE(PREVIOUS)", NULL);
   cogl_pipeline_add_snippet (pipeline, snippet);
 
-  saturation_uniform =
-    cogl_pipeline_get_uniform_location (pipeline,
-                                        "blur_framebuffer_saturation");
-  if (saturation_uniform > -1)
-    cogl_pipeline_set_uniform_1f (pipeline, saturation_uniform, saturation);
+  set_uniform (pipeline, "blur_framebuffer_saturation", saturation);
+  set_uniform (pipeline, "blur_framebuffer_noise", noise);
+  set_uniform (pipeline, "blur_framebuffer_luminosity", luminosity);
+  set_uniform (pipeline, "blur_framebuffer_hue", hue);
+  set_uniform (pipeline, "blur_framebuffer_speckle", speckle);
+  cogl_pipeline_set_uniform_float (pipeline,
+                                   cogl_pipeline_get_uniform_location (pipeline,
+                                                                       "blur_framebuffer_tint"),
+                                   4, 1, tint);
+}
+
+void
+clutter_blur_add_framebuffer_effect (CoglPipeline    *pipeline,
+                                     float            saturation,
+                                     float            noise,
+                                     const CoglColor *tint,
+                                     float            luminosity)
+{
+  float tint_color[4] = { 0.f, 0.f, 0.f, 0.f };
 
-  noise_uniform =
-    cogl_pipeline_get_uniform_location (pipeline, "blur_framebuffer_noise");
-  if (noise_uniform > -1)
-    cogl_pipeline_set_uniform_1f (pipeline, noise_uniform, noise);
+  if (saturation == 1.0f && noise == 0.0f && !tint)
+    return;
 
   if (tint)
     {
@@ -1770,14 +1795,23 @@ clutter_blur_add_framebuffer_effect (CoglPipeline    *pipeline,
       tint_color[2] = cogl_color_get_blue (tint);
       tint_color[3] = cogl_color_get_alpha (tint);
     }
-  cogl_pipeline_set_uniform_float (pipeline,
-                                   cogl_pipeline_get_uniform_location (pipeline,
-                                                                       "blur_framebuffer_tint"),
-                                   4, 1, tint_color);
-  cogl_pipeline_set_uniform_1f (pipeline,
-                                cogl_pipeline_get_uniform_location (pipeline,
-                                                                    "blur_framebuffer_luminosity"),
-                                luminosity);
+  add_effect (pipeline, saturation, noise, tint_color, luminosity, 0.f, 0.f);
+}
+
+void
+clutter_blur_add_niko_effect (CoglPipeline    *pipeline,
+                              const CoglColor *tint,
+                              float            luminosity)
+{
+  float tint_color[4] = {
+    cogl_color_get_red (tint),
+    cogl_color_get_green (tint),
+    cogl_color_get_blue (tint),
+    0.f,
+  };
+
+  add_effect (pipeline, 1.f, 0.f, tint_color, luminosity,
+              cogl_color_get_alpha (tint), NIKO_SPECKLE);
 }
 
 static gboolean
