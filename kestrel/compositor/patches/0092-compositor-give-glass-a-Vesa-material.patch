--- a/src/compositor/compositor.c
+++ b/src/compositor/compositor.c
@@ -151,7 +151,7 @@ typedef struct _MetaCompositorPrivate
   float background_blur_radius;
   float background_saturation;
   float background_noise;
-  GArray *frosted_wallpaper[2];
+  GArray *frosted_wallpaper[3];
   MetaGlassStyle glass_windows;
   MetaGlassStyle glass_transients;
   gboolean luca_from_wallpaper;
@@ -1459,6 +1459,7 @@ meta_compositor_dispose (GObject *object)
   g_clear_pointer (&priv->uncovered, mtk_region_unref);
   g_clear_pointer (&priv->frosted_wallpaper[META_WALLPAPER_FROST_BLURRED], g_array_unref);
   g_clear_pointer (&priv->frosted_wallpaper[META_WALLPAPER_FROST_WIDE], g_array_unref);
+  g_clear_pointer (&priv->frosted_wallpaper[META_WALLPAPER_FROST_CLEAR], g_array_unref);
 
   G_OBJECT_CLASS (meta_compositor_parent_class)->dispose (object);
 }
@@ -1750,6 +1751,15 @@ niko_material (MetaCompositor *compositor)
   return priv->luca_from_wallpaper ? META_GLASS_MATERIAL_NIKO_WALLPAPER : META_GLASS_MATERIAL_NIKO;
 }
 
+static MetaGlassMaterial
+vesa_material (MetaCompositor *compositor)
+{
+  MetaCompositorPrivate *priv =
+    meta_compositor_get_instance_private (compositor);
+
+  return priv->luca_from_wallpaper ? META_GLASS_MATERIAL_VESA_WALLPAPER : META_GLASS_MATERIAL_VESA;
+}
+
 MetaGlassMaterial
 meta_compositor_get_glass_material (MetaCompositor       *compositor,
                                     MetaGlassRole         role,
@@ -1767,6 +1777,8 @@ meta_compositor_get_glass_material (MetaCompositor       *compositor,
       return luca_material (compositor);
     case META_GLASS_PREFERENCE_NIKO:
       return niko_material (compositor);
+    case META_GLASS_PREFERENCE_VESA:
+      return vesa_material (compositor);
     case META_GLASS_PREFERENCE_USER:
       break;
     }
@@ -1778,6 +1790,8 @@ meta_compositor_get_glass_material (MetaCompositor       *compositor,
       return META_GLASS_MATERIAL_SURFACE;
     case META_GLASS_STYLE_NIKO:
       return niko_material (compositor);
+    case META_GLASS_STYLE_VESA:
+      return vesa_material (compositor);
     case META_GLASS_STYLE_LUCA:
       break;
     }
@@ -1843,7 +1857,7 @@ meta_compositor_clear_frosted_wallpaper (MetaCompositor     *compositor,
  *
  * Adds a piece of blurred wallpaper that glass shows instead of blurring
  * what is behind it: the blurred one for Luca glass that blurs only the
- * wallpaper, the wide one for Maris.
+ * wallpaper, the wide one for Maris and the clear one for Vesa shell glass.
  */
