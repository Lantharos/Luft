[Unit]
Description=Luft installer and first-run setup

[Service]
Type=dbus
BusName=com.lantharos.Installer1
ExecStart=/usr/libexec/installer
SELinuxContext=system_u:system_r:install_t:s0
SyslogIdentifier=installer
RuntimeDirectory=installer
RuntimeDirectoryPreserve=yes
StateDirectory=installer
KillMode=mixed
TimeoutStopSec=5min
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
