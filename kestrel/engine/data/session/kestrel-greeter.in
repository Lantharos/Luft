#!/bin/sh
XDG_DATA_DIRS="${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
case ":$XDG_DATA_DIRS:" in
  *:@datadir@:*) ;;
  *) XDG_DATA_DIRS="@datadir@:$XDG_DATA_DIRS" ;;
esac
export XDG_DATA_DIRS
export XDG_CONFIG_DIRS="/var/lib/kestrel-greeter/display:${XDG_CONFIG_DIRS:-/etc/xdg}"
export GSETTINGS_BACKEND=memory
exec systemd-cat --identifier=kestrel-greeter dbus-run-session -- @bindir@/kestrel --greeter --wayland --display-server --no-x11
