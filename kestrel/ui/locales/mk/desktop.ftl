## App menu (right-click on a taskbar app)

window-menu-open = Отвори
window-menu-new-window = Нов прозорец
window-menu-restore = Врати
window-menu-minimize = Минимизирај
window-menu-maximize = Максимизирај
window-menu-unmaximize = Врати во нормална големина
window-menu-pin = Закачи на лентата со задачи
window-menu-unpin = Откачи од лентата со задачи
window-menu-close = { $count ->
    [one] Затвори го прозорецот
   *[other] Затвори ги сите прозорци
}

## Context menus

context-menu-back = Назад

## Window previews (hovering a taskbar app)

previews-close-window = Затвори { $title }

## Tray

tray-apps = Апликации во системската област
tray-open-app = Отвори { $appName }

## Board (tablet window layout)

board-open-start = Отвори го менито Старт
board-show-all-windows = Прикажи ги сите прозорци
board-quick-settings = Брзи поставки

## Task view

task-view-close-window = Затвори го прозорецот
task-view-desktop = Работен простор { $number }

## Snap layouts

snap-zone = Прилепи во област од { $width }% на { $height }%

## Window title bars

title-bar-minimize = Минимизирај
title-bar-maximize = Максимизирај
title-bar-close = Затвори

## Window resizing

window-resize-size = { $width } × { $height }

## App not responding

close-dialog-title = „{ $appName }“ не одговара
