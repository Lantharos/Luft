+G_BEGIN_DECLS
+
+/**
+ * ClutterGraphicsRecoveryState:
+ * @CLUTTER_GRAPHICS_RECOVERY_STATE_NORMAL: Operating normally.
+ * @CLUTTER_GRAPHICS_RECOVERY_STATE_RESET_IN_PROGRESS: A graphics reset has
+ * been detected and might be actively underway.
+ * @CLUTTER_GRAPHICS_RECOVERY_STATE_RESET_COMPLETED: The hardware has finished
+ * resetting; it is now safe to recreate resources.
+ * @CLUTTER_GRAPHICS_RECOVERY_STATE_RESTORING: Recreating resources, and
+ * restoring compositor state.
+ * @CLUTTER_GRAPHICS_RECOVERY_STATE_FAILED: The recovery process could not be
+ * completed due to an error.
+ *
+ * Represents the state of the graphics pipeline in the graphics recovery cycle.
+ */
+typedef enum _ClutterGraphicsRecoveryState
+{
+  CLUTTER_GRAPHICS_RECOVERY_STATE_NORMAL,
+  CLUTTER_GRAPHICS_RECOVERY_STATE_RESET_IN_PROGRESS,
+  CLUTTER_GRAPHICS_RECOVERY_STATE_RESET_COMPLETED,
+  CLUTTER_GRAPHICS_RECOVERY_STATE_RESTORING,
+  CLUTTER_GRAPHICS_RECOVERY_STATE_FAILED,
+} ClutterGraphicsRecoveryState;
+
+#define CLUTTER_TYPE_GRAPHICS_RECOVERY_CONTEXT (clutter_graphics_recovery_context_get_type ())
+
+CLUTTER_EXPORT
+G_DECLARE_FINAL_TYPE (ClutterGraphicsRecoveryContext,
+                      clutter_graphics_recovery_context,
+                      CLUTTER,
+                      GRAPHICS_RECOVERY_CONTEXT,
+                      GObject)
+
+CLUTTER_EXPORT
+ClutterGraphicsRecoveryState clutter_graphics_recovery_context_get_state (ClutterGraphicsRecoveryContext *context);
+
+CLUTTER_EXPORT
+gboolean clutter_graphics_recovery_context_is_in_progress (ClutterGraphicsRecoveryContext *context);
+
+G_END_DECLS
