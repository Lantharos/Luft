## Fingerprints
## Each finger has a name used as a title (the message value) and a form used inside
## a sentence (.inline), like "Place your … on the sensor." Adjust the case of .inline
## to fit those sentences.

ui-finger-right-index = Hægri vísifingur
    .inline = hægri vísifingur
ui-finger-left-index = Vinstri vísifingur
    .inline = vinstri vísifingur
ui-finger-right-thumb = Hægri þumalfingur
    .inline = hægri þumalfingur
ui-finger-left-thumb = Vinstri þumalfingur
    .inline = vinstri þumalfingur
ui-finger-right-middle = Hægri langatöng
    .inline = hægri löngutöng
ui-finger-left-middle = Vinstri langatöng
    .inline = vinstri löngutöng
ui-finger-right-ring = Hægri baugfingur
    .inline = hægri baugfingur
ui-finger-left-ring = Vinstri baugfingur
    .inline = vinstri baugfingur
ui-finger-right-little = Hægri litlifingur
    .inline = hægri litlafingur
ui-finger-left-little = Vinstri litlifingur
    .inline = vinstri litlafingur

ui-fingerprint-place = Leggðu { $finger } á skynjarann.
ui-fingerprint-swipe = Dragðu { $finger } yfir skynjarann.
ui-fingerprint-stage-passed = Gott. Lyftu fingrinum og leggðu hann svo aftur á.
ui-fingerprint-stage-passed-swipe = Gott. Dragðu aftur.
ui-fingerprint-retry = Lesturinn tókst ekki. Reyndu aftur.
ui-fingerprint-swipe-too-short = Dragðu aðeins hægar.
ui-fingerprint-not-centered = Leggðu fingurinn á miðjan skynjarann.
ui-fingerprint-remove-and-retry = Lyftu fingrinum og reyndu aftur.
ui-fingerprint-added = Fingrafari bætt við.
ui-fingerprint-full = Lesarinn hefur ekki pláss fyrir fleiri fingraför.
ui-fingerprint-disconnected = Fingrafaralesarinn hætti að svara. Reyndu aftur eftir smástund.
ui-fingerprint-duplicate = Lesarinn hefur þegar vistað þennan fingur, líklega úr Windows eða öðrum aðgangi. Notaðu annan fingur.
ui-fingerprint-failed = Ekki tókst að bæta þessu fingrafari við. Reyndu aftur.

