diff --git a/src/core/meta-dbus-guard.c b/src/core/meta-dbus-guard.c
index cbd2d79ab10cb8a12806f60a162b336f9d4a029e..24b3b23957200a813e916454a691b3330f808820 100644
--- a/src/core/meta-dbus-guard.c
+++ b/src/core/meta-dbus-guard.c
@@ -6,6 +6,7 @@
 #include "core/meta-sandbox.h"
 
 #define SANDBOXED_KEY "-meta-dbus-guard-sandboxed"
+#define GUARD_KEY "-meta-dbus-guard"
 
 typedef struct
 {
@@ -13,6 +14,20 @@ typedef struct
   const char * const *open_methods;
 } Guard;
 
+typedef struct
+{
+  GDBusInterfaceVTable * (* get_vtable) (GDBusInterfaceSkeleton *skeleton);
+  GDBusInterfaceVTable vtable;
+  GDBusInterfaceSetPropertyFunc set_property;
+  size_t filled;
+} GuardedClass;
+
+static GQuark
+guarded_class_quark (void)
+{
+  return g_quark_from_static_string ("meta-dbus-guarded-class");
+}
+
 static gboolean
 authorize_method (GDBusInterfaceSkeleton *skeleton,
                   GDBusMethodInvocation  *invocation,
@@ -49,7 +64,8 @@ authorize_method (GDBusInterfaceSkeleton *skeleton,
  *
  * Keeps every method of @skeleton to callers outside a sandbox and apps given
  * full access, except those in @open_methods. A caller that can't be
- * identified counts as sandboxed.
+ * identified counts as sandboxed. Writable properties need
+ * meta_dbus_guard_property_writes() on the skeleton's class as well.
  */
 void
 meta_dbus_guard_interface (GDBusInterfaceSkeleton *skeleton,
@@ -60,11 +76,129 @@ meta_dbus_guard_interface (GDBusInterfaceSkeleton *skeleton,
 
   guard->context = context;
   guard->open_methods = open_methods;
+  g_object_set_data (G_OBJECT (skeleton), GUARD_KEY, guard);
   g_signal_connect_data (skeleton, "g-authorize-method",
                          G_CALLBACK (authorize_method), guard,
                          (GClosureNotify) g_free, G_CONNECT_DEFAULT);
 }
 
+static GuardedClass *
+guarded_class_of (GDBusInterfaceSkeleton *skeleton)
+{
+  GType type = G_OBJECT_TYPE (skeleton);
+  GuardedClass *guarded;
+
+  while (!(guarded = g_type_get_qdata (type, guarded_class_quark ())))
+    type = g_type_parent (type);
+
+  return guarded;
+}
+
+static gboolean
+set_property (GDBusConnection  *connection,
+              const char       *sender,
+              const char       *object_path,
+              const char       *interface_name,
+              const char       *property_name,
+              GVariant         *value,
+              GError          **error,
+              gpointer          user_data)
+{
+  GDBusInterfaceSkeleton *skeleton = user_data;
+  Guard *guard = g_object_get_data (G_OBJECT (skeleton), GUARD_KEY);
+
+  if (!guard ||
+      !meta_dbus_sender_is_unsandboxed (guard->context, connection, sender))
+    {
+      g_set_error (error, G_DBUS_ERROR, G_DBUS_ERROR_ACCESS_DENIED,
+                   "Sandboxed apps cannot set %s.%s",
+                   interface_name, property_name);
+      return FALSE;
+    }
+
+  return guarded_class_of (skeleton)->set_property (connection, sender,
+                                                    object_path, interface_name,
+                                                    property_name, value,
+                                                    error, user_data);
+}
+
+static GDBusInterfaceVTable *
+get_vtable (GDBusInterfaceSkeleton *skeleton)
+{
+  GuardedClass *guarded = guarded_class_of (skeleton);
+
+  if (g_once_init_enter (&guarded->filled))
+    {
+      guarded->vtable = *guarded->get_vtable (skeleton);
+      guarded->set_property = guarded->vtable.set_property;
+      guarded->vtable.set_property = set_property;
+      g_once_init_leave (&guarded->filled, 1);
+    }
+
+  return &guarded->vtable;
+}
+
+/*
+ * meta_dbus_guard_property_writes:
+ * @klass: the class of a skeleton Mutter exports, from its class_init
+ *
+ * Keeps the writable properties of the class's interface to the callers
+ * meta_dbus_guard_interface() lets call every method. An instance that
+ * was never passed to it takes no writes at all.
+ */
+void
+meta_dbus_guard_property_writes (GDBusInterfaceSkeletonClass *klass)
+{
+  GuardedClass *guarded = g_new0 (GuardedClass, 1);
+
+  guarded->get_vtable = klass->get_vtable;
+  klass->get_vtable = get_vtable;
+  g_type_set_qdata (G_TYPE_FROM_CLASS (klass), guarded_class_quark (), guarded);
+}
+
+static void
+guarded_class_init (gpointer klass,
+                    gpointer class_data)
+{
+  meta_dbus_guard_property_writes (klass);
+}
+
+/*
+ * meta_dbus_guarded_skeleton_new:
+ * @skeleton_type: a generated skeleton type
+ * @context: the #MetaContext
+ *
+ * Makes a skeleton whose methods and writable properties sandboxed apps
+ * can't reach, for interfaces that have no type of their own in Mutter.
+ *
+ * Returns: (transfer full): the skeleton
+ */
+GDBusInterfaceSkeleton *
+meta_dbus_guarded_skeleton_new (GType        skeleton_type,
+                                MetaContext *context)
+{
+  g_autofree char *name =
+    g_strconcat ("MetaGuarded", g_type_name (skeleton_type), NULL);
+  GType type = g_type_from_name (name);
+  GDBusInterfaceSkeleton *skeleton;
+
+  if (!type)
+    {
+      GTypeQuery query;
+      GTypeInfo info = { 0 };
+
+      g_type_query (skeleton_type, &query);
+      info.class_size = query.class_size;
+      info.class_init = guarded_class_init;
+      info.instance_size = query.instance_size;
+      type = g_type_register_static (skeleton_type, name, &info, 0);
+    }
+
+  skeleton = g_object_new (type, NULL);
+  meta_dbus_guard_interface (skeleton, context, NULL);
+  return skeleton;
+}
+
 gboolean
 meta_dbus_caller_is_sandboxed (GDBusMethodInvocation *invocation)
 {
diff --git a/src/core/meta-dbus-guard.h b/src/core/meta-dbus-guard.h
index da3d7059dadc6e1581f945898860de934ed219ae..5a3a59fa9af1ba5ebc07df506a121f59975c1ca5 100644
--- a/src/core/meta-dbus-guard.h
+++ b/src/core/meta-dbus-guard.h
@@ -9,4 +9,9 @@ void meta_dbus_guard_interface (GDBusInterfaceSkeleton *skeleton,
                                 MetaContext            *context,
                                 const char * const     *open_methods);
 
+void meta_dbus_guard_property_writes (GDBusInterfaceSkeletonClass *klass);
+
+GDBusInterfaceSkeleton * meta_dbus_guarded_skeleton_new (GType        skeleton_type,
+                                                         MetaContext *context);
+
 gboolean meta_dbus_caller_is_sandboxed (GDBusMethodInvocation *invocation);
