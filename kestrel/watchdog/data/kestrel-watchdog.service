[Unit]
Description=Kestrel graphics watchdog
DefaultDependencies=no
After=dbus.service
SurviveFinalKillSignal=yes

[Service]
ExecStart=@libexecdir@/kestrel-watchdog
StateDirectory=kestrel-watchdog
Group=wheel
UMask=0027
StateDirectoryMode=0750
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
NoNewPrivileges=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_SYS_PTRACE CAP_SYSLOG CAP_LINUX_IMMUTABLE CAP_DAC_OVERRIDE
