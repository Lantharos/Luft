@@ -0,0 +1,32 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "config.h"
+
+#include "core/window-private.h"
+
+/**
+ * meta_window_get_titlebar_height:
+ * @window: a #MetaWindow
+ *
+ * Gets the height of the title bar the compositor draws for @window, at
+ * the top of its frame rect, because its client asked for server-side
+ * decorations.
+ *
+ * Returns: the title bar height in stage pixels, or 0 when the client
+ *   draws its own decorations or the window is fullscreen
+ */
+int
+meta_window_get_titlebar_height (MetaWindow *window)
+{
+  return window->titlebar_height;
+}
+
+void
+meta_window_set_titlebar_height (MetaWindow *window,
+                                 int         height)
+{
+  if (window->titlebar_height == height)
+    return;
+
+  window->titlebar_height = height;
+  g_object_notify (G_OBJECT (window), "titlebar-height");
+}
