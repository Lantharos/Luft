 pub const BIOS_BOOT: &str = "21686148-6449-6e6f-744e-656564454649";
 
+/// Extended Boot Loader Partition (XBOOTLDR) type GUID for GPT
+pub const XBOOTLDR: &str = "bc13c2ff-59e6-4262-a352-b275fd6f7172";
