+
+#include "config.h"
+
+#include "meta-frame-style.h"
+
+static void
+load_palette (GtkCssProvider *palette,
+              GFile          *file)
+{
+  if (g_file_query_exists (file, NULL))
+    gtk_css_provider_load_from_file (palette, file);
+  else
+    gtk_css_provider_load_from_string (palette, "");
+}
+
+static void
+on_palette_changed (GFileMonitor      *monitor,
+                    GFile             *file,
+                    GFile             *other_file,
+                    GFileMonitorEvent  event,
+                    GtkCssProvider    *palette)
+{
+  switch (event)
+    {
+    case G_FILE_MONITOR_EVENT_CHANGES_DONE_HINT:
+    case G_FILE_MONITOR_EVENT_CREATED:
+    case G_FILE_MONITOR_EVENT_DELETED:
+      load_palette (palette, file);
+      break;
+    default:
+      break;
+    }
+}
+
+static GtkCssProvider *
+add_provider (GdkDisplay *display)
+{
+  GtkCssProvider *provider = gtk_css_provider_new ();
+
+  g_object_bind_property (gtk_settings_get_for_display (display), "gtk-interface-color-scheme",
+                          provider, "prefers-color-scheme",
+                          G_BINDING_SYNC_CREATE);
+  gtk_style_context_add_provider_for_display (display, GTK_STYLE_PROVIDER (provider),
+                                              GTK_STYLE_PROVIDER_PRIORITY_APPLICATION);
+  return provider;
+}
+
+void
+meta_frame_style_init (GdkDisplay *display)
+{
+  GtkCssProvider *frames, *palette;
+  g_autoptr (GFile) file = NULL;
+  GFileMonitor *monitor;
+
+  frames = add_provider (display);
+  gtk_css_provider_load_from_resource (frames, "/org/gnome/mutter/frames/frames.css");
+
+  file = g_file_new_build_filename (g_get_user_config_dir (), "kestrel", "appearance.css", NULL);
+  palette = add_provider (display);
+  load_palette (palette, file);
+
+  monitor = g_file_monitor_file (file, G_FILE_MONITOR_NONE, NULL, NULL);
+  if (monitor)
+    g_signal_connect (monitor, "changed", G_CALLBACK (on_palette_changed), palette);
+}
