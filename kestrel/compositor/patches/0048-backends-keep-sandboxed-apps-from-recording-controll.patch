diff --git a/src/backends/meta-dbus-access-checker.c b/src/backends/meta-dbus-access-checker.c
index 0ace12607751be46508a315b9788c4ebd5fb791e..3b9e942c83d5bb87887dfa39d2de84b18fa92a9f 100644
--- a/src/backends/meta-dbus-access-checker.c
+++ b/src/backends/meta-dbus-access-checker.c
@@ -21,7 +21,11 @@
 
 #include "meta-dbus-access-checker.h"
 
+#include <gio/gunixfdlist.h>
+#include <glib/gstdio.h>
+
 #include "core/meta-context-private.h"
+#include "core/meta-sandbox.h"
 
 enum
 {
@@ -210,3 +214,38 @@ meta_dbus_access_checker_is_sender_allowed (MetaDbusAccessChecker *self,
 
   return FALSE;
 }
+
+gboolean
+meta_dbus_sender_is_unsandboxed (MetaContext     *context,
+                                 GDBusConnection *connection,
+                                 const char      *sender_name)
+{
+  g_autoptr (GUnixFDList) fd_list = NULL;
+  g_autoptr (GVariant) reply = NULL;
+  g_autoptr (GVariant) credentials = NULL;
+  g_autofd int pidfd = -1;
+  int32_t pidfd_handle;
+  uint32_t pid;
+
+  reply = g_dbus_connection_call_with_unix_fd_list_sync (connection,
+                                                         "org.freedesktop.DBus",
+                                                         "/org/freedesktop/DBus",
+                                                         "org.freedesktop.DBus",
+                                                         "GetConnectionCredentials",
+                                                         g_variant_new ("(s)", sender_name),
+                                                         G_VARIANT_TYPE ("(a{sv})"),
+                                                         G_DBUS_CALL_FLAGS_NONE,
+                                                         -1, NULL, &fd_list,
+                                                         NULL, NULL);
+  if (!reply)
+    return FALSE;
+
+  credentials = g_variant_get_child_value (reply, 0);
+  if (!fd_list ||
+      !g_variant_lookup (credentials, "ProcessFD", "h", &pidfd_handle) ||
+      !g_variant_lookup (credentials, "ProcessID", "u", &pid))
+    return FALSE;
+
+  pidfd = g_unix_fd_list_get (fd_list, pidfd_handle, NULL);
+  return pidfd >= 0 && meta_process_is_unsandboxed (context, pidfd, pid);
+}
diff --git a/src/backends/meta-dbus-access-checker.h b/src/backends/meta-dbus-access-checker.h
index acbb942c0c54ad74fe394f76f3a8137733f2cc90..64a1a2fe8ef534ec584d398da37b80743b90be60 100644
--- a/src/backends/meta-dbus-access-checker.h
+++ b/src/backends/meta-dbus-access-checker.h
@@ -37,3 +37,7 @@ void meta_dbus_access_checker_allow_sender (MetaDbusAccessChecker *self,
 
 gboolean meta_dbus_access_checker_is_sender_allowed (MetaDbusAccessChecker *self,
                                                      const char            *sender_name);
+
+gboolean meta_dbus_sender_is_unsandboxed (MetaContext     *context,
+                                          GDBusConnection *connection,
+                                          const char      *sender_name);
diff --git a/src/backends/meta-dbus-session-manager.c b/src/backends/meta-dbus-session-manager.c
index 3944bca391936fadcf020452937a533b82467773..655c0084781b86d698d87a2f7c83211aeef63dab 100644
--- a/src/backends/meta-dbus-session-manager.c
+++ b/src/backends/meta-dbus-session-manager.c
@@ -23,8 +23,12 @@
 #include <gobject/gvaluecollector.h>
 
 #include "backends/meta-backend-private.h"
+#include "backends/meta-dbus-access-checker.h"
 #include "backends/meta-dbus-session-watcher.h"
 
+#define PORTAL_BACKEND_NAME "org.freedesktop.impl.portal.desktop.kestrel"
+#define SCREENCAST_SERVICE_NAME "com.lantharos.Kestrel.Screencast"
+
 enum
 {
   ENABLED,
@@ -60,6 +64,8 @@ typedef struct _MetaDbusSessionManagerPrivate
 
   guint dbus_name_id;
   GDBusInterfaceSkeleton *interface_skeleton;
+  MetaDbusAccessChecker *portal_checker;
+  MetaDbusAccessChecker *screencast_checker;
 
   gboolean is_enabled;
 
@@ -107,10 +113,39 @@ meta_dbus_session_manager_finalize (GObject *object)
   g_clear_pointer (&priv->service_path, g_free);
 
   g_clear_object (&priv->interface_skeleton);
+  g_clear_object (&priv->portal_checker);
+  g_clear_object (&priv->screencast_checker);
 
   G_OBJECT_CLASS (meta_dbus_session_manager_parent_class)->finalize (object);
 }
 
+static gboolean
+authorize_method (GDBusInterfaceSkeleton *interface_skeleton,
+                  GDBusMethodInvocation  *invocation,
+                  MetaDbusSessionManager *session_manager)
+{
+  MetaDbusSessionManagerPrivate *priv =
+    meta_dbus_session_manager_get_instance_private (session_manager);
+  const char *sender = g_dbus_method_invocation_get_sender (invocation);
+
+  if (!g_str_equal (g_dbus_method_invocation_get_method_name (invocation),
+                    "CreateSession") ||
+      meta_dbus_access_checker_is_sender_allowed (priv->portal_checker, sender))
+    return TRUE;
+
+  if (meta_dbus_access_checker_is_sender_allowed (priv->screencast_checker, sender) &&
+      meta_dbus_sender_is_unsandboxed (meta_backend_get_context (priv->backend),
+                                       g_dbus_method_invocation_get_connection (invocation),
+                                       sender))
+    return TRUE;
+
+  g_dbus_method_invocation_return_error (invocation,
+                                         G_DBUS_ERROR,
+                                         G_DBUS_ERROR_ACCESS_DENIED,
+                                         "Only the desktop portal may create sessions");
+  return FALSE;
+}
+
 static void
 on_bus_acquired (GDBusConnection *connection,
                  const char      *name,
@@ -120,8 +155,18 @@ on_bus_acquired (GDBusConnection *connection,
     META_DBUS_SESSION_MANAGER (user_data);
   MetaDbusSessionManagerPrivate *priv =
     meta_dbus_session_manager_get_instance_private (session_manager);
+  MetaContext *context = meta_backend_get_context (priv->backend);
   g_autoptr (GError) error = NULL;
 
+  priv->portal_checker = meta_dbus_access_checker_new (connection, context);
+  meta_dbus_access_checker_allow_sender (priv->portal_checker,
+                                         PORTAL_BACKEND_NAME);
+  priv->screencast_checker = meta_dbus_access_checker_new (connection, context);
+  meta_dbus_access_checker_allow_sender (priv->screencast_checker,
+                                         SCREENCAST_SERVICE_NAME);
+  g_signal_connect (priv->interface_skeleton, "g-authorize-method",
+                    G_CALLBACK (authorize_method), session_manager);
+
   meta_topic (META_DEBUG_BACKEND,
               "Acquired D-Bus name '%s', exporting service on '%s'",
               priv->service_name, priv->service_path);
diff --git a/src/backends/meta-display-config-skeleton.c b/src/backends/meta-display-config-skeleton.c
new file mode 100644
index 0000000000000000000000000000000000000000..7a106e709e5cf45029436de75e0b18d9a0d0b7e8
--- /dev/null
+++ b/src/backends/meta-display-config-skeleton.c
@@ -0,0 +1,113 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "config.h"
+
+#include "backends/meta-display-config-skeleton.h"
+
+#include "backends/meta-dbus-access-checker.h"
+
+#define ACCESS_DENIED_MESSAGE "Sandboxed apps cannot change displays"
+
+struct _MetaDisplayConfigSkeleton
+{
+  MetaDBusDisplayConfigSkeleton parent;
+
+  MetaContext *context;
+  GDBusInterfaceVTable vtable;
+  GDBusInterfaceSetPropertyFunc set_property;
+};
+
+G_DEFINE_TYPE (MetaDisplayConfigSkeleton, meta_display_config_skeleton,
+               META_DBUS_TYPE_DISPLAY_CONFIG_SKELETON)
+
+static const char * const display_changing_methods[] = {
+  "ApplyConfiguration",
+  "ApplyMonitorsConfig",
+  "ChangeBacklight",
+  "SetBacklight",
+  "SetCrtcGamma",
+  "SetOutputCTM",
+  NULL,
+};
+
+static gboolean
+authorize_method (GDBusInterfaceSkeleton *interface_skeleton,
+                  GDBusMethodInvocation  *invocation)
+{
+  MetaDisplayConfigSkeleton *skeleton = META_DISPLAY_CONFIG_SKELETON (interface_skeleton);
+
+  if (!g_strv_contains (display_changing_methods,
+                        g_dbus_method_invocation_get_method_name (invocation)) ||
+      meta_dbus_sender_is_unsandboxed (skeleton->context,
+                                       g_dbus_method_invocation_get_connection (invocation),
+                                       g_dbus_method_invocation_get_sender (invocation)))
+    return TRUE;
+
+  g_dbus_method_invocation_return_error_literal (invocation,
+                                                 G_DBUS_ERROR,
+                                                 G_DBUS_ERROR_ACCESS_DENIED,
+                                                 ACCESS_DENIED_MESSAGE);
+  return FALSE;
+}
+
+static gboolean
+set_property (GDBusConnection  *connection,
+              const char       *sender,
+              const char       *object_path,
+              const char       *interface_name,
+              const char       *property_name,
+              GVariant         *value,
+              GError          **error,
+              gpointer          user_data)
+{
+  MetaDisplayConfigSkeleton *skeleton = META_DISPLAY_CONFIG_SKELETON (user_data);
+
+  if (!meta_dbus_sender_is_unsandboxed (skeleton->context, connection, sender))
+    {
+      g_set_error_literal (error, G_DBUS_ERROR, G_DBUS_ERROR_ACCESS_DENIED,
+                           ACCESS_DENIED_MESSAGE);
+      return FALSE;
+    }
+
+  return skeleton->set_property (connection, sender, object_path,
+                                 interface_name, property_name, value,
+                                 error, user_data);
+}
+
+static GDBusInterfaceVTable *
+get_vtable (GDBusInterfaceSkeleton *interface_skeleton)
+{
+  return &META_DISPLAY_CONFIG_SKELETON (interface_skeleton)->vtable;
+}
+
+static void
+meta_display_config_skeleton_init (MetaDisplayConfigSkeleton *skeleton)
+{
+  GDBusInterfaceSkeletonClass *parent_class =
+    G_DBUS_INTERFACE_SKELETON_CLASS (meta_display_config_skeleton_parent_class);
+
+  skeleton->vtable = *parent_class->get_vtable (G_DBUS_INTERFACE_SKELETON (skeleton));
+  skeleton->set_property = skeleton->vtable.set_property;
+  skeleton->vtable.set_property = set_property;
+
+  g_signal_connect (skeleton, "g-authorize-method",
+                    G_CALLBACK (authorize_method), NULL);
+}
+
+static void
+meta_display_config_skeleton_class_init (MetaDisplayConfigSkeletonClass *klass)
+{
+  GDBusInterfaceSkeletonClass *interface_skeleton_class =
+    G_DBUS_INTERFACE_SKELETON_CLASS (klass);
+
+  interface_skeleton_class->get_vtable = get_vtable;
+}
+
+MetaDBusDisplayConfig *
+meta_display_config_skeleton_new (MetaContext *context)
+{
+  MetaDisplayConfigSkeleton *skeleton =
+    g_object_new (META_TYPE_DISPLAY_CONFIG_SKELETON, NULL);
+
+  skeleton->context = context;
+  return META_DBUS_DISPLAY_CONFIG (skeleton);
+}
