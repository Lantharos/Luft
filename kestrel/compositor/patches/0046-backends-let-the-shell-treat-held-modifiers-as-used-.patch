 clutter/clutter/clutter-seat.h         |  6 +++
 src/backends/native/meta-seat-impl.c   | 70 ++++++++++++++++++++++++++
 src/backends/native/meta-seat-impl.h   |  1 +
 src/backends/native/meta-seat-native.c |  9 ++++
 src/wayland/meta-wayland-keyboard.c    | 12 ++++-
 src/wayland/meta-wayland-keyboard.h    |  3 ++
 src/wayland/meta-wayland-seat.c        |  5 ++
 8 files changed, 123 insertions(+), 1 deletion(-)

diff --git a/clutter/clutter/clutter-seat.c b/clutter/clutter/clutter-seat.c
index f9ab9a707438cb72a8d10c82c6c297003518f198..0639a471ec9ecef8df76b2b428c8f10e270c8240 100644
--- a/clutter/clutter/clutter-seat.c
+++ b/clutter/clutter/clutter-seat.c
@@ -636,6 +636,24 @@ clutter_seat_warp_pointer (ClutterSeat *seat,
   CLUTTER_SEAT_GET_CLASS (seat)->warp_pointer (seat, x, y);
 }
 
+/**
+ * clutter_seat_consume_held_modifiers:
+ * @seat: a #ClutterSeat
+ *
+ * Treats the modifier keys held right now as used up, for example by a
+ * shortcut made of modifiers alone that is still held. Until their keys
+ * are pressed again, events, key symbols and the keyboard state clients
+ * see leave those modifiers out, so the rest of the input behaves as if
+ * they weren't held.
+ */
+void
+clutter_seat_consume_held_modifiers (ClutterSeat *seat)
+{
+  g_return_if_fail (CLUTTER_IS_SEAT (seat));
+
+  CLUTTER_SEAT_GET_CLASS (seat)->consume_held_modifiers (seat);
+}
+
 void
 clutter_seat_init_pointer_position (ClutterSeat *seat,
                                     float        x,
diff --git a/clutter/clutter/clutter-seat.h b/clutter/clutter/clutter-seat.h
