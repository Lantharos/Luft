<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE martif PUBLIC "ISO 12200:1999A//DTD MARTIF core (DXFcdV04)//EN" "TBXcdv04.dtd">
<martif type="TBX" xml:lang="en">
  <martifHeader>
    <fileDesc>
      <sourceDesc>
        <p>Luft glossary for uk</p>
      </sourceDesc>
    </fileDesc>
  </martifHeader>
  <text>
    <body>
      <termEntry id="1">
        <descrip type="Translation needed">No</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>Luft</term>
          </tig>
        </langSet>
        <langSet xml:lang="uk">
          <tig>
            <term>Luft</term>
            <note from="translator">Not translated. Name of the operating system; avoid declining it: «у системі Luft», not «у Luftі»</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="2">
        <descrip type="Translation needed">No</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>Kestrel</term>
          </tig>
        </langSet>
        <langSet xml:lang="uk">
          <tig>
            <term>Kestrel</term>
            <note from="translator">Not translated. Name of Luft's desktop</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="3">
        <descrip type="Translation needed">No</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>Rover</term>
          </tig>
        </langSet>
        <langSet xml:lang="uk">
          <tig>
            <term>Rover</term>
            <note from="translator">Not translated. App name, the file manager; not declined, say «програма Rover»</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="4">
        <descrip type="Translation needed">No</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>Magpie</term>
          </tig>
        </langSet>
        <langSet xml:lang="uk">
          <tig>
            <term>Magpie</term>
            <note from="translator">Not translated. App name, the viewer for photos, videos, music and PDFs</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="5">
        <descrip type="Translation needed">No</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>Mailman</term>
          </tig>
        </langSet>
        <langSet xml:lang="uk">
          <tig>
            <term>Mailman</term>
            <note from="translator">Not translated. App name, the mail app</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="6">
        <descrip type="Translation needed">No</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>Draft</term>
          </tig>
        </langSet>
        <langSet xml:lang="uk">
          <tig>
            <term>Draft</term>
            <note from="translator">Not translated. App name, the text and code editor</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="7">
        <descrip type="Translation needed">No</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>Tern</term>
          </tig>
        </langSet>
        <langSet xml:lang="uk">
          <tig>
            <term>Tern</term>
            <note from="translator">Not translated. App name, the terminal</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="8">
        <descrip type="Translation needed">No</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>Schelf</term>
          </tig>
        </langSet>
        <langSet xml:lang="uk">
          <tig>
            <term>Schelf</term>
            <note from="translator">Not translated. App name, the app store</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="9">
        <descrip type="Translation needed">No</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>Barometer</term>
          </tig>
        </langSet>
        <langSet xml:lang="uk">
          <tig>
            <term>Barometer</term>
            <note from="translator">Not translated. App name, the system monitor</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="10">
        <descrip type="Translation needed">No</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>Keys</term>
          </tig>
        </langSet>
        <langSet xml:lang="uk">
          <tig>
            <term>Keys</term>
            <note from="translator">Not translated. App name, makes keyboard layouts and input methods</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="11">
        <descrip type="Translation needed">No</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>Meet Luft</term>
          </tig>
        </langSet>
        <langSet xml:lang="uk">
          <tig>
            <term>Meet Luft</term>
            <note from="translator">Not translated. Name of the Windows app that prepares a PC for Luft</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="12">
        <descrip type="Translation needed">No</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>Helium</term>
          </tig>
        </langSet>
        <langSet xml:lang="uk">
          <tig>
            <term>Helium</term>
            <note from="translator">Not translated. Name of the default browser</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="13">
        <descrip type="Translation needed">No</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>Flatpak</term>
          </tig>
        </langSet>
        <langSet xml:lang="uk">
          <tig>
            <term>Flatpak</term>
            <note from="translator">Not translated. App packaging format</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="14">
        <descrip type="Translation needed">No</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>Secure Boot</term>
          </tig>
        </langSet>
        <langSet xml:lang="uk">
          <tig>
            <term>Secure Boot</term>
            <note from="translator">Not translated. UEFI feature, named this way in every PC's firmware setup</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="15">
        <descrip type="Translation needed">No</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>TPM</term>
          </tig>
        </langSet>
        <langSet xml:lang="uk">
          <tig>
            <term>TPM</term>
            <note from="translator">Not translated. Trusted Platform Module; in the interface usually called the security chip</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="16">
        <descrip type="Translation needed">No</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>Bluetooth</term>
          </tig>
        </langSet>
        <langSet xml:lang="uk">
          <tig>
            <term>Bluetooth</term>
            <note from="translator">Not translated. Trademark</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="17">
        <descrip type="Translation needed">No</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>Wi-Fi</term>
          </tig>
        </langSet>
        <langSet xml:lang="uk">
          <tig>
            <term>Wi-Fi</term>
            <note from="translator">Not translated. Wireless network; what Windows and people write</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="18">
        <langSet xml:lang="en">
          <tig>
            <term>Settings</term>
          </tig>
        </langSet>
        <langSet xml:lang="uk">
          <tig>
            <term>Параметри</term>
            <note from="translator">App name and the general word for settings; plural, у Параметрах. Not «Настройки»</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="19">
        <langSet xml:lang="en">
          <tig>
            <term>Disks</term>
          </tig>
        </langSet>
        <langSet xml:lang="uk">
          <tig>
            <term>Диски</term>
            <note from="translator">App name for the disk utility</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="20">
        <langSet xml:lang="en">
          <tig>
            <term>Install Luft</term>
          </tig>
        </langSet>
        <langSet xml:lang="uk">
          <tig>
            <term>Встановлення Luft</term>
            <note from="translator">App name of the installer; a noun, like Windows' «Встановлення Windows»</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="21">
        <langSet xml:lang="en">
          <tig>
            <term>Network Sign-In</term>
          </tig>
        </langSet>
        <langSet xml:lang="uk">
          <tig>
            <term>Вхід у мережу</term>
            <note from="translator">App that opens the sign-in page of a public Wi-Fi</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="22">
        <langSet xml:lang="en">
          <tig>
            <term>File Manager</term>
          </tig>
        </langSet>
        <langSet xml:lang="uk">
          <tig>
            <term>Файловий менеджер</term>
            <note from="translator">Generic name of Rover</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="23">
        <langSet xml:lang="en">
          <tig>
            <term>Media Viewer</term>
          </tig>
        </langSet>
        <langSet xml:lang="uk">
          <tig>
            <term>Переглядач медіа</term>
            <note from="translator">Generic name of Magpie</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="24">
        <langSet xml:lang="en">
          <tig>
            <term>Mail</term>
          </tig>
        </langSet>
        <langSet xml:lang="uk">
          <tig>
            <term>Пошта</term>
            <note from="translator">Generic name of Mailman</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="25">
        <langSet xml:lang="en">
          <tig>
            <term>Text Editor</term>
          </tig>
        </langSet>
        <langSet xml:lang="uk">
          <tig>
            <term>Текстовий редактор</term>
            <note from="translator">Generic name of Draft</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="26">
        <langSet xml:lang="en">
          <tig>
            <term>App Store</term>
          </tig>
        </langSet>
        <langSet xml:lang="uk">
          <tig>
            <term>Магазин програм</term>
            <note from="translator">Generic name of Schelf</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="27">
        <langSet xml:lang="en">
          <tig>
            <term>System Monitor</term>
          </tig>
        </langSet>
        <langSet xml:lang="uk">
          <tig>
            <term>Системний монітор</term>
            <note from="translator">Generic name of Barometer</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="28">
        <langSet xml:lang="en">
          <tig>
            <term>Keyboard Layouts</term>
          </tig>
        </langSet>
        <langSet xml:lang="uk">
          <tig>
            <term>Розкладки клавіатури</term>
            <note from="translator">Generic name of Keys</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="29">
        <langSet xml:lang="en">
          <tig>
            <term>Start</term>
          </tig>
        </langSet>
        <langSet xml:lang="uk">
          <tig>
            <term>Пуск</term>
            <note from="translator">The menu opened with Super or the Luft mark; Windows' name, masculine; in sentences «меню „Пуск“»</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="30">
        <langSet xml:lang="en">
          <tig>
            <term>board</term>
          </tig>
        </langSet>
        <langSet xml:lang="uk">
          <tig>
            <term>дошка</term>
            <note from="translator">Mode that lays a workspace's windows side by side on an endless canvas; feminine, plural дошки</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="31">
        <langSet xml:lang="en">
          <tig>
            <term>Quick settings</term>
          </tig>
        </langSet>
        <langSet xml:lang="uk">
          <tig>
            <term>Швидкі параметри</term>
            <note from="translator">Panel of switches and sliders opened from the status icons; plural</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="32">
        <langSet xml:lang="en">
          <tig>
            <term>notification center</term>
          </tig>
        </langSet>
        <langSet xml:lang="uk">
          <tig>
            <term>центр сповіщень</term>
            <note from="translator">Panel with notifications, media and the calendar, opened from the clock; masculine</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="33">
        <langSet xml:lang="en">
          <tig>
            <term>All windows</term>
          </tig>
        </langSet>
        <langSet xml:lang="uk">
          <tig>
            <term>Усі вікна</term>
            <note from="translator">The task view: every window of a workspace and the workspaces, Super+Tab</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="34">
        <langSet xml:lang="en">
          <tig>
            <term>snap</term>
          </tig>
        </langSet>
        <langSet xml:lang="uk">
          <tig>
            <term>прикріпити</term>
            <note from="translator">verb: put a window into a half, third or quarter of the screen; noun прикріплення. Not закріпити, which is pin</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="35">
        <langSet xml:lang="en">
          <tig>
            <term>snap layout</term>
          </tig>
        </langSet>
        <langSet xml:lang="uk">
          <tig>
            <term>макет прикріплення</term>
            <note from="translator">One of the arrangements offered by Super+Z; masculine</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="36">
        <langSet xml:lang="en">
          <tig>
            <term>snap group</term>
          </tig>
        </langSet>
        <langSet xml:lang="uk">
          <tig>
            <term>група прикріплення</term>
            <note from="translator">Windows snapped side by side that come back together; feminine</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="37">
        <langSet xml:lang="en">
          <tig>
            <term>taskbar</term>
          </tig>
        </langSet>
        <langSet xml:lang="uk">
          <tig>
            <term>панель завдань</term>
            <note from="translator">The bar along the bottom of the screen; feminine</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="38">
        <langSet xml:lang="en">
          <tig>
            <term>tray</term>
          </tig>
        </langSet>
        <langSet xml:lang="uk">
          <tig>
            <term>системний лоток</term>
            <note from="translator">Taskbar button holding the icons of apps running in the background; masculine</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="39">
        <langSet xml:lang="en">
          <tig>
            <term>status icons</term>
          </tig>
        </langSet>
        <langSet xml:lang="uk">
          <tig>
            <term>значки стану</term>
            <note from="translator">Taskbar icons for network, sound and battery that open Quick settings</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="40">
        <langSet xml:lang="en">
          <tig>
            <term>lock screen</term>
          </tig>
        </langSet>
        <langSet xml:lang="uk">
          <tig>
            <term>екран блокування</term>
            <note from="translator">Screen shown while the session is locked; masculine</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="41">
        <langSet xml:lang="en">
          <tig>
            <term>login screen</term>
          </tig>
        </langSet>
        <langSet xml:lang="uk">
          <tig>
            <term>екран входу</term>
            <note from="translator">Screen listing the people on the computer before anyone signs in; masculine</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="42">
        <langSet xml:lang="en">
          <tig>
            <term>workspace</term>
          </tig>
        </langSet>
        <langSet xml:lang="uk">
          <tig>
            <term>робочий простір</term>
            <note from="translator">One of up to ten separate desktops; masculine</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="43">
        <langSet xml:lang="en">
          <tig>
            <term>desktop</term>
          </tig>
        </langSet>
        <langSet xml:lang="uk">
          <tig>
            <term>робочий стіл</term>
            <note from="translator">The background area behind the windows; also the whole desktop environment; masculine, на робочому столі</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="44">
        <langSet xml:lang="en">
          <tig>
            <term>wallpaper</term>
          </tig>
        </langSet>
        <langSet xml:lang="uk">
          <tig>
            <term>шпалери</term>
            <note from="translator">Picture behind the desktop; plural only: «Змінити шпалери»</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="45">
        <langSet xml:lang="en">
          <tig>
            <term>accent color</term>
          </tig>
        </langSet>
        <langSet xml:lang="uk">
          <tig>
            <term>колір акценту</term>
            <note from="translator">Color taken from the wallpaper and used for highlights; masculine</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="46">
        <langSet xml:lang="en">
          <tig>
            <term>dark style</term>
          </tig>
        </langSet>
        <langSet xml:lang="uk">
          <tig>
            <term>Темний стиль</term>
            <note from="translator">Quick settings tile that switches between light and dark</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="47">
        <langSet xml:lang="en">
          <tig>
            <term>Night light</term>
          </tig>
        </langSet>
        <langSet xml:lang="uk">
          <tig>
            <term>Нічне світло</term>
            <note from="translator">Warmer screen colors in the evening; neuter</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="48">
        <langSet xml:lang="en">
          <tig>
            <term>Do Not Disturb</term>
          </tig>
        </langSet>
        <langSet xml:lang="uk">
          <tig>
            <term>Не турбувати</term>
            <note from="translator">Holds back notification banners and sounds</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="49">
        <langSet xml:lang="en">
          <tig>
            <term>Airplane mode</term>
          </tig>
        </langSet>
        <langSet xml:lang="uk">
          <tig>
            <term>Режим польоту</term>
            <note from="translator">Turns off every radio</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="50">
        <langSet xml:lang="en">
          <tig>
            <term>Keep awake</term>
          </tig>
        </langSet>
        <langSet xml:lang="uk">
          <tig>
            <term>Не засинати</term>
            <note from="translator">Keeps the screen on for a while</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="51">
        <langSet xml:lang="en">
          <tig>
            <term>Power mode</term>
          </tig>
        </langSet>
        <langSet xml:lang="uk">
          <tig>
            <term>Режим живлення</term>
            <note from="translator">Performance, Balanced or Power saver</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="52">
        <langSet xml:lang="en">
          <tig>
            <term>Power saver</term>
          </tig>
        </langSet>
        <langSet xml:lang="uk">
          <tig>
            <term>Енергозбереження</term>
            <note from="translator">Power mode; neuter</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="53">
        <langSet xml:lang="en">
          <tig>
            <term>Dictation</term>
          </tig>
        </langSet>
        <langSet xml:lang="uk">
          <tig>
            <term>Диктування</term>
            <note from="translator">Typing by speaking; neuter</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="54">
        <langSet xml:lang="en">
          <tig>
            <term>clipboard</term>
          </tig>
        </langSet>
        <langSet xml:lang="uk">
          <tig>
            <term>буфер обміну</term>
            <note from="translator">Holds what was copied; masculine, у буфері обміну</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="55">
        <langSet xml:lang="en">
          <tig>
            <term>clipboard history</term>
          </tig>
        </langSet>
        <langSet xml:lang="uk">
          <tig>
            <term>журнал буфера обміну</term>
            <note from="translator">List of recently copied items, Super+V</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="56">
        <langSet xml:lang="en">
          <tig>
            <term>emoji</term>
          </tig>
        </langSet>
        <langSet xml:lang="uk">
          <tig>
            <term>емодзі</term>
            <note from="translator">noun; neuter, indeclinable, same in the plural</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="57">
        <langSet xml:lang="en">
          <tig>
            <term>screenshot</term>
          </tig>
        </langSet>
        <langSet xml:lang="uk">
          <tig>
            <term>знімок екрана</term>
            <note from="translator">Picture of the screen; masculine; екрана, not екрану</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="58">
        <langSet xml:lang="en">
          <tig>
            <term>screen recording</term>
          </tig>
        </langSet>
        <langSet xml:lang="uk">
          <tig>
            <term>запис екрана</term>
            <note from="translator">Video of the screen; masculine</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="59">
        <langSet xml:lang="en">
          <tig>
            <term>privacy indicator</term>
          </tig>
        </langSet>
        <langSet xml:lang="uk">
          <tig>
            <term>індикатор конфіденційності</term>
            <note from="translator">Taskbar icon shown while the camera, microphone, location or screen is in use</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="60">
        <langSet xml:lang="en">
          <tig>
            <term>Full access</term>
