-on_rounded_corners_changed (MetaCompositor *compositor)
+refresh_window_corners (MetaCompositor *compositor)
 {
   MetaCompositorPrivate *priv =
     meta_compositor_get_instance_private (compositor);
   GList *l;
 
-  meta_window_corners_set_rounded (g_settings_get_boolean (priv->kestrel_settings,
-                                                           "rounded-window-corners"));
-
   /* Corners are synced lazily while windows paint and pick, but X11 shadow
    * shapes are kept until the window is reshaped */
   for (l = priv->windows; l; l = l->next)
@@ -1276,6 +1273,36 @@ on_rounded_corners_changed (MetaCompositor *compositor)
     }
 }
 
+static void
+on_rounded_corners_changed (MetaCompositor *compositor)
+{
+  MetaCompositorPrivate *priv =
+    meta_compositor_get_instance_private (compositor);
+
+  meta_window_corners_set_rounded (g_settings_get_boolean (priv->kestrel_settings,
+                                                           "rounded-window-corners"));
+  refresh_window_corners (compositor);
+}
+
+/**
+ * meta_compositor_set_monitor_gap:
+ * @compositor: a #MetaCompositor
+ * @monitor: index of the monitor
+ * @gap: whether the shell leaves a gap between the monitor's work area and its edge
+ *
+ * Tells the compositor that windows filling @monitor's work area don't meet
+ * the screen edge where its work area ends, so their corners facing that gap
+ * stay rounded.
+ */
+void
+meta_compositor_set_monitor_gap (MetaCompositor *compositor,
+                                 int             monitor,
+                                 gboolean        gap)
+{
+  if (meta_window_corners_set_monitor_gap (monitor, gap))
+    refresh_window_corners (compositor);
+}
