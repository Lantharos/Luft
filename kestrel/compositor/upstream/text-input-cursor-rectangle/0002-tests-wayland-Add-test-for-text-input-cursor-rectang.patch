 src/tests/wayland-test-clients/meson.build  |   3 +
 src/tests/wayland-test-clients/text-input.c | 182 ++++++++++++++++++++
 src/tests/wayland-text-input-tests.c        | 115 +++++++++++++
 4 files changed, 311 insertions(+)
 create mode 100644 src/tests/wayland-test-clients/text-input.c
 create mode 100644 src/tests/wayland-text-input-tests.c

