+static const char *sample_declarations =
+"uniform vec2 kawase_step;                                                 \n"
+"uniform vec4 kawase_bounds;                                               \n"
+"                                                                          \n"
+"vec4 kawase_sample (sampler2D source, vec2 position)                      \n"
+"{                                                                         \n"
+"  return texture2D (source,                                               \n"
+"                    clamp (position, kawase_bounds.xy, kawase_bounds.zw));\n"
+"}                                                                         \n";
+
+static const char *down_source =
+"  vec2 uv = cogl_tex_coord.st;                                            \n"
+"  vec2 o = kawase_step;                                                   \n"
+"  vec4 sum = kawase_sample (cogl_sampler, uv) * 4.0;                      \n"
+"  sum += kawase_sample (cogl_sampler, uv - o);                            \n"
+"  sum += kawase_sample (cogl_sampler, uv + o);                            \n"
+"  sum += kawase_sample (cogl_sampler, uv + vec2 (o.x, -o.y));             \n"
+"  sum += kawase_sample (cogl_sampler, uv - vec2 (o.x, -o.y));             \n"
+"  cogl_texel = sum / 8.0;                                                 \n";
