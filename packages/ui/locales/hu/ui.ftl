## Fingerprints
## Each finger has a name used as a title (the message value) and a form used inside
## a sentence (.inline), like "Place your … on the sensor." Adjust the case of .inline
## to fit those sentences.

ui-finger-right-index = Jobb mutatóujj
    .inline = a jobb mutatóujját
ui-finger-left-index = Bal mutatóujj
    .inline = a bal mutatóujját
ui-finger-right-thumb = Jobb hüvelykujj
    .inline = a jobb hüvelykujját
ui-finger-left-thumb = Bal hüvelykujj
    .inline = a bal hüvelykujját
ui-finger-right-middle = Jobb középső ujj
    .inline = a jobb középső ujját
ui-finger-left-middle = Bal középső ujj
    .inline = a bal középső ujját
ui-finger-right-ring = Jobb gyűrűsujj
    .inline = a jobb gyűrűsujját
ui-finger-left-ring = Bal gyűrűsujj
    .inline = a bal gyűrűsujját
ui-finger-right-little = Jobb kisujj
    .inline = a jobb kisujját
ui-finger-left-little = Bal kisujj
    .inline = a bal kisujját

ui-fingerprint-place = Helyezze { $finger } az érzékelőre.
ui-fingerprint-swipe = Húzza végig { $finger } az érzékelőn.
ui-fingerprint-stage-passed = Rendben. Emelje fel az ujját, majd helyezze vissza.
ui-fingerprint-stage-passed-swipe = Rendben. Húzza végig újra.
ui-fingerprint-retry = Ez nem sikerült jól. Próbálja újra.
ui-fingerprint-swipe-too-short = Húzza végig egy kicsit lassabban.
ui-fingerprint-not-centered = Helyezze az ujját az érzékelő közepére.
ui-fingerprint-remove-and-retry = Emelje fel az ujját, és próbálja újra.
ui-fingerprint-added = Ujjlenyomat hozzáadva.
ui-fingerprint-full = Az olvasón nem fér el több ujjlenyomat.
ui-fingerprint-disconnected = Az ujjlenyomat-olvasó nem válaszol. Próbálja újra egy pillanat múlva.
ui-fingerprint-duplicate = Ez az ujj már el van mentve az olvasón, valószínűleg a Windows vagy egy másik fiók mentette el. Használjon egy másik ujjat.
ui-fingerprint-failed = Nem sikerült hozzáadni ezt az ujjlenyomatot. Próbálja újra.

