window-menu-unpin = Díphionnáil ón tascbharra
window-menu-close = { $count ->
    [one] Dún an fhuinneog
    [two] Dún an dá fhuinneog
    [few] Dún gach fuinneog
    [many] Dún gach fuinneog
   *[other] Dún gach fuinneog
}

## Context menus

context-menu-back = Ar ais

## Window previews (hovering a taskbar app)

