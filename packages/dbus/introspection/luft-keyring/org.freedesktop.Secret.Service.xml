      <arg type="v" direction="out"/>
      <arg type="o" direction="out"/>
    </method>
    <method name="CreateCollection">
      <arg name="properties" type="a{sv}" direction="in"/>
      <arg name="alias" type="s" direction="in"/>
      <arg type="o" direction="out"/>
      <arg type="o" direction="out"/>
    </method>
    <method name="SearchItems">
