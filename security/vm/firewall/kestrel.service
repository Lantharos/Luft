[Unit]
Description=Stand-in for Kestrel, in Kestrel's unit but not Kestrel's program

[Service]
Slice=session.slice
ExecStart=/usr/bin/sh -c "busctl call com.lantharos.Firewall1 /com/lantharos/Firewall1 com.lantharos.Firewall1 SetExtensionPorts 'a(qs)' 1 8003 tcp || touch %h/kestrel-refused; busctl call com.lantharos.Firewall1 /com/lantharos/Firewall1 com.lantharos.Firewall1 SetExtensionPorts 'a(qs)' 0 && touch %h/kestrel-closed; exec python3 -m http.server 8003 --directory /usr/share"
