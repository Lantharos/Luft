---
import { nav, urls } from '@luft/web';
import Logo from './Logo.astro';

interface Props {
	overFog?: boolean;
}

const { overFog = false } = Astro.props;
const local = (href: string) => (href.startsWith(urls.site) ? href.slice(urls.site.length) || '/' : href);
---

<header class:list={['fixed inset-x-0 top-0 z-50', overFog && 'fog-ink']}>
	<div class:list={['absolute inset-0 border-b border-hairline bg-glass backdrop-blur-xl backdrop-saturate-150', overFog && 'frost']}></div>
	<nav class="page relative flex h-16 items-center justify-between" aria-label="Main">
		<a href="/" class="flex items-center gap-2.5 text-lg font-semibold tracking-tight" aria-label="Luft home">
			<Logo class="size-6" />
			<span>Luft</span>
		</a>
		<ul class="flex items-center gap-1 text-[0.9375rem] font-medium">
			{
				nav.map(({ label, href }) => (
					<li>
						<a
							href={local(href)}
							class="rounded-full px-3 py-2 opacity-80 transition-opacity duration-(--motion-tap) hover:opacity-100 aria-[current=page]:opacity-100"
							aria-current={local(href) === Astro.url.pathname ? 'page' : undefined}
						>
							{label}
						</a>
					</li>
				))
			}
		</ul>
	</nav>
</header>
