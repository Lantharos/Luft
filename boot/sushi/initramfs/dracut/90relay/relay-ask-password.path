[Unit]
Description=Relay Password Request Watcher
Documentation=man:relayd(8)
DefaultDependencies=no
Conflicts=systemd-ask-password-plymouth.path
Before=cryptsetup-pre.target
ConditionKernelCommandLine=!rd.relay=0

[Path]
PathExistsGlob=/run/systemd/ask-password/ask.*
DirectoryNotEmpty=/run/systemd/ask-password

[Install]
WantedBy=initrd.target