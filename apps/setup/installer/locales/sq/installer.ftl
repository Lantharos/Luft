## Errors shown in Install Luft and first-run setup

installer-not-allowed = Nuk të lejohet ta bësh këtë.
installer-stopped = Instaluesi u ndal papritur.
installer-request-invalid = Kërkesa nuk është e vlefshme: { $error }
installer-settings-invalid = Cilësimet nuk janë të vlefshme: { $error }
installer-busy = Luft po instalohet tashmë.
installer-account-exists = Llogaria është krijuar tashmë.

## Choosing what to install

installer-no-image = Nuk ka imazh { $variant } për të instaluar.
installer-read-failed = { $path } nuk u lexua dot
installer-parse-failed = { $path } nuk u analizua dot
installer-write-failed = { $path } nuk u shkrua dot

## Checking the destination

installer-drive-gone = Ai disk nuk është më i lidhur.
installer-drive-unusable = Luft nuk mund të instalohet në atë disk.
installer-system-gone = Ai sistem nuk është më aty.
installer-system-unreplaceable = Luft nuk mund ta zëvendësojë ende { $system }.
installer-drive-running = Luft po niset nga ai disk tani, ndaj nuk mund të fshihet.
installer-windows-unshrinkable = Windows në atë disk nuk mund të zvogëlohet.
installer-size-wont-fit = Ajo madhësi nuk nxihet pranë Windows.
installer-space-gone = Ajo hapësirë e lirë nuk është më aty.
installer-space-too-small = Ajo hapësirë e lirë është shumë e vogël për Luft.

## Account and regional settings

installer-user-name-invalid = Ai emër përdoruesi nuk mund të përdoret.
installer-full-name-invalid = Një emër nuk mund të përmbajë dy pika, presje ose rreshta të rinj.
installer-password-missing = Zgjidh një fjalëkalim.
installer-account-not-saved = Llogaria e re nuk u ruajt
installer-account-missing = Llogaria e re mungon
installer-regional-invalid = Ato cilësime rajonale nuk janë të vlefshme.
installer-unknown-zone = Sistemi i ri nuk e njeh zonën kohore { $zone }.

## Installing

installer-esp-partition-failed = Ndarja e sistemit EFI nuk u krijua dot
installer-startup-partition-failed = Ndarja për skedarët e nisjes së Luft nuk u krijua dot
installer-root-partition-failed = Ndarja për Luft nuk u krijua dot
installer-shrink-failed = Windows nuk u zvogëlua dot
installer-no-esp = Disku nuk ka ndarje të sistemit EFI
installer-no-root = Nuk u krijua asnjë ndarje për Luft
installer-copy-failed = Luft nuk u kopjua dot
installer-no-deployment = Sistemi i ri nuk ka asnjë vendosje
installer-deployment-unnamed = Vendosja e sistemit të ri nuk ka emër
installer-deployment-unopened = Sistemi i ri nuk u hap dot
installer-boot-menu-failed = Menyja e nisjes së Luft nuk u vendos dot në ndarjen e sistemit EFI
installer-key-queue-failed = Çelësi Secure Boot i Luft nuk u vu dot në radhë për rinisjen e ardhshme

## Replacing a Linux system

installer-leftovers-failed = Mbetjet e një përpjekjeje të mëparshme nuk u pastruan dot
installer-default-failed = Luft nuk u bë dot sistemi që niset
installer-relabel-failed = Skedarët e tu nuk u etiketuan dot për Luft
installer-set-aside-failed = Sistemi i vjetër nuk u vu dot mënjanë

## Things packed with Meet Luft

installer-box-unopened = Kutia e zhvendosjes nuk u hap dot
installer-box-no-list = Kutia e zhvendosjes nuk ka listë të përmbajtjes
installer-unpack-failed = { $path } nuk u shpaketua dot
installer-wallpaper-unnamed = Sfondi nuk ka emër
