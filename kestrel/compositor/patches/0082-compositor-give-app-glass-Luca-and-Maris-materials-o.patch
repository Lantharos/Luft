diff --git a/src/compositor/meta-background-wallpaper.c b/src/compositor/meta-background-wallpaper.c
new file mode 100644
index 0000000000000000000000000000000000000000..adf76c48114bc0cc511c69d7cc8badcc564577f5
--- /dev/null
+++ b/src/compositor/meta-background-wallpaper.c
@@ -0,0 +1,161 @@
+/*
+ * Copyright (C) 2026 Kristof Imeri
+ *
