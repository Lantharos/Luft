## Fingerprints
## Each finger has a name used as a title (the message value) and a form used inside
## a sentence (.inline), like "Place your … on the sensor." Adjust the case of .inline
## to fit those sentences.

ui-finger-right-index = Dedo indicador direito
    .inline = dedo indicador direito
ui-finger-left-index = Dedo indicador esquerdo
    .inline = dedo indicador esquerdo
ui-finger-right-thumb = Polegar direito
    .inline = polegar direito
ui-finger-left-thumb = Polegar esquerdo
    .inline = polegar esquerdo
ui-finger-right-middle = Dedo médio direito
    .inline = dedo médio direito
ui-finger-left-middle = Dedo médio esquerdo
    .inline = dedo médio esquerdo
ui-finger-right-ring = Dedo anelar direito
    .inline = dedo anelar direito
ui-finger-left-ring = Dedo anelar esquerdo
    .inline = dedo anelar esquerdo
ui-finger-right-little = Dedo mínimo direito
    .inline = dedo mínimo direito
ui-finger-left-little = Dedo mínimo esquerdo
    .inline = dedo mínimo esquerdo

ui-fingerprint-place = Coloque o { $finger } no sensor.
ui-fingerprint-swipe = Deslize o { $finger } pelo sensor.
ui-fingerprint-stage-passed = Muito bem. Levante o dedo e coloque-o de novo.
ui-fingerprint-stage-passed-swipe = Muito bem. Deslize de novo.
ui-fingerprint-retry = Não foi possível ler direito. Tente novamente.
ui-fingerprint-swipe-too-short = Deslize um pouco mais devagar.
ui-fingerprint-not-centered = Centralize o dedo no sensor.
ui-fingerprint-remove-and-retry = Levante o dedo e tente novamente.
ui-fingerprint-added = Impressão digital adicionada.
ui-fingerprint-full = O leitor não tem espaço para mais uma impressão digital.
ui-fingerprint-disconnected = O leitor de impressão digital parou de responder. Tente novamente daqui a pouco.
ui-fingerprint-duplicate = Este dedo já está salvo no leitor, provavelmente pelo Windows ou por outra conta. Use outro dedo.
ui-fingerprint-failed = Não foi possível adicionar esta impressão digital. Tente novamente.

