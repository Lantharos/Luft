diff --git a/clutter/clutter/clutter-graphics-recovery-context.c b/clutter/clutter/clutter-graphics-recovery-context.c
new file mode 100644
index 0000000000000000000000000000000000000000..484127c1c1121188707509338533cee983679f56
--- /dev/null
+++ b/clutter/clutter/clutter-graphics-recovery-context.c
@@ -0,0 +1,610 @@
+/*
