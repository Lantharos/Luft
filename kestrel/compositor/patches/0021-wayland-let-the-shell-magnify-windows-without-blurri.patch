+double
+meta_wayland_surface_get_preferred_scale (MetaWaylandSurface *surface)
+{
+  MetaLogicalMonitor *logical_monitor;
+  MetaWindow *window;
+  double scale;
+
+  window = meta_wayland_surface_get_toplevel_window (surface);
+  if (window && window->client_type != META_WINDOW_CLIENT_TYPE_WAYLAND)
+    window = NULL;
+
+  logical_monitor = meta_wayland_surface_get_preferred_scale_monitor (surface);
+  if (!logical_monitor && window && meta_window_is_unconstrained (window))
+    {
+      MetaContext *context =
+        meta_wayland_compositor_get_context (surface->compositor);
+      MetaMonitorManager *monitor_manager =
+        meta_backend_get_monitor_manager (meta_context_get_backend (context));
+
+      logical_monitor =
+        meta_monitor_manager_get_primary_logical_monitor (monitor_manager);
+    }
+  if (!logical_monitor)
+    return 0.0;
+
+  scale = meta_logical_monitor_get_scale (logical_monitor);
+  if (window)
+    scale *= meta_window_get_magnification (window);
+
+  return scale;
+}
