#!/usr/bin/bash
set -uo pipefail

medium=/run/initramfs/live
host=/run/luft/host
logs="$medium/Luft logs"
staged="$logs/.saving.zip"
state=/run/luft-live-logs
collected="$state/collected"
packed="$state/packed.zip"
coredump_store=/var/lib/systemd/coredump
coredump_message=fc2e22bc6ee647b6b90729ab34a250b1
sessions_kept=5
session_cap=$((48 * 1024 * 1024))
free_kept=$((16 * 1024 * 1024))
journal_lines_kept=(100000 20000)
probe_timeout=20s

session_name() {
    [[ -s "$state/session" ]] || date '+%Y-%m-%d %H-%M-%S' >"$state/session"
    cat "$state/session"
}

crash_reports() {
    journalctl --boot --quiet --output=cat --output-fields=COREDUMP_PID "MESSAGE_ID=$coredump_message" | grep -c .
}

stored_coredumps() {
    find "$coredump_store" -maxdepth 1 -type f -name 'core.*' 2>/dev/null | wc -l
}

wait_for_crash_reports() {
    local attempt
    for attempt in {1..60}; do
        (($(crash_reports) >= $(stored_coredumps))) && return
        sleep 1
    done
}

coredumps() {
    local boot
    boot="_BOOT_ID=$(tr -d - </proc/sys/kernel/random/boot_id)"
    coredumpctl --no-pager --quiet list "$boot"
    echo
    timeout 2m coredumpctl --no-pager --quiet info "$boot"
}

binary_number() {
    od --address-radix=n --format="$1" --skip-bytes="$2" --read-bytes="${1:1}" "$3" | tr -d ' '
}

firmware_display() {
    local bgrt=/sys/firmware/acpi/bgrt boot_params=/sys/kernel/boot_params/data height
    printf 'Firmware framebuffer: %sx%s\n' "$(binary_number u2 18 "$boot_params")" "$(binary_number u2 20 "$boot_params")"
    [[ -r "$bgrt/image" ]] || return
    height="$(binary_number d4 22 "$bgrt/image")"
    printf 'Firmware logo: %sx%s at (%s, %s), status %s\n' "$(binary_number u4 18 "$bgrt/image")" "${height#-}" \
        "$(<"$bgrt/xoffset")" "$(<"$bgrt/yoffset")" "$(<"$bgrt/status")"
}

drm() {
    local card connector
    firmware_display
    echo
    for card in /sys/class/drm/card[0-9]; do
        printf '%s: %s %s\n' "${card##*/}" "$(basename "$(readlink -f "$card/device/driver")")" "$(basename "$(readlink -f "$card/device")")"
    done
    for connector in /sys/class/drm/card[0-9]-*; do
        printf '\n%s: %s, %s, dpms %s, EDID %s bytes\n' "${connector##*/}" \
            "$(<"$connector/status")" "$(<"$connector/enabled")" "$(<"$connector/dpms")" "$(wc -c <"$connector/edid")"
        sed 's/^/  /' "$connector/modes"
    done
}

video_acceleration() {
    local node
    for node in /dev/dri/renderD*; do
        echo "== $node"
        timeout "$probe_timeout" vainfo --display drm --device "$node" 2>&1
    done
}

graphics() {
    echo "== vulkaninfo --summary"
    timeout "$probe_timeout" vulkaninfo --summary 2>&1
    echo
    echo "== eglinfo -B"
    timeout "$probe_timeout" eglinfo -B 2>&1
}

system() {
    uname -a
    echo
    cat /etc/os-release
    echo
    cat /proc/cmdline
    echo
    cat "$medium/meet.json"
    echo
    uptime
    free -h
    echo
    df -h "$medium"
    echo
    lsblk -o NAME,SIZE,TYPE,FSTYPE,LABEL,PARTLABEL,PARTUUID,MOUNTPOINTS
}

live_home() {
    getent passwd live | cut -d: -f6
}

journal_text() {
    journalctl --boot --no-pager --output=short-precise "$@" >"$collected/journal.txt"
}

collect() {
    local home
    rm -rf "$collected"
    mkdir "$collected"
    journal_text
    journalctl --boot --no-pager --output=json | zstd --quiet -6 -o "$collected/journal.json.zst"
    journalctl --boot --no-pager --output=short-precise \
        _SYSTEMD_USER_UNIT=kestrel.service + SYSLOG_IDENTIFIER=kestrel-setup + \
        _SYSTEMD_UNIT=kestrel-greeter.service + _SYSTEMD_UNIT=kestrel-watchdog.service >"$collected/kestrel.txt"
    coredumps >"$collected/coredumps.txt" 2>&1
    dmesg --time-format=iso >"$collected/dmesg.txt"
    system >"$collected/system.txt" 2>&1
    timeout "$probe_timeout" lspci -nnk >"$collected/lspci.txt" 2>&1
    { timeout "$probe_timeout" lsusb; echo; timeout "$probe_timeout" lsusb -t; } >"$collected/lsusb.txt" 2>&1
    drm >"$collected/drm.txt" 2>&1
    video_acceleration >"$collected/vainfo.txt"
    graphics >"$collected/graphics.txt"
    timeout "$probe_timeout" sushictl status >"$collected/sushi.txt" 2>&1
    home="$(live_home)"
    [[ -d "$home/.local/share/sabine/logs" ]] && cp -r "$home/.local/share/sabine/logs" "$collected/sabine"
    [[ -d /var/lib/kestrel-watchdog ]] && cp -r /var/lib/kestrel-watchdog "$collected/kestrel-watchdog"
}

pack() {
    rm -f "$packed"
    (cd "$collected" && 7z a -tzip -mx=5 -bso0 -bsp0 "$packed" .)
}

packed_size() {
    stat --format=%s "$packed"
}

pack_within_cap() {
    local lines
    pack
    (($(packed_size) <= session_cap)) && return
    rm "$collected/journal.json.zst"
    pack
    for lines in "${journal_lines_kept[@]}"; do
        (($(packed_size) <= session_cap)) && return
        journal_text --lines="$lines"
        pack
    done
}

free_bytes() {
    df --output=avail --block-size=1 "$medium" | tail -n1
}

older_sessions() {
    find "$logs" -mindepth 1 -maxdepth 1 -type f -name '*.zip' -not -name '.*' -not -name "$1" -printf '%f\n' | sort
}

make_room() {
    local own="$1" needed="$2"
    local -a older
    mapfile -t older < <(older_sessions "$own")
    while ((${#older[@]} >= sessions_kept)) || ((${#older[@]} > 0 && $(free_bytes) < needed)); do
        rm -f "$logs/${older[0]}"
        older=("${older[@]:1}")
    done
    (($(free_bytes) >= needed)) && return
    rm -f "$logs/$own"
    (($(free_bytes) >= needed))
}

save() {
    local own needed
    own="$(session_name).zip"
    needed=$(($(packed_size) + free_kept))
    mkdir -p "$logs"
    rm -f "$staged"
    make_room "$own" "$needed" || return
    cp "$packed" "$staged" && sync --file-system "$medium" && mv -f "$staged" "$logs/$own"
    sync --file-system "$medium"
}

open_medium() {
    if mountpoint --quiet "$host"; then
        mount -o remount,rw "$host" && mount -o remount,bind,rw "$medium" || return
        trap 'mount -o remount,bind,ro "$medium"' EXIT
    else
        mount -o remount,rw "$medium" || return
        trap 'mount -o remount,ro "$medium"' EXIT
    fi
}

mkdir -p "$state"
exec 9>"$state/lock"
flock 9
wait_for_crash_reports
collect
pack_within_cap
open_medium || exit
save
