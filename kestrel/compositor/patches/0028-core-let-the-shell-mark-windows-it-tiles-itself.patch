--- a/src/meta/window.h
+++ b/src/meta/window.h
@@ -379,6 +379,13 @@ MetaFrameType meta_window_get_frame_type (MetaWindow *window);
 META_EXPORT
 MetaWindow *meta_window_get_tile_match (MetaWindow *window);
 
+META_EXPORT
+void        meta_window_set_tiled_edges (MetaWindow    *window,
+                                         MetaDirection  edges);
+
+META_EXPORT
+MetaDirection meta_window_get_tiled_edges (MetaWindow *window);
+
 META_EXPORT
 void        meta_window_make_fullscreen    (MetaWindow  *window);
 
