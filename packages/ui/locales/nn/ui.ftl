## Fingerprints
## Each finger has a name used as a title (the message value) and a form used inside
## a sentence (.inline), like "Place your … on the sensor." Adjust the case of .inline
## to fit those sentences.

ui-finger-right-index = Høgre peikefinger
    .inline = høgre peikefinger
ui-finger-left-index = Venstre peikefinger
    .inline = venstre peikefinger
ui-finger-right-thumb = Høgre tommel
    .inline = høgre tommel
ui-finger-left-thumb = Venstre tommel
    .inline = venstre tommel
ui-finger-right-middle = Høgre langfinger
    .inline = høgre langfinger
ui-finger-left-middle = Venstre langfinger
    .inline = venstre langfinger
ui-finger-right-ring = Høgre ringfinger
    .inline = høgre ringfinger
ui-finger-left-ring = Venstre ringfinger
    .inline = venstre ringfinger
ui-finger-right-little = Høgre veslefinger
    .inline = høgre veslefinger
ui-finger-left-little = Venstre veslefinger
    .inline = venstre veslefinger

ui-fingerprint-place = Legg { $finger } på sensoren.
ui-fingerprint-swipe = Dra { $finger } over sensoren.
ui-fingerprint-stage-passed = Bra. Løft fingeren, og legg han på igjen.
ui-fingerprint-stage-passed-swipe = Bra. Dra ein gong til.
ui-fingerprint-retry = Fingeren vart ikkje lesen godt nok. Prøv igjen.
ui-fingerprint-swipe-too-short = Dra litt saktare.
ui-fingerprint-not-centered = Legg fingeren midt på sensoren.
ui-fingerprint-remove-and-retry = Løft fingeren og prøv igjen.
ui-fingerprint-added = Fingeravtrykket er lagt til.
ui-fingerprint-full = Lesaren har ikkje plass til fleire fingeravtrykk.
ui-fingerprint-disconnected = Fingeravtrykklesaren svarer ikkje lenger. Prøv igjen om litt.
ui-fingerprint-duplicate = Lesaren har alt lagra denne fingeren, truleg frå Windows eller ein annan konto. Bruk ein annan finger.
ui-fingerprint-failed = Kunne ikkje leggje til dette fingeravtrykket. Prøv igjen.

