[Unit]
Description=Kestrel session manager
CollectMode=inactive-or-failed
PartOf=kestrel-session.target
PartOf=kestrel-setup.target
Before=kestrel.service kestrel-setup.service

[Service]
Slice=session.slice
Type=dbus
BusName=org.gnome.SessionManager
ExecStart=@gjs@ -m @pkgdatadir@/kestrel-session.js
Restart=on-failure
TimeoutStopSec=5
OOMScoreAdjust=-800
MemoryMin=32M
