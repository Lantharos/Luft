<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
 "https://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<node name="/com/lantharos/Updater1">
  <!--
    Updates the system image with bootc. Started on demand and stops when idle.

    Downloading: whether an update is being downloaded right now, by anyone, or the system packages
      are being built for one that just was.
    Downloaded: bytes of image layers fetched so far by the current download.
    Schedule: how often luft-updater-check.timer has updates checked for, "daily", "weekly" or
      "never", kept in /var/lib/luft-updater/schedule.json.
    DownloadAutomatically: whether an update found on schedule is downloaded and staged too.
    LastChecked: when an update was last checked for on schedule, in seconds since 1970, or 0.

    Luft's images follow a channel by their tag: stable (":1") or nightly (":1-nightly"), each in the
    standard and NVIDIA image. SwitchChannel moves the system to the same image on the other channel
    when that channel has a version at least as new as the running one, staged like SwitchVariant,
    or, when that version is the running one under the other tag, by pointing the running
    deployment at the new tag without downloading or staging anything. When the channel has
    nothing as new, the channel is kept as the one the system waits for in schedule.json, and
    Download and RunSchedule move it there once the channel has caught up. Until then a system
    waiting for stable keeps taking nightly updates, and one waiting for nightly keeps its version.

    Download, Cancel and Apply need com.lantharos.updater.download, which administrators at the
    computer have without being asked; SwitchVariant needs com.lantharos.updater.variant,
    SwitchChannel com.lantharos.updater.channel, SetSchedule com.lantharos.updater.schedule and Rollback com.lantharos.updater.rollback, which
    ask for a password. Status, Space and StableReleased need nothing. Only root can call RunSchedule.

    A version older than the running one is never staged or applied: its version is read from the
    image's configuration, which its signature covers. Only Rollback starts an older version, the
    one kept on the computer.

    A finished download also has com.lantharos.Packages1 build the system packages for the version
    it staged, before Finished.
  -->
  <interface name="com.lantharos.Updater1">
    <property name="Downloading" type="b" access="read"/>
    <property name="Downloaded" type="t" access="read"/>
    <property name="Schedule" type="s" access="read"/>
    <property name="DownloadAutomatically" type="b" access="read"/>
    <property name="LastChecked" type="t" access="read"/>

    <!-- JSON: {"host": `bootc status` as JSON, "configs": {manifest digest: OCI image config}} for the
         booted, staged and rollback images, and "waiting": the channel the system moves to once it
         has caught up, "stable" or "nightly", or null. -->
    <method name="Status">
      <arg name="status" type="s" direction="out"/>
    </method>
    <!-- JSON: {"running", "downloaded", "older"}, the bytes on the drive the running version, a
         downloaded update and the older versions kept on the computer hold. What versions share
         counts toward the running one, then the update, so the others say what removing them
         frees; what no version refers to any more counts as older. -->
    <method name="Space">
      <arg name="space" type="s" direction="out"/>
    </method>
    <!-- Starts downloading the newest image and stages it, locked: it's only installed at a restart once
         Apply unlocks it. Finished says how it went. -->
    <method name="Download"/>
    <!-- Starts downloading the same channel and version of Luft's other image, "standard" or "nvidia",
         and stages it, unlocked, for the next restart, keeping this one to go back to. When that is
         the version already kept to go back to, it starts that one next instead. Downloading,
         Downloaded and Finished report it like an update. -->
    <method name="SwitchVariant">
      <arg name="variant" type="s" direction="in"/>
    </method>
    <!-- "stable" or "nightly". Returns whether the move to it started now. -->
    <method name="SwitchChannel">
      <arg name="channel" type="s" direction="in"/>
      <arg name="moving" type="b" direction="out"/>
    </method>
    <!-- "yes" when a stable version of this image is published, "no" when none is, "unknown" when
         the registry couldn't be asked. Asked at most every ten minutes. -->
    <method name="StableReleased">
      <arg name="released" type="s" direction="out"/>
    </method>
    <method name="Cancel"/>
    <!-- Installs the downloaded update at the next restart or power off. -->
    <method name="Apply"/>
    <!-- Starts the previous version next time, or, when that's already queued, stays on this one. -->
    <method name="Rollback"/>
    <method name="SetSchedule">
      <arg name="schedule" type="s" direction="in"/>
      <arg name="download" type="b" direction="in"/>
    </method>
    <!-- Checks for an update when the schedule says one is due and the connection isn't metered,
         and downloads and stages it when DownloadAutomatically says so, reported like any
         download. When nothing is downloaded, com.lantharos.Packages1 brings the system packages
         up to their newest versions instead. -->
    <method name="RunSchedule"/>
    <!-- Empty when the download succeeded. -->
    <signal name="Finished">
      <arg name="error" type="s"/>
    </signal>
    <!-- A check on schedule found an update: ready when it was also downloaded and staged. -->
    <signal name="UpdateFound">
      <arg name="ready" type="b"/>
    </signal>
  </interface>
</node>
