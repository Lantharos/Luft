+
+#define OUTLINE_GRAY 0.5f
+#define OUTLINE_ALPHA 0.3f
+#define OUTLINE_MIN_BAND 12.0f
+
+static CoglPipeline *
+get_outline_pipeline (CoglContext *context)
+{
+  static CoglPipelineKey key = "kestrel-window-outline";
+  CoglPipeline *pipeline = cogl_context_get_named_pipeline (context, &key);
+
+  if (!pipeline)
+    {
+      g_autoptr (CoglSnippet) vertex = NULL;
+      g_autoptr (CoglSnippet) fragment = NULL;
+
+      /* Positions reach the shader already transformed, so the actor
+       * coordinates come in as texture coordinates of a blank layer */
+      pipeline = cogl_pipeline_new (context);
+      cogl_pipeline_set_layer_null_texture (pipeline, 0);
+      vertex = cogl_snippet_new (COGL_SNIPPET_HOOK_VERTEX,
+        "varying vec2 kestrel_position;\n",
+        "kestrel_position = cogl_tex_coord0_in.xy;\n");
+      fragment = cogl_snippet_new (COGL_SNIPPET_HOOK_FRAGMENT,
+        CORNER_DECLARATIONS,
+        "float pixel = kestrel_pixel_size ();\n"
+        "vec2 half_size = kestrel_bounds.zw * 0.5;\n"
+        "vec2 q = abs(kestrel_position - kestrel_bounds.xy - half_size) - half_size + kestrel_radius;\n"
+        "float distance = (length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - kestrel_radius) / pixel;\n"
+        "float width = max(floor(1.0 / pixel + 0.01), 1.0);\n"
+        "float outside = clamp(0.5 + distance, 0.0, 1.0);\n"
+        "float inside = clamp(0.5 + distance + width, 0.0, 1.0);\n"
+        "cogl_color_out *= inside - outside;\n");
+      cogl_pipeline_add_snippet (pipeline, vertex);
+      cogl_pipeline_add_snippet (pipeline, fragment);
+      cogl_context_set_named_pipeline (context, &key, pipeline);
+    }
+
+  return pipeline;
+}
+
+static void
+draw_band (CoglFramebuffer *framebuffer,
+           CoglPipeline    *pipeline,
+           float            x1,
+           float            y1,
+           float            x2,
+           float            y2)
+{
+  cogl_framebuffer_draw_textured_rectangle (framebuffer, pipeline,
+                                            x1, y1, x2, y2,
+                                            x1, y1, x2, y2);
+}
+
+/* Paint a line one whole device pixel per logical pixel wide along the
+ * inside of @bounds' rounded edge, where window corners clip windows, so it
+ * meets their antialiased edge without a gap. It lightens dark windows and
+ * darkens light ones, so windows stay apart from each other and from the
+ * wallpaper in either style. */
+void
+meta_window_corners_paint_outline (CoglFramebuffer       *framebuffer,
+                                   const graphene_rect_t *bounds,
+                                   guint8                 opacity)
+{
+  CoglContext *context = cogl_framebuffer_get_context (framebuffer);
+  g_autoptr (CoglPipeline) pipeline = NULL;
+  float x1 = bounds->origin.x, y1 = bounds->origin.y;
+  float x2 = x1 + bounds->size.width, y2 = y1 + bounds->size.height;
+  float radius = MIN (META_WINDOW_CORNER_RADIUS,
+                      MIN (bounds->size.width, bounds->size.height) / 2.0f);
+  float band = MAX (ceilf (radius), OUTLINE_MIN_BAND) + 1.0f;
+  float rect[4] = { x1, y1, bounds->size.width, bounds->size.height };
+  float alpha = OUTLINE_ALPHA * opacity / 255.0f;
+  CoglColor color;
+
+  if (opacity == 0)
+    return;
+
+  pipeline = cogl_pipeline_copy (get_outline_pipeline (context));
+  cogl_color_init_from_4f (&color, OUTLINE_GRAY * alpha, OUTLINE_GRAY * alpha,
+                           OUTLINE_GRAY * alpha, alpha);
+  cogl_pipeline_set_color (pipeline, &color);
+  cogl_pipeline_set_uniform_float (pipeline,
+                                   cogl_pipeline_get_uniform_location (pipeline, "kestrel_bounds"),
+                                   4, 1, rect);
+  cogl_pipeline_set_uniform_1f (pipeline,
+                                cogl_pipeline_get_uniform_location (pipeline, "kestrel_radius"),
+                                radius);
+
+  /* Only the bands along the edges, so the line doesn't cost a full-size pass */
+  band = MIN (band, MIN (bounds->size.width, bounds->size.height) / 2.0f);
+  draw_band (framebuffer, pipeline, x1, y1, x2, y1 + band);
+  draw_band (framebuffer, pipeline, x1, y2 - band, x2, y2);
+  if (y2 - band > y1 + band)
+    {
+      draw_band (framebuffer, pipeline, x1, y1 + band, x1 + band, y2 - band);
+      draw_band (framebuffer, pipeline, x2 - band, y1 + band, x2, y2 - band);
+    }
+}
