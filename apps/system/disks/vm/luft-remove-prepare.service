[Unit]
Description=Install Luft next to a Windows-like drive with a kept old system
After=dbus.service local-fs.target
ConditionPathExists=/dev/disk/by-label/luft-source

[Service]
Type=oneshot
ExecStart=/usr/libexec/luft-remove-prepare
ExecStopPost=/usr/bin/systemctl poweroff --no-block

[Install]
WantedBy=multi-user.target
