+static gboolean
+is_outlined (MetaWindow *window)
+{
+  if (window->unmanaging ||
+      meta_window_is_override_redirect (window) ||
+      !meta_window_has_rounded_corners (window))
+    return FALSE;
+
+  switch (meta_window_get_window_type (window))
+    {
+    case META_WINDOW_NORMAL:
+    case META_WINDOW_DIALOG:
+    case META_WINDOW_MODAL_DIALOG:
+    case META_WINDOW_UTILITY:
+      return TRUE;
+    default:
+      return FALSE;
+    }
+}
+
+/* @window's frame in the coordinates of @window_actor, and how far past it
+ * the window shows, 1 for clients that draw their own shadow and the line
+ * along their edge just outside their frame, 0 for others */
+static gboolean
+get_frame_bounds (MetaWindowActor *window_actor,
+                  graphene_rect_t *bounds,
+                  float           *border)
+{
+  MetaWindow *window = meta_window_actor_get_meta_window (window_actor);
+  int geometry_scale = meta_window_actor_get_geometry_scale (window_actor);
+  MtkRectangle frame, buffer;
+
+  meta_window_get_frame_rect (window, &frame);
+  meta_window_get_buffer_rect (window, &buffer);
+  if (frame.width <= 0 || frame.height <= 0 ||
+      buffer.width <= 0 || buffer.height <= 0)
+    return FALSE;
+
+  *border = (float) CLAMP (MIN (MIN (frame.x - buffer.x, frame.y - buffer.y),
+                               MIN (buffer.x + buffer.width - frame.x - frame.width,
+                                    buffer.y + buffer.height - frame.y - frame.height)),
+                          0, 1) / geometry_scale;
+  *bounds = GRAPHENE_RECT_INIT ((float) (frame.x - buffer.x) / geometry_scale,
+                                (float) (frame.y - buffer.y) / geometry_scale,
+                                (float) frame.width / geometry_scale,
+                                (float) frame.height / geometry_scale);
+  return TRUE;
+}
+
+/* Whether the compositor outlines @window like every floating top-level
+ * window, and where, in the coordinates of @window_actor. Clients that draw
+ * their own shadow get the outline along their frame too. */
+gboolean
+meta_window_corners_get_outline (MetaWindowActor *window_actor,
+                                 graphene_rect_t *bounds)
+{
+  MetaWindow *window = meta_window_actor_get_meta_window (window_actor);
+  float border;
+
+  return window && is_outlined (window) &&
+         get_frame_bounds (window_actor, bounds, &border);
+}
+
+/* Whether the compositor draws @window's shadow too, because its buffer
+ * doesn't reach past its frame, where a client would draw a shadow of its
+ * own */
+gboolean
+meta_window_corners_casts_shadow (MetaWindow *window)
+{
+  MtkRectangle frame, buffer;
+
+  meta_window_get_frame_rect (window, &frame);
+  meta_window_get_buffer_rect (window, &buffer);
+  return mtk_rectangle_contains_rect (&frame, &buffer);
+}
