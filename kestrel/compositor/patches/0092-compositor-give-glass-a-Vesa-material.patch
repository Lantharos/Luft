@@ -147,6 +154,7 @@ meta_background_shows_wallpaper (MetaCompositor    *compositor,
 
   return material != META_GLASS_MATERIAL_LIVE &&
     material != META_GLASS_MATERIAL_NIKO &&
+    material != META_GLASS_MATERIAL_VESA &&
     meta_compositor_get_frosted_wallpaper (compositor, frost_of (material), 0, &area);
