diff --git a/src/backends/native/meta-virtual-input-device-native.c b/src/backends/native/meta-virtual-input-device-native.c
index e0821d45872f1dfd954e9edae11d747dd2010cdd..b8c4001a6c4d960c895351abaea466103b2e3c40 100644
--- a/src/backends/native/meta-virtual-input-device-native.c
+++ b/src/backends/native/meta-virtual-input-device-native.c
@@ -1093,6 +1093,42 @@ meta_virtual_input_device_native_notify_touchpad_swipe (ClutterVirtualInputDevic
                     (GSourceFunc) notify_touchpad_swipe_in_impl);
 }
 
+static gboolean
+notify_tablet_mode_in_impl (GTask *task)
+{
+  MetaVirtualInputDeviceNative *virtual_native =
+    g_task_get_source_object (task);
+  MetaSeatNative *seat_native =
+    meta_virtual_input_device_native_get_seat_native (virtual_native);
+  gboolean tablet_mode = GPOINTER_TO_INT (g_task_get_task_data (task));
+
+  meta_seat_impl_notify_tablet_mode_in_impl (seat_native->impl,
+                                             virtual_native->impl_state->device,
+                                             tablet_mode);
+
+  g_task_return_boolean (task, TRUE);
+  return G_SOURCE_REMOVE;
+}
+
+static void
+meta_virtual_input_device_native_notify_tablet_mode (ClutterVirtualInputDevice *virtual_device,
+                                                     gboolean                   tablet_mode)
+{
+  MetaVirtualInputDeviceNative *virtual_native =
+    META_VIRTUAL_INPUT_DEVICE_NATIVE (virtual_device);
+  MetaSeatNative *seat_native =
+    meta_virtual_input_device_native_get_seat_native (virtual_native);
+  GTask *task;
+
+  g_return_if_fail (virtual_native->impl_state != NULL);
+
+  task = g_task_new (virtual_native, NULL, NULL, NULL);
+  g_task_set_task_data (task, GINT_TO_POINTER (tablet_mode), NULL);
+  meta_seat_impl_run_input_task (seat_native->impl, task,
+                                 (GSourceFunc) notify_tablet_mode_in_impl);
+  g_object_unref (task);
+}
+
 static void
 meta_virtual_input_device_native_get_property (GObject    *object,
                                                guint       prop_id,
@@ -1252,6 +1288,7 @@ meta_virtual_input_device_native_class_init (MetaVirtualInputDeviceNativeClass *
   virtual_input_device_class->notify_touch_up = meta_virtual_input_device_native_notify_touch_up;
   virtual_input_device_class->notify_touchpad_pinch = meta_virtual_input_device_native_notify_touchpad_pinch;
   virtual_input_device_class->notify_touchpad_swipe = meta_virtual_input_device_native_notify_touchpad_swipe;
+  virtual_input_device_class->notify_tablet_mode = meta_virtual_input_device_native_notify_tablet_mode;
 
   obj_props[PROP_SLOT_BASE] = g_param_spec_uint ("slot-base", NULL, NULL,
                                                  0, G_MAXUINT, 0,
