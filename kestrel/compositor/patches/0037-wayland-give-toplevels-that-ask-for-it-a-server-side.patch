diff --git a/src/wayland/meta-wayland-xdg-decoration.c b/src/wayland/meta-wayland-xdg-decoration.c
new file mode 100644
index 0000000000000000000000000000000000000000..1a1d2c99aa4d1568eb9d190dba8539fd90b77515
--- /dev/null
+++ b/src/wayland/meta-wayland-xdg-decoration.c
@@ -0,0 +1,243 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "config.h"
+
+#include "wayland/meta-wayland-xdg-decoration.h"
+
+#include "core/meta-window-config-private.h"
+#include "wayland/meta-wayland-private.h"
+#include "wayland/meta-wayland-surface-private.h"
+#include "wayland/meta-wayland-versions.h"
+#include "wayland/meta-wayland-window-configuration.h"
+#include "wayland/meta-window-wayland.h"
+
+#include "xdg-decoration-unstable-v1-server-protocol.h"
+
+#define TITLEBAR_HEIGHT 40
+
+typedef struct _MetaWaylandXdgDecoration
+{
+  struct wl_resource *resource;
+  MetaWaylandXdgToplevel *toplevel;
+  uint32_t mode;
+  uint32_t sent_mode;
+} MetaWaylandXdgDecoration;
+
+static GQuark quark_decoration;
+
+static MetaWaylandXdgDecoration *
+decoration_of (MetaWaylandXdgToplevel *xdg_toplevel)
+{
+  return g_object_get_qdata (G_OBJECT (xdg_toplevel), quark_decoration);
+}
+
+static MetaWindow *
+window_of (MetaWaylandXdgToplevel *xdg_toplevel)
+{
+  MetaWaylandSurface *surface =
+    meta_wayland_surface_role_get_surface (META_WAYLAND_SURFACE_ROLE (xdg_toplevel));
+
+  return meta_wayland_surface_get_window (surface);
+}
+
+static void
+reconfigure (MetaWaylandXdgToplevel *xdg_toplevel)
+{
+  MetaWindow *window = window_of (xdg_toplevel);
+
+  if (window)
+    meta_window_wayland_reconfigure (window);
+}
+
+static void
+request_mode (MetaWaylandXdgDecoration *decoration,
+              uint32_t                  mode)
+{
+  if (!decoration->toplevel)
+    return;
+
+  decoration->mode = mode;
+  decoration->sent_mode = 0;
+  reconfigure (decoration->toplevel);
+}
+
+static void
+decoration_destructor (struct wl_resource *resource)
+{
+  MetaWaylandXdgDecoration *decoration = wl_resource_get_user_data (resource);
+
+  if (decoration->toplevel)
+    {
+      g_object_set_qdata (G_OBJECT (decoration->toplevel), quark_decoration, NULL);
+      if (decoration->mode == ZXDG_TOPLEVEL_DECORATION_V1_MODE_SERVER_SIDE)
+        reconfigure (decoration->toplevel);
+    }
+
+  g_free (decoration);
+}
+
+static void
+decoration_destroy (struct wl_client   *client,
+                    struct wl_resource *resource)
+{
+  wl_resource_destroy (resource);
+}
+
+static void
+decoration_set_mode (struct wl_client   *client,
+                     struct wl_resource *resource,
+                     uint32_t            mode)
+{
+  MetaWaylandXdgDecoration *decoration = wl_resource_get_user_data (resource);
+
+  switch (mode)
+    {
+    case ZXDG_TOPLEVEL_DECORATION_V1_MODE_CLIENT_SIDE:
+    case ZXDG_TOPLEVEL_DECORATION_V1_MODE_SERVER_SIDE:
+      break;
+    default:
+      wl_resource_post_error (resource,
+                              ZXDG_TOPLEVEL_DECORATION_V1_ERROR_INVALID_MODE,
+                              "Invalid decoration mode %u", mode);
+      return;
+    }
+
+  request_mode (decoration, mode);
+}
+
+static void
+decoration_unset_mode (struct wl_client   *client,
+                       struct wl_resource *resource)
+{
+  MetaWaylandXdgDecoration *decoration = wl_resource_get_user_data (resource);
+
+  request_mode (decoration, ZXDG_TOPLEVEL_DECORATION_V1_MODE_SERVER_SIDE);
+}
+
+static const struct zxdg_toplevel_decoration_v1_interface decoration_interface = {
+  decoration_destroy,
+  decoration_set_mode,
+  decoration_unset_mode,
+};
+
+static void
+manager_destroy (struct wl_client   *client,
+                 struct wl_resource *resource)
+{
+  wl_resource_destroy (resource);
+}
+
+static void
+manager_get_toplevel_decoration (struct wl_client   *client,
+                                 struct wl_resource *resource,
+                                 uint32_t            id,
+                                 struct wl_resource *toplevel_resource)
+{
+  MetaWaylandXdgToplevel *xdg_toplevel =
+    wl_resource_get_user_data (toplevel_resource);
+  MetaWaylandSurface *surface =
+    meta_wayland_surface_role_get_surface (META_WAYLAND_SURFACE_ROLE (xdg_toplevel));
+  MetaWaylandXdgDecoration *decoration;
+  struct wl_resource *decoration_resource;
+
+  decoration_resource =
+    wl_resource_create (client, &zxdg_toplevel_decoration_v1_interface,
+                        wl_resource_get_version (resource), id);
+
+  if (decoration_of (xdg_toplevel))
+    {
+      wl_resource_post_error (decoration_resource,
+                              ZXDG_TOPLEVEL_DECORATION_V1_ERROR_ALREADY_CONSTRUCTED,
+                              "The xdg_toplevel already has a decoration object");
+      return;
+    }
+
+  if (wl_resource_get_version (resource) < 2 &&
+      meta_wayland_surface_get_buffer (surface))
+    {
+      wl_resource_post_error (decoration_resource,
+                              ZXDG_TOPLEVEL_DECORATION_V1_ERROR_UNCONFIGURED_BUFFER,
+                              "The xdg_toplevel already has a buffer");
+      return;
+    }
+
+  decoration = g_new0 (MetaWaylandXdgDecoration, 1);
+  decoration->resource = decoration_resource;
+  decoration->toplevel = xdg_toplevel;
+  wl_resource_set_implementation (decoration_resource, &decoration_interface,
+                                  decoration, decoration_destructor);
+  g_object_set_qdata (G_OBJECT (xdg_toplevel), quark_decoration, decoration);
+
+  request_mode (decoration, ZXDG_TOPLEVEL_DECORATION_V1_MODE_SERVER_SIDE);
+}
+
+static const struct zxdg_decoration_manager_v1_interface manager_interface = {
+  manager_destroy,
+  manager_get_toplevel_decoration,
+};
+
+static void
+bind_decoration_manager (struct wl_client *client,
+                         void             *data,
+                         uint32_t          version,
+                         uint32_t          id)
+{
+  struct wl_resource *resource;
+
+  resource = wl_resource_create (client, &zxdg_decoration_manager_v1_interface,
+                                 version, id);
+  wl_resource_set_implementation (resource, &manager_interface, NULL, NULL);
+}
+
+int
+meta_wayland_xdg_decoration_get_titlebar_height (MetaWaylandXdgToplevel         *xdg_toplevel,
+                                                 MetaWaylandWindowConfiguration *configuration)
+{
+  MetaWaylandXdgDecoration *decoration = decoration_of (xdg_toplevel);
+
+  if (!decoration ||
+      decoration->mode != ZXDG_TOPLEVEL_DECORATION_V1_MODE_SERVER_SIDE ||
+      meta_window_config_get_is_fullscreen (configuration->config))
+    return 0;
+
+  return TITLEBAR_HEIGHT * configuration->scale;
+}
+
+void
+meta_wayland_xdg_decoration_send_configure (MetaWaylandXdgToplevel *xdg_toplevel)
+{
+  MetaWaylandXdgDecoration *decoration = decoration_of (xdg_toplevel);
+
+  if (!decoration || decoration->sent_mode == decoration->mode)
+    return;
+
+  zxdg_toplevel_decoration_v1_send_configure (decoration->resource,
+                                              decoration->mode);
+  decoration->sent_mode = decoration->mode;
+}
+
+void
+meta_wayland_xdg_decoration_toplevel_destroyed (MetaWaylandXdgToplevel *xdg_toplevel)
+{
+  MetaWaylandXdgDecoration *decoration = decoration_of (xdg_toplevel);
+
+  if (!decoration)
+    return;
+
+  decoration->toplevel = NULL;
+  g_object_set_qdata (G_OBJECT (xdg_toplevel), quark_decoration, NULL);
+  wl_resource_post_error (decoration->resource,
+                          ZXDG_TOPLEVEL_DECORATION_V1_ERROR_ORPHANED,
+                          "The xdg_toplevel was destroyed before its decoration");
+}
+
+void
+meta_wayland_init_xdg_decoration (MetaWaylandCompositor *compositor)
+{
+  quark_decoration = g_quark_from_static_string ("-meta-wayland-xdg-decoration");
+
+  if (wl_global_create (compositor->wayland_display,
+                        &zxdg_decoration_manager_v1_interface,
+                        META_ZXDG_DECORATION_MANAGER_V1_VERSION,
+                        NULL, bind_decoration_manager) == NULL)
+    g_error ("Failed to register a global xdg-decoration object");
+}
