(type luft_keyring_runtime_t)
(roletype object_r luft_keyring_runtime_t)
(typeattributeset file_type (luft_keyring_runtime_t))
(typeattributeset non_security_file_type (luft_keyring_runtime_t))
(typeattributeset non_auth_file_type (luft_keyring_runtime_t))
(filecon "/run/luft-keyring" dir (system_u object_r luft_keyring_runtime_t ((s0) (s0))))
(filecon "/run/luft-keyring/unlock" socket (system_u object_r luft_keyring_runtime_t ((s0) (s0))))
(allow xdm_t luft_keyring_runtime_t (dir (getattr search)))
(allow xdm_t luft_keyring_runtime_t (sock_file (getattr write)))
(allow xdm_t init_t (unix_stream_socket (connectto)))
(allow init_t luft_keyring_runtime_t (dir (getattr setattr search open read write add_name remove_name create rmdir relabelfrom relabelto)))
(allow init_t luft_keyring_runtime_t (sock_file (getattr setattr create unlink write relabelfrom relabelto)))
