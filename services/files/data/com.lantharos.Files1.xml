<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
 "https://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<node name="/com/lantharos/Files1">
  <!--
    Changes to files and processes that the person asking can't make themselves. Started on demand
    and stops when idle. Paths are absolute, as bytes, and may not pass through a link on the way to
    the item; the item itself may be a link and is then handled as the link, never what it points to.
    The file methods need com.lantharos.files.change, Signal and SetPriority need
    com.lantharos.files.processes. Every call asks for an administrator's password, and the answer
    covers that call alone. The prompt says what the call is about to do: one item is named in full,
    several are counted together with the folder they are all in, and processes are named. polkit
    rules get the same as "operation", "path" (the item, or the folder for several), "target",
    "count" and "processes".

    Copy, Move, Delete and Trash take every item of one change in a single call. They work through
    the items in order and stop at the first that can't be changed, with an error that names it;
    the items before it stay changed.
  -->
  <interface name="com.lantharos.Files1">
    <!-- Copies files, folders or links, each source to its target. A target that exists is left
         alone and fails the call, and a copy that can't be finished is removed again. Each copy
         belongs to whoever owns the folder it lands in and never keeps setuid or setgid. -->
    <method name="Copy">
      <arg name="items" type="a(ayay)" direction="in"/>
    </method>
    <!-- Moves or renames items, each source to its target. A target that exists is left alone and
         fails the call. -->
    <method name="Move">
      <arg name="items" type="a(ayay)" direction="in"/>
    </method>
    <!-- Removes items and everything in them for good. -->
    <method name="Delete">
      <arg name="paths" type="aay" direction="in"/>
    </method>
    <!-- Moves items to the caller's own trash, on the drive each is on, and returns where each item
         and its note went, in the order given. -->
    <method name="Trash">
      <arg name="paths" type="aay" direction="in"/>
      <arg name="trashed" type="a(ayay)" direction="out"/>
    </method>
    <!-- Makes a folder and the missing folders above it, each owned by whoever owns the folder it's
         in. Answers whether the folder is new. -->
    <method name="MakeFolder">
      <arg name="path" type="ay" direction="in"/>
      <arg name="created" type="b" direction="out"/>
    </method>
    <!-- Makes an empty file owned by whoever owns its folder. Fails when it exists. -->
    <method name="MakeFile">
      <arg name="path" type="ay" direction="in"/>
    </method>
    <!-- Sends SIGTERM, SIGKILL, SIGSTOP or SIGCONT to processes, each given as its number and the
         clock tick it started on. Processes that ended since are left out. -->
    <method name="Signal">
      <arg name="processes" type="a(ut)" direction="in"/>
      <arg name="signal" type="i" direction="in"/>
    </method>
    <!-- Sets the niceness, from -20 to 19, of every thread of a process. -->
    <method name="SetPriority">
      <arg name="process" type="(ut)" direction="in"/>
      <arg name="nice" type="i" direction="in"/>
    </method>
  </interface>
</node>
