## Fingerprints
## Each finger has a name used as a title (the message value) and a form used inside
## a sentence (.inline), like "Place your … on the sensor." Adjust the case of .inline
## to fit those sentences.

ui-finger-right-index = Oikea etusormi
    .inline = oikea etusormi
ui-finger-left-index = Vasen etusormi
    .inline = vasen etusormi
ui-finger-right-thumb = Oikea peukalo
    .inline = oikea peukalo
ui-finger-left-thumb = Vasen peukalo
    .inline = vasen peukalo
ui-finger-right-middle = Oikea keskisormi
    .inline = oikea keskisormi
ui-finger-left-middle = Vasen keskisormi
    .inline = vasen keskisormi
ui-finger-right-ring = Oikea nimetön
    .inline = oikea nimetön
ui-finger-left-ring = Vasen nimetön
    .inline = vasen nimetön
ui-finger-right-little = Oikea pikkusormi
    .inline = oikea pikkusormi
ui-finger-left-little = Vasen pikkusormi
    .inline = vasen pikkusormi

ui-fingerprint-place = Aseta { $finger } anturille.
ui-fingerprint-swipe = Vedä { $finger } anturin yli.
ui-fingerprint-stage-passed = Hyvä. Nosta sormi ja aseta se uudelleen.
ui-fingerprint-stage-passed-swipe = Hyvä. Vedä uudelleen.
ui-fingerprint-retry = Sormenjälkeä ei saatu luettua kunnolla. Yritä uudelleen.
ui-fingerprint-swipe-too-short = Vedä hieman hitaammin.
ui-fingerprint-not-centered = Aseta sormi anturin keskelle.
ui-fingerprint-remove-and-retry = Nosta sormi ja yritä uudelleen.
ui-fingerprint-added = Sormenjälki lisätty.
ui-fingerprint-full = Lukijaan ei mahdu enempää sormenjälkiä.
ui-fingerprint-disconnected = Sormenjälkilukija lakkasi vastaamasta. Yritä hetken päästä uudelleen.
ui-fingerprint-duplicate = Tämä sormi on jo tallennettu lukijaan, luultavasti Windowsissa tai toisella tilillä. Käytä toista sormea.
ui-fingerprint-failed = Sormenjälkeä ei voitu lisätä. Yritä uudelleen.

