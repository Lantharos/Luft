@@ -0,0 +1,553 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "config.h"
+
+#include "wayland/meta-wayland-layer-shell.h"
+
+#include "backends/meta-logical-monitor-private.h"
+#include "backends/meta-monitor-manager-private.h"
+#include "backends/meta-monitor-private.h"
+#include "compositor/compositor-private.h"
+#include "wayland/meta-wayland-actor-surface.h"
+#include "wayland/meta-wayland-outputs.h"
+#include "wayland/meta-wayland-private.h"
+#include "wayland/meta-wayland-sandbox.h"
+#include "wayland/meta-wayland-surface-private.h"
+#include "wayland/meta-wayland-versions.h"
+
+#include "wlr-layer-shell-unstable-v1-server-protocol.h"
+
+#define ANCHOR_ALL (ZWLR_LAYER_SURFACE_V1_ANCHOR_TOP | ZWLR_LAYER_SURFACE_V1_ANCHOR_BOTTOM | \
+                    ZWLR_LAYER_SURFACE_V1_ANCHOR_LEFT | ZWLR_LAYER_SURFACE_V1_ANCHOR_RIGHT)
+
+typedef struct
+{
+  uint32_t width;
+  uint32_t height;
+  uint32_t anchor;
+  int32_t margin_top;
+  int32_t margin_right;
+  int32_t margin_bottom;
+  int32_t margin_left;
+} LayerState;
+
+#define META_TYPE_WAYLAND_OVERLAY_GROUP (meta_wayland_overlay_group_get_type ())
+G_DECLARE_FINAL_TYPE (MetaWaylandOverlayGroup, meta_wayland_overlay_group,
+                      META, WAYLAND_OVERLAY_GROUP, ClutterActor)
+
+struct _MetaWaylandOverlayGroup
+{
+  ClutterActor parent;
+};
+
+G_DEFINE_TYPE (MetaWaylandOverlayGroup, meta_wayland_overlay_group, CLUTTER_TYPE_ACTOR)
+
+static void
+meta_wayland_overlay_group_pick (ClutterActor       *actor,
+                                 ClutterPickContext *pick_context)
+{
+}
+
+static void
+meta_wayland_overlay_group_init (MetaWaylandOverlayGroup *group)
+{
+}
+
+static void
+meta_wayland_overlay_group_class_init (MetaWaylandOverlayGroupClass *klass)
+{
+  CLUTTER_ACTOR_CLASS (klass)->pick = meta_wayland_overlay_group_pick;
+}
+
+#define META_TYPE_WAYLAND_LAYER_SURFACE (meta_wayland_layer_surface_get_type ())
+G_DECLARE_FINAL_TYPE (MetaWaylandLayerSurface, meta_wayland_layer_surface,
+                      META, WAYLAND_LAYER_SURFACE, MetaWaylandActorSurface)
+
+struct _MetaWaylandLayerSurface
+{
+  MetaWaylandActorSurface parent;
+
+  struct wl_resource *resource;
+  MetaWaylandOutput *output;
+  LayerState pending;
+  LayerState current;
+  uint32_t configured_serial;
+  gboolean configured;
+  ClutterActor *group;
+};
+
+G_DEFINE_TYPE (MetaWaylandLayerSurface, meta_wayland_layer_surface, META_TYPE_WAYLAND_ACTOR_SURFACE)
+
+static MetaWaylandSurface *
+surface_of (MetaWaylandLayerSurface *layer_surface)
+{
+  return meta_wayland_surface_role_get_surface (META_WAYLAND_SURFACE_ROLE (layer_surface));
+}
+
+static MetaContext *
+context_of (MetaWaylandLayerSurface *layer_surface)
+{
+  return meta_wayland_compositor_get_context (surface_of (layer_surface)->compositor);
+}
+
+static MetaLogicalMonitor *
+logical_monitor_of (MetaWaylandLayerSurface *layer_surface)
+{
+  MetaBackend *backend = meta_context_get_backend (context_of (layer_surface));
+  MetaMonitor *monitor = layer_surface->output ? meta_wayland_output_get_monitor (layer_surface->output) : NULL;
+  MetaLogicalMonitor *logical_monitor = monitor ? meta_monitor_get_logical_monitor (monitor) : NULL;
+
+  return logical_monitor ?: meta_monitor_manager_get_primary_logical_monitor (meta_backend_get_monitor_manager (backend));
+}
+
+static void
+send_configure (MetaWaylandLayerSurface *layer_surface)
+{
+  MetaLogicalMonitor *logical_monitor = logical_monitor_of (layer_surface);
+  MtkRectangle area = logical_monitor ? meta_logical_monitor_get_layout (logical_monitor) : (MtkRectangle) { 0 };
+  LayerState *state = &layer_surface->current;
+  uint32_t width = state->width;
+  uint32_t height = state->height;
+
+  if (!width)
+    width = MAX (0, area.width - state->margin_left - state->margin_right);
+  if (!height)
+    height = MAX (0, area.height - state->margin_top - state->margin_bottom);
+
+  layer_surface->configured_serial =
+    wl_display_next_serial (surface_of (layer_surface)->compositor->wayland_display);
+  zwlr_layer_surface_v1_send_configure (layer_surface->resource, layer_surface->configured_serial, width, height);
+  layer_surface->configured = TRUE;
+}
+
+static float
+place (int      start,
+       int      length,
+       int      size,
+       gboolean at_start,
+       gboolean at_end,
+       int      margin_start,
+       int      margin_end)
+{
+  if (at_start && !at_end)
+    return start + margin_start;
+  if (at_end && !at_start)
+    return start + length - size - margin_end;
+  return start + (length - size) / 2.0f;
+}
+
+static void
+update_position (MetaWaylandLayerSurface *layer_surface)
+{
+  MetaWaylandSurface *surface = surface_of (layer_surface);
+  MetaLogicalMonitor *logical_monitor = logical_monitor_of (layer_surface);
+  LayerState *state = &layer_surface->current;
+  MtkRectangle area;
+
+  if (!logical_monitor)
+    return;
+
+  area = meta_logical_monitor_get_layout (logical_monitor);
+  clutter_actor_set_position (layer_surface->group,
+                              place (area.x, area.width, meta_wayland_surface_get_width (surface),
+                                     state->anchor & ZWLR_LAYER_SURFACE_V1_ANCHOR_LEFT,
+                                     state->anchor & ZWLR_LAYER_SURFACE_V1_ANCHOR_RIGHT,
+                                     state->margin_left, state->margin_right),
+                              place (area.y, area.height, meta_wayland_surface_get_height (surface),
+                                     state->anchor & ZWLR_LAYER_SURFACE_V1_ANCHOR_TOP,
+                                     state->anchor & ZWLR_LAYER_SURFACE_V1_ANCHOR_BOTTOM,
+                                     state->margin_top, state->margin_bottom));
+}
+
+static gboolean
+collect_surface_actor (GNode    *node,
+                       gpointer  data)
+{
+  MetaSurfaceActor *surface_actor = meta_wayland_surface_get_actor (node->data);
+  GList **surface_actors = data;
+
+  if (surface_actor)
+    *surface_actors = g_list_append (*surface_actors, surface_actor);
+  return FALSE;
+}
+
+static void
+rebuild_surface_tree (MetaWaylandLayerSurface *layer_surface)
+{
+  MetaWaylandSurface *surface = surface_of (layer_surface);
+  g_autoptr (GList) surface_actors = NULL;
+  g_autoptr (GList) children = NULL;
+  int index = 0;
+
+  if (!layer_surface->group)
+    return;
+
+  g_node_traverse (surface->applied_state.subsurface_branch_node, G_IN_ORDER, G_TRAVERSE_LEAVES, -1,
+                   collect_surface_actor, &surface_actors);
+
+  children = clutter_actor_get_children (layer_surface->group);
+  for (GList *l = children; l; l = l->next)
+    if (!g_list_find (surface_actors, l->data))
+      clutter_actor_remove_child (layer_surface->group, l->data);
+
+  for (GList *l = surface_actors; l; l = l->next, index++)
+    {
+      ClutterActor *actor = l->data;
+      ClutterActor *parent = clutter_actor_get_parent (actor);
+
+      if (parent == layer_surface->group)
+        {
+          clutter_actor_set_child_at_index (layer_surface->group, actor, index);
+          continue;
+        }
+      if (parent)
+        clutter_actor_remove_child (parent, actor);
+      clutter_actor_insert_child_at_index (layer_surface->group, actor, index);
+    }
+}
+
+static void
+show (MetaWaylandLayerSurface *layer_surface)
+{
+  MetaDisplay *display = meta_context_get_display (context_of (layer_surface));
+  ClutterActor *top_window_group = meta_compositor_get_top_window_group (display->compositor);
+
+  if (layer_surface->group)
+    return;
+
+  layer_surface->group = g_object_new (META_TYPE_WAYLAND_OVERLAY_GROUP, NULL);
+  clutter_actor_add_child (top_window_group, layer_surface->group);
+  rebuild_surface_tree (layer_surface);
+}
+
+static void
+hide (MetaWaylandLayerSurface *layer_surface)
+{
+  if (!layer_surface->group)
+    return;
+
+  clutter_actor_remove_all_children (layer_surface->group);
+  g_clear_pointer (&layer_surface->group, clutter_actor_destroy);
+}
+
+static MetaWaylandSurface *
+layer_surface_get_toplevel (MetaWaylandSurfaceRole *surface_role)
+{
+  return meta_wayland_surface_role_get_surface (surface_role);
+}
+
+static void
+layer_surface_notify_subsurface_state_changed (MetaWaylandSurfaceRole *surface_role)
+{
+  rebuild_surface_tree (META_WAYLAND_LAYER_SURFACE (surface_role));
+}
+
+static void
+layer_surface_assigned (MetaWaylandSurfaceRole *surface_role)
+{
+  MetaWaylandSurface *surface = meta_wayland_surface_role_get_surface (surface_role);
+
+  if (!wl_list_empty (&surface->unassigned.pending_frame_callback_list))
+    meta_wayland_compositor_add_frame_callback_surface (surface->compositor, surface);
+
+  META_WAYLAND_SURFACE_ROLE_CLASS (meta_wayland_layer_surface_parent_class)->assigned (surface_role);
+}
+
+static void
+layer_surface_apply_state (MetaWaylandSurfaceRole  *surface_role,
+                           MetaWaylandSurfaceState *pending)
+{
+  MetaWaylandLayerSurface *layer_surface = META_WAYLAND_LAYER_SURFACE (surface_role);
+  MetaWaylandSurface *surface = meta_wayland_surface_role_get_surface (surface_role);
+
+  meta_wayland_compositor_add_frame_callback_surface (surface->compositor, surface);
+  META_WAYLAND_SURFACE_ROLE_CLASS (meta_wayland_layer_surface_parent_class)->apply_state (surface_role, pending);
+
+  if (!layer_surface->resource)
+    return;
+
+  layer_surface->current = layer_surface->pending;
+  if (!meta_wayland_surface_get_buffer (surface))
+    {
+      hide (layer_surface);
+      send_configure (layer_surface);
+      return;
+    }
+
+  if (!layer_surface->configured)
+    {
+      wl_resource_post_error (layer_surface->resource, ZWLR_LAYER_SURFACE_V1_ERROR_INVALID_SURFACE_STATE,
+                              "a buffer was attached before the first configure");
+      return;
+    }
+
+  show (layer_surface);
+  update_position (layer_surface);
+}
+
+static int
+layer_surface_get_geometry_scale (MetaWaylandActorSurface *actor_surface)
+{
+  MetaWaylandLayerSurface *layer_surface = META_WAYLAND_LAYER_SURFACE (actor_surface);
+  MetaBackend *backend = meta_context_get_backend (context_of (layer_surface));
+  MetaLogicalMonitor *logical_monitor = logical_monitor_of (layer_surface);
+
+  if (meta_backend_is_stage_views_scaled (backend) || !logical_monitor)
+    return 1;
+  return (int) roundf (meta_logical_monitor_get_scale (logical_monitor));
+}
+
+static MetaLogicalMonitor *
+layer_surface_get_preferred_scale_monitor (MetaWaylandSurfaceRole *surface_role)
+{
+  return logical_monitor_of (META_WAYLAND_LAYER_SURFACE (surface_role));
+}
+
+static void
+layer_surface_dispose (GObject *object)
+{
+  hide (META_WAYLAND_LAYER_SURFACE (object));
+  G_OBJECT_CLASS (meta_wayland_layer_surface_parent_class)->dispose (object);
+}
+
+static void
+meta_wayland_layer_surface_init (MetaWaylandLayerSurface *layer_surface)
+{
+}
+
+static void
+meta_wayland_layer_surface_class_init (MetaWaylandLayerSurfaceClass *klass)
+{
+  GObjectClass *object_class = G_OBJECT_CLASS (klass);
+  MetaWaylandSurfaceRoleClass *surface_role_class = META_WAYLAND_SURFACE_ROLE_CLASS (klass);
+  MetaWaylandActorSurfaceClass *actor_surface_class = META_WAYLAND_ACTOR_SURFACE_CLASS (klass);
+
+  object_class->dispose = layer_surface_dispose;
+  surface_role_class->assigned = layer_surface_assigned;
+  surface_role_class->apply_state = layer_surface_apply_state;
+  surface_role_class->get_preferred_scale_monitor = layer_surface_get_preferred_scale_monitor;
+  surface_role_class->notify_subsurface_state_changed = layer_surface_notify_subsurface_state_changed;
+  surface_role_class->get_toplevel = layer_surface_get_toplevel;
+  actor_surface_class->get_geometry_scale = layer_surface_get_geometry_scale;
+}
+
+static void
+layer_surface_destructor (struct wl_resource *resource)
+{
+  MetaWaylandLayerSurface *layer_surface = wl_resource_get_user_data (resource);
+
+  if (!layer_surface)
+    return;
+
+  hide (layer_surface);
+  layer_surface->resource = NULL;
+}
+
+static void
+layer_surface_set_size (struct wl_client   *client,
+                        struct wl_resource *resource,
+                        uint32_t            width,
+                        uint32_t            height)
+{
+  MetaWaylandLayerSurface *layer_surface = wl_resource_get_user_data (resource);
+
+  layer_surface->pending.width = width;
+  layer_surface->pending.height = height;
+}
+
+static void
+layer_surface_set_anchor (struct wl_client   *client,
+                          struct wl_resource *resource,
+                          uint32_t            anchor)
+{
+  MetaWaylandLayerSurface *layer_surface = wl_resource_get_user_data (resource);
+
+  if (anchor & ~ANCHOR_ALL)
+    {
+      wl_resource_post_error (resource, ZWLR_LAYER_SURFACE_V1_ERROR_INVALID_ANCHOR, "unknown anchor edges");
+      return;
+    }
+  layer_surface->pending.anchor = anchor;
+}
+
+static void
+layer_surface_set_exclusive_zone (struct wl_client   *client,
+                                  struct wl_resource *resource,
+                                  int32_t             zone)
+{
+}
+
+static void
+layer_surface_set_margin (struct wl_client   *client,
+                          struct wl_resource *resource,
+                          int32_t             top,
+                          int32_t             right,
+                          int32_t             bottom,
+                          int32_t             left)
+{
+  MetaWaylandLayerSurface *layer_surface = wl_resource_get_user_data (resource);
+
+  layer_surface->pending.margin_top = top;
+  layer_surface->pending.margin_right = right;
+  layer_surface->pending.margin_bottom = bottom;
+  layer_surface->pending.margin_left = left;
+}
+
+static void
+layer_surface_set_keyboard_interactivity (struct wl_client   *client,
+                                          struct wl_resource *resource,
+                                          uint32_t            keyboard_interactivity)
+{
+  if (keyboard_interactivity > ZWLR_LAYER_SURFACE_V1_KEYBOARD_INTERACTIVITY_ON_DEMAND)
+    wl_resource_post_error (resource, ZWLR_LAYER_SURFACE_V1_ERROR_INVALID_KEYBOARD_INTERACTIVITY,
+                            "unknown keyboard interactivity");
+}
+
+static void
+layer_surface_get_popup (struct wl_client   *client,
+                         struct wl_resource *resource,
+                         struct wl_resource *popup)
+{
+  wl_resource_post_error (resource, ZWLR_LAYER_SURFACE_V1_ERROR_INVALID_SURFACE_STATE,
+                          "overlays take no input, so they have no popups");
+}
+
+static void
+layer_surface_ack_configure (struct wl_client   *client,
+                             struct wl_resource *resource,
+                             uint32_t            serial)
+{
+}
+
+static void
+layer_surface_destroy (struct wl_client   *client,
+                       struct wl_resource *resource)
+{
+  wl_resource_destroy (resource);
+}
+
+static void
+layer_surface_set_layer (struct wl_client   *client,
+                         struct wl_resource *resource,
+                         uint32_t            layer)
+{
+  if (layer != ZWLR_LAYER_SHELL_V1_LAYER_OVERLAY)
+    wl_resource_post_error (resource, ZWLR_LAYER_SHELL_V1_ERROR_INVALID_LAYER,
+                            "Kestrel offers only the overlay layer");
+}
+
+static void
+layer_surface_set_exclusive_edge (struct wl_client   *client,
+                                  struct wl_resource *resource,
+                                  uint32_t            edge)
+{
+}
+
+static const struct zwlr_layer_surface_v1_interface layer_surface_interface = {
+  layer_surface_set_size,
+  layer_surface_set_anchor,
+  layer_surface_set_exclusive_zone,
+  layer_surface_set_margin,
+  layer_surface_set_keyboard_interactivity,
+  layer_surface_get_popup,
+  layer_surface_ack_configure,
+  layer_surface_destroy,
+  layer_surface_set_layer,
+  layer_surface_set_exclusive_edge,
+};
+
+static void
+layer_shell_get_layer_surface (struct wl_client   *client,
+                               struct wl_resource *resource,
+                               uint32_t            id,
+                               struct wl_resource *surface_resource,
+                               struct wl_resource *output_resource,
+                               uint32_t            layer,
+                               const char         *namespace)
+{
+  MetaWaylandSurface *surface = wl_resource_get_user_data (surface_resource);
+  MetaContext *context = meta_wayland_compositor_get_context (surface->compositor);
+  MetaWaylandLayerSurface *layer_surface;
+
+  if (!meta_wayland_client_may_capture_windows (context, client))
+    {
+      wl_resource_post_error (resource, ZWLR_LAYER_SHELL_V1_ERROR_ROLE,
+                              "this app may not show overlays");
+      return;
+    }
+  if (layer != ZWLR_LAYER_SHELL_V1_LAYER_OVERLAY)
+    {
+      wl_resource_post_error (resource, ZWLR_LAYER_SHELL_V1_ERROR_INVALID_LAYER,
+                              "Kestrel offers only the overlay layer");
+      return;
+    }
+  if (meta_wayland_surface_get_buffer (surface))
+    {
+      wl_resource_post_error (resource, ZWLR_LAYER_SHELL_V1_ERROR_ALREADY_CONSTRUCTED,
+                              "wl_surface@%d already has a buffer", wl_resource_get_id (surface_resource));
+      return;
+    }
+  if (!meta_wayland_surface_assign_role (surface, META_TYPE_WAYLAND_LAYER_SURFACE, NULL))
+    {
+      wl_resource_post_error (resource, ZWLR_LAYER_SHELL_V1_ERROR_ROLE,
+                              "wl_surface@%d already has a role", wl_resource_get_id (surface_resource));
+      return;
+    }
+
+  layer_surface = META_WAYLAND_LAYER_SURFACE (surface->role);
+  layer_surface->output = output_resource ? wl_resource_get_user_data (output_resource) : NULL;
+  layer_surface->resource = wl_resource_create (client, &zwlr_layer_surface_v1_interface,
+                                                wl_resource_get_version (resource), id);
+  wl_resource_set_implementation (layer_surface->resource, &layer_surface_interface,
+                                  layer_surface, layer_surface_destructor);
+}
+
+static void
+layer_shell_destroy (struct wl_client   *client,
+                     struct wl_resource *resource)
+{
+  wl_resource_destroy (resource);
+}
+
+static const struct zwlr_layer_shell_v1_interface layer_shell_interface = {
+  layer_shell_get_layer_surface,
+  layer_shell_destroy,
+};
+
+static void
+bind_layer_shell (struct wl_client *client,
+                  void             *data,
+                  uint32_t          version,
+                  uint32_t          id)
+{
+  struct wl_resource *resource = wl_resource_create (client, &zwlr_layer_shell_v1_interface, version, id);
+
+  wl_resource_set_implementation (resource, &layer_shell_interface, data, NULL);
+}
+
+/**
+ * meta_wayland_surface_is_overlay:
+ * @surface: a #MetaWaylandSurface
+ *
+ * Returns: whether @surface is shown on the overlay layer
+ */
+gboolean
+meta_wayland_surface_is_overlay (MetaWaylandSurface *surface)
+{
+  return surface && surface->role && META_IS_WAYLAND_LAYER_SURFACE (surface->role);
+}
+
+void
+meta_wayland_init_layer_shell (MetaWaylandCompositor *compositor)
+{
+  struct wl_global *global = wl_global_create (compositor->wayland_display,
+                                               &zwlr_layer_shell_v1_interface,
+                                               META_ZWLR_LAYER_SHELL_V1_VERSION,
+                                               compositor, bind_layer_shell);
+
+  if (!global)
+    g_error ("Failed to register a global wlr-layer-shell object");
+
+  meta_wayland_filter_manager_add_global (meta_wayland_compositor_get_filter_manager (compositor),
+                                          global, meta_wayland_filter_window_capture,
+                                          compositor->context);
+}
