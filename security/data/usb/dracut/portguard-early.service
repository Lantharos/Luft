[Unit]
Description=Hold back USB devices this computer doesn't know
DefaultDependencies=no
ConditionKernelCommandLine=!systemd.unit=rescue.target
After=initrd-root-fs.target
Before=initrd-fs.target initrd.target initrd-switch-root.target
RequiresMountsFor=/sysroot

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/portguard-early /sysroot
SyslogIdentifier=portguard
UMask=0077
ProtectSystem=strict
ReadWritePaths=/run /sys/devices /sys/bus/usb /sys/module/usbcore/parameters
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
CapabilityBoundingSet=
