+/**
+ * clutter_blur_get_reach: (skip)
+ * @n_levels: how many times the texture is halved
+ * @offset: sampling offset from clutter_blur_get_levels()
+ *
+ * Returns: how far, in pixels of the blurred area, the pixels a blurred
+ *   pixel is made of can lie from it: each step's taps and filtering, and
+ *   a pixel of the level it draws for rounding the area to that level
+ */
+int
+clutter_blur_get_reach (int   n_levels,
+                        float offset)
+{
+  float reach = 2.0f;
+  int i;
+
+  for (i = 1; i <= n_levels; i++)
+    reach += (0.5f * offset + 1.0f) * (1 << (i - 1)) + (1 << i);
+  for (i = 1; i < n_levels; i++)
+    reach += (offset + 1.0f) * (1 << (i + 1)) + (1 << i);
+
+  return n_levels > 0 ? (int) ceilf (reach) : 0;
 }
 
