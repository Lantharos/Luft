+/**
+ * clutter_virtual_input_device_notify_tablet_proximity:
+ * @virtual_device: a virtual tablet device
+ * @time_us: the time of the event, in microseconds
+ * @in_proximity: whether the tool comes near the tablet or leaves it
+ * @tool_type: the kind of tool, such as a pen or an eraser
+ *
+ * Brings a tool near the tablet or takes it away, as a pen hovering over
+ * a screen would. The tool draws at stage coordinates, like a pen on the
+ * screen itself.
+ */
+void
+clutter_virtual_input_device_notify_tablet_proximity (ClutterVirtualInputDevice  *virtual_device,
+                                                      uint64_t                    time_us,
+                                                      gboolean                    in_proximity,
+                                                      ClutterInputDeviceToolType  tool_type)
+{
+  ClutterVirtualInputDeviceClass *klass =
+    CLUTTER_VIRTUAL_INPUT_DEVICE_GET_CLASS (virtual_device);
+
+  g_return_if_fail (CLUTTER_IS_VIRTUAL_INPUT_DEVICE (virtual_device));
+  g_return_if_fail (klass->notify_tablet_proximity != NULL);
+
+  klass->notify_tablet_proximity (virtual_device, time_us, in_proximity,
+                                  tool_type);
+}
+
+/**
+ * clutter_virtual_input_device_notify_tablet_motion:
+ * @virtual_device: a virtual tablet device
+ * @time_us: the time of the event, in microseconds
+ * @x: where the tool is, in stage coordinates
+ * @y: where the tool is, in stage coordinates
+ * @pressure: how hard the tool presses, from 0 to 1
+ *
+ * Moves the tool that is near the tablet.
+ */
+void
+clutter_virtual_input_device_notify_tablet_motion (ClutterVirtualInputDevice *virtual_device,
+                                                   uint64_t                   time_us,
+                                                   double                     x,
+                                                   double                     y,
+                                                   double                     pressure)
+{
+  ClutterVirtualInputDeviceClass *klass =
+    CLUTTER_VIRTUAL_INPUT_DEVICE_GET_CLASS (virtual_device);
+
+  g_return_if_fail (CLUTTER_IS_VIRTUAL_INPUT_DEVICE (virtual_device));
+  g_return_if_fail (klass->notify_tablet_motion != NULL);
+
+  klass->notify_tablet_motion (virtual_device, time_us, x, y, pressure);
+}
+
+/**
+ * clutter_virtual_input_device_notify_tablet_button:
+ * @virtual_device: a virtual tablet device
+ * @time_us: the time of the event, in microseconds
+ * @button: the evdev code of the button, BTN_TOUCH for the tip
+ * @button_state: whether the button is pressed or released
+ *
+ * Presses or releases the tip or a button of the tool near the tablet.
+ */
+void
+clutter_virtual_input_device_notify_tablet_button (ClutterVirtualInputDevice *virtual_device,
+                                                   uint64_t                   time_us,
+                                                   uint32_t                   button,
+                                                   ClutterButtonState         button_state)
+{
+  ClutterVirtualInputDeviceClass *klass =
+    CLUTTER_VIRTUAL_INPUT_DEVICE_GET_CLASS (virtual_device);
+
+  g_return_if_fail (CLUTTER_IS_VIRTUAL_INPUT_DEVICE (virtual_device));
+  g_return_if_fail (klass->notify_tablet_button != NULL);
+
+  klass->notify_tablet_button (virtual_device, time_us, button, button_state);
+}
