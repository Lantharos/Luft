{
	"compilerOptions": {
		"target": "ES2025",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noEmit": true,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"types": ["@types/bun"]
	},
	"include": ["src/**/*.ts"]
}
