--- a/src/core/meta-debug-control.c
+++ b/src/core/meta-debug-control.c
@@ -20,6 +20,7 @@
 
 #include "core/meta-debug-control-private.h"
 
+#include "core/meta-dbus-guard.h"
 #include "core/util-private.h"
 #include "meta/meta-backend.h"
 #include "meta/meta-context.h"
@@ -74,6 +75,8 @@ on_bus_acquired (GDBusConnection *connection,
               "Acquired D-Bus name '%s', exporting service on '%s'",
               META_DEBUG_CONTROL_DBUS_SERVICE, META_DEBUG_CONTROL_DBUS_PATH);
 
+  meta_dbus_guard_interface (G_DBUS_INTERFACE_SKELETON (debug_control),
+                             debug_control->context, NULL);
   if (!g_dbus_interface_skeleton_export (G_DBUS_INTERFACE_SKELETON (debug_control),
                                          connection,
                                          META_DEBUG_CONTROL_DBUS_PATH,
@@ -161,6 +164,8 @@ meta_debug_control_class_init (MetaDebugControlClass *klass)
                                                    G_PARAM_EXPLICIT_NOTIFY |
                                                    G_PARAM_STATIC_STRINGS);
   g_object_class_install_properties (object_class, N_PROPS, obj_props);
+
+  meta_dbus_guard_property_writes (G_DBUS_INTERFACE_SKELETON_CLASS (klass));
 }
 
