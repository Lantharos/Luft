                   G_TYPE_INT,
                   META_TYPE_WINDOW);
 
+  /**
+   * MetaDisplay::window-capture-started:
+   * @display: the #MetaDisplay
+   * @id: the capture, to stop it with meta_display_stop_window_capture()
+   * @window: the window being recorded
+   * @app_id: (nullable): the sandboxed app recording it, or %NULL for a
+   *   program outside a sandbox
+   *
+   * A Wayland client started recording a window through
+   * ext-image-copy-capture-v1.
+   */
+  display_signals[WINDOW_CAPTURE_STARTED] =
+    g_signal_new ("window-capture-started",
+                  G_TYPE_FROM_CLASS (klass),
+                  G_SIGNAL_RUN_LAST,
+                  0, NULL, NULL, NULL,
+                  G_TYPE_NONE, 3,
+                  G_TYPE_UINT, META_TYPE_WINDOW, G_TYPE_STRING);
+
+  /**
+   * MetaDisplay::window-capture-ended:
+   * @display: the #MetaDisplay
+   * @id: the capture that ended
+   */
+  display_signals[WINDOW_CAPTURE_ENDED] =
+    g_signal_new ("window-capture-ended",
+                  G_TYPE_FROM_CLASS (klass),
+                  G_SIGNAL_RUN_LAST,
+                  0, NULL, NULL, NULL,
+                  G_TYPE_NONE, 1,
+                  G_TYPE_UINT);
+
   display_signals[IN_FULLSCREEN_CHANGED] =
     g_signal_new ("in-fullscreen-changed",
                   G_TYPE_FROM_CLASS (klass),
@@ -2341,6 +2376,39 @@ meta_display_get_context (MetaDisplay *display)
   return priv->context;
 }
 
+void
+meta_display_window_capture_started (MetaDisplay  *display,
+                                     unsigned int  id,
+                                     MetaWindow   *window,
+                                     const char   *app_id)
+{
+  g_signal_emit (display, display_signals[WINDOW_CAPTURE_STARTED], 0, id, window, app_id);
+}
+
+void
+meta_display_window_capture_ended (MetaDisplay  *display,
+                                   unsigned int  id)
+{
+  g_signal_emit (display, display_signals[WINDOW_CAPTURE_ENDED], 0, id);
+}
+
+/**
+ * meta_display_stop_window_capture:
+ * @display: a #MetaDisplay
+ * @id: a capture from #MetaDisplay::window-capture-started
+ *
+ * Stops recording the window; the app hears the capture stopped.
+ */
+void
+meta_display_stop_window_capture (MetaDisplay  *display,
+                                  unsigned int  id)
+{
+  MetaWaylandCompositor *compositor =
+    meta_context_get_wayland_compositor (meta_display_get_context (display));
+
+  meta_wayland_image_copy_capture_stop (meta_wayland_compositor_get_image_copy_capture (compositor), id);
+}
