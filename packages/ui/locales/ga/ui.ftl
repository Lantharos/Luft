## Fingerprints
## Each finger has a name used as a title (the message value) and a form used inside
## a sentence (.inline), like "Place your … on the sensor." Adjust the case of .inline
## to fit those sentences.

ui-finger-right-index = Corrmhéar dheas
    .inline = do chorrmhéar dheas
ui-finger-left-index = Corrmhéar chlé
    .inline = do chorrmhéar chlé
ui-finger-right-thumb = Ordóg dheas
    .inline = d’ordóg dheas
ui-finger-left-thumb = Ordóg chlé
    .inline = d’ordóg chlé
ui-finger-right-middle = Méar fhada dheas
    .inline = do mhéar fhada dheas
ui-finger-left-middle = Méar fhada chlé
    .inline = do mhéar fhada chlé
ui-finger-right-ring = Méar fáinne dheas
    .inline = do mhéar fáinne dheas
ui-finger-left-ring = Méar fáinne chlé
    .inline = do mhéar fáinne chlé
ui-finger-right-little = Lúidín deas
    .inline = do lúidín deas
ui-finger-left-little = Lúidín clé
    .inline = do lúidín clé

ui-fingerprint-place = Cuir { $finger } ar an mbraiteoir.
ui-fingerprint-swipe = Scuab { $finger } trasna an bhraiteora.
ui-fingerprint-stage-passed = Go maith. Tóg do mhéar, ansin cuir ar ais í.
ui-fingerprint-stage-passed-swipe = Go maith. Scuab arís.
ui-fingerprint-retry = Níor léadh é sin i gceart. Bain triail eile as.
ui-fingerprint-swipe-too-short = Scuab beagán níos moille.
ui-fingerprint-not-centered = Cuir do mhéar i lár an bhraiteora.
ui-fingerprint-remove-and-retry = Tóg do mhéar agus bain triail eile as.
ui-fingerprint-added = Cuireadh an méarlorg leis.
ui-fingerprint-full = Níl spás fágtha sa léitheoir do mhéarlorg eile.
ui-fingerprint-disconnected = Stop an léitheoir méarloirg ag freagairt. Bain triail eile as i gceann nóiméid.
ui-fingerprint-duplicate = Tá an mhéar seo sábháilte sa léitheoir cheana, ó Windows nó ó chuntas eile is dócha. Úsáid méar eile.
ui-fingerprint-failed = Níorbh fhéidir an méarlorg seo a chur leis. Bain triail eile as.

