+      cogl_framebuffer_draw_textured_rectangle (target->framebuffer, pipeline,
+                                                0, 0, target_level->width, target_level->height,
+                                                0, 0,
+                                                source_level->width / texture_width,
+                                                source_level->height / texture_height);
