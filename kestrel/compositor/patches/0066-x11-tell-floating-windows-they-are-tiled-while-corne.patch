From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Kristof Imeri <kristof@lanth.me>
Date: Thu, 5 Nov 2026 21:05:57 +0100
Subject: [PATCH 66/68] x11: tell floating windows they are tiled while corners
 are square

With rounded corners off, Wayland clients are told they are tiled, which
makes toolkits draw square corners. X11 clients weren't, so GTK 3 apps
under Xwayland kept rounding their own corners on a desktop where
everything else is square, and Phosphor's borders ran past them.

Send them the same through _GTK_EDGE_CONSTRAINTS, whose resizable bits
stay as they are, and update it when the setting changes.

Upstream-Status: luft-only follows Kestrel's rounded corner setting
---
 src/compositor/compositor.c  |  6 +++++-
 src/x11/window-x11-private.h |  2 ++
 src/x11/window-x11.c         | 16 ++++++++++++----
 3 files changed, 19 insertions(+), 5 deletions(-)

diff --git a/src/compositor/compositor.c b/src/compositor/compositor.c
index b036568c0735dd46502e9d2bc475dbb637eba5fd..cc0f7fd45a8899bb4e037a0f57547972345b921a 100644
--- a/src/compositor/compositor.c
+++ b/src/compositor/compositor.c
@@ -82,6 +82,7 @@
 #include "compositor/meta-window-actor-x11.h"
 
 #include "x11/meta-x11-display-private.h"
+#include "x11/window-x11-private.h"
 #endif
 
 enum
@@ -1267,7 +1268,10 @@ refresh_window_corners (MetaCompositor *compositor)
         meta_window_wayland_refresh_states (window);
 #ifdef HAVE_XWAYLAND
       if (META_IS_WINDOW_ACTOR_X11 (window_actor))
-        meta_window_actor_x11_update_shape (META_WINDOW_ACTOR_X11 (window_actor));
+        {
+          meta_window_actor_x11_update_shape (META_WINDOW_ACTOR_X11 (window_actor));
+          meta_window_x11_sync_square_corners (window);
+        }
 #endif
       clutter_actor_queue_redraw (CLUTTER_ACTOR (window_actor));
     }
diff --git a/src/x11/window-x11-private.h b/src/x11/window-x11-private.h
index 8f470edd39935997b58fe977c57ca8fe15dfed98..63d81362b8be4fff4487d94a26a2748fd71546ce 100644
--- a/src/x11/window-x11-private.h
+++ b/src/x11/window-x11-private.h
@@ -115,6 +115,8 @@ MetaWindowX11Private * meta_window_x11_get_private (MetaWindowX11 *window_x11);
 
 void meta_window_x11_initialize_state (MetaWindow *window);
 
+void meta_window_x11_sync_square_corners (MetaWindow *window);
+
 Window meta_window_x11_get_xgroup_leader (MetaWindow *window);
 
 Window meta_window_x11_get_user_time_window (MetaWindow *window);
diff --git a/src/x11/window-x11.c b/src/x11/window-x11.c
index fd9d43399447ab05352fc63761872fdad785870a..3b446c38963fbaa60fffde08cc210ec5619282f6 100644
--- a/src/x11/window-x11.c
+++ b/src/x11/window-x11.c
@@ -37,6 +37,7 @@
 #include "backends/meta-logical-monitor-private.h"
 #include "compositor/compositor-private.h"
 #include "compositor/meta-window-actor-private.h"
+#include "compositor/meta-window-corners.h"
 #include "core/boxes-private.h"
 #include "core/meta-window-config-private.h"
 #include "core/meta-workspace-manager-private.h"
@@ -1221,23 +1222,24 @@ static unsigned long
 edge_constraints_to_gtk_edge_constraints (MetaWindow *window)
 {
   unsigned long gtk_edge_constraints = 0;
+  gboolean square = meta_window_corners_square_client (window);
 
-  if (is_edge_constraint_tiled (window->edge_constraints.top))
+  if (square || is_edge_constraint_tiled (window->edge_constraints.top))
     gtk_edge_constraints |= META_GTK_EDGE_CONSTRAINT_TOP_TILED;
   if (is_edge_constraint_resizable (window->edge_constraints.top))
     gtk_edge_constraints |= META_GTK_EDGE_CONSTRAINT_TOP_RESIZABLE;
 
-  if (is_edge_constraint_tiled (window->edge_constraints.right))
+  if (square || is_edge_constraint_tiled (window->edge_constraints.right))
     gtk_edge_constraints |= META_GTK_EDGE_CONSTRAINT_RIGHT_TILED;
   if (is_edge_constraint_resizable (window->edge_constraints.right))
     gtk_edge_constraints |= META_GTK_EDGE_CONSTRAINT_RIGHT_RESIZABLE;
 
-  if (is_edge_constraint_tiled (window->edge_constraints.bottom))
+  if (square || is_edge_constraint_tiled (window->edge_constraints.bottom))
     gtk_edge_constraints |= META_GTK_EDGE_CONSTRAINT_BOTTOM_TILED;
   if (is_edge_constraint_resizable (window->edge_constraints.bottom))
     gtk_edge_constraints |= META_GTK_EDGE_CONSTRAINT_BOTTOM_RESIZABLE;
 
-  if (is_edge_constraint_tiled (window->edge_constraints.left))
+  if (square || is_edge_constraint_tiled (window->edge_constraints.left))
     gtk_edge_constraints |= META_GTK_EDGE_CONSTRAINT_LEFT_TILED;
   if (is_edge_constraint_resizable (window->edge_constraints.left))
     gtk_edge_constraints |= META_GTK_EDGE_CONSTRAINT_LEFT_RESIZABLE;
@@ -1267,6 +1269,12 @@ update_gtk_edge_constraints (MetaWindow *window)
   mtk_x11_error_trap_pop (x11_display->xdisplay);
 }
 
+void
+meta_window_x11_sync_square_corners (MetaWindow *window)
+{
+  update_gtk_edge_constraints (window);
+}
+
 static unsigned long
 meta_window_get_net_wm_desktop (MetaWindow *window)
 {
