diff --git a/src/backends/native/meta-virtual-input-device-native.c b/src/backends/native/meta-virtual-input-device-native.c
index 0d6b8f269f45309022aec474f249fa4679b8c2e4..e0821d45872f1dfd954e9edae11d747dd2010cdd 100644
--- a/src/backends/native/meta-virtual-input-device-native.c
+++ b/src/backends/native/meta-virtual-input-device-native.c
@@ -96,6 +96,17 @@ typedef struct
   double y;
 } MetaVirtualEventTouch;
 
+typedef struct
+{
+  uint64_t time_us;
+  ClutterTouchpadGesturePhase phase;
+  uint32_t fingers;
+  double dx;
+  double dy;
+  double angle_delta;
+  double scale;
+} MetaVirtualEventGesture;
+
 G_DEFINE_TYPE (MetaVirtualInputDeviceNative,
                meta_virtual_input_device_native,
                CLUTTER_TYPE_VIRTUAL_INPUT_DEVICE)
@@ -971,6 +982,117 @@ meta_virtual_input_device_native_notify_touch_up (ClutterVirtualInputDevice *vir
   g_object_unref (task);
 }
 
+static gboolean
+notify_touchpad_pinch_in_impl (GTask *task)
+{
+  MetaVirtualInputDeviceNative *virtual_native =
+    g_task_get_source_object (task);
+  MetaVirtualEventGesture *event = g_task_get_task_data (task);
+
+  if (event->time_us == CLUTTER_CURRENT_TIME)
+    event->time_us = g_get_monotonic_time ();
+
+  meta_seat_impl_notify_touchpad_pinch_in_impl (virtual_native->impl_state->device,
+                                                event->time_us,
+                                                event->phase,
+                                                event->fingers,
+                                                event->dx, event->dy,
+                                                event->angle_delta,
+                                                event->scale);
+
+  g_task_return_boolean (task, TRUE);
+  return G_SOURCE_REMOVE;
+}
+
+static gboolean
+notify_touchpad_swipe_in_impl (GTask *task)
+{
+  MetaVirtualInputDeviceNative *virtual_native =
+    g_task_get_source_object (task);
+  MetaVirtualEventGesture *event = g_task_get_task_data (task);
+
+  if (event->time_us == CLUTTER_CURRENT_TIME)
+    event->time_us = g_get_monotonic_time ();
+
+  meta_seat_impl_notify_touchpad_swipe_in_impl (virtual_native->impl_state->device,
+                                                event->time_us,
+                                                event->phase,
+                                                event->fingers,
+                                                event->dx, event->dy);
+
+  g_task_return_boolean (task, TRUE);
+  return G_SOURCE_REMOVE;
+}
+
+static void
+run_gesture_task (MetaVirtualInputDeviceNative *virtual_native,
+                  MetaVirtualEventGesture      *event,
+                  GSourceFunc                   func)
+{
+  MetaSeatNative *seat_native =
+    meta_virtual_input_device_native_get_seat_native (virtual_native);
+  GTask *task;
+
+  task = g_task_new (virtual_native, NULL, NULL, NULL);
+  g_task_set_task_data (task, event, g_free);
+  meta_seat_impl_run_input_task (seat_native->impl, task, func);
+  g_object_unref (task);
+}
+
+static void
+meta_virtual_input_device_native_notify_touchpad_pinch (ClutterVirtualInputDevice   *virtual_device,
+                                                        uint64_t                     time_us,
+                                                        ClutterTouchpadGesturePhase  phase,
+                                                        uint32_t                     fingers,
+                                                        double                       dx,
+                                                        double                       dy,
+                                                        double                       angle_delta,
+                                                        double                       scale)
+{
+  MetaVirtualInputDeviceNative *virtual_native =
+    META_VIRTUAL_INPUT_DEVICE_NATIVE (virtual_device);
+  MetaVirtualEventGesture *event;
+
+  g_return_if_fail (virtual_native->impl_state != NULL);
+
+  event = g_new0 (MetaVirtualEventGesture, 1);
+  event->time_us = time_us;
+  event->phase = phase;
+  event->fingers = fingers;
+  event->dx = dx;
+  event->dy = dy;
+  event->angle_delta = angle_delta;
+  event->scale = scale;
+
+  run_gesture_task (virtual_native, event,
+                    (GSourceFunc) notify_touchpad_pinch_in_impl);
+}
+
+static void
+meta_virtual_input_device_native_notify_touchpad_swipe (ClutterVirtualInputDevice   *virtual_device,
+                                                        uint64_t                     time_us,
+                                                        ClutterTouchpadGesturePhase  phase,
+                                                        uint32_t                     fingers,
+                                                        double                       dx,
+                                                        double                       dy)
+{
+  MetaVirtualInputDeviceNative *virtual_native =
+    META_VIRTUAL_INPUT_DEVICE_NATIVE (virtual_device);
+  MetaVirtualEventGesture *event;
+
+  g_return_if_fail (virtual_native->impl_state != NULL);
+
+  event = g_new0 (MetaVirtualEventGesture, 1);
+  event->time_us = time_us;
+  event->phase = phase;
+  event->fingers = fingers;
+  event->dx = dx;
+  event->dy = dy;
+
+  run_gesture_task (virtual_native, event,
+                    (GSourceFunc) notify_touchpad_swipe_in_impl);
+}
+
 static void
 meta_virtual_input_device_native_get_property (GObject    *object,
                                                guint       prop_id,
@@ -1128,6 +1250,8 @@ meta_virtual_input_device_native_class_init (MetaVirtualInputDeviceNativeClass *
   virtual_input_device_class->notify_touch_down = meta_virtual_input_device_native_notify_touch_down;
   virtual_input_device_class->notify_touch_motion = meta_virtual_input_device_native_notify_touch_motion;
   virtual_input_device_class->notify_touch_up = meta_virtual_input_device_native_notify_touch_up;
