(type luft_keyring_runtime_t)
(roletype object_r luft_keyring_runtime_t)
(typeattributeset file_type (luft_keyring_runtime_t))
(typeattributeset non_security_file_type (luft_keyring_runtime_t))
(typeattributeset non_auth_file_type (luft_keyring_runtime_t))
(filecon "/run/luft-keyring" dir (system_u object_r luft_keyring_runtime_t ((s0) (s0))))
(filecon "/run/luft-keyring/unlock" socket (system_u object_r luft_keyring_runtime_t ((s0) (s0))))

(type luft_keyring_unlock_exec_t)
(roletype object_r luft_keyring_unlock_exec_t)
(typeattributeset file_type (luft_keyring_unlock_exec_t))
(typeattributeset exec_type (luft_keyring_unlock_exec_t))
(typeattributeset entry_type (luft_keyring_unlock_exec_t))
(typeattributeset non_security_file_type (luft_keyring_unlock_exec_t))
(typeattributeset non_auth_file_type (luft_keyring_unlock_exec_t))
(filecon "/usr/libexec/luft-keyring-unlock" file (system_u object_r luft_keyring_unlock_exec_t ((s0) (s0))))

(type luft_keyring_unlock_t)
(roletype system_r luft_keyring_unlock_t)
(typeattributeset domain (luft_keyring_unlock_t))
(typeattributeset unconfined_domain_type (luft_keyring_unlock_t))
(typeattributeset files_unconfined_type (luft_keyring_unlock_t))
(typeattributeset filesystem_unconfined_type (luft_keyring_unlock_t))
(typeattributeset devices_unconfined_type (luft_keyring_unlock_t))
(typeattributeset storage_unconfined_type (luft_keyring_unlock_t))
(typeattributeset kern_unconfined (luft_keyring_unlock_t))
(typeattributeset selinux_unconfined_type (luft_keyring_unlock_t))
(typeattributeset corenet_unconfined_type (luft_keyring_unlock_t))
(typeattributeset dbusd_unconfined (luft_keyring_unlock_t))
(typeattributeset process_uncond_exempt (luft_keyring_unlock_t))
(typetransition init_t luft_keyring_unlock_exec_t process luft_keyring_unlock_t)
(allow init_t luft_keyring_unlock_exec_t (file (getattr open read execute map)))
(allow init_t luft_keyring_unlock_t (process (transition siginh rlimitinh noatsecure)))
(allow init_t luft_keyring_unlock_t (process2 (nnp_transition)))
(allow luft_keyring_unlock_t luft_keyring_unlock_exec_t (file (entrypoint getattr open read execute map)))
(allow init_t luft_keyring_unlock_t (unix_stream_socket (create bind listen accept getattr setattr getopt setopt read write shutdown ioctl)))

(allow xdm_t luft_keyring_runtime_t (dir (getattr search)))
(allow xdm_t luft_keyring_runtime_t (sock_file (getattr write)))
(allow xdm_t luft_keyring_unlock_t (unix_stream_socket (connectto)))
(allow init_t luft_keyring_runtime_t (dir (getattr setattr search open read write add_name remove_name create rmdir relabelfrom relabelto)))
(allow init_t luft_keyring_runtime_t (sock_file (getattr setattr create unlink write relabelfrom relabelto)))
