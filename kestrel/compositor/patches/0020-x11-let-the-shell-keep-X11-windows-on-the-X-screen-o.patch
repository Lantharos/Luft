+void
+meta_window_stage_to_root_point (MetaWindow *window,
+                                 int         stage_x,
+                                 int         stage_y,
+                                 int        *root_x,
+                                 int        *root_y)
+{
+  MetaDisplay *display = window->display;
+
+  meta_window_stage_to_protocol_point (window,
+                                       stage_x - display->x11_origin_x,
+                                       stage_y - display->x11_origin_y,
+                                       root_x, root_y);
+}
+
+void
+meta_window_stage_to_root_rect (MetaWindow         *window,
+                                const MtkRectangle *stage_rect,
+                                MtkRectangle       *root_rect)
+{
+  MetaDisplay *display = window->display;
+  MtkRectangle rect = *stage_rect;
+
+  rect.x -= display->x11_origin_x;
+  rect.y -= display->x11_origin_y;
+  meta_window_stage_to_protocol_rect (window, &rect, root_rect);
+}
+
+void
+meta_window_root_to_stage_point (MetaWindow          *window,
+                                 int                  root_x,
+                                 int                  root_y,
+                                 int                 *stage_x,
+                                 int                 *stage_y,
+                                 MtkRoundingStrategy  rounding_strategy)
+{
+  MetaDisplay *display = window->display;
+
+  meta_window_protocol_to_stage_point (window, root_x, root_y,
+                                       stage_x, stage_y, rounding_strategy);
+  if (stage_x)
+    *stage_x += display->x11_origin_x;
+  if (stage_y)
+    *stage_y += display->x11_origin_y;
+}
+
+void
+meta_window_root_to_stage_rect (MetaWindow         *window,
+                                const MtkRectangle *root_rect,
+                                MtkRectangle       *stage_rect)
+{
+  MetaDisplay *display = window->display;
+
+  meta_window_protocol_to_stage_rect (window, root_rect, stage_rect);
+  stage_rect->x += display->x11_origin_x;
+  stage_rect->y += display->x11_origin_y;
+}
