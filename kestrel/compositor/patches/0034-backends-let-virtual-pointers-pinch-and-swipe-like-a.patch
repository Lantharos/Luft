From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Kristof Imeri <kristof@lanth.me>
Date: Sat, 17 Oct 2026 19:19:33 +0200
Subject: [PATCH 34/55] backends: let virtual pointers pinch and swipe like a
 touchpad

Add clutter_virtual_input_device_notify_touchpad_pinch() and
notify_touchpad_swipe(), implemented by the native backend. The events
start at the pointer and go through the same path as a real touchpad's,
so programs that drive the desktop, such as Kestrel's checks, can pinch
and swipe over windows.
---
 .../clutter/clutter-virtual-input-device.c    |  62 +++++++++
 .../clutter/clutter-virtual-input-device.h    |  34 +++++
 src/backends/native/meta-seat-impl.c          |  26 ++++
 src/backends/native/meta-seat-impl.h          |  16 +++
 .../native/meta-virtual-input-device-native.c | 124 ++++++++++++++++++
 5 files changed, 262 insertions(+)

diff --git a/clutter/clutter/clutter-virtual-input-device.c b/clutter/clutter/clutter-virtual-input-device.c
index 4ebefff93aa9bbd8a33abacdc3e03cccd0ef3173..a6f9e2d6892eb97a10413a637245eb716cb5cab9 100644
--- a/clutter/clutter/clutter-virtual-input-device.c
+++ b/clutter/clutter/clutter-virtual-input-device.c
@@ -193,6 +193,68 @@ clutter_virtual_input_device_notify_touch_up (ClutterVirtualInputDevice *virtual
                           slot);
 }
 
+/**
+ * clutter_virtual_input_device_notify_touchpad_pinch:
+ * @virtual_device: a virtual pointer device
+ * @time_us: the time of the event, in microseconds
+ * @phase: the phase of the pinch
+ * @fingers: how many fingers pinch
+ * @dx: how far the fingers' center moved horizontally
+ * @dy: how far the fingers' center moved vertically
+ * @angle_delta: how far the fingers turned since the last update, in degrees
+ * @scale: the distance between the fingers relative to the start
+ *
+ * Sends a touchpad pinch at the pointer, as a touchpad would.
+ */
+void
+clutter_virtual_input_device_notify_touchpad_pinch (ClutterVirtualInputDevice   *virtual_device,
+                                                    uint64_t                     time_us,
+                                                    ClutterTouchpadGesturePhase  phase,
+                                                    uint32_t                     fingers,
+                                                    double                       dx,
+                                                    double                       dy,
+                                                    double                       angle_delta,
+                                                    double                       scale)
+{
+  ClutterVirtualInputDeviceClass *klass =
+    CLUTTER_VIRTUAL_INPUT_DEVICE_GET_CLASS (virtual_device);
+
+  g_return_if_fail (CLUTTER_IS_VIRTUAL_INPUT_DEVICE (virtual_device));
+  g_return_if_fail (klass->notify_touchpad_pinch != NULL);
+
+  klass->notify_touchpad_pinch (virtual_device, time_us, phase, fingers,
+                                dx, dy, angle_delta, scale);
+}
+
+/**
+ * clutter_virtual_input_device_notify_touchpad_swipe:
+ * @virtual_device: a virtual pointer device
+ * @time_us: the time of the event, in microseconds
+ * @phase: the phase of the swipe
+ * @fingers: how many fingers swipe
+ * @dx: how far the fingers moved horizontally
+ * @dy: how far the fingers moved vertically
+ *
+ * Sends a touchpad swipe at the pointer, as a touchpad would.
+ */
+void
+clutter_virtual_input_device_notify_touchpad_swipe (ClutterVirtualInputDevice   *virtual_device,
+                                                    uint64_t                     time_us,
+                                                    ClutterTouchpadGesturePhase  phase,
+                                                    uint32_t                     fingers,
+                                                    double                       dx,
+                                                    double                       dy)
+{
+  ClutterVirtualInputDeviceClass *klass =
+    CLUTTER_VIRTUAL_INPUT_DEVICE_GET_CLASS (virtual_device);
+
+  g_return_if_fail (CLUTTER_IS_VIRTUAL_INPUT_DEVICE (virtual_device));
+  g_return_if_fail (klass->notify_touchpad_swipe != NULL);
+
+  klass->notify_touchpad_swipe (virtual_device, time_us, phase, fingers,
+                                dx, dy);
+}
+
 int
 clutter_virtual_input_device_get_device_type (ClutterVirtualInputDevice *virtual_device)
 {
