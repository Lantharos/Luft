<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
 "https://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<node name="/com/lantharos/Installer1">
  <!--
    Installing Luft from the live system, and finishing first-run setup on the installed one.

    Phase: "live" (started from the USB stick), "first-boot" (installed, setup still pending) or "installed".
    Stage: "idle", "preparing" (making room and partitions), "copying", "waiting" (copied, waiting for the
      account and regional settings), "configuring", "finished" or "failed" (Error says why).
    Progress: 0 to 1 over the whole install.

    Survey, Install, Configure and CreateAccount need com.lantharos.installer.install. The rest only answer the
    account setup is pending for: FinishFirstBoot, and, while setup is still open, the setup steps, which also
    need com.lantharos.installer.set-up and have to come from Install Luft's own program. Anyone may call UseLanguage.
  -->
  <interface name="com.lantharos.Installer1">
    <property name="Phase" type="s" access="read"/>
    <property name="Stage" type="s" access="read"/>
    <property name="Progress" type="d" access="read"/>
    <property name="Error" type="s" access="read"/>

    <!-- JSON: drives with their free spaces, EFI system partition and Windows (size, used, smallest it can
         shrink to, room for Luft, version, fast startup, whether its clock is in UTC, how many
         Bluetooth devices it has paired, and why it can't shrink: "bitlocker", "hibernated",
         "dirty" or "full"), drives Luft can't use ("running", "read-only", "too-small"), hints read from
         Windows (time zone, keyboard, locale) and the smallest size Luft needs. -->
    <method name="Survey">
      <arg name="survey" type="s" direction="out"/>
    </method>
    <!-- JSON: {"target": {"kind": "whole", "drive"} | {"kind": "alongside", "drive", "size"} |
         {"kind": "free", "drive", "offset"} | {"kind": "replace", "system"}, "variant": "default" | "nvidia",
         "windows": {"fastStartupOff", "universalClock", "bluetooth"}, "encryption": {"recoveryKey", "passphrase"} | null}.
         Starts right away; the Windows choices apply to the Windows on that drive. With encryption, Luft's partition
         is encrypted with the recovery key from trustd's GenerateRecoveryKey, and the passphrase too when the TPM
         can't unlock it; replacing a system while keeping its files can't be encrypted. -->
    <method name="Install">
      <arg name="request" type="s" direction="in"/>
    </method>
    <!-- JSON: {"locale", "keyboard": {"layout", "variant"}, "timezone", "hostname"}. The last one given before
         copying ends is used. -->
    <method name="Configure">
      <arg name="regional" type="s" direction="in"/>
    </method>
    <!-- The account signs in automatically once, into first-run setup. -->
    <method name="CreateAccount">
      <arg name="name" type="s" direction="in"/>
      <arg name="full_name" type="s" direction="in"/>
      <arg name="password" type="s" direction="in"/>
    </method>
    <!-- The language errors are written in, as a BCP 47 tag like "de-AT". It's kept until the computer restarts. -->
    <method name="UseLanguage">
      <arg name="language" type="s" direction="in"/>
    </method>
    <!-- Only the account setup is pending for: stops signing in automatically. -->
    <method name="FinishFirstBoot"/>
    <!-- Asks trustd to add Luft's key to shim, and gives the code to type when the computer restarts. -->
    <method name="EnrollSigningKey">
      <arg name="code" type="s" direction="out"/>
    </method>
    <!-- Starts adding a fingerprint for the account on the default reader; FingerprintStatus follows each
         touch until done, then the reader is let go. -->
    <method name="EnrollFingerprint">
      <arg name="finger" type="s" direction="in"/>
    </method>
    <method name="StopFingerprint"/>
    <!-- fprintd's EnrollStatus, for the fingerprint being added. -->
    <signal name="FingerprintStatus">
      <arg name="result" type="s"/>
      <arg name="done" type="b"/>
    </signal>
  </interface>
</node>
