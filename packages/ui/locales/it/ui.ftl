## Fingerprints
## Each finger has a name used as a title (the message value) and a form used inside
## a sentence (.inline), like "Place your … on the sensor." Adjust the case of .inline
## to fit those sentences.

ui-finger-right-index = Indice destro
    .inline = l’indice destro
ui-finger-left-index = Indice sinistro
    .inline = l’indice sinistro
ui-finger-right-thumb = Pollice destro
    .inline = il pollice destro
ui-finger-left-thumb = Pollice sinistro
    .inline = il pollice sinistro
ui-finger-right-middle = Medio destro
    .inline = il medio destro
ui-finger-left-middle = Medio sinistro
    .inline = il medio sinistro
ui-finger-right-ring = Anulare destro
    .inline = l’anulare destro
ui-finger-left-ring = Anulare sinistro
    .inline = l’anulare sinistro
ui-finger-right-little = Mignolo destro
    .inline = il mignolo destro
ui-finger-left-little = Mignolo sinistro
    .inline = il mignolo sinistro

ui-fingerprint-place = Appoggia { $finger } sul sensore.
ui-fingerprint-swipe = Fai scorrere { $finger } sul sensore.
ui-fingerprint-stage-passed = Bene. Solleva il dito, poi appoggialo di nuovo.
ui-fingerprint-stage-passed-swipe = Bene. Fallo scorrere di nuovo.
ui-fingerprint-retry = La lettura non è riuscita. Riprova.
ui-fingerprint-swipe-too-short = Fai scorrere il dito un po’ più lentamente.
ui-fingerprint-not-centered = Centra il dito sul sensore.
ui-fingerprint-remove-and-retry = Solleva il dito e riprova.
ui-fingerprint-added = Impronta aggiunta.
ui-fingerprint-full = Il lettore non ha più spazio per altre impronte.
ui-fingerprint-disconnected = Il lettore di impronte ha smesso di rispondere. Riprova tra poco.
ui-fingerprint-duplicate = Il lettore ha già salvato questo dito, probabilmente da Windows o da un altro account. Usa un dito diverso.
ui-fingerprint-failed = Impossibile aggiungere questa impronta. Riprova.

