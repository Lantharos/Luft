 src/tests/x11-test-clients/meson.build        |   3 +
 .../unresponsive-selection-owner.c            | 178 ++++++++++++++++++
 src/tests/x11-tests.c                         |  97 ++++++++++
 4 files changed, 279 insertions(+)
 create mode 100644 src/tests/x11-test-clients/unresponsive-selection-owner.c

