## Fingerprints
## Each finger has a name used as a title (the message value) and a form used inside
## a sentence (.inline), like "Place your … on the sensor." Adjust the case of .inline
## to fit those sentences.

ui-finger-right-index = Sağ işaret parmağı
    .inline = sağ işaret parmağınızı
ui-finger-left-index = Sol işaret parmağı
    .inline = sol işaret parmağınızı
ui-finger-right-thumb = Sağ başparmak
    .inline = sağ başparmağınızı
ui-finger-left-thumb = Sol başparmak
    .inline = sol başparmağınızı
ui-finger-right-middle = Sağ orta parmak
    .inline = sağ orta parmağınızı
ui-finger-left-middle = Sol orta parmak
    .inline = sol orta parmağınızı
ui-finger-right-ring = Sağ yüzük parmağı
    .inline = sağ yüzük parmağınızı
ui-finger-left-ring = Sol yüzük parmağı
    .inline = sol yüzük parmağınızı
ui-finger-right-little = Sağ serçe parmak
    .inline = sağ serçe parmağınızı
ui-finger-left-little = Sol serçe parmak
    .inline = sol serçe parmağınızı

ui-fingerprint-place = Sensöre { $finger } yerleştirin.
ui-fingerprint-swipe = Sensörün üzerinde { $finger } kaydırın.
ui-fingerprint-stage-passed = Güzel. Parmağınızı kaldırıp yeniden yerleştirin.
ui-fingerprint-stage-passed-swipe = Güzel. Yeniden kaydırın.
ui-fingerprint-retry = İyi okunamadı. Yeniden deneyin.
ui-fingerprint-swipe-too-short = Biraz daha yavaş kaydırın.
ui-fingerprint-not-centered = Parmağınızı sensörün ortasına yerleştirin.
ui-fingerprint-remove-and-retry = Parmağınızı kaldırıp yeniden deneyin.
ui-fingerprint-added = Parmak izi eklendi.
ui-fingerprint-full = Okuyucuda başka bir parmak izine yer kalmadı.
ui-fingerprint-disconnected = Parmak izi okuyucu yanıt vermiyor. Biraz sonra yeniden deneyin.
ui-fingerprint-duplicate = Bu parmak okuyucuda zaten kayıtlı, büyük olasılıkla Windows ya da başka bir hesap tarafından. Başka bir parmak kullanın.
ui-fingerprint-failed = Bu parmak izi eklenemedi. Yeniden deneyin.

