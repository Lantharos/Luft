+#include "config.h"
+
+#include "wayland/meta-wayland-kestrel-glass.h"
+
+#include "compositor/compositor-private.h"
+#include "wayland/meta-wayland-private.h"
+#include "wayland/meta-wayland-surface-private.h"
+#include "wayland/meta-wayland-versions.h"
+
+#include "kestrel-glass-v1-server-protocol.h"
+
+#define KESTREL_GLASS_DATA "-meta-wayland-kestrel-glass"
+
+typedef struct
+{
+  struct wl_resource *resource;
+  MetaWaylandSurface *surface;
+  MetaCompositor *compositor;
+  gulong surface_destroyed_id;
+  gulong glass_changed_id;
+  MetaGlassMaterial material;
+} MetaWaylandKestrelGlass;
+
+static enum kestrel_glass_v1_material
+material_of (MetaGlassMaterial material)
+{
+  return material == META_GLASS_MATERIAL_SURFACE ?
+    KESTREL_GLASS_V1_MATERIAL_MARIS : KESTREL_GLASS_V1_MATERIAL_LUCA;
+}
+
+static void
+update (MetaWaylandKestrelGlass *glass)
+{
+  MetaWaylandSurface *surface = glass->surface;
+  MetaSurfaceActor *actor = meta_wayland_surface_get_actor (surface);
+  MetaGlassMaterial material;
+
+  if (actor)
+    meta_surface_actor_set_glass (actor, surface->glass_role, surface->glass_preference);
+
+  material = meta_compositor_get_glass_material (glass->compositor,
+                                                 surface->glass_role,
+                                                 surface->glass_preference);
+  if (material_of (material) == material_of (glass->material))
+    return;
+
+  glass->material = material;
+  kestrel_glass_v1_send_material (glass->resource, material_of (material));
+}
+
+static void
+set_preference (MetaWaylandKestrelGlass *glass,
+                MetaGlassPreference      preference)
+{
+  MetaGlassPreference previous = glass->surface->glass_preference;
+
+  if (previous == META_GLASS_PREFERENCE_MARIS)
+    meta_compositor_count_maris_request (glass->compositor, -1);
+  glass->surface->glass_preference = preference;
+  if (preference == META_GLASS_PREFERENCE_MARIS)
+    meta_compositor_count_maris_request (glass->compositor, 1);
+}
+
+static void
+forget_surface (MetaWaylandKestrelGlass *glass)
+{
+  set_preference (glass, META_GLASS_PREFERENCE_USER);
+  glass->surface->glass_role = META_GLASS_ROLE_WINDOW;
+  g_object_set_data (G_OBJECT (glass->surface), KESTREL_GLASS_DATA, NULL);
+  g_clear_signal_handler (&glass->surface_destroyed_id, glass->surface);
+  glass->surface = NULL;
+}
+
+static void
+glass_destructor (struct wl_resource *resource)
+{
+  MetaWaylandKestrelGlass *glass = wl_resource_get_user_data (resource);
+
+  if (glass->surface)
+    {
+      MetaSurfaceActor *actor = meta_wayland_surface_get_actor (glass->surface);
+
+      forget_surface (glass);
+      if (actor)
+        meta_surface_actor_set_glass (actor, META_GLASS_ROLE_WINDOW,
+                                      META_GLASS_PREFERENCE_USER);
+    }
+  g_clear_signal_handler (&glass->glass_changed_id, glass->compositor);
+  g_free (glass);
+}
+
+static void
+glass_destroy (struct wl_client   *client,
+               struct wl_resource *resource)
+{
+  wl_resource_destroy (resource);
+}
+
+static void
+glass_set_role (struct wl_client   *client,
+                struct wl_resource *resource,
+                uint32_t            role)
+{
+  MetaWaylandKestrelGlass *glass = wl_resource_get_user_data (resource);
+
+  if (!glass->surface)
+    return;
+
+  glass->surface->glass_role = role == KESTREL_GLASS_V1_ROLE_TRANSIENT ?
+    META_GLASS_ROLE_TRANSIENT : META_GLASS_ROLE_WINDOW;
+  update (glass);
+}
+
+static void
+glass_set_preference (struct wl_client   *client,
+                      struct wl_resource *resource,
+                      uint32_t            preference)
+{
+  MetaWaylandKestrelGlass *glass = wl_resource_get_user_data (resource);
+
+  if (!glass->surface)
+    return;
+
+  switch (preference)
+    {
+    case KESTREL_GLASS_V1_PREFERENCE_LUCA:
+      set_preference (glass, META_GLASS_PREFERENCE_LUCA);
+      break;
+    case KESTREL_GLASS_V1_PREFERENCE_MARIS:
+      set_preference (glass, META_GLASS_PREFERENCE_MARIS);
+      break;
+    default:
+      set_preference (glass, META_GLASS_PREFERENCE_USER);
+      break;
+    }
+  update (glass);
+}
+
+static const struct kestrel_glass_v1_interface glass_implementation =
+{
+  glass_destroy,
+  glass_set_role,
+  glass_set_preference,
+};
+
+static void
+on_surface_destroyed (MetaWaylandSurface      *surface,
+                      MetaWaylandKestrelGlass *glass)
+{
+  forget_surface (glass);
+}
+
+static void
+on_glass_changed (MetaCompositor          *compositor,
+                  MetaWaylandKestrelGlass *glass)
+{
+  if (glass->surface)
+    update (glass);
+}
+
+static void
+manager_destroy (struct wl_client   *client,
+                 struct wl_resource *resource)
+{
+  wl_resource_destroy (resource);
+}
+
+static void
+manager_get_glass (struct wl_client   *client,
+                   struct wl_resource *resource,
+                   uint32_t            id,
+                   struct wl_resource *surface_resource)
+{
+  MetaWaylandSurface *surface = wl_resource_get_user_data (surface_resource);
+  MetaWaylandCompositor *wayland_compositor = wl_resource_get_user_data (resource);
+  MetaContext *context = meta_wayland_compositor_get_context (wayland_compositor);
+  MetaDisplay *display = meta_context_get_display (context);
+  MetaWaylandKestrelGlass *glass;
+
+  if (g_object_get_data (G_OBJECT (surface), KESTREL_GLASS_DATA))
+    {
+      wl_resource_post_error (resource, KESTREL_GLASS_MANAGER_V1_ERROR_GLASS_EXISTS,
+                              "The surface already has a glass object");
+      return;
+    }
+
+  glass = g_new0 (MetaWaylandKestrelGlass, 1);
+  glass->surface = surface;
+  glass->compositor = meta_display_get_compositor (display);
+  glass->resource = wl_resource_create (client, &kestrel_glass_v1_interface,
+                                        wl_resource_get_version (resource), id);
+  wl_resource_set_implementation (glass->resource, &glass_implementation,
+                                  glass, glass_destructor);
+  g_object_set_data (G_OBJECT (surface), KESTREL_GLASS_DATA, glass);
+  glass->surface_destroyed_id =
+    g_signal_connect (surface, "destroy", G_CALLBACK (on_surface_destroyed), glass);
+  glass->glass_changed_id =
+    g_signal_connect (glass->compositor, "glass-changed", G_CALLBACK (on_glass_changed), glass);
+
+  glass->material = meta_compositor_get_glass_material (glass->compositor,
+                                                        surface->glass_role,
+                                                        surface->glass_preference);
+  kestrel_glass_v1_send_material (glass->resource, material_of (glass->material));
+}
+
+static const struct kestrel_glass_manager_v1_interface manager_implementation =
+{
+  manager_destroy,
+  manager_get_glass,
+};
+
+static void
+bind_manager (struct wl_client *client,
+              void             *data,
+              uint32_t          version,
+              uint32_t          id)
+{
+  struct wl_resource *resource;
+
+  resource = wl_resource_create (client, &kestrel_glass_manager_v1_interface, version, id);
+  wl_resource_set_implementation (resource, &manager_implementation, data, NULL);
+}
+
+void
+meta_wayland_init_kestrel_glass (MetaWaylandCompositor *compositor)
+{
+  if (!wl_global_create (compositor->wayland_display,
+                         &kestrel_glass_manager_v1_interface,
+                         META_KESTREL_GLASS_V1_VERSION,
+                         compositor, bind_manager))
+    g_warning ("Failed to create kestrel_glass_manager_v1 global");
+}
