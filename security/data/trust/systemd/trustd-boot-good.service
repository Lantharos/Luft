[Unit]
Description=Remember that this version of Luft started
Documentation=https://github.com/Lantharos/Luft/blob/main/docs/boot.md
Requires=boot-complete.target
After=boot-complete.target
ConditionPathExists=/sys/firmware/efi/efivars/LuftBootTrying-b6a4c1e2-3f5d-4c8a-9e71-2d0f6a8b5c3e

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/trustctl startup good

[Install]
WantedBy=graphical.target
