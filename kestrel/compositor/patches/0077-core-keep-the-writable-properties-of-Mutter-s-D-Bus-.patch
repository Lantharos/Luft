index b9089d31d900becf600f163e6ff99523111c4644..6d46db7d99f33e6c100970fc2add551fa95b359d 100644
--- a/src/core/meta-profiler.c
+++ b/src/core/meta-profiler.c
@@ -24,6 +24,7 @@
 #include <gio/gunixfdlist.h>
 
 #include "cogl/cogl.h"
+#include "core/meta-dbus-guard.h"
 
 #define META_SYSPROF_PROFILER_DBUS_PATH "/org/gnome/Sysprof3/Profiler"
 
@@ -285,11 +286,14 @@ meta_profiler_init (MetaProfiler *self)
 }
 
