-    G_DBUS_INTERFACE_SKELETON_CLASS (klass);
-
-  interface_skeleton_class->get_vtable = get_vtable;
+  meta_dbus_guard_property_writes (G_DBUS_INTERFACE_SKELETON_CLASS (klass));
 }
 
