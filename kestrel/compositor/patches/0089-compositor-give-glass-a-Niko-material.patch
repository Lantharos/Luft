   for (i = 0; i < mtk_region_num_rectangles (paint->paint_region); i++)
@@ -223,7 +224,7 @@ create_result_pipeline (const MetaBackgroundPaint *paint,
                               (float) height / result->capacity_height,
                               1.f);
   cogl_pipeline_set_layer_matrix (pipeline, 0, &matrix);
-  clutter_blur_add_framebuffer_effect (pipeline, paint->saturation, paint->noise, NULL, 0.f);
+  meta_background_add_glass_effect (paint, pipeline);
   apply_source_corners (paint, pipeline);
