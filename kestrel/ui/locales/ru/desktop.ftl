## App menu (right-click on a taskbar app)

window-menu-open = Открыть
window-menu-new-window = Новое окно
window-menu-restore = Восстановить
window-menu-minimize = Свернуть
window-menu-maximize = Развернуть
window-menu-unmaximize = Восстановить размер
window-menu-pin = Закрепить на панели задач
window-menu-unpin = Открепить от панели задач
window-menu-close = { $count ->
    [1] Закрыть окно
   *[other] Закрыть все окна
}

## Context menus

context-menu-back = Назад

## Window previews (hovering a taskbar app)

previews-close-window = Закрыть { $title }

## Tray

tray-apps = Приложения в системном трее
tray-open-app = Открыть { $appName }

## Board (tablet window layout)

board-open-start = Открыть меню «Пуск»
board-show-all-windows = Показать все окна
board-quick-settings = Быстрые настройки

## Task view

task-view-close-window = Закрыть окно
task-view-desktop = Рабочая область { $number }

## Snap layouts

snap-zone = Прикрепить к области { $width } % на { $height } %

## Window title bars

title-bar-minimize = Свернуть
title-bar-maximize = Развернуть
title-bar-close = Закрыть

## Window resizing

window-resize-size = { $width } × { $height }

## App not responding

close-dialog-title = Приложение «{ $appName }» не отвечает
close-dialog-description = Можно немного подождать, пока оно продолжит работу, или принудительно закрыть приложение
close-dialog-force-quit = Закрыть принудительно
close-dialog-wait = Подождать

