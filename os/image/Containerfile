ARG FEDORA=45
ARG BASE=quay.io/fedora/fedora-bootc:${FEDORA}

FROM ${BASE} AS luft
COPY os/image/packages /usr/share/luft/image/packages
COPY os/image/stages /usr/share/luft/image/stages
COPY --from=parts needed.txt /usr/share/luft/image/needed.txt
COPY --from=parts bootc/rpms/ /tmp/bootc/
RUN --mount=type=cache,target=/var/cache/libdnf5,sharing=locked \
    dnf install -y /tmp/bootc/*.rpm && rm -rf /tmp/bootc && \
    /usr/share/luft/image/stages/packages.sh /usr/share/luft/image/needed.txt
COPY --from=parts kestrel/stage/ /
COPY --from=parts boot/stage/ /
COPY --from=parts runtime/stage/ /
COPY --from=parts apps/ /
COPY os/image/files/ /
COPY --from=parts kestrel/typelibs.txt /usr/share/luft/image/typelibs.txt
COPY --from=parts keys/luft-secureboot.der /usr/share/luft/secure-boot/luft.der
COPY --from=parts keys/luft-pcr-policy.pub.pem /usr/share/luft/secure-boot/pcr-policy.pem
ARG FEDORA
ARG VERSION=45.dev
ARG IMAGE_REFERENCE=ghcr.io/lantharos/luft:${FEDORA}
RUN /usr/share/luft/image/stages/finalize.sh luft "${VERSION}" "${IMAGE_REFERENCE}" && \
    rm -rf /usr/share/luft/image
RUN bootc container lint
ARG RELEASE_NOTES=""
LABEL org.opencontainers.image.version="${VERSION}" com.lantharos.release-notes="${RELEASE_NOTES}"

FROM luft AS luft-nvidia
COPY os/image/stages/nvidia.sh os/image/stages/rpmfusion.sh /tmp/stages/
COPY --from=parts nvidia/ /tmp/nvidia/
RUN --mount=type=cache,target=/var/cache/libdnf5,sharing=locked \
    /tmp/stages/nvidia.sh /tmp/nvidia && \
    rm -rf /tmp/stages /tmp/nvidia
RUN bootc container lint
