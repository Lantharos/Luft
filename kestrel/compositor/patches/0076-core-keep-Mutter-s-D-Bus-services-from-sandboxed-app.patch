diff --git a/src/core/meta-dbus-guard.c b/src/core/meta-dbus-guard.c
new file mode 100644
index 0000000000000000000000000000000000000000..cbd2d79ab10cb8a12806f60a162b336f9d4a029e
--- /dev/null
+++ b/src/core/meta-dbus-guard.c
@@ -0,0 +1,72 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "config.h"
+
+#include "core/meta-dbus-guard.h"
+
+#include "core/meta-sandbox.h"
+
+#define SANDBOXED_KEY "-meta-dbus-guard-sandboxed"
+
+typedef struct
+{
+  MetaContext *context;
+  const char * const *open_methods;
+} Guard;
+
+static gboolean
+authorize_method (GDBusInterfaceSkeleton *skeleton,
+                  GDBusMethodInvocation  *invocation,
+                  Guard                  *guard)
+{
+  const char *method = g_dbus_method_invocation_get_method_name (invocation);
+
+  if (meta_dbus_sender_is_unsandboxed (guard->context,
+                                       g_dbus_method_invocation_get_connection (invocation),
+                                       g_dbus_method_invocation_get_sender (invocation)))
+    return TRUE;
+
+  if (guard->open_methods && g_strv_contains (guard->open_methods, method))
+    {
+      g_object_set_data (G_OBJECT (invocation), SANDBOXED_KEY, GINT_TO_POINTER (TRUE));
+      return TRUE;
+    }
+
+  g_dbus_method_invocation_return_error (invocation,
+                                         G_DBUS_ERROR,
+                                         G_DBUS_ERROR_ACCESS_DENIED,
+                                         "Sandboxed apps cannot call %s.%s",
+                                         g_dbus_method_invocation_get_interface_name (invocation),
+                                         method);
+  return FALSE;
+}
+
+/*
+ * meta_dbus_guard_interface:
+ * @skeleton: an interface Mutter exports
+ * @context: the #MetaContext
+ * @open_methods: (array zero-terminated=1) (nullable): the methods sandboxed
+ *   apps may call, which must outlive @skeleton
+ *
+ * Keeps every method of @skeleton to callers outside a sandbox and apps given
+ * full access, except those in @open_methods. A caller that can't be
+ * identified counts as sandboxed.
+ */
+void
+meta_dbus_guard_interface (GDBusInterfaceSkeleton *skeleton,
+                           MetaContext            *context,
+                           const char * const     *open_methods)
+{
+  Guard *guard = g_new0 (Guard, 1);
+
+  guard->context = context;
+  guard->open_methods = open_methods;
+  g_signal_connect_data (skeleton, "g-authorize-method",
+                         G_CALLBACK (authorize_method), guard,
+                         (GClosureNotify) g_free, G_CONNECT_DEFAULT);
+}
+
+gboolean
+meta_dbus_caller_is_sandboxed (GDBusMethodInvocation *invocation)
+{
+  return g_object_get_data (G_OBJECT (invocation), SANDBOXED_KEY) != NULL;
+}
