                            stage);
 }
 
+static ClutterActorTraverseVisitFlags
+unrealize_mapped_actor_before_children_cb (ClutterActor *self,
+                                           int           depth,
+                                           void         *user_data)
+{
+  ClutterActorPrivate *priv = self->priv;
+
+  /* Fails if a previous call to `clutter_actor_unrealize_mapped()` was
+   * not paired with a call to `clutter_actor_realize_mapped()`. */
+  g_assert (!clutter_actor_is_unrealized_mapped (self));
+
+#ifdef CLUTTER_ENABLE_DEBUG
+  clutter_actor_verify_map_state (self);
+#endif
+
+  /* If an actor is already unrealized, we know its children have also
+   * already been unrealized. */
+  if (!clutter_actor_is_realized (self))
+    return CLUTTER_ACTOR_TRAVERSE_VISIT_SKIP_CHILDREN;
+
+  priv->is_unrealized_mapped = TRUE;
+
+  g_signal_emit (self, actor_signals[UNREALIZE], 0);
+
+  return CLUTTER_ACTOR_TRAVERSE_VISIT_CONTINUE;
+}
+
+static ClutterActorTraverseVisitFlags
+unrealize_mapped_actor_after_children_cb (ClutterActor *self,
+                                          int           depth,
+                                          void         *user_data)
+{
+  /* We want to unset the realized flag only *after* child actors
+   * are unrealized, to maintain invariants. */
+  self->flags &= ~CLUTTER_ACTOR_REALIZED;
+  g_object_notify_by_pspec (G_OBJECT (self), obj_props[PROP_REALIZED]);
+
+  return CLUTTER_ACTOR_TRAVERSE_VISIT_CONTINUE;
+}
+
+/*
+ * clutter_actor_unrealize_mapped:
+ * @self: A #ClutterActor
+ *
+ * Unrealizes an actor and its children, even if mapped.
+ *
+ * IMPORTANT:
+ *   Must be paired with a call to `clutter_actor_realize_mapped()`.
+ *
+ * Used to restore actors during graphics recovery.
+ *
+ * This introduces a temporary exception to actor realization invariants, but is
+ * deemed neccessary for the special case of graphics recovery where unmapping
+ * has undesired side effects. It also introduces a few *localized* (i.e, only
+ * within `_clutter_actor_[un]realize_mapped()`) invariants of its own.
+ */
+void
+clutter_actor_unrealize_mapped (ClutterActor *self)
+{
+  g_return_if_fail (CLUTTER_IS_ACTOR (self));
+
+  _clutter_actor_traverse (self,
+                           CLUTTER_ACTOR_TRAVERSE_DEPTH_FIRST,
+                           unrealize_mapped_actor_before_children_cb,
+                           unrealize_mapped_actor_after_children_cb,
+                           NULL);
+}
+
+/*
+ * clutter_actor_is_unrealized_mapped:
+ * @self: a #ClutterActor
+ *
+ * Checks whether a #ClutterActor was unrealized
+ * by `clutter_actor_unrealize_mapped()`.
+ *
+ * Returns: %TRUE if the actor was unrealized
+ * by `clutter_actor_unrealize_mapped()`.
+ */
+gboolean
+clutter_actor_is_unrealized_mapped (ClutterActor *self)
+{
+  g_return_val_if_fail (CLUTTER_IS_ACTOR (self), FALSE);
+
+  return self->priv->is_unrealized_mapped;
+}
