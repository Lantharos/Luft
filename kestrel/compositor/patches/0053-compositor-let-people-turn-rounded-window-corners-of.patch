index 3d39602d060d3b34ea475c03f2c768cdf8bff3f1..918abcc28869a593e161d0bbf938c2997113f31a 100644
--- a/src/compositor/meta-window-corners.h
+++ b/src/compositor/meta-window-corners.h
@@ -19,6 +19,8 @@ typedef enum
