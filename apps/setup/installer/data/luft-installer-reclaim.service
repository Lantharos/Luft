[Unit]
Description=Give Luft the space Meet Luft used
After=local-fs.target dbus.service
Before=trustd.service trustd-follow-up.service luft-installer.service display-manager.service greetd.service
ConditionPathExists=/var/lib/luft-installer/meet.json
ConditionPathExists=!/var/lib/trustd/encryption.json

[Service]
Type=oneshot
ExecStart=/usr/libexec/luft-installer reclaim
SELinuxContext=system_u:system_r:install_t:s0
SyslogIdentifier=luft-installer

[Install]
WantedBy=multi-user.target
