## Errors shown in Install Luft and first-run setup

installer-not-allowed = Za to nimate dovoljenja.
installer-stopped = Namestitveni program se je nepričakovano ustavil.
installer-request-invalid = Zahteva ni veljavna: { $error }
installer-settings-invalid = Nastavitve niso veljavne: { $error }
installer-busy = Luft se že namešča.
installer-account-exists = Račun je že ustvarjen.

## Choosing what to install

installer-no-image = Slike { $variant } za namestitev ni.
installer-read-failed = Datoteke { $path } ni bilo mogoče prebrati
installer-parse-failed = Datoteke { $path } ni bilo mogoče razčleniti
installer-write-failed = Datoteke { $path } ni bilo mogoče zapisati

## Checking the destination

installer-drive-gone = Ta disk ni več priključen.
installer-drive-unusable = Na ta disk Lufta ni mogoče namestiti.
installer-system-gone = Tega sistema ni več.
installer-system-unreplaceable = Luft sistema { $system } še ne more zamenjati.
installer-drive-running = Luft se trenutno zaganja s tega diska, zato ga ni mogoče izbrisati.
installer-windows-unshrinkable = Sistema Windows na tem disku ni mogoče zmanjšati.
installer-size-wont-fit = Ta velikost ne ustreza prostoru ob sistemu Windows.
installer-space-gone = Tega prostega prostora ni več.
installer-space-too-small = Ta prosti prostor je za Luft premajhen.

## Account and regional settings

installer-user-name-invalid = Tega uporabniškega imena ni mogoče uporabiti.
installer-full-name-invalid = Ime ne sme vsebovati dvopičij, vejic ali prelomov vrstic.
installer-password-missing = Izberite geslo.
installer-account-not-saved = Novi račun ni bil shranjen
installer-account-missing = Novi račun manjka
installer-regional-invalid = Te področne nastavitve niso veljavne.
installer-unknown-zone = Novi sistem ne pozna časovnega pasu { $zone }.

## Installing

installer-esp-partition-failed = Sistemske particije EFI ni bilo mogoče ustvariti
installer-startup-partition-failed = Particije za Luftove zagonske datoteke ni bilo mogoče ustvariti
installer-root-partition-failed = Particije za Luft ni bilo mogoče ustvariti
installer-shrink-failed = Sistema Windows ni bilo mogoče zmanjšati
installer-no-esp = Disk nima sistemske particije EFI
installer-no-root = Particija za Luft ni bila ustvarjena
installer-copy-failed = Lufta ni bilo mogoče kopirati
installer-no-deployment = Novi sistem nima namestitve
installer-deployment-unnamed = Namestitev novega sistema nima imena
installer-deployment-unopened = Novega sistema ni bilo mogoče odpreti
installer-boot-menu-failed = Luftovega zagonskega menija ni bilo mogoče zapisati na sistemsko particijo EFI
installer-key-queue-failed = Luftovega ključa za Secure Boot ni bilo mogoče pripraviti za naslednji zagon

## Replacing a Linux system

installer-leftovers-failed = Ostankov prejšnjega poskusa ni bilo mogoče počistiti
installer-default-failed = Lufta ni bilo mogoče nastaviti kot sistem, ki se zažene
installer-relabel-failed = Vaših datotek ni bilo mogoče označiti za Luft
installer-set-aside-failed = Starega sistema ni bilo mogoče umakniti

## Things packed with Meet Luft

installer-box-unopened = Selitvene škatle ni bilo mogoče odpreti
installer-box-no-list = Selitvena škatla nima seznama vsebine
installer-unpack-failed = Datoteke { $path } ni bilo mogoče razpakirati
installer-wallpaper-unnamed = Ozadje nima imena
