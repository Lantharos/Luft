ARG FEDORA
FROM quay.io/fedora/fedora:${FEDORA}
ARG BUN_VERSION
ARG BUN_SHA256

COPY build.txt runtime.txt /tmp/packages/
RUN dnf install --assumeyes --setopt=install_weak_deps=False dnf5-plugins systemd rust cargo clippy jq \
      $(cat /tmp/packages/build.txt /tmp/packages/runtime.txt) && \
    dnf builddep --assumeyes mutter && \
    dnf clean all && rm -rf /tmp/packages

RUN curl -fsSL "https://github.com/oven-sh/bun/releases/download/bun-v${BUN_VERSION}/bun-linux-x64.zip" -o /tmp/bun.zip && \
    echo "${BUN_SHA256}  /tmp/bun.zip" | sha256sum -c - && \
    unzip -j /tmp/bun.zip bun-linux-x64/bun -d /usr/local/bin && rm /tmp/bun.zip

RUN mkdir -p /etc/systemd/system/user@.service.d && \
    printf '[Service]\nEnvironment=XDG_RUNTIME_DIR=/run/user/%%i\n' > /etc/systemd/system/user@.service.d/runtime.conf && \
    systemctl mask getty.target console-getty.service systemd-udevd.service polkit.service rtkit-daemon.service \
      systemd-oomd.service NetworkManager.service ModemManager.service fwupd.service bluetooth.service
